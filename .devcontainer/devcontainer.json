{
  "name": "codex-gateway (Go 1.26.10)",
  "dockerComposeFile": "compose.yaml",
  "service": "dev",
  "workspaceFolder": "/workspaces/codex-gateway",
  "remoteUser": "vscode",
  "containerEnv": {
    "GOTOOLCHAIN": "local"
  },
  "postCreateCommand": "go mod download",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go"
      ]
    }
  }
}
