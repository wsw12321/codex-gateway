# Copy this file to .env and replace every placeholder before deployment.
GATEWAY_DOMAIN=codex.example.com

# Enable only after deploying the browser workbench handoff receiver.
# Empty disables one-click launch and browser API CORS. See docs/browser-cors.md.
GATEWAY_BROWSER_CLIENT_URL=
# Production value: https://ai.water555.com

# Optional 吾水阁 OIDC. Default deployments require no OIDC secret.
# Set up deploy/secrets/oidc_client_secret, then use deploy/oidc.override.yml.
# Read docs/oidc.md and complete real staging acceptance before enabling.
OIDC_ENABLED=false
OIDC_ISSUER=
# Optional browser authorization proxy; HTTPS public hostname, no query/fragment.
# Discovery, token exchange and JWKS still use OIDC_ISSUER through the fixed proxy.
OIDC_AUTHORIZATION_URL=
OIDC_CLIENT_ID=
OIDC_AUTH_HOST=

# Build from a reviewed Git revision. The image tag must equal either the
# release version or the full 40-character revision; never use a mutable tag
# such as local, dev, latest, or unknown in production.
GATEWAY_IMAGE_TAG=replace-with-git-sha-or-version
GATEWAY_VERSION=replace-with-release-version
GATEWAY_REVISION=replace-with-full-git-sha

# Required v2 snapshot for the local "API Token 等价成本" report. The
# readable canonical template is deploy/pricing-v2.example.json; keep its
# minified copy below on one line. Review dates and published combinations.
# GPT-5.6 Sol deliberately uses pre-promotion rates from the 2026-08-20
# template (commit 5d224a8), restored on 2026-09-16; see
# docs/gpt-5.6-server-configuration.md for the historical pricing policy.
# AGY uses exact Gemini IDs and Standard API family token-equivalent pricing;
# output includes thinking. Pro has a 200K context boundary; Flash is flat.
# Reviewed 2026-09-28. These local charges are not AGY subscription charges.
# Flash promotion ends 2026-12-31. Plan a manual switch on 2027-01-01 for Flash input /
# cached input / output snapshot to 1.50 / 0.15 / 7.50 USD per million tokens.
# Claude Standard API prices were reviewed on 2026-10-08 against
# https://platform.claude.com/docs/en/about-claude/pricing; Fable 5.1, Opus 5.5,
# Sonnet 5.5 and Haiku 4.5 use separate 5-minute/1-hour cache-write prices.
# Fable/Opus/Sonnet have flat 1M context pricing; Haiku has a 200K limit.
# Claude Fast, Batch and regional surcharges remain out of scope.
# This is configuration metadata, not a secret. Unversioned three-price JSON
# remains accepted only for v1 transition and in-flight reservation settlement.
