_usd_per_million":"75"}}}},"gpt-5.4":{"cache_write_mode":"included_in_input","max_input_tokens":1050000,"long_context_threshold_tokens":272000,"service_tiers":{"standard":{"short":{"input_usd_per_million":"2.5","cached_input_usd_per_million":"0.25","output_usd_per_million":"15"},"long":{"input_usd_per_million":"5","cached_input_usd_per_million":"0.5","output_usd_per_million":"22.5"}},"flex":{"short":{"input_usd_per_million":"1.25","cached_input_usd_per_million":"0.13","output_usd_per_million":"7.5"},"long":{"input_usd_per_million":"2.5","cached_input_usd_per_million":"0.25","output_usd_per_million":"11.25"}},"fast":{"short":{"input_usd_per_million":"5","cached_input_usd_per_million":"0.5","output_usd_per_million":"30"}}}},"gpt-5.4-mini":{"cache_write_mode":"included_in_input","max_input_tokens":272000,"long_context_threshold_tokens":272000,"service_tiers":{"standard":{"short":{"input_usd_per_million":"0.75","cached_input_usd_per_million":"0.075","output_usd_per_million":"4.5"}},"flex":{"short":{"input_usd_per_million":"0.375","cached_input_usd_per_million":"0.0375","output_usd_per_million":"2.25"}},"fast":{"short":{"input_usd_per_million":"1.5","cached_input_usd_per_million":"0.15","output_usd_per_million":"9"}}}},"codex-auto-review":{"cache_write_mode":"included_in_input","max_input_tokens":272000,"long_context_threshold_tokens":272000,"service_tiers":{"standard":{"short":{"input_usd_per_million":"0","cached_input_usd_per_million":"0","output_usd_per_million":"0"}}}}}}

# Set this to the private deployment user's primary group: id -g
# Service secret files are owner/group readable (0640), never world readable.
# bootstrap-secrets.sh creates the required gateway_api_key_encryption_key as
# unpadded URL-safe Base64 for exactly 32 random bytes; never put it in .env.
GATEWAY_SECRET_GID=1000

# The Go gateway must trust only this fixed Caddy address for client IP headers.
GATEWAY_TRUSTED_PROXY_CIDRS=172.28.10.2/32

# Gateway concurrency admission limits. Increase these gradually and monitor
# upstream 429 responses, PostgreSQL latency, CPU, and memory.
LIMIT_KEY_CONCURRENT=16
LIMIT_USER_CONCURRENT=16
LIMIT_GLOBAL_CONCURRENT=32

# The Cloudflare Tunnel token is not an environment variable. Store it only in
# deploy/secrets/cloudflared_tunnel_token with mode 0640.

# Used only by scripts/smoke-sidecar.sh. Confirm this model after login.
CODEX_SMOKE_MODEL=gpt-5-codex
