# Copy this file to .env and replace every placeholder before deployment.
GATEWAY_DOMAIN=codex.example.com

# Build from a reviewed Git revision. The image tag must equal either the
# release version or the full 40-character revision; never use a mutable tag
# such as local, dev, latest, or unknown in production.
GATEWAY_IMAGE_TAG=replace-with-git-sha-or-version
GATEWAY_VERSION=replace-with-release-version
GATEWAY_REVISION=replace-with-full-git-sha

# Set this to the private deployment user's primary group: id -g
# Service secret files are owner/group readable (0640), never world readable.
GATEWAY_SECRET_GID=1000

# The Go gateway must trust only this fixed Caddy address for client IP headers.
GATEWAY_TRUSTED_PROXY_CIDRS=172.28.10.2/32

# The Cloudflare Tunnel token is not an environment variable. Store it only in
# deploy/secrets/cloudflared_tunnel_token with mode 0640.

# Used only by scripts/smoke-sidecar.sh. Confirm this model after login.
CODEX_SMOKE_MODEL=gpt-5-codex
