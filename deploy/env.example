# Copy this file to .env and replace every placeholder before deployment.
GATEWAY_DOMAIN=codex.example.com

# Enable only after deploying the browser workbench handoff receiver.
# Empty disables one-click launch and browser API CORS. See docs/browser-cors.md.
GATEWAY_BROWSER_CLIENT_URL=
# Production value: https://ai.water555.com

# Optional 吾水阁 OIDC. Default deployments require no OIDC secret.
# Set up deploy/secrets/oidc_client_secret, then use deploy/oidc.override.yml.
# Read docs/oidc.md and complete real staging acceptance before enabling.
OIDC_ENABLED=false
OIDC_ISSUER=
# Optional browser authorization proxy; HTTPS public hostname, no query/fragment.
# Discovery, token exchange and JWKS still use OIDC_ISSUER through the fixed proxy.
OIDC_AUTHORIZATION_URL=
OIDC_CLIENT_ID=
OIDC_AUTH_HOST=

# Build from a reviewed Git revision. The image tag must equal either the
# release version or the full 40-character revision; never use a mutable tag
# such as local, dev, latest, or unknown in production.
GATEWAY_IMAGE_TAG=replace-with-git-sha-or-version
GATEWAY_VERSION=replace-with-release-version
GATEWAY_REVISION=replace-with-full-git-sha

# Prices are built into the Gateway image from the reviewed catalog
# internal/config/data/pricing.json; no pricing setting belongs here. To
# deviate from the built-in prices or USD/CNY rate on this server only, create
# deploy/pricing/override.json (see deploy/pricing/README.md). The retired
# GATEWAY_USAGE_PRICING_JSON setting stops every Compose call; migrate it with
# `gateway pricing migrate-env` (docs/operations.md).

# Set this to the private deployment user's primary group: id -g
# Service secret files are owner/group readable (0640), never world readable.
# bootstrap-secrets.sh creates the required gateway_api_key_encryption_key as
# unpadded URL-safe Base64 for exactly 32 random bytes; never put it in .env.
GATEWAY_SECRET_GID=1000

# The Go gateway must trust only this fixed Caddy address for client IP headers.
GATEWAY_TRUSTED_PROXY_CIDRS=172.28.10.2/32

# Gateway concurrency admission limits. Increase these gradually and monitor
# upstream 429 responses, PostgreSQL latency, CPU, and memory.
LIMIT_KEY_CONCURRENT=16
LIMIT_USER_CONCURRENT=16
LIMIT_GLOBAL_CONCURRENT=32

# The Cloudflare Tunnel token is not an environment variable. Store it only in
# deploy/secrets/cloudflared_tunnel_token with mode 0640.

# Shared Codex/Gemini egress: direct, relay (WireGuard + B Squid), shadowsocks.
# Apply changes with ./scripts/apply-egress.sh; see docs/egress.md.
# Explicit mode wins even if old relay settings remain. Missing/empty mode
# preserves legacy behavior: nonempty CODEX_RELAY_IP selects relay, else direct.
EGRESS_MODE=direct
# Owner API Key suppliers. Review docs/model-suppliers.md before enabling.
SUPPLIERS_ENABLED=false
# SUPPLIER_RELAY_KEY_FILE=./deploy/secrets/supplier_relay_key
# Relay uses canonical IPv4 and a decimal port without leading zeros.
# Upgrade B's allowlist first; see docs/openai-relay.md and docs/relay-upgrade.md.
CODEX_RELAY_IP=
CODEX_RELAY_PORT=3128
# Only required in shadowsocks mode. The password is never an env value.
# Secret file: 0640, group GATEWAY_SECRET_GID; mounted only into ss-egress.
SHADOWSOCKS_SERVER=
SHADOWSOCKS_PORT=24019
SHADOWSOCKS_CIPHER=aes-128-gcm
SHADOWSOCKS_PASSWORD_FILE=./deploy/secrets/shadowsocks_password

# CPA v8 serves Codex and native Antigravity in one process. The empty map
# selects all five reviewed native Gemini IDs; price, account readiness and
# Gateway user/key permissions still determine visibility. A nonempty map
# restricts routing to a reviewed subset with identical public/native IDs.
ANTIGRAVITY_MODEL_ROUTES_JSON={}
