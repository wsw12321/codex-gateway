,"long_context_threshold_tokens":1000000,"service_tiers":{"standard":{"short":{"input_usd_per_million":"10","output_usd_per_million":"50","cached_input_usd_per_million":"0.25","cache_write_5m_usd_per_million":"12.50","cache_write_1h_usd_per_million":"20"}}}},"claude-opus-5-5":{"cache_write_mode":"separate_by_ttl","max_input_tokens":1000000,"long_context_threshold_tokens":1000000,"service_tiers":{"standard":{"short":{"input_usd_per_million":"4","output_usd_per_million":"20","cached_input_usd_per_million":"0.20","cache_write_5m_usd_per_million":"5","cache_write_1h_usd_per_million":"8"}}}},"claude-sonnet-5-5":{"cache_write_mode":"separate_by_ttl","max_input_tokens":1000000,"long_context_threshold_tokens":1000000,"service_tiers":{"standard":{"short":{"input_usd_per_million":"2","output_usd_per_million":"10","cached_input_usd_per_million":"0.10","cache_write_5m_usd_per_million":"2.50","cache_write_1h_usd_per_million":"4"}}}},"claude-haiku-4-5-20251001":{"cache_write_mode":"separate_by_ttl","max_input_tokens":200000,"long_context_threshold_tokens":200000,"service_tiers":{"standard":{"short":{"input_usd_per_million":"1","output_usd_per_million":"5","cached_input_usd_per_million":"0.10","cache_write_5m_usd_per_million":"1.25","cache_write_1h_usd_per_million":"2"}}}}}}

# Set this to the private deployment user's primary group: id -g
# Service secret files are owner/group readable (0640), never world readable.
# bootstrap-secrets.sh creates the required gateway_api_key_encryption_key as
# unpadded URL-safe Base64 for exactly 32 random bytes; never put it in .env.
GATEWAY_SECRET_GID=1000

# The Go gateway must trust only this fixed Caddy address for client IP headers.
GATEWAY_TRUSTED_PROXY_CIDRS=172.28.10.2/32

# Gateway concurrency admission limits. Increase these gradually and monitor
# upstream 429 responses, PostgreSQL latency, CPU, and memory.
LIMIT_KEY_CONCURRENT=16
LIMIT_USER_CONCURRENT=16
LIMIT_GLOBAL_CONCURRENT=32

# The Cloudflare Tunnel token is not an environment variable. Store it only in
# deploy/secrets/cloudflared_tunnel_token with mode 0640.

# Used only by scripts/smoke-sidecar.sh. Confirm this model after login.
CODEX_SMOKE_MODEL=gpt-5-codex

# Shared Codex/Gemini egress: direct, relay (WireGuard + B Squid), shadowsocks.
# Apply changes with ./scripts/apply-egress.sh; see docs/egress.md.
# Explicit mode wins even if old relay settings remain. Missing/empty mode
# preserves legacy behavior: nonempty CODEX_RELAY_IP selects relay, else direct.
EGRESS_MODE=direct
# Relay uses canonical IPv4 and a decimal port without leading zeros.
# Upgrade B's allowlist first; see docs/openai-relay.md and docs/relay-upgrade.md.
CODEX_RELAY_IP=
CODEX_RELAY_PORT=3128
# Only required in shadowsocks mode. The password is never an env value.
# Secret file: 0640, group GATEWAY_SECRET_GID; mounted only into ss-egress.
SHADOWSOCKS_SERVER=
SHADOWSOCKS_PORT=24019
SHADOWSOCKS_CIPHER=aes-128-gcm
SHADOWSOCKS_PASSWORD_FILE=./deploy/secrets/shadowsocks_password

# CPA v8 serves Codex and native Antigravity in one process. The empty map
# selects all eight reviewed native Gemini IDs; price, account readiness and
# Gateway user/key permissions still determine visibility. A nonempty map
# restricts routing to a reviewed subset with identical public/native IDs.
ANTIGRAVITY_MODEL_ROUTES_JSON={}
# The legacy bridge runs only with --profile legacy-bridge and the reviewed
# deploy/legacy-bridge.override.yml after reverse credential conversion.
