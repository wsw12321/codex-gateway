# Copy this file to .env and replace the public hostname.
GATEWAY_DOMAIN=codex.example.com
GATEWAY_IMAGE_TAG=local

# Set this to the private deployment user's primary group: id -g
# Service secret files are owner/group readable (0640), never world readable.
GATEWAY_SECRET_GID=1000

# The Go gateway must trust only this fixed Caddy address for client IP headers.
GATEWAY_TRUSTED_PROXY_CIDRS=172.28.10.2/32

# Used only by scripts/smoke-sidecar.sh. Confirm this model after login.
CODEX_SMOKE_MODEL=gpt-5-codex
