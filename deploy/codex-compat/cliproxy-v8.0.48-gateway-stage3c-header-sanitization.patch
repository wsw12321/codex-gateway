+
+// RemoveCodexInternalHeaders removes routing, attribution, and hierarchy hints
+// at the final provider request assembly boundary. Session-Id / Session_id and
+// X-Codex-Turn-Metadata retain the existing Codex provider cache/turn semantics.
+func RemoveCodexInternalHeaders(headers http.Header) {
+	if headers == nil {
+		return
+	}
+	for name := range headers {
+		if isCodexInternalHeader(name) || isCodexRelationHeader(name) {
+			delete(headers, name)
+		}
+	}
+}
+
+func isCodexInternalHeader(name string) bool {
+	return strings.EqualFold(strings.TrimSpace(name), "X-Codex-Diagnostic-Run") || strings.EqualFold(strings.TrimSpace(name), "X-Codex-Diagnostic-Probe") || strings.EqualFold(strings.TrimSpace(name), CodexGatewayUserHeader) || strings.EqualFold(strings.TrimSpace(name), CodexGatewayAffinityHeader) ||
+		strings.EqualFold(strings.TrimSpace(name), CodexUpstreamAccountHeader) || strings.EqualFold(strings.TrimSpace(name), "X-Codex-Conversation-Hash")
+}
+
+func isCodexRelationHeader(name string) bool {
+	switch strings.ToLower(strings.ReplaceAll(name, "_", "-")) {
+	case "thread-id", "x-codex-parent-thread-id", "x-openai-subagent",
+		"x-claude-code-session-id", "x-claude-code-agent-id", "x-claude-code-parent-agent-id",
+		"x-claude-code-parent-session-id", "x-claude-parent-session-id", "x-claude-code-side-session-id",
+		"x-http-session-id", "x-session-id", "x-session-affinity", "x-slot-session-id", "x-task-id",
+		"x-conversation-id", "x-thread-id", "x-client-request-id", "x-side-session-id", "x-side-thread-id",
+		"x-parent-id", "x-parent-session", "x-parent-session-id", "x-parent-thread-id", "x-parent-task-id",
+		"x-parent-conversation-id", "x-parent-session-affinity", "x-parent-slot-session-id",
+		"x-parent-side-session-id", "x-parent-side-thread-id":
+		return true
+	}
+	return false
+}
