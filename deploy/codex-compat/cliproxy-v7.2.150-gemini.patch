+package pluginhost
+
+import (
+	"context"
+	"flag"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/pluginapi"
+)
+
+// Run the built test binary in the runtime image with the actual shared
+// library. This checks the native ABI, not an in-process fake plugin.
+func TestGeminiCLISharedPluginLoads(t *testing.T) {
+	dir := os.Getenv("GEMINI_PLUGIN_TEST_DIR")
+	if dir == "" {
+		t.Skip("GEMINI_PLUGIN_TEST_DIR is only set for the image ABI check")
+	}
+	host := New()
+	ctx := context.Background()
+	enabled := true
+	host.ApplyConfig(ctx, &config.Config{
+		AuthDir: t.TempDir(),
+		Plugins: config.PluginsConfig{
+			Enabled: true,
+			Dir:     dir,
+			Configs: map[string]config.PluginInstanceConfig{"gemini-cli": {Enabled: &enabled}},
+		},
+	})
+	defer host.ShutdownAll()
+	if !host.PluginLoaded("gemini-cli") || !host.HasAuthProvider("gemini-cli") {
+		t.Fatal("Gemini CLI shared library failed to register its auth provider")
+	}
+	flags := flag.NewFlagSet("gemini-plugin-test", flag.ContinueOnError)
+	flags.SetOutput(io.Discard)
+	host.RegisterCommandLineFlags(ctx, flags)
+	for _, name := range []string{"geminicli-login", "geminicli-project-id"} {
+		if flags.Lookup(name) == nil {
+			t.Fatalf("shared plugin did not register --%s", name)
+		}
+	}
+	for _, kind := range []string{"gemini-cli", "gemini"} {
+		const name = "gemini-synthetic.json"
+		auth, handled, err := host.ParseAuth(ctx, pluginapi.AuthParseRequest{
+			Path:     filepath.Join(t.TempDir(), name),
+			FileName: name,
+			RawJSON:  []byte(`{"type":"` + kind + `","email":"synthetic@example.invalid","project_id":"synthetic-project","access_token":"synthetic-access-token","refresh_token":"synthetic-refresh-token"}`),
+		})
+		if err != nil || !handled || auth == nil || auth.Provider != "gemini-cli" {
+			t.Fatalf("synthetic %s OAuth file was not recognized: handled=%t err=%v", kind, handled, err)
+		}
+		models := host.ModelsForAuth(ctx, auth)
+		if models.Err != nil || !models.Handled {
+			t.Fatalf("plugin model catalog failed: %v", models.Err)
+		}
+		found := false
+		for _, model := range models.Models {
+			if model.ID == "gemini-3.1-pro-preview" && model.InputTokenLimit == 1048576 {
+				found = true
+			}
+		}
+		if !found {
+			t.Fatal("Gemini Pro absent from parsed OAuth model catalog")
+		}
+	}
+	testGeminiCLISharedStreamCleanup(t, host)
+}
+
+type geminiGatewayRoundTripper func(*http.Request) (*http.Response, error)
+
+func (f geminiGatewayRoundTripper) RoundTrip(req *http.Request) (*http.Response, error) {
+	return f(req)
+}
+
+func testGeminiCLISharedStreamCleanup(t *testing.T, host *Host) {
+	t.Helper()
+	var executor pluginapi.ProviderExecutor
+	for _, record := range host.activeRecords() {
+		if record.id == "gemini-cli" {
+			executor = record.plugin.Capabilities.Executor
+		}
+	}
+	if executor == nil {
+		t.Fatal("shared plugin executor was not registered")
+	}
+	for _, mode := range []string{"client cancel", "invalid SSE"} {
+		t.Run(mode, func(t *testing.T) {
+			closed := make(chan struct{})
+			rt := geminiGatewayRoundTripper(func(req *http.Request) (*http.Response, error) {
+				if req.URL.Host != "cloudcode-pa.googleapis.com" || req.Header.Get("Authorization") != "Bearer synthetic-access" {
+					t.Errorf("unexpected mock Google request: %s", req.URL)
+				}
+				reader, writer := io.Pipe()
+				go func() {
+					defer close(closed)
+					wire := "data: {\"response\":{\"candidates\":[{\"content\":{\"parts\":[{\"text\":\"partial\"}]}}]}}\n\n"
+					if mode == "invalid SSE" {
+						wire = "data: {invalid-json}\n\n"
+					}
+					_, _ = io.WriteString(writer, wire)
+					<-req.Context().Done()
+					_ = writer.CloseWithError(req.Context().Err())
+				}()
+				return &http.Response{StatusCode: http.StatusOK, Header: http.Header{"Content-Type": {"text/event-stream"}}, Body: reader}, nil
+			})
+			ctx, cancel := context.WithCancel(context.WithValue(context.Background(), "cliproxy.roundtripper", rt))
+			defer cancel()
+			stream, err := executor.ExecuteStream(ctx, pluginapi.ExecutorRequest{
+				Model:       "gemini-3.1-pro-preview",
+				Payload:     []byte(`{"contents":[{"parts":[{"text":"hello"}]}]}`),
+				StorageJSON: []byte(`{"type":"gemini-cli","project_id":"synthetic-project","access_token":"synthetic-access"}`),
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			select {
+			case chunk, ok := <-stream.Chunks:
+				if !ok || (mode == "invalid SSE") != (chunk.Err != nil) {
+					t.Fatalf("shared plugin stream %s: open=%t error=%v", mode, ok, chunk.Err)
+				}
+			case <-time.After(3 * time.Second):
+				t.Fatal("shared plugin did not produce its first event")
+			}
+			if mode == "client cancel" {
+				cancel()
+			}
+			// For malformed SSE, no caller cancellation is performed: the actual
+			// C ABI pump must cancel its own upstream reader on decoder failure.
+			select {
+			case <-closed:
+			case <-time.After(3 * time.Second):
+				t.Fatal("shared plugin leaked the upstream HTTP stream")
+			}
+			deadline := time.After(3 * time.Second)
+			for {
+				select {
+				case _, ok := <-stream.Chunks:
+					if !ok {
+						return
+					}
+				case <-deadline:
+					t.Fatal("shared plugin did not close the client stream")
+				}
+			}
+		})
+	}
+}
