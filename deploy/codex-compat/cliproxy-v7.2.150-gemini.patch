+package responses
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"testing"
+
+	"github.com/tidwall/gjson"
+)
+
+func TestGeminiGatewayResponsesUsageIncludesReasoning(t *testing.T) {
+	for _, tc := range []struct {
+		name, usage                      string
+		input, output, reasoning, cached int64
+	}{
+		{"answer and reasoning", `{"promptTokenCount":10,"candidatesTokenCount":2,"thoughtsTokenCount":3,"totalTokenCount":15,"cachedContentTokenCount":4}`, 10, 5, 3, 4},
+		{"answer only", `{"promptTokenCount":10,"candidatesTokenCount":2,"totalTokenCount":12}`, 10, 2, 0, 0},
+		{"reasoning only", `{"promptTokenCount":10,"thoughtsTokenCount":3,"totalTokenCount":13}`, 10, 3, 3, 0},
+	} {
+		for _, stream := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/stream=%t", tc.name, stream), func(t *testing.T) {
+				body := []byte(`{"candidates":[{"content":{"parts":[{"text":"answer"}]},"finishReason":"STOP"}],"usageMetadata":` + tc.usage + `,"modelVersion":"gemini-3.1-pro-preview","responseId":"resp_usage"}`)
+				var response []byte
+				if stream {
+					var state any
+					completed := 0
+					// Duplicate terminal events must not duplicate billing completions.
+					for range 2 {
+						for _, event := range ConvertGeminiResponseToOpenAIResponses(context.Background(), "gemini-3.1-pro-preview", nil, nil, body, &state) {
+							if !bytes.Contains(event, []byte("event: response.completed\n")) {
+								continue
+							}
+							completed++
+							_, payload, _ := bytes.Cut(event, []byte("data: "))
+							response = []byte(gjson.GetBytes(bytes.TrimSpace(payload), "response").Raw)
+						}
+					}
+					if completed != 1 {
+						t.Fatalf("completion count=%d, want 1", completed)
+					}
+				} else {
+					response = ConvertGeminiResponseToOpenAIResponsesNonStream(context.Background(), "gemini-3.1-pro-preview", nil, nil, body, nil)
+				}
+				for path, want := range map[string]int64{
+					"usage.input_tokens":                           tc.input,
+					"usage.output_tokens":                          tc.output,
+					"usage.output_tokens_details.reasoning_tokens": tc.reasoning,
+					"usage.input_tokens_details.cached_tokens":     tc.cached,
+					"usage.total_tokens":                           tc.input + tc.output,
+				} {
+					if got := gjson.GetBytes(response, path); !got.Exists() || got.Int() != want {
+						t.Fatalf("%s=%s, want %d: %s", path, got.Raw, want, response)
+					}
+				}
+			})
+		}
+	}
+}
