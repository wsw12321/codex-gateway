+package pluginhost
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/pluginapi"
+)
+
+func TestGeminiGatewayPluginHTTPRejectsRedirects(t *testing.T) {
+	var redirected atomic.Int32
+	destination := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		redirected.Add(1)
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer destination.Close()
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Location", destination.URL)
+		w.WriteHeader(http.StatusTemporaryRedirect)
+		_, _ = io.WriteString(w, "redirect refused")
+	}))
+	defer upstream.Close()
+	client := New().newHTTPClient(nil, "gemini-cli")
+	req := pluginapi.HTTPRequest{Method: http.MethodPost, URL: upstream.URL, Headers: http.Header{"Authorization": {"Bearer synthetic-google-token"}}}
+	response, err := client.Do(context.Background(), req)
+	if err != nil || response.StatusCode != http.StatusTemporaryRedirect {
+		t.Fatalf("JSON redirect status=%d err=%v", response.StatusCode, err)
+	}
+	stream, err := client.DoStream(context.Background(), req)
+	if err != nil || stream.StatusCode != http.StatusTemporaryRedirect {
+		t.Fatalf("SSE redirect status=%d err=%v", stream.StatusCode, err)
+	}
+	for chunk := range stream.Chunks {
+		if chunk.Err != nil {
+			t.Fatal(chunk.Err)
+		}
+	}
+	if redirected.Load() != 0 {
+		t.Fatal("plugin HTTP client followed a redirect with OAuth credentials")
+	}
+}
