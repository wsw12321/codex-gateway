+package executor
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/pluginapi"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/translator/builtin"
+	"github.com/tidwall/gjson"
+)
+
+const gatewayGeminiModel = "gemini-3.1-pro-preview"
+
+type gatewayMockHTTP struct {
+	requests  []pluginapi.HTTPRequest
+	wire      string
+	chunkSize int
+	status    int
+}
+
+func (m *gatewayMockHTTP) Do(_ context.Context, req pluginapi.HTTPRequest) (pluginapi.HTTPResponse, error) {
+	m.requests = append(m.requests, req)
+	if req.URL == "https://oauth2.googleapis.com/token" {
+		return pluginapi.HTTPResponse{StatusCode: http.StatusOK, Body: []byte(`{"access_token":"new-access","refresh_token":"refresh-token","token_type":"Bearer","expires_in":3600}`)}, nil
+	}
+	return pluginapi.HTTPResponse{StatusCode: m.status, Body: []byte(m.wire)}, nil
+}
+
+func (m *gatewayMockHTTP) DoStream(_ context.Context, req pluginapi.HTTPRequest) (pluginapi.HTTPStreamResponse, error) {
+	m.requests = append(m.requests, req)
+	var parts []string
+	for wire := m.wire; len(wire) > 0; {
+		n := len(wire)
+		if m.chunkSize > 0 && n > m.chunkSize {
+			n = m.chunkSize
+		}
+		parts = append(parts, wire[:n])
+		wire = wire[n:]
+	}
+	return pluginapi.HTTPStreamResponse{StatusCode: m.status, Chunks: streamTestChunks(parts...)}, nil
+}
+
+func gatewayRequest(t *testing.T, client pluginapi.HostHTTPClient, original []byte, stream, expired bool) pluginapi.ExecutorRequest {
+	t.Helper()
+	storage := `{"type":"gemini-cli","project_id":"test-project","access_token":"current-access","refresh_token":"refresh-token"}`
+	if expired {
+		storage = fmt.Sprintf(`{"type":"gemini-cli","project_id":"test-project","access_token":"old-access","refresh_token":"refresh-token","expiry":%q}`, time.Now().Add(-time.Hour).Format(time.RFC3339))
+	}
+	return pluginapi.ExecutorRequest{
+		Model:       gatewayGeminiModel,
+		Payload:     builtin.Registry().TranslateRequest(sdktranslator.FormatOpenAIResponse, sdktranslator.FormatGemini, gatewayGeminiModel, original, stream),
+		StorageJSON: []byte(storage),
+		HTTPClient:  client,
+		Headers:     http.Header{"Authorization": {"Bearer gateway-private-key"}, "X-Codex-Upstream-Account": {"private-account"}, "X-Codex-Caller-Scope": {"private-caller"}},
+	}
+}
+
+func TestGatewayResponsesJSONAndSSEWithTokenRefresh(t *testing.T) {
+	original := []byte(`{"model":"gemini-3.1-pro-preview","input":"hello"}`)
+	final := `{"response":{"candidates":[{"content":{"role":"model","parts":[{"text":"answer"}]},"finishReason":"STOP"}],"usageMetadata":{"promptTokenCount":10,"candidatesTokenCount":2,"thoughtsTokenCount":3,"totalTokenCount":15,"cachedContentTokenCount":4},"modelVersion":"gemini-3.1-pro-preview","responseId":"resp_gateway"}}`
+	for _, mode := range []string{"json", "sse split", "sse coalesced"} {
+		t.Run(mode, func(t *testing.T) {
+			stream := mode != "json"
+			client := &gatewayMockHTTP{status: http.StatusOK, wire: final}
+			if stream {
+				// First event is a nonterminal text delta; final event owns usage.
+				client.wire = "data: {\"response\":{\"candidates\":[{\"content\":{\"parts\":[{\"text\":\"hello \"}]}}],\"responseId\":\"resp_gateway\"}}\n\n" + "data: " + final + "\n\n"
+				if mode == "sse split" {
+					client.chunkSize = 7
+				}
+			}
+			req := gatewayRequest(t, client, original, stream, true)
+			var result []byte
+			if stream {
+				response, err := NewExecutor().ExecuteStream(context.Background(), req)
+				if err != nil {
+					t.Fatal(err)
+				}
+				var state any
+				completions := 0
+				for chunk := range response.Chunks {
+					if chunk.Err != nil {
+						t.Fatal(chunk.Err)
+					}
+					for _, event := range builtin.Registry().TranslateStream(context.Background(), sdktranslator.FormatGemini, sdktranslator.FormatOpenAIResponse, gatewayGeminiModel, original, req.Payload, chunk.Payload, &state) {
+						if bytes.Contains(event, []byte("event: response.completed\n")) {
+							completions++
+							_, data, _ := bytes.Cut(event, []byte("data: "))
+							result = []byte(gjson.GetBytes(bytes.TrimSpace(data), "response").Raw)
+						}
+					}
+				}
+				if completions != 1 {
+					t.Fatalf("completion count=%d", completions)
+				}
+			} else {
+				response, err := NewExecutor().Execute(context.Background(), req)
+				if err != nil {
+					t.Fatal(err)
+				}
+				result = builtin.Registry().TranslateNonStream(context.Background(), sdktranslator.FormatGemini, sdktranslator.FormatOpenAIResponse, gatewayGeminiModel, original, req.Payload, response.Payload, nil)
+			}
+			if !gjson.ValidBytes(result) || gjson.GetBytes(result, "model").String() != gatewayGeminiModel || gjson.GetBytes(result, "status").String() != "completed" {
+				t.Fatalf("invalid Responses reply: %s", result)
+			}
+			for path, want := range map[string]int64{"usage.input_tokens": 10, "usage.output_tokens": 5, "usage.output_tokens_details.reasoning_tokens": 3, "usage.input_tokens_details.cached_tokens": 4, "usage.total_tokens": 15} {
+				if got := gjson.GetBytes(result, path).Int(); got != want {
+					t.Fatalf("%s=%d want=%d: %s", path, got, want, result)
+				}
+			}
+			if len(client.requests) != 2 || client.requests[0].URL != "https://oauth2.googleapis.com/token" || client.requests[1].Headers.Get("Authorization") != "Bearer new-access" {
+				t.Fatal("upstream generation did not use the refreshed credential")
+			}
+			for _, name := range []string{"X-Codex-Upstream-Account", "X-Codex-Caller-Scope"} {
+				if client.requests[1].Headers.Get(name) != "" {
+					t.Fatalf("private client header %s reached Google", name)
+				}
+			}
+			if got := gjson.GetBytes(client.requests[1].Body, "model").String(); got != gatewayGeminiModel {
+				t.Fatalf("upstream model=%q", got)
+			}
+		})
+	}
+}
+
+func TestGatewayResponsesFunctionCallRoundTrip(t *testing.T) {
+	original := []byte(`{"model":"gemini-3.1-pro-preview","input":"weather?","tools":[{"type":"function","name":"weather","parameters":{"type":"object","properties":{"city":{"type":"string"}},"required":["city"]}}]}`)
+	client := &gatewayMockHTTP{status: http.StatusOK, wire: `{"response":{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"name":"weather","id":"upstream-call","args":{"city":"Shanghai"}}}]},"finishReason":"STOP"}],"modelVersion":"gemini-3.1-pro-preview","responseId":"resp_tool"}}`}
+	req := gatewayRequest(t, client, original, false, false)
+	response, err := NewExecutor().Execute(context.Background(), req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result := builtin.Registry().TranslateNonStream(context.Background(), sdktranslator.FormatGemini, sdktranslator.FormatOpenAIResponse, gatewayGeminiModel, original, req.Payload, response.Payload, nil)
+	var call gjson.Result
+	for _, item := range gjson.GetBytes(result, "output").Array() {
+		if item.Get("type").String() == "function_call" {
+			call = item
+		}
+	}
+	if call.Get("name").String() != "weather" || call.Get("call_id").String() == "" || gjson.Get(call.Get("arguments").String(), "city").String() != "Shanghai" {
+		t.Fatalf("function call lost: %s", result)
+	}
+	followUp, err := json.Marshal(map[string]any{"model": gatewayGeminiModel, "input": []any{json.RawMessage(call.Raw), map[string]any{"type": "function_call_output", "call_id": call.Get("call_id").String(), "output": "sunny"}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	client.wire = `{"response":{"candidates":[{"content":{"parts":[{"text":"It is sunny."}]},"finishReason":"STOP"}],"modelVersion":"gemini-3.1-pro-preview"}}`
+	_, err = NewExecutor().Execute(context.Background(), gatewayRequest(t, client, followUp, false, false))
+	if err != nil {
+		t.Fatal(err)
+	}
+	found := false
+	for _, content := range gjson.GetBytes(client.requests[1].Body, "request.contents").Array() {
+		for _, part := range content.Get("parts").Array() {
+			fr := part.Get("functionResponse")
+			if fr.Get("name").String() == "weather" && fr.Get("response.result").String() == "sunny" {
+				found = true
+			}
+		}
+	}
+	if !found {
+		t.Fatalf("function result did not round-trip: %s", client.requests[1].Body)
+	}
+}
+
+func TestGatewayUpstreamRateLimitIsAnErrorForJSONAndSSE(t *testing.T) {
+	for _, stream := range []bool{false, true} {
+		client := &gatewayMockHTTP{status: http.StatusTooManyRequests, wire: `{"error":{"message":"quota exceeded"}}`, chunkSize: 3}
+		req := gatewayRequest(t, client, []byte(`{"input":"hello"}`), stream, false)
+		var err error
+		if stream {
+			_, err = NewExecutor().ExecuteStream(context.Background(), req)
+		} else {
+			_, err = NewExecutor().Execute(context.Background(), req)
+		}
+		status, ok := err.(interface{ StatusCode() int })
+		if !ok || status.StatusCode() != http.StatusTooManyRequests || err.Error() != "quota exceeded" || len(client.requests) != 1 {
+			t.Fatalf("stream=%t: rate limit=%v, requests=%d", stream, err, len(client.requests))
+		}
+	}
+}
