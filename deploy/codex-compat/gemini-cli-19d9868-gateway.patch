@@ -0,0 +1,50 @@
+//go:build cgo
+
+package main
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/pluginapi"
+)
+
+func TestGatewayABIPumpCancelsUpstreamOnHostEmitFailure(t *testing.T) {
+	// No host callback is registered: emission fails exactly as it does after
+	// the host removes a cancelled downstream stream.
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	chunks := make(chan pluginapi.ExecutorStreamChunk, 1)
+	chunks <- pluginapi.ExecutorStreamChunk{Payload: []byte(`{"partial":true}`)}
+	done := make(chan struct{})
+	go func() {
+		pumpABIStream(ctx, cancel, "removed-client-stream", chunks)
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("ABI pump blocked after failed host emit")
+	}
+	if ctx.Err() != context.Canceled {
+		t.Fatal("ABI pump left the upstream parser running after client loss")
+	}
+}
+
+func TestGatewayABIHTTPReaderCancellationUnblocksErrorSend(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	chunks := make(chan pluginapi.HTTPStreamChunk)
+	done := make(chan struct{})
+	go func() {
+		readHostHTTPStream(ctx, "removed-upstream-stream", chunks)
+		close(done)
+	}()
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("ABI HTTP reader leaked while publishing a cancellation error")
+	}
+}
