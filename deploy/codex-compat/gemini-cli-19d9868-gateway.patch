diff --git a/internal/executor/stream.go b/internal/executor/stream.go
new file mode 100644
index 0000000..b87d020
--- /dev/null
+++ b/internal/executor/stream.go
@@ -0,0 +1,178 @@
+package executor
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/pluginapi"
+	"github.com/router-for-me/CLIProxyAPIPlugins/geminicli/internal/compat"
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+const maxStreamEventBytes = 4 << 20
+
+// HTTP chunks are arbitrary network reads, not SSE events. Decode complete
+// events before removing the Cloud Code envelope or invoking host translation.
+func convertHTTPChunks(ctx context.Context, in <-chan pluginapi.HTTPStreamChunk) <-chan pluginapi.ExecutorStreamChunk {
+	out := make(chan pluginapi.ExecutorStreamChunk)
+	go func() {
+		defer close(out)
+		send := func(chunk pluginapi.ExecutorStreamChunk) bool {
+			select {
+			case <-ctx.Done():
+				return false
+			case out <- chunk:
+				return true
+			}
+		}
+		scanner := bufio.NewScanner(&httpChunkReader{ctx: ctx, chunks: in})
+		scanner.Buffer(make([]byte, 4096), maxStreamEventBytes)
+		scanner.Split(splitSSELines)
+		var data, pendingTerminal []byte
+		emitPending := func() bool {
+			if len(pendingTerminal) == 0 {
+				return true
+			}
+			ok := send(pluginapi.ExecutorStreamChunk{Payload: pendingTerminal})
+			pendingTerminal = nil
+			return ok
+		}
+		hasData, firstLine, terminal := false, true, false
+		for scanner.Scan() {
+			line := scanner.Bytes()
+			if firstLine {
+				line = bytes.TrimPrefix(line, []byte{0xef, 0xbb, 0xbf})
+				firstLine = false
+			}
+			if len(line) == 0 {
+				if !hasData {
+					continue
+				}
+				payload := bytes.TrimSpace(data)
+				if bytes.Equal(payload, []byte("[DONE]")) {
+					if !terminal {
+						send(pluginapi.ExecutorStreamChunk{Err: fmt.Errorf("gemini-cli: stream ended before finishReason: %w", io.ErrUnexpectedEOF)})
+					} else {
+						emitPending()
+					}
+					return
+				}
+				if !json.Valid(payload) {
+					send(pluginapi.ExecutorStreamChunk{Err: fmt.Errorf("gemini-cli: invalid SSE event JSON")})
+					return
+				}
+				// The host usage observer consumes one JSON line per event.
+				var compact bytes.Buffer
+				_ = json.Compact(&compact, payload)
+				unwrapped := compat.UnwrapResponse(compact.Bytes())
+				usage := gjson.GetBytes(unwrapped, "usageMetadata")
+				candidates := gjson.GetBytes(unwrapped, "candidates").Array()
+				if len(pendingTerminal) > 0 {
+					// Google can send usage in a final metadata-only event. Merge it
+					// before the host translator emits response.completed.
+					if usage.Exists() && len(candidates) == 0 {
+						pendingTerminal, _ = sjson.SetRawBytes(pendingTerminal, "usageMetadata", []byte(usage.Raw))
+						if !emitPending() {
+							return
+						}
+						data, hasData = data[:0], false
+						continue
+					}
+					if !emitPending() {
+						return
+					}
+				}
+				finishes := false
+				for _, candidate := range candidates {
+					finishes = finishes || candidate.Get("finishReason").String() != ""
+				}
+				terminal = terminal || finishes
+				if finishes && !usage.Exists() {
+					pendingTerminal = bytes.Clone(unwrapped)
+				} else if !send(pluginapi.ExecutorStreamChunk{Payload: bytes.Clone(unwrapped)}) {
+					return
+				}
+				data, hasData = data[:0], false
+				continue
+			}
+			field, value, _ := bytes.Cut(line, []byte(":"))
+			if !bytes.Equal(field, []byte("data")) {
+				continue
+			}
+			value = bytes.TrimPrefix(value, []byte(" "))
+			if len(data)+len(value)+1 > maxStreamEventBytes {
+				send(pluginapi.ExecutorStreamChunk{Err: fmt.Errorf("gemini-cli: SSE event exceeds size limit")})
+				return
+			}
+			if hasData {
+				data = append(data, '\n')
+			}
+			data = append(data, value...)
+			hasData = true
+		}
+		if err := scanner.Err(); err != nil {
+			send(pluginapi.ExecutorStreamChunk{Err: fmt.Errorf("gemini-cli: read SSE: %w", err)})
+		} else if hasData || !terminal {
+			// Never treat an incomplete event as a successful completion.
+			send(pluginapi.ExecutorStreamChunk{Err: fmt.Errorf("gemini-cli: read SSE: %w", io.ErrUnexpectedEOF)})
+		} else {
+			emitPending()
+		}
+	}()
+	return out
+}
+
+// SSE accepts LF, CRLF and CR, including a CRLF split across network reads.
+func splitSSELines(data []byte, atEOF bool) (int, []byte, error) {
+	for i, c := range data {
+		if c != '\r' && c != '\n' {
+			continue
+		}
+		advance := i + 1
+		if c == '\r' {
+			if advance == len(data) && !atEOF {
+				return 0, nil, nil
+			}
+			if advance < len(data) && data[advance] == '\n' {
+				advance++
+			}
+		}
+		return advance, data[:i], nil
+	}
+	if atEOF && len(data) > 0 {
+		return len(data), data, nil
+	}
+	return 0, nil, nil
+}
+
+type httpChunkReader struct {
+	ctx     context.Context
+	chunks  <-chan pluginapi.HTTPStreamChunk
+	pending []byte
+	err     error
+}
+
+func (r *httpChunkReader) Read(dst []byte) (int, error) {
+	for len(r.pending) == 0 {
+		if r.err != nil {
+			return 0, r.err
+		}
+		select {
+		case <-r.ctx.Done():
+			return 0, r.ctx.Err()
+		case chunk, ok := <-r.chunks:
+			if !ok {
+				return 0, io.EOF
+			}
+			r.pending, r.err = chunk.Payload, chunk.Err
+		}
+	}
+	n := copy(dst, r.pending)
+	r.pending = r.pending[n:]
+	return n, nil
+}
diff --git a/internal/executor/stream_test.go b/internal/executor/stream_test.go
new file mode 100644
index 0000000..3b27d8f
--- /dev/null
+++ b/internal/executor/stream_test.go
@@ -0,0 +1,167 @@
+package executor
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/pluginapi"
+	"github.com/tidwall/gjson"
+)
+
+func streamTestChunks(parts ...string) <-chan pluginapi.HTTPStreamChunk {
+	in := make(chan pluginapi.HTTPStreamChunk, len(parts))
+	for _, part := range parts {
+		in <- pluginapi.HTTPStreamChunk{Payload: []byte(part)}
+	}
+	close(in)
+	return in
+}
+
+func TestGatewaySSEFramingAcrossEveryNetworkBoundary(t *testing.T) {
+	first := `{"response":{"candidates":[{"content":{"parts":[{"text":"你好"}]}}]}}`
+	last := `{"response":{"candidates":[{"finishReason":"STOP"}],"usageMetadata":{"promptTokenCount":10,"candidatesTokenCount":2,"thoughtsTokenCount":3,"totalTokenCount":15}}}`
+	wire := "\xef\xbb\xbf: heartbeat\r\nevent: message\r\ndata: " + first + "\r\n\r\ndata: " + last + "\r\n\r\n"
+	for split := 0; split <= len(wire); split++ {
+		t.Run(fmt.Sprint(split), func(t *testing.T) {
+			var got []pluginapi.ExecutorStreamChunk
+			for chunk := range convertHTTPChunks(context.Background(), streamTestChunks(wire[:split], wire[split:])) {
+				if chunk.Err != nil {
+					t.Fatal(chunk.Err)
+				}
+				got = append(got, chunk)
+			}
+			if len(got) != 2 {
+				t.Fatalf("decoded %d events, want 2", len(got))
+			}
+			if text := gjson.GetBytes(got[0].Payload, "candidates.0.content.parts.0.text").String(); text != "你好" {
+				t.Fatalf("text=%q payload=%s", text, got[0].Payload)
+			}
+			if total := gjson.GetBytes(got[1].Payload, "usageMetadata.totalTokenCount").Int(); total != 15 {
+				t.Fatalf("completion usage lost: %s", got[1].Payload)
+			}
+		})
+	}
+}
+
+func TestGatewaySSEMultilineAndCarriageReturn(t *testing.T) {
+	wire := "id: one\rdata: {\rdata: \"response\":{\"responseId\":\"one\",\"candidates\":[{\"finishReason\":\"STOP\"}]}}\r\rdata: [DONE]\r\r"
+	var got []pluginapi.ExecutorStreamChunk
+	for chunk := range convertHTTPChunks(context.Background(), streamTestChunks(wire)) {
+		if chunk.Err != nil {
+			t.Fatal(chunk.Err)
+		}
+		got = append(got, chunk)
+	}
+	if len(got) != 1 || gjson.GetBytes(got[0].Payload, "responseId").String() != "one" {
+		t.Fatalf("multiline event=%v", got)
+	}
+}
+
+func TestGatewaySSERejectsIncompleteMalformedAndOversizedEvents(t *testing.T) {
+	for name, wire := range map[string]string{
+		"incomplete":  "data: {\"response\":{}}\n",
+		"malformed":   "data: {bad}\n\n",
+		"large line":  "data: " + strings.Repeat("x", maxStreamEventBytes) + "\n\n",
+		"large event": strings.Repeat("data: "+strings.Repeat("x", 1024)+"\n", maxStreamEventBytes/1024) + "\n",
+	} {
+		t.Run(name, func(t *testing.T) {
+			var failures int
+			for chunk := range convertHTTPChunks(context.Background(), streamTestChunks(wire)) {
+				if len(chunk.Payload) != 0 || chunk.Err == nil {
+					t.Fatalf("invalid stream produced output: %+v", chunk)
+				}
+				if name == "incomplete" && !errors.Is(chunk.Err, io.ErrUnexpectedEOF) {
+					t.Fatalf("error=%v, want unexpected EOF", chunk.Err)
+				}
+				failures++
+			}
+			if failures != 1 {
+				t.Fatalf("failure count=%d, want 1", failures)
+			}
+		})
+	}
+}
+
+func TestGatewaySSEPreservesFinalBytesAndReadError(t *testing.T) {
+	wantErr := errors.New("upstream read failed")
+	in := make(chan pluginapi.HTTPStreamChunk, 1)
+	in <- pluginapi.HTTPStreamChunk{Payload: []byte("data: {\"response\":{\"responseId\":\"one\"}}\n\n"), Err: wantErr}
+	close(in)
+	var got []pluginapi.ExecutorStreamChunk
+	for chunk := range convertHTTPChunks(context.Background(), in) {
+		got = append(got, chunk)
+	}
+	if len(got) != 2 || gjson.GetBytes(got[0].Payload, "responseId").String() != "one" || !errors.Is(got[1].Err, wantErr) {
+		t.Fatalf("final bytes or error lost: %+v", got)
+	}
+}
+
+func TestGatewaySSERequiresTerminalGeminiResponse(t *testing.T) {
+	for _, tail := range []string{"", "data: [DONE]\n\n"} {
+		wire := "data: {\"response\":{\"candidates\":[{\"content\":{\"parts\":[{\"text\":\"partial\"}]}}]}}\n\n" + tail
+		var payloads, failures int
+		for chunk := range convertHTTPChunks(context.Background(), streamTestChunks(wire)) {
+			if chunk.Err != nil {
+				failures++
+				if !errors.Is(chunk.Err, io.ErrUnexpectedEOF) {
+					t.Fatalf("truncated terminal error=%v", chunk.Err)
+				}
+			} else {
+				payloads++
+			}
+		}
+		if payloads != 1 || failures != 1 {
+			t.Fatalf("truncated stream looked complete: payloads=%d errors=%d", payloads, failures)
+		}
+	}
+}
+
+func TestGatewaySSETrailingUsageJoinsTerminalBeforeTranslation(t *testing.T) {
+	wire := "data: {\"response\":{\"candidates\":[{\"content\":{\"parts\":[{\"text\":\"answer\"}]},\"finishReason\":\"STOP\"}]}}\n\n" +
+		"data: {\"response\":{\"usageMetadata\":{\"promptTokenCount\":10,\"candidatesTokenCount\":2,\"thoughtsTokenCount\":3,\"totalTokenCount\":15}}}\n\n"
+	var got []pluginapi.ExecutorStreamChunk
+	for chunk := range convertHTTPChunks(context.Background(), streamTestChunks(wire)) {
+		if chunk.Err != nil {
+			t.Fatal(chunk.Err)
+		}
+		got = append(got, chunk)
+	}
+	if len(got) != 1 || gjson.GetBytes(got[0].Payload, "candidates.0.finishReason").String() != "STOP" || gjson.GetBytes(got[0].Payload, "usageMetadata.totalTokenCount").Int() != 15 {
+		t.Fatalf("terminal usage was lost or duplicated: %+v", got)
+	}
+}
+
+func TestGatewaySSECancellationClosesBlockedInputAndOutput(t *testing.T) {
+	for _, blockedOutput := range []bool{false, true} {
+		t.Run(fmt.Sprint(blockedOutput), func(t *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			in := make(chan pluginapi.HTTPStreamChunk)
+			out := convertHTTPChunks(ctx, in)
+			if blockedOutput {
+				select {
+				case in <- pluginapi.HTTPStreamChunk{Payload: []byte("data: {\"response\":{}}\n\n")}:
+				case <-time.After(time.Second):
+					t.Fatal("decoder did not read input")
+				}
+			}
+			cancel()
+			deadline := time.After(time.Second)
+			for {
+				select {
+				case _, ok := <-out:
+					if !ok {
+						return
+					}
+				case <-deadline:
+					t.Fatal("decoder leaked after client cancellation")
+				}
+			}
+		})
+	}
+}
