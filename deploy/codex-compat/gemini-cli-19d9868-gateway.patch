new file mode 100644
index 0000000..a0aece4
--- /dev/null
+++ b/internal/executor/gateway_functions_test.go
@@ -0,0 +1,165 @@
+package executor
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"testing"
+
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/translator/builtin"
+	"github.com/tidwall/gjson"
+)
+
+func TestGatewaySignedParallelFunctionCallsRoundTrip(t *testing.T) {
+	// Valid Gemini function signature shape: a protobuf wrapper around a UUID.
+	signatures := map[string]string{}
+	for id, uuid := range map[string]string{
+		"native-weather-1": "e24830a7-5cd6-42fe-998b-ee539e72b9c3",
+		"native-weather-2": "e24830a7-5cd6-42fe-998b-ee539e72b9c4",
+	} {
+		signatures[id] = base64.StdEncoding.EncodeToString(append([]byte{0x12, 0x26, 0x0a, 0x24}, uuid...))
+	}
+	original := []byte(`{"model":"gemini-3.1-pro-preview","input":"Compare Shanghai and Beijing weather.","tools":[{"type":"function","name":"weather","parameters":{"type":"object","properties":{"city":{"type":"string"}},"required":["city"]}}]}`)
+	providerBody := fmt.Sprintf(`{"response":{"candidates":[{"content":{"role":"model","parts":[
+		{"thoughtSignature":%q,"functionCall":{"name":"weather","id":"native-weather-1","args":{"city":"Shanghai"}}},
+		{"thoughtSignature":%q,"functionCall":{"name":"weather","id":"native-weather-2","args":{"city":"Beijing"}}}
+	]},"finishReason":"STOP"}],"usageMetadata":{"promptTokenCount":10,"candidatesTokenCount":2,"thoughtsTokenCount":3,"totalTokenCount":15},"modelVersion":"gemini-3.1-pro-preview","responseId":"resp_signed_tools"}}`, signatures["native-weather-1"], signatures["native-weather-2"])
+	// A single data line must not contain the pretty-print newlines above.
+	var compact bytes.Buffer
+	if err := json.Compact(&compact, []byte(providerBody)); err != nil {
+		t.Fatal(err)
+	}
+	providerBody = compact.String()
+
+	for _, stream := range []bool{false, true} {
+		t.Run(fmt.Sprintf("stream=%t", stream), func(t *testing.T) {
+			client := &gatewayMockHTTP{status: http.StatusOK, chunkSize: 7, wire: providerBody}
+			if stream {
+				client.wire = "data: " + providerBody + "\n\n"
+			}
+			response, replay := gatewaySignedFunctionResponse(t, client, original, stream)
+			callCount, signatureCount := 0, 0
+			for _, itemJSON := range replay {
+				item := gjson.ParseBytes(itemJSON)
+				switch item.Get("type").String() {
+				case "function_call":
+					callCount++
+					id := item.Get("call_id").String()
+					if _, ok := signatures[id]; !ok || item.Get("name").String() != "weather" {
+						t.Fatalf("provider call ID or name lost: %s", itemJSON)
+					}
+				case "reasoning":
+					if item.Get("encrypted_content").String() == "" {
+						t.Fatalf("signature carrier is empty: %s", itemJSON)
+					}
+					signatureCount++
+				}
+			}
+			if callCount != 2 || signatureCount != 2 || gjson.GetBytes(response, "usage.output_tokens").Int() != 5 {
+				t.Fatalf("signed tool outputs or reasoning usage lost: %s", response)
+			}
+
+			// Replay all returned items, including opaque reasoning carriers, as a
+			// Responses client does. Results arrive in reverse call order to prove
+			// that two calls to the same tool retain their own ID and signature.
+			replay = append(replay,
+				json.RawMessage(`{"type":"function_call_output","call_id":"native-weather-2","output":"Beijing: cloudy"}`),
+				json.RawMessage(`{"type":"function_call_output","call_id":"native-weather-1","output":"Shanghai: sunny"}`),
+			)
+			followUp, err := json.Marshal(map[string]any{
+				"model": gatewayGeminiModel, "input": replay,
+				"tools": json.RawMessage(gjson.GetBytes(original, "tools").Raw),
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			client.wire = `{"response":{"candidates":[{"content":{"role":"model","parts":[{"text":"Shanghai is sunny; Beijing is cloudy."}]},"finishReason":"STOP"}],"modelVersion":"gemini-3.1-pro-preview","responseId":"resp_signed_result"}}`
+			if stream {
+				client.wire = "data: " + client.wire + "\n\n"
+			}
+			gatewaySignedFunctionResponse(t, client, followUp, stream)
+			if len(client.requests) != 2 {
+				t.Fatalf("upstream requests = %d, want 2", len(client.requests))
+			}
+			calls, results := map[string]gjson.Result{}, map[string]gjson.Result{}
+			for _, content := range gjson.GetBytes(client.requests[1].Body, "request.contents").Array() {
+				for _, part := range content.Get("parts").Array() {
+					if call := part.Get("functionCall"); call.Exists() {
+						calls[call.Get("id").String()] = part
+					}
+					if result := part.Get("functionResponse"); result.Exists() {
+						results[result.Get("id").String()] = part
+					}
+				}
+			}
+			if len(calls) != 2 || len(results) != 2 {
+				t.Fatalf("parallel call/result pairing lost: %s", client.requests[1].Body)
+			}
+			for _, want := range []struct{ id, city, result string }{
+				{"native-weather-1", "Shanghai", "Shanghai: sunny"},
+				{"native-weather-2", "Beijing", "Beijing: cloudy"},
+			} {
+				call, result := calls[want.id], results[want.id]
+				if call.Get("thoughtSignature").String() != signatures[want.id] ||
+					call.Get("functionCall.name").String() != "weather" || call.Get("functionCall.args.city").String() != want.city ||
+					result.Get("functionResponse.name").String() != "weather" || result.Get("functionResponse.response.result").String() != want.result ||
+					result.Get("thoughtSignature").Exists() {
+					t.Fatalf("signed call/result changed: call=%s result=%s", call.Raw, result.Raw)
+				}
+			}
+		})
+	}
+}
+
+func gatewaySignedFunctionResponse(t *testing.T, client *gatewayMockHTTP, original []byte, stream bool) ([]byte, []json.RawMessage) {
+	t.Helper()
+	req := gatewayRequest(t, client, original, stream, false)
+	if !stream {
+		response, err := NewExecutor().Execute(context.Background(), req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		result := builtin.Registry().TranslateNonStream(context.Background(), sdktranslator.FormatGemini, sdktranslator.FormatOpenAIResponse, gatewayGeminiModel, original, req.Payload, response.Payload, nil)
+		var replay []json.RawMessage
+		if err := json.Unmarshal([]byte(gjson.GetBytes(result, "output").Raw), &replay); err != nil {
+			t.Fatalf("decode full Responses output: %v: %s", err, result)
+		}
+		return result, replay
+	}
+	response, err := NewExecutor().ExecuteStream(context.Background(), req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var state any
+	var result []byte
+	var replay []json.RawMessage
+	for chunk := range response.Chunks {
+		if chunk.Err != nil {
+			t.Fatal(chunk.Err)
+		}
+		for _, event := range builtin.Registry().TranslateStream(context.Background(), sdktranslator.FormatGemini, sdktranslator.FormatOpenAIResponse, gatewayGeminiModel, original, req.Payload, chunk.Payload, &state) {
+			_, data, ok := bytes.Cut(event, []byte("data: "))
+			if !ok {
+				t.Fatalf("invalid Responses SSE event: %s", event)
+			}
+			payload := gjson.ParseBytes(bytes.TrimSpace(data))
+			switch payload.Get("type").String() {
+			case "response.output_item.done":
+				replay = append(replay, json.RawMessage(payload.Get("item").Raw))
+			case "response.completed":
+				if len(result) > 0 {
+					t.Fatal("duplicate Responses completion")
+				}
+				result = []byte(payload.Get("response").Raw)
+			}
+		}
+	}
+	if len(result) == 0 || len(replay) == 0 || len(gjson.GetBytes(result, "output").Array()) != len(replay) {
+		t.Fatalf("streamed output/completion mismatch: result=%s items=%v", result, replay)
+	}
+	return result, replay
+}
