+type probeCaptureExecutor struct {
+	quotaCaptureExecutor
+	calls    int
+	selected []string
+	body     []byte
+	opts     coreexecutor.Options
+	fail     bool
+}
+
+func (e *probeCaptureExecutor) Execute(_ context.Context, account *auth.Auth, req coreexecutor.Request, opts coreexecutor.Options) (coreexecutor.Response, error) {
+	e.calls++
+	e.selected = append(e.selected, account.ID)
+	e.body = append([]byte(nil), req.Payload...)
+	e.opts = opts
+	if e.fail {
+		return coreexecutor.Response{}, &auth.Error{HTTPStatus: http.StatusBadGateway, Message: "upstream echoed fixed question"}
+	}
+	return coreexecutor.Response{Payload: []byte(`{"status":"completed","usage":{"output_tokens":1},"output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"answer"}]}]}`)}, nil
+}
+
+func probeRequest(t *testing.T, server *Server, method, path, body string) *httptest.ResponseRecorder {
+	t.Helper()
+	request := httptest.NewRequest(method, path, strings.NewReader(body))
+	request.Header.Set("Authorization", "Bearer test-key")
+	request.Header.Set("Content-Type", "application/json")
+	recorder := httptest.NewRecorder()
+	server.engine.ServeHTTP(recorder, request)
+	return recorder
+}
+
+func newProbeTestServer(t *testing.T, fail bool) (*Server, *auth.Auth, *probeCaptureExecutor) {
+	t.Helper()
