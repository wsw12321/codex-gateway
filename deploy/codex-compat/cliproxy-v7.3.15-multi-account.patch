+func gatewayResult(candidate *Auth, err *Error) Result {
+	return Result{AuthID: candidate.ID, GatewayAccountIndex: gatewayAccountResultIndex(candidate), GatewayAccountVersion: candidate.GatewayAccountVersion,
+		Provider: "codex", Model: "gateway-model", Success: err == nil, Error: err}
+}
