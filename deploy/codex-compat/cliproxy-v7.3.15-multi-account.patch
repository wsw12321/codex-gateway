@@ -0,0 +1,29 @@
+package watcher
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/fsnotify/fsnotify"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+)
+
+func TestHandleEventIgnoresGatewayAccountState(t *testing.T) {
+	dir := t.TempDir()
+	w := &Watcher{authDir: dir, configPath: filepath.Join(dir, "config.yaml"), lastAuthHashes: make(map[string]string)}
+	w.SetConfig(&config.Config{AuthDir: dir})
+	for _, name := range []string{coreauth.GatewayAccountStateFile, coreauth.GatewayAccountStateFile + ".tmp.json"} {
+		path := filepath.Join(dir, name)
+		if err := os.WriteFile(path, []byte(`{"type":"codex","access_token":"token","account_id":"account"}`), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		for _, op := range []fsnotify.Op{fsnotify.Create, fsnotify.Write, fsnotify.Remove, fsnotify.Rename} {
+			w.handleEvent(fsnotify.Event{Name: path, Op: op})
+		}
+	}
+	if len(w.lastAuthHashes) != 0 || len(w.currentAuths) != 0 {
+		t.Fatal("state events changed OAuth watcher state")
+	}
+}
