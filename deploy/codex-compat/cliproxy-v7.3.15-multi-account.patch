+func credentialSwitchEligible(provider string, err error, ctx context.Context) bool {
+	if isCodexProvider(provider) {
+		return gatewayRetryEligible(err, ctx)
+	}
+	return !isRequestInvalidError(err)
+}
+
+func isCodexProvider(provider string) bool {
+	return strings.EqualFold(strings.TrimSpace(provider), "codex")
+}
+
+func homeWebsocketTransportFallbackEligible(ctx context.Context, selection *HomeDispatchSelection, err error) bool {
+	return selection != nil && cliproxyexecutor.DownstreamWebsocket(ctx) && statusCodeFromError(err) == http.StatusUpgradeRequired
+}
+
+func (m *Manager) recordCredentialFailure(ctx context.Context, result Result, auth *Auth, provider string, err error, ephemeral bool) bool {
+	eligible := credentialSwitchEligible(provider, err, ctx)
+	if ephemeral {
+		m.reportHomeResult(ctx, result, auth)
+	} else if isCodexProvider(provider) && !eligible {
+		m.recordAvailabilityNeutralResult(ctx, result)
+	} else {
+		m.MarkResult(ctx, result)
+	}
+	return eligible
+}
