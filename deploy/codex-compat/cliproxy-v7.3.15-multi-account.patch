+func TestApplyCodexOAuthAccountIdentitySupportsLegacyClaimAndRejectsConflict(t *testing.T) {
+	for _, test := range []struct {
+		name         string
+		metadata     map[string]any
+		wantAccount  bool
+		wantDisabled bool
+	}{
+		{
+			name:        "top level only",
+			metadata:    map[string]any{"access_token": "token", "account_id": "account-a"},
+			wantAccount: true,
+		},
+		{
+			name:        "legacy claim only",
+			metadata:    map[string]any{"access_token": "token", "id_token": codexAccountJWT(t, "account-a")},
+			wantAccount: true,
+		},
+		{
+			name:        "matching top level and claim",
+			metadata:    map[string]any{"access_token": "token", "account_id": "account-a", "id_token": codexAccountJWT(t, "account-a")},
+			wantAccount: true,
+		},
+		{
+			name:         "conflicting top level and claim",
+			metadata:     map[string]any{"access_token": "token", "account_id": "account-a", "id_token": codexAccountJWT(t, "account-b")},
+			wantDisabled: true,
+		},
+		{
+			name:         "unsafe top level",
+			metadata:     map[string]any{"access_token": "token", "account_id": "account/a", "id_token": codexAccountJWT(t, "account-a")},
+			wantDisabled: true,
+		},
+		{
+			name:         "malformed ID token",
+			metadata:     map[string]any{"access_token": "token", "id_token": "not-a-jwt"},
+			wantDisabled: true,
+		},
+		{
+			name:     "missing identity stays unattributed",
+			metadata: map[string]any{"access_token": "token"},
+		},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			candidate := &Auth{
+				ID:         "codex.json",
+				Provider:   "codex",
+				Status:     StatusActive,
+				Metadata:   test.metadata,
+				Attributes: map[string]string{AttributeSourceBackend: AuthSourceFile},
+			}
+			gotAccount := ApplyCodexOAuthAccountIdentity(candidate, test.metadata)
+			if gotAccount != test.wantAccount {
+				t.Fatalf("ApplyCodexOAuthAccountIdentity() = %t, want %t", gotAccount, test.wantAccount)
+			}
+			if candidate.Disabled != test.wantDisabled || (test.wantDisabled && candidate.Status != StatusDisabled) {
+				t.Fatalf("disabled/status = %t/%q, want disabled=%t", candidate.Disabled, candidate.Status, test.wantDisabled)
+			}
+			index, attributable := CodexOAuthAccountIndex(candidate)
+			if attributable != test.wantAccount || (test.wantAccount && index == "") {
+				t.Fatalf("CodexOAuthAccountIndex() = %q, %t, want attributable=%t", index, attributable, test.wantAccount)
+			}
+		})
+	}
+}
