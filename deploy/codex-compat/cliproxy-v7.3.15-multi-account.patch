+func TestExtractSessionInfoParentRelationHeaders(t *testing.T) {
+	for _, header := range []string{
+		"X-Parent-Session-Id", "X-Parent-Session_id", "X-Parent-Session",
+		"X-Parent-Thread-Id", "X-Parent-Thread_id", "X-Parent-Task-Id", "X-Parent-Task_id",
+		"X-Parent-Id", "X-Parent-Conversation-Id", "X-Parent-Session-Affinity",
+		"X-Parent-Slot-Session-Id", "X-Parent-Side-Session-Id", "X-Parent-Side-Thread-Id",
+		"X-Claude-Code-Parent-Session-Id", "X-Claude-Parent-Session-Id",
+	} {
+		t.Run(header, func(t *testing.T) {
+			headers := http.Header{"Session-Id": {"child"}, header: {"root"}}
+			info, ok := ExtractSessionInfo(headers, nil, nil)
+			if !ok || info.SessionID != "codex:child" || info.ParentSessionID != "codex:root" {
+				t.Fatalf("header hierarchy: %#v, found=%t", info, ok)
+			}
+			info, ok = ExtractSessionInfo(headers, []byte(`{"parent_session_id":"body-root"}`), nil)
+			if !ok || info.ParentSessionID != "codex:body-root" {
+				t.Fatalf("body parent precedence: %#v, found=%t", info, ok)
+			}
+		})
+	}
+}
+
+func TestExtractSideConversationKeepsClientNamespace(t *testing.T) {
+	for _, test := range []struct {
+		name, session, parent string
+		headers               http.Header
+		body                  string
+	}{
+		{name: "codex session", headers: http.Header{"Session-Id": {"root"}, "X-Side-Session-Id": {"side"}}, session: "codex:side", parent: "codex:root"},
+		{name: "codex thread alias", headers: http.Header{"Thread_id": {"root"}, "X-Side-Thread-Id": {"side"}}, session: "codex:side", parent: "codex:root"},
+		{name: "explicit side parent", headers: http.Header{"Session-Id": {"root"}, "X-Side-Session-Id": {"nested"}, "X-Parent-Side-Session-Id": {"side"}}, session: "codex:nested", parent: "codex:side"},
+		{name: "codex parent without main session", headers: http.Header{"X-Side-Session-Id": {"side"}, "X-Codex-Parent-Thread-Id": {"root"}}, session: "codex:side", parent: "codex:root"},
+		{name: "claude", headers: http.Header{"X-Claude-Code-Session-Id": {"root"}, "X-Claude-Code-Side-Session-Id": {"side"}}, session: "claude:side", parent: "claude:root"},
+		{name: "generic", headers: http.Header{"X-Session-Id": {"root"}, "X-Side-Session-Id": {"side"}}, session: "header:side", parent: "header:root"},
+		{name: "slot", headers: http.Header{"X-Slot-Session-Id": {"root"}, "X-Side-Session-Id": {"side"}}, session: "slot:side", parent: "slot:root"},
+		{name: "body", body: `{"session_id":"root","side_session_id":"side"}`, session: "session:side", parent: "session:root"},
+		{name: "nested body", body: `{"request":{"session_id":"root","metadata":{"side_session_id":"side"}}}`, session: "session:side", parent: "session:root"},
+		{name: "without parent", headers: http.Header{"X-Side-Session-Id": {"side"}}, session: "session:side"},
+		{name: "self parent", headers: http.Header{"Session-Id": {"side"}, "X-Side-Session-Id": {"side"}}, session: "codex:side"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			info, ok := ExtractSessionInfo(test.headers, []byte(test.body), nil)
+			if !ok || info.SessionID != test.session || info.ParentSessionID != test.parent {
+				t.Fatalf("side hierarchy: %#v, found=%t", info, ok)
+			}
+			_, options := Enrich(cliproxyexecutor.Request{Payload: []byte(test.body)}, cliproxyexecutor.Options{Headers: test.headers})
+			if got := options.Metadata[cliproxyexecutor.CanonicalSessionIDMetadataKey]; got != test.session {
+				t.Fatalf("side execution canonical=%v want=%s", got, test.session)
+			}
+		})
+	}
+}
+
+func TestInvalidParentHeaderDoesNotCreateRelationship(t *testing.T) {
+	for _, parent := range []string{"bad\r\nparent", "bad\x00parent", "\tparent"} {
+		info, ok := ExtractSessionInfo(http.Header{"Session-Id": {"leaf"}, "X-Parent-Session-Id": {parent}}, nil, nil)
+		if !ok || info.SessionID != "codex:leaf" || info.ParentSessionID != "" {
+			t.Fatalf("invalid parent was retained: %#v, found=%t", info, ok)
+		}
+	}
+}
