+func (e *codexOAuthTokenError) Error() string {
+	if e == nil {
+		return ""
+	}
+	operation := strings.TrimSpace(e.operation)
+	if operation == "" {
+		operation = "token request"
+	}
+	if e.code != "" {
+		return fmt.Sprintf("Codex OAuth %s failed: %s", operation, e.code)
+	}
+	return fmt.Sprintf("Codex OAuth %s failed with status %d", operation, e.upstreamStatus)
