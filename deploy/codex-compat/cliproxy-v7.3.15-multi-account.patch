+		{name: "fork body", body: []byte(`{"sessionId":"same-child","forkSource":{"sessionId":"same-parent"}}`)},
+		{name: "long composite", headers: http.Header{"X-Claude-Code-Session-Id": {strings.Repeat("s", 200)}, "X-Claude-Code-Agent-Id": {strings.Repeat("a", 100)}}},
+		{name: "prompt cache", body: []byte(`{"prompt_cache_key":"same-session"}`)},
