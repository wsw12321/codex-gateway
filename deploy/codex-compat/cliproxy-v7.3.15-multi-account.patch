+func TestInternalUpstreamAccountStatus(t *testing.T) {
+	s := newTestServer(t)
+	dir := t.TempDir()
+	if err := s.handlers.AuthManager.LoadGatewayAccountState(dir); err != nil {
+		t.Fatal(err)
+	}
+	a := registerQuotaTestAccount(t, s, &quotaCaptureExecutor{})
+	id := stableCodexAccountID(a)
+	for _, enabled := range []bool{false, true, false} {
+		body := `{"enabled":false}`
+		want := "unavailable"
+		if enabled {
+			body = `{"enabled":true}`
+			want = "available"
+		}
+		r := httptest.NewRequest(http.MethodPut, "/internal/upstream-accounts/"+id+"/status", strings.NewReader(body))
+		r.Header.Set("Authorization", "Bearer test-key")
+		w := httptest.NewRecorder()
+		s.engine.ServeHTTP(w, r)
+		if w.Code != 200 || w.Header().Get("Cache-Control") != "no-store" {
+			t.Fatalf("status=%d body=%s", w.Code, w.Body)
+		}
+		var got struct{ ID, Status string }
+		if err := json.Unmarshal(w.Body.Bytes(), &got); err != nil {
+			t.Fatal(err)
+		}
+		if got.ID != id || got.Status != want {
+			t.Fatalf("response=%+v", got)
+		}
+		listed := findCodexOAuthAccount(s.handlers.AuthManager.List(), id)
+		if auth.GatewayAccountAvailable(listed) != enabled {
+			t.Fatalf("confirmed status disagrees with manager")
+		}
+		if !enabled && upstreamAccountStatus(listed) != "unavailable" {
+			t.Fatal("list missed durable block")
+		}
+	}
+	stat, err := os.Stat(filepath.Join(dir, ".gateway-account-state"))
+	if err != nil || stat.Mode().Perm() != 0600 {
+		t.Fatalf("state permissions: %v %v", stat, err)
+	}
+}
