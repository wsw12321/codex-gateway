diff --git a/sdk/cliproxy/auth/gateway_allocation_selector.go b/sdk/cliproxy/auth/gateway_allocation_selector.go
new file mode 100644
index 0000000..0bfdbcf
--- /dev/null
+++ b/sdk/cliproxy/auth/gateway_allocation_selector.go
@@ -0,0 +1,372 @@
+package auth
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"os"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/google/uuid"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	cliproxysession "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/session"
+)
+
+const gatewayAllocationURL = "http://gateway:8080/internal/upstream-accounts/select"
+const gatewayEligibilityURL = "http://gateway:8080/internal/upstream-accounts/eligible"
+
+var errGatewayAllocationRequired = errors.New("gateway allocation required")
+
+// GatewayAllocationSelector keeps the existing affinity implementation, while
+// every cold selection (including a single candidate) is decided by Gateway.
+// Its lock protects only in-memory lookup and binding, never the HTTP callback.
+type GatewayAllocationSelector struct {
+	mu       sync.Mutex
+	limitMu  sync.RWMutex
+	affinity *SessionAffinitySelector
+	probe    *gatewayAllocationProbe
+	client   *http.Client
+	key      string
+	limits   map[string]int64
+}
+
+type gatewayAllocationProbe struct {
+	candidates []*Auth
+	selected   string
+}
+
+func (p *gatewayAllocationProbe) Pick(_ context.Context, _, _ string, _ cliproxyexecutor.Options, candidates []*Auth) (*Auth, error) {
+	p.candidates = candidates
+	if p.selected == "" {
+		return nil, errGatewayAllocationRequired
+	}
+	for _, candidate := range candidates {
+		if index := gatewayAccountResultIndex(candidate); index != "" && index == p.selected {
+			return candidate, nil
+		}
+	}
+	return nil, gatewayAllocationUnavailable()
+}
+
+func NewGatewayAllocationSelector(ttl time.Duration, subagents bool) *GatewayAllocationSelector {
+	keyFile := os.Getenv("CLIPROXY_API_KEY_FILE")
+	if keyFile == "" {
+		keyFile = "/run/secrets/sidecar_api_key"
+	}
+	key, _ := os.ReadFile(keyFile)
+	p := &gatewayAllocationProbe{}
+	return &GatewayAllocationSelector{
+		probe:  p,
+		limits: make(map[string]int64),
+		affinity: NewSessionAffinitySelectorWithConfig(SessionAffinityConfig{
+			Fallback: p, TTL: ttl, SubagentAffinity: &subagents,
+		}),
+		key: strings.TrimSpace(string(key)),
+		client: &http.Client{
+			Timeout: 2 * time.Second,
+			Transport: &http.Transport{
+				Proxy:        nil,
+				MaxIdleConns: 16, MaxIdleConnsPerHost: 16,
+				IdleConnTimeout:       30 * time.Second,
+				ResponseHeaderTimeout: 2 * time.Second,
+			},
+			CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse },
+		},
+	}
+}
+
+func gatewayAllocationUnavailable() error {
+	return wrapRequestStopError(&Error{Code: "gateway_allocation_unavailable", Message: "upstream account allocation unavailable", HTTPStatus: http.StatusServiceUnavailable})
+}
+
+func (s *GatewayAllocationSelector) Pick(ctx context.Context, provider, model string, opts cliproxyexecutor.Options, auths []*Auth) (*Auth, error) {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	userID, _ := opts.Metadata[cliproxyexecutor.GatewayUserIDMetadataKey].(string)
+	parsed, parseErr := uuid.Parse(userID)
+	if parseErr != nil || parsed.String() != userID {
+		return nil, gatewayAllocationUnavailable()
+	}
+	var err error
+	auths, err = s.eligibleAccounts(ctx, userID, auths)
+	if err != nil {
+		return nil, err
+	}
+	s.mu.Lock()
+	s.clearUnauthorizedBinding(provider, model, opts, auths)
+	if len(auths) == 0 {
+		s.mu.Unlock()
+		return nil, gatewayAllocationUnavailable()
+	}
+	s.probe.selected = ""
+	auth, err := s.affinity.Pick(ctx, provider, model, opts, auths)
+	candidates := append([]*Auth(nil), s.probe.candidates...)
+	s.mu.Unlock()
+	if !errors.Is(err, errGatewayAllocationRequired) {
+		return auth, err
+	}
+	selected, err := s.selectAccount(ctx, userID, candidates)
+	if err != nil {
+		return nil, err
+	}
+	// The manager refreshes model/control/cooldown state after the network call.
+	// It acquires its own lock before our binding lock, avoiding lock inversion.
+	if refresh, ok := ctx.Value(gatewayAllocationRefreshKey{}).(func() ([]*Auth, error)); ok {
+		auths, err = refresh()
+		if err != nil {
+			return nil, gatewayAllocationUnavailable()
+		}
+	}
+	auths, err = s.eligibleAccounts(ctx, userID, auths)
+	if err != nil {
+		return nil, err
+	}
+	if ctx.Err() != nil {
+		return nil, gatewayAllocationUnavailable()
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.clearUnauthorizedBinding(provider, model, opts, auths)
+	if len(auths) == 0 {
+		return nil, gatewayAllocationUnavailable()
+	}
+	s.probe.selected = selected
+	defer func() { s.probe.selected = "" }()
+	// Re-run affinity atomically with binding: another first request may have
+	// established a valid explicit, alias, derived, or LCP binding meanwhile.
+	auth, err = s.affinity.Pick(ctx, provider, model, opts, auths)
+	if err != nil {
+		return nil, gatewayAllocationUnavailable()
+	}
+	return auth, nil
+}
+
+func (s *GatewayAllocationSelector) selectAccount(ctx context.Context, userID string, candidates []*Auth) (string, error) {
+	if s.key == "" || len(candidates) == 0 || len(candidates) > 256 {
+		return "", gatewayAllocationUnavailable()
+	}
+	ids := make([]string, 0, len(candidates))
+	seen := make(map[string]bool, len(candidates))
+	for _, candidate := range candidates {
+		index := gatewayAccountResultIndex(candidate)
+		if index == "" {
+			return "", gatewayAllocationUnavailable()
+		}
+		if !seen[index] {
+			ids = append(ids, index)
+			seen[index] = true
+		}
+	}
+	sort.Strings(ids)
+	body, _ := json.Marshal(struct {
+		AccountIDs []string `json:"account_ids"`
+		UserID     string   `json:"user_id"`
+	}{ids, userID})
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, gatewayAllocationURL, bytes.NewReader(body))
+	if err != nil {
+		return "", gatewayAllocationUnavailable()
+	}
+	req.Header.Set("Authorization", "Bearer "+s.key)
+	req.Header.Set("Content-Type", "application/json")
+	response, err := s.client.Do(req)
+	if err != nil {
+		return "", gatewayAllocationUnavailable()
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusOK {
+		if response.StatusCode == http.StatusTooManyRequests {
+			return "", gatewayConcurrencyExceeded()
+		}
+		return "", gatewayAllocationUnavailable()
+	}
+	data, err := io.ReadAll(io.LimitReader(response.Body, 1025))
+	if err != nil || len(data) > 1024 {
+		return "", gatewayAllocationUnavailable()
+	}
+	fields, err := decodeGatewayObject(data, "account_id")
+	var selected string
+	if err != nil || json.Unmarshal(fields["account_id"], &selected) != nil || !seen[selected] {
+		return "", gatewayAllocationUnavailable()
+	}
+	return selected, nil
+}
+
+// The callback is intentionally outside all selector/manager locks and runs
+// before every affinity lookup, including retries and already-bound sessions.
+func (s *GatewayAllocationSelector) eligibleAccounts(ctx context.Context, userID string, candidates []*Auth) ([]*Auth, error) {
+	if s.key == "" || len(candidates) == 0 || len(candidates) > 256 {
+		return nil, gatewayAllocationUnavailable()
+	}
+	ids := make([]string, 0, len(candidates))
+	seen := make(map[string]bool, len(candidates))
+	for _, candidate := range candidates {
+		id := gatewayAccountResultIndex(candidate)
+		if id == "" {
+			return nil, gatewayAllocationUnavailable()
+		}
+		if !seen[id] {
+			ids = append(ids, id)
+			seen[id] = true
+		}
+	}
+	sort.Strings(ids)
+	body, _ := json.Marshal(struct {
+		AccountIDs []string `json:"account_ids"`
+		UserID     string   `json:"user_id"`
+	}{ids, userID})
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, gatewayEligibilityURL, bytes.NewReader(body))
+	if err != nil {
+		return nil, gatewayAllocationUnavailable()
+	}
+	req.Header.Set("Authorization", "Bearer "+s.key)
+	req.Header.Set("Content-Type", "application/json")
+	response, err := s.client.Do(req)
+	if err != nil {
+		return nil, gatewayAllocationUnavailable()
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusOK {
+		return nil, gatewayAllocationUnavailable()
+	}
+	data, err := io.ReadAll(io.LimitReader(response.Body, 8193))
+	if err != nil || len(data) > 8192 {
+		return nil, gatewayAllocationUnavailable()
+	}
+	fields, err := decodeGatewayObject(data, "accounts")
+	var allowed []struct {
+		ID              string `json:"id"`
+		ConcurrentLimit int64  `json:"concurrent_limit"`
+	}
+	if err != nil || json.Unmarshal(fields["accounts"], &allowed) != nil {
+		return nil, gatewayAllocationUnavailable()
+	}
+	permitted := make(map[string]bool, len(allowed))
+	s.limitMu.Lock()
+	for _, item := range allowed {
+		if !seen[item.ID] || permitted[item.ID] || item.ConcurrentLimit < 1 || item.ConcurrentLimit > 1<<31-1 {
+			s.limitMu.Unlock()
+			return nil, gatewayAllocationUnavailable()
+		}
+		permitted[item.ID] = true
+		s.limits[item.ID] = item.ConcurrentLimit
+	}
+	s.limitMu.Unlock()
+	result := make([]*Auth, 0, len(allowed))
+	for _, candidate := range candidates {
+		if permitted[gatewayAccountResultIndex(candidate)] {
+			result = append(result, candidate)
+		}
+	}
+	return result, nil
+}
+
+// Remove only this request's aliases / LCP sequence; other users and sessions
+// bound to the same account must keep their bindings.
+func (s *GatewayAllocationSelector) clearUnauthorizedBinding(provider, model string, opts cliproxyexecutor.Options, allowed []*Auth) {
+	permitted := make(map[string]bool, len(allowed))
+	for _, a := range allowed {
+		permitted[a.ID] = true
+	}
+	primary, fallback := extractExplicitSessionIDs(opts.Headers, opts.OriginalRequest, opts.Metadata)
+	if primary == "" {
+		namespace := lcpAffinityNamespace(provider, model, opts.Metadata)
+		turns := cliproxysession.ExtractCanonicalTurns(opts.SourceFormat, opts.OriginalRequest)
+		fingerprints, minPrefix := s.affinity.matcher.Prepare(turns)
+		if namespace != "" && len(fingerprints) > 0 && minPrefix > 0 {
+			if match, ok := s.affinity.matcher.MatchFingerprints(namespace, fingerprints, minPrefix); ok && !permitted[match.AuthID] {
+				s.affinity.matcher.RemoveFingerprints(namespace, fingerprints, match.AuthID)
+			}
+		}
+		primary, fallback = extractSessionIDs(opts.Headers, opts.OriginalRequest, opts.Metadata)
+	}
+	remove := func(id string) {
+		if id == "" {
+			return
+		}
+		id = cliproxysession.BoundSessionIdentity(id)
+		key := provider + "::" + id + "::" + canonicalModelKey(model)
+		if account, ok := s.affinity.cache.Get(key); ok && !permitted[account] {
+			s.affinity.cache.CompareAndDelete(key, account)
+		}
+	}
+	remove(primary)
+	if fallback != primary && !isSubagentSession(primary, fallback) {
+		remove(fallback)
+	}
+}
+
+func (s *GatewayAllocationSelector) concurrencyLimit(id string) int64 {
+	s.limitMu.RLock()
+	defer s.limitMu.RUnlock()
+	if limit, ok := s.limits[id]; ok && limit > 0 {
+		return limit
+	}
+	// A Gateway-selected account is fail-closed until its eligibility response
+	// supplies an owner-configured value. The database default is one.
+	return 1
+}
+
+func (s *GatewayAllocationSelector) Stop() {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.affinity.Stop()
+	s.client.CloseIdleConnections()
+}
+
+func (s *GatewayAllocationSelector) OnResult(result Result) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.affinity.OnResult(result)
+}
+
+func (s *GatewayAllocationSelector) InvalidateAuth(id string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.affinity.InvalidateAuth(id)
+}
+
+type gatewayAllocationRefreshKey struct{}
+
+func (m *Manager) withGatewayAllocationRefresh(ctx context.Context, selector Selector, candidates []*Auth, provider, model string) context.Context {
+	if _, ok := selector.(*GatewayAllocationSelector); !ok {
+		return ctx
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	return context.WithValue(ctx, gatewayAllocationRefreshKey{}, func() ([]*Auth, error) {
+		return m.gatewayAllocationSnapshot(selector, candidates, provider, model)
+	})
+}
+
+func (m *Manager) gatewayAllocationSnapshot(selector Selector, candidates []*Auth, provider, model string) ([]*Auth, error) {
+	m.mu.RLock()
+	defer m.mu.RUnlock()
+	current := make([]*Auth, 0, len(candidates))
+	for _, candidate := range candidates {
+		fresh := m.auths[candidate.ID]
+		if fresh == nil || !GatewayAccountAvailable(fresh) || executorKeyFromAuth(fresh) != executorKeyFromAuth(candidate) {
+			continue
+		}
+		index := gatewayAccountResultIndex(candidate)
+		freshIndex := gatewayAccountResultIndex(fresh)
+		if index == "" || freshIndex == "" || index != freshIndex {
+			continue
+		}
+		if strings.TrimSpace(model) != "" && !m.authSupportsRouteModel(registry.GetGlobalRegistry(), fresh, model) {
+			continue
+		}
+		current = append(current, fresh)
+	}
+	_, snapshot, err := m.availableAuthsForSelector(selector, current, provider, model, time.Now())
+	return snapshot, err
+}
