+func TestGatewayAccountCorruptAmbiguousStateRejected(t *testing.T) {
+	const state = `{"enabled":false,"manual_disabled":true,"quota_exhausted":false,"version":1,"updated_at":"2026-08-20T00:00:00Z"}`
+	const index = "0123456789abcdef"
+	valid := `{"version":1,"accounts":{"` + index + `":` + state + `}}`
+	var doc map[string]any
+	if err := json.Unmarshal([]byte(valid), &doc); err != nil {
+		t.Fatal(err)
+	}
+	for _, data := range []string{
+		`{"version":1,"version":1,"accounts":{}}`,
+		`{"Version":1,"accounts":{}}`,
+		`{"version":1,"accounts":{"` + index + `":` + state + `,"` + index + `":` + state + `}}`,
+		`{"version":1,"accounts":{"` + index + `":{"enabled":false,"enabled":true,"manual_disabled":false,"quota_exhausted":false,"version":1,"updated_at":"2026-08-20T00:00:00Z"}}}`,
+		`{"version":1,"accounts":{"` + index + `":{"Enabled":false,"manual_disabled":true,"quota_exhausted":false,"version":1,"updated_at":"2026-08-20T00:00:00Z"}}}`,
+		`{"version":1,"accounts":{"` + index + `":{"enabled":null,"manual_disabled":true,"quota_exhausted":false,"version":1,"updated_at":"2026-08-20T00:00:00Z"}}}`,
+		`{"version":1,"accounts":{"` + index + `":{"enabled":false,"manual_disabled":true,"version":1,"updated_at":"2026-08-20T00:00:00Z"}}}`,
+	} {
+		if _, err := decodeGatewayAccountState([]byte(data)); !errors.Is(err, ErrGatewayAccountStateUnavailable) {
+			t.Fatalf("ambiguous state accepted: %s, %v", data, err)
+		}
+	}
+	if _, err := decodeGatewayAccountState([]byte(valid)); err != nil {
+		t.Fatalf("valid state rejected: %v", err)
+	}
+}
+
+func TestGatewayAccountEnablePreservesIdentityValidation(t *testing.T) {
+	m, candidate, _ := newGatewayAccountTestManager(t)
+	if _, err := m.SetGatewayAccountEnabled(candidate.Index, false); err != nil {
+		t.Fatal(err)
+	}
+	m.mu.Lock()
+	m.auths[candidate.ID].Metadata["account_id"] = "different-account"
+	m.mu.Unlock()
+	if _, err := m.SetGatewayAccountEnabled(candidate.Index, true); !errors.Is(err, ErrGatewayAccountIdentityInvalid) {
+		t.Fatalf("inconsistent identity enabled: %v", err)
+	}
+	current, _ := m.GetByID(candidate.ID)
+	if GatewayAccountAvailable(current) {
+		t.Fatal("identity failure cleared lock")
+	}
+}
diff --git a/sdk/cliproxy/auth/gateway_allocation_selector.go b/sdk/cliproxy/auth/gateway_allocation_selector.go
new file mode 100644
index 0000000000000000000000000000000000000000..df73ee7bece02a335b834f2567bd32a32b023f8e
--- /dev/null
+++ b/sdk/cliproxy/auth/gateway_allocation_selector.go
@@ -0,0 +1,348 @@
+package auth
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"os"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/google/uuid"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	cliproxysession "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/session"
+)
+
+const gatewayAllocationURL = "http://gateway:8080/internal/upstream-accounts/select"
+const gatewayEligibilityURL = "http://gateway:8080/internal/upstream-accounts/eligible"
+
+var errGatewayAllocationRequired = errors.New("gateway allocation required")
+
+// GatewayAllocationSelector keeps the existing affinity implementation, while
+// every cold selection (including a single candidate) is decided by Gateway.
+// Its lock protects only in-memory lookup and binding, never the HTTP callback.
+type GatewayAllocationSelector struct {
+	mu       sync.Mutex
+	affinity *SessionAffinitySelector
+	probe    *gatewayAllocationProbe
+	client   *http.Client
+	key      string
+}
+
+type gatewayAllocationProbe struct {
+	candidates []*Auth
+	selected   string
+}
+
+func (p *gatewayAllocationProbe) Pick(_ context.Context, _, _ string, _ cliproxyexecutor.Options, candidates []*Auth) (*Auth, error) {
+	p.candidates = candidates
+	if p.selected == "" {
+		return nil, errGatewayAllocationRequired
+	}
+	for _, candidate := range candidates {
+		if index := gatewayAccountResultIndex(candidate); index != "" && index == p.selected {
+			return candidate, nil
+		}
+	}
+	return nil, gatewayAllocationUnavailable()
+}
+
+func NewGatewayAllocationSelector(ttl time.Duration, subagents bool) *GatewayAllocationSelector {
+	keyFile := os.Getenv("CLIPROXY_API_KEY_FILE")
+	if keyFile == "" {
+		keyFile = "/run/secrets/sidecar_api_key"
+	}
+	key, _ := os.ReadFile(keyFile)
+	p := &gatewayAllocationProbe{}
+	return &GatewayAllocationSelector{
+		probe: p,
+		affinity: NewSessionAffinitySelectorWithConfig(SessionAffinityConfig{
+			Fallback: p, TTL: ttl, SubagentAffinity: &subagents,
+		}),
+		key: strings.TrimSpace(string(key)),
+		client: &http.Client{
+			Timeout: 2 * time.Second,
+			Transport: &http.Transport{
+				Proxy:        nil,
+				MaxIdleConns: 16, MaxIdleConnsPerHost: 16,
+				IdleConnTimeout:       30 * time.Second,
+				ResponseHeaderTimeout: 2 * time.Second,
+			},
+			CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse },
+		},
+	}
+}
+
+func gatewayAllocationUnavailable() error {
+	return wrapRequestStopError(&Error{Code: "gateway_allocation_unavailable", Message: "upstream account allocation unavailable", HTTPStatus: http.StatusServiceUnavailable})
+}
+
+func (s *GatewayAllocationSelector) Pick(ctx context.Context, provider, model string, opts cliproxyexecutor.Options, auths []*Auth) (*Auth, error) {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	userID, _ := opts.Metadata[cliproxyexecutor.GatewayUserIDMetadataKey].(string)
+	parsed, parseErr := uuid.Parse(userID)
+	if parseErr != nil || parsed.String() != userID {
+		return nil, gatewayAllocationUnavailable()
+	}
+	var err error
+	auths, err = s.eligibleAccounts(ctx, userID, auths)
+	if err != nil {
+		return nil, err
+	}
+	s.mu.Lock()
+	s.clearUnauthorizedBinding(provider, model, opts, auths)
+	if len(auths) == 0 {
+		s.mu.Unlock()
+		return nil, gatewayAllocationUnavailable()
+	}
+	s.probe.selected = ""
+	auth, err := s.affinity.Pick(ctx, provider, model, opts, auths)
+	candidates := append([]*Auth(nil), s.probe.candidates...)
+	s.mu.Unlock()
+	if !errors.Is(err, errGatewayAllocationRequired) {
+		return auth, err
+	}
+	selected, err := s.selectAccount(ctx, userID, candidates)
+	if err != nil {
+		return nil, err
+	}
+	// The manager refreshes model/control/cooldown state after the network call.
+	// It acquires its own lock before our binding lock, avoiding lock inversion.
+	if refresh, ok := ctx.Value(gatewayAllocationRefreshKey{}).(func() ([]*Auth, error)); ok {
+		auths, err = refresh()
+		if err != nil {
+			return nil, gatewayAllocationUnavailable()
+		}
+	}
+	auths, err = s.eligibleAccounts(ctx, userID, auths)
+	if err != nil {
+		return nil, err
+	}
+	if ctx.Err() != nil {
+		return nil, gatewayAllocationUnavailable()
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.clearUnauthorizedBinding(provider, model, opts, auths)
+	if len(auths) == 0 {
+		return nil, gatewayAllocationUnavailable()
+	}
+	s.probe.selected = selected
+	defer func() { s.probe.selected = "" }()
+	// Re-run affinity atomically with binding: another first request may have
+	// established a valid explicit, alias, derived, or LCP binding meanwhile.
+	auth, err = s.affinity.Pick(ctx, provider, model, opts, auths)
+	if err != nil {
+		return nil, gatewayAllocationUnavailable()
+	}
+	return auth, nil
+}
+
+func (s *GatewayAllocationSelector) selectAccount(ctx context.Context, userID string, candidates []*Auth) (string, error) {
+	if s.key == "" || len(candidates) == 0 || len(candidates) > 256 {
+		return "", gatewayAllocationUnavailable()
+	}
+	ids := make([]string, 0, len(candidates))
+	seen := make(map[string]bool, len(candidates))
+	for _, candidate := range candidates {
+		index := gatewayAccountResultIndex(candidate)
+		if index == "" {
+			return "", gatewayAllocationUnavailable()
+		}
+		if !seen[index] {
+			ids = append(ids, index)
+			seen[index] = true
+		}
+	}
+	sort.Strings(ids)
+	body, _ := json.Marshal(struct {
+		AccountIDs []string `json:"account_ids"`
+		UserID     string   `json:"user_id"`
+	}{ids, userID})
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, gatewayAllocationURL, bytes.NewReader(body))
+	if err != nil {
+		return "", gatewayAllocationUnavailable()
+	}
+	req.Header.Set("Authorization", "Bearer "+s.key)
+	req.Header.Set("Content-Type", "application/json")
+	response, err := s.client.Do(req)
+	if err != nil {
+		return "", gatewayAllocationUnavailable()
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusOK {
+		return "", gatewayAllocationUnavailable()
+	}
+	data, err := io.ReadAll(io.LimitReader(response.Body, 1025))
+	if err != nil || len(data) > 1024 {
+		return "", gatewayAllocationUnavailable()
+	}
+	fields, err := decodeGatewayObject(data, "account_id")
+	var selected string
+	if err != nil || json.Unmarshal(fields["account_id"], &selected) != nil || !seen[selected] {
+		return "", gatewayAllocationUnavailable()
+	}
+	return selected, nil
+}
+
+// The callback is intentionally outside all selector/manager locks and runs
+// before every affinity lookup, including retries and already-bound sessions.
+func (s *GatewayAllocationSelector) eligibleAccounts(ctx context.Context, userID string, candidates []*Auth) ([]*Auth, error) {
+	if s.key == "" || len(candidates) == 0 || len(candidates) > 256 {
+		return nil, gatewayAllocationUnavailable()
+	}
+	ids := make([]string, 0, len(candidates))
+	seen := make(map[string]bool, len(candidates))
+	for _, candidate := range candidates {
+		id := gatewayAccountResultIndex(candidate)
+		if id == "" {
+			return nil, gatewayAllocationUnavailable()
+		}
+		if !seen[id] {
+			ids = append(ids, id)
+			seen[id] = true
+		}
+	}
+	sort.Strings(ids)
+	body, _ := json.Marshal(struct {
+		AccountIDs []string `json:"account_ids"`
+		UserID     string   `json:"user_id"`
+	}{ids, userID})
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, gatewayEligibilityURL, bytes.NewReader(body))
+	if err != nil {
+		return nil, gatewayAllocationUnavailable()
+	}
+	req.Header.Set("Authorization", "Bearer "+s.key)
+	req.Header.Set("Content-Type", "application/json")
+	response, err := s.client.Do(req)
+	if err != nil {
+		return nil, gatewayAllocationUnavailable()
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusOK {
+		return nil, gatewayAllocationUnavailable()
+	}
+	data, err := io.ReadAll(io.LimitReader(response.Body, 8193))
+	if err != nil || len(data) > 8192 {
+		return nil, gatewayAllocationUnavailable()
+	}
+	fields, err := decodeGatewayObject(data, "account_ids")
+	var allowed []string
+	if err != nil || json.Unmarshal(fields["account_ids"], &allowed) != nil {
+		return nil, gatewayAllocationUnavailable()
+	}
+	permitted := make(map[string]bool, len(allowed))
+	for _, id := range allowed {
+		if !seen[id] || permitted[id] {
+			return nil, gatewayAllocationUnavailable()
+		}
+		permitted[id] = true
+	}
+	result := make([]*Auth, 0, len(allowed))
+	for _, candidate := range candidates {
+		if permitted[gatewayAccountResultIndex(candidate)] {
+			result = append(result, candidate)
+		}
+	}
+	return result, nil
+}
+
+// Remove only this request's aliases / LCP sequence; other users and sessions
+// bound to the same account must keep their bindings.
+func (s *GatewayAllocationSelector) clearUnauthorizedBinding(provider, model string, opts cliproxyexecutor.Options, allowed []*Auth) {
+	permitted := make(map[string]bool, len(allowed))
+	for _, a := range allowed {
+		permitted[a.ID] = true
+	}
+	primary, fallback := extractExplicitSessionIDs(opts.Headers, opts.OriginalRequest, opts.Metadata)
+	if primary == "" {
+		namespace := lcpAffinityNamespace(provider, model, opts.Metadata)
+		turns := cliproxysession.ExtractCanonicalTurns(opts.SourceFormat, opts.OriginalRequest)
+		fingerprints, minPrefix := s.affinity.matcher.Prepare(turns)
+		if namespace != "" && len(fingerprints) > 0 && minPrefix > 0 {
+			if match, ok := s.affinity.matcher.MatchFingerprints(namespace, fingerprints, minPrefix); ok && !permitted[match.AuthID] {
+				s.affinity.matcher.RemoveFingerprints(namespace, fingerprints, match.AuthID)
+			}
+		}
+		primary, fallback = extractSessionIDs(opts.Headers, opts.OriginalRequest, opts.Metadata)
+	}
+	remove := func(id string) {
+		if id == "" {
+			return
+		}
+		id = cliproxysession.BoundSessionIdentity(id)
+		key := provider + "::" + id + "::" + canonicalModelKey(model)
+		if account, ok := s.affinity.cache.Get(key); ok && !permitted[account] {
+			s.affinity.cache.CompareAndDelete(key, account)
+		}
+	}
+	remove(primary)
+	if fallback != primary && !isSubagentSession(primary, fallback) {
+		remove(fallback)
+	}
+}
+
+func (s *GatewayAllocationSelector) Stop() {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.affinity.Stop()
+	s.client.CloseIdleConnections()
+}
+
+func (s *GatewayAllocationSelector) OnResult(result Result) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.affinity.OnResult(result)
+}
+
+func (s *GatewayAllocationSelector) InvalidateAuth(id string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.affinity.InvalidateAuth(id)
+}
+
+type gatewayAllocationRefreshKey struct{}
+
+func (m *Manager) withGatewayAllocationRefresh(ctx context.Context, selector Selector, candidates []*Auth, provider, model string) context.Context {
+	if _, ok := selector.(*GatewayAllocationSelector); !ok {
+		return ctx
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	return context.WithValue(ctx, gatewayAllocationRefreshKey{}, func() ([]*Auth, error) {
+		return m.gatewayAllocationSnapshot(selector, candidates, provider, model)
+	})
+}
+
+func (m *Manager) gatewayAllocationSnapshot(selector Selector, candidates []*Auth, provider, model string) ([]*Auth, error) {
+	m.mu.RLock()
+	defer m.mu.RUnlock()
+	current := make([]*Auth, 0, len(candidates))
+	for _, candidate := range candidates {
+		fresh := m.auths[candidate.ID]
+		if fresh == nil || !GatewayAccountAvailable(fresh) || executorKeyFromAuth(fresh) != executorKeyFromAuth(candidate) {
+			continue
+		}
+		index := gatewayAccountResultIndex(candidate)
+		freshIndex := gatewayAccountResultIndex(fresh)
+		if index == "" || freshIndex == "" || index != freshIndex {
+			continue
+		}
+		if strings.TrimSpace(model) != "" && !m.authSupportsRouteModel(registry.GetGlobalRegistry(), fresh, model) {
+			continue
+		}
+		current = append(current, fresh)
+	}
+	_, snapshot, err := m.availableAuthsForSelector(selector, current, provider, model, time.Now())
+	return snapshot, err
+}
diff --git a/sdk/cliproxy/auth/gateway_allocation_selector_test.go b/sdk/cliproxy/auth/gateway_allocation_selector_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..8ea2d4b3f38f8a330c4927f65d4ebf5565b390a8
--- /dev/null
+++ b/sdk/cliproxy/auth/gateway_allocation_selector_test.go
@@ -0,0 +1,515 @@
+package auth
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+)
+
+type gatewayAllocationTransport func(*http.Request) (*http.Response, error)
+
+func (f gatewayAllocationTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	if r.URL.String() == gatewayEligibilityURL {
+		var request struct {
+			AccountIDs []string `json:"account_ids"`
+			UserID     string   `json:"user_id"`
+		}
+		if err := json.NewDecoder(r.Body).Decode(&request); err != nil || request.UserID != "00000000-0000-0000-0000-000000000001" {
+			return allocationResponse(400, `{}`), nil
+		}
+		data, _ := json.Marshal(map[string]any{"account_ids": request.AccountIDs})
+		return allocationResponse(200, string(data)), nil
+	}
+	return f(r)
+}
+
+func allocationResponse(status int, body string) *http.Response {
+	return &http.Response{StatusCode: status, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(body))}
+}
+
+func allocationFixture(t *testing.T) (*GatewayAllocationSelector, []*Auth) {
+	t.Helper()
+	s := NewGatewayAllocationSelector(time.Hour, true)
+	s.key = "synthetic-key"
+	t.Cleanup(s.Stop)
+	return s, []*Auth{
+		codexOAuthDedupeAuth("allocation-a.json", "allocation-account-a", "2026-08-20T00:00:00Z"),
+		codexOAuthDedupeAuth("allocation-b.json", "allocation-account-b", "2026-08-20T00:00:00Z"),
+	}
+}
+
+func allocationOptions(session string) cliproxyexecutor.Options {
+	return cliproxyexecutor.Options{Metadata: map[string]any{cliproxyexecutor.GatewayUserIDMetadataKey: "00000000-0000-0000-0000-000000000001"}, Headers: http.Header{"Session_id": []string{session}}}
+}
+
+func assertAllocation503(t *testing.T, err error) {
+	t.Helper()
+	var apiErr *Error
+	if !errors.As(err, &apiErr) || apiErr.HTTPStatus != http.StatusServiceUnavailable {
+		t.Fatalf("error = %v, want 503", err)
+	}
+}
+
+func TestGatewayAllocationBindingDrainAndEveryColdBranch(t *testing.T) {
+	for _, mode := range []string{"explicit", "no-session", "singleton", "body-derived", "lcp"} {
+		t.Run(mode, func(t *testing.T) {
+			s, auths := allocationFixture(t)
+			opts := allocationOptions("existing")
+			if mode == "no-session" || mode == "singleton" {
+				opts = allocationOptions("")
+			}
+			if mode == "singleton" {
+				auths = auths[:1]
+			}
+			if mode == "body-derived" {
+				opts = cliproxyexecutor.Options{Metadata: map[string]any{cliproxyexecutor.GatewayUserIDMetadataKey: "00000000-0000-0000-0000-000000000001"}, OriginalRequest: []byte(`{"messages":[{"role":"user","content":"hello"}]}`)}
+			}
+			if mode == "lcp" {
+				opts = cliproxyexecutor.Options{SourceFormat: "openai", OriginalRequest: []byte(`{"messages":[{"role":"user","content":"hello"}]}`), Metadata: map[string]any{cliproxyexecutor.GatewayUserIDMetadataKey: "00000000-0000-0000-0000-000000000001", cliproxyexecutor.CallerScopeMetadataKey: "caller"}}
+			}
+			var calls int
+			s.client.Transport = gatewayAllocationTransport(func(r *http.Request) (*http.Response, error) {
+				calls++
+				if r.Method != http.MethodPost || r.URL.String() != gatewayAllocationURL || r.Header.Get("Authorization") != "Bearer synthetic-key" {
+					t.Errorf("invalid callback contract")
+				}
+				var request struct {
+					AccountIDs []string `json:"account_ids"`
+				}
+				if err := json.NewDecoder(r.Body).Decode(&request); err != nil || len(request.AccountIDs) != len(auths) {
+					t.Errorf("candidates = %+v: %v", request, err)
+				}
+				if calls > 1 {
+					return allocationResponse(503, `{}`), nil
+				}
+				return allocationResponse(200, fmt.Sprintf(`{"account_id":%q}`, gatewayAccountResultIndex(auths[0]))), nil
+			})
+			first, err := s.Pick(context.Background(), "codex", "gateway-model", opts, auths)
+			if err != nil || first.ID != auths[0].ID || calls != 1 {
+				t.Fatalf("first = %v, %v; calls %d", first, err, calls)
+			}
+			second, err := s.Pick(context.Background(), "codex", "gateway-model", opts, auths)
+			if mode == "no-session" || mode == "singleton" {
+				assertAllocation503(t, err)
+				return
+			}
+			if err != nil || second.ID != first.ID || calls != 1 {
+				t.Fatalf("weight-zero drain lost binding: %v, %v, calls %d", second, err, calls)
+			}
+			s.InvalidateAuth(first.ID)
+			_, err = s.Pick(context.Background(), "codex", "gateway-model", opts, auths)
+			assertAllocation503(t, err)
+		})
+	}
+}
+
+func TestGatewayAllocationConcurrentFirstBinding(t *testing.T) {
+	for _, lcp := range []bool{false, true} {
+		t.Run(fmt.Sprint(lcp), func(t *testing.T) {
+			s, auths := allocationFixture(t)
+			entered := make(chan struct{}, 2)
+			release := make(chan struct{})
+			var calls atomic.Int32
+			s.client.Transport = gatewayAllocationTransport(func(r *http.Request) (*http.Response, error) {
+				i := calls.Add(1) - 1
+				entered <- struct{}{}
+				select {
+				case <-release:
+				case <-r.Context().Done():
+					return nil, r.Context().Err()
+				}
+				return allocationResponse(200, fmt.Sprintf(`{"account_id":%q}`, gatewayAccountResultIndex(auths[i]))), nil
+			})
+			results := make(chan *Auth, 2)
+			for i := 0; i < 2; i++ {
+				go func() {
+					opts := allocationOptions("concurrent")
+					if lcp {
+						opts = cliproxyexecutor.Options{SourceFormat: "openai", OriginalRequest: []byte(`{"messages":[{"role":"user","content":"hello"}]}`), Metadata: map[string]any{cliproxyexecutor.GatewayUserIDMetadataKey: "00000000-0000-0000-0000-000000000001", cliproxyexecutor.CallerScopeMetadataKey: "caller"}}
+					}
+					a, err := s.Pick(context.Background(), "codex", "gateway-model", opts, auths)
+					if err != nil {
+						t.Errorf("Pick: %v", err)
+					}
+					results <- a
+				}()
+			}
+			for i := 0; i < 2; i++ {
+				select {
+				case <-entered:
+				case <-time.After(time.Second):
+					t.Fatal("callback held binding lock")
+				}
+			}
+			close(release)
+			a, b := <-results, <-results
+			if a == nil || b == nil || a.ID != b.ID {
+				t.Fatalf("conflicting first bindings: %v / %v", a, b)
+			}
+		})
+	}
+}
