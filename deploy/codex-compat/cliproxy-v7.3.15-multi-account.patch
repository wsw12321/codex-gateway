+func TestAccountProbeStableIndexFenceAndOutputValidation(t *testing.T) {
+	server, account, executor := newProbeTestServer(t, false)
+	_, executeErr := server.handlers.ExecuteModel(context.Background(), handlers.ModelExecutionRequest{
+		EntryProtocol: "openai-response", ExitProtocol: "openai-response",
