@@ -0,0 +1,114 @@
+package executor
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+	"github.com/tidwall/gjson"
+)
+
+func TestCodexAstraUpgradeHTTPTransports(t *testing.T) {
+	for _, mode := range []string{"ordinary", "sse", "compact"} {
+		t.Run(mode, func(t *testing.T) {
+			type capturedRequest struct {
+				path    string
+				headers http.Header
+				body    []byte
+			}
+			captured := make(chan capturedRequest, 1)
+			upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				body, err := io.ReadAll(r.Body)
+				if err != nil {
+					t.Error(err)
+					w.WriteHeader(http.StatusBadRequest)
+					return
+				}
+				captured <- capturedRequest{r.URL.Path, r.Header.Clone(), body}
+				if mode == "compact" {
+					w.Header().Set("Content-Type", "application/json")
+					_, _ = w.Write([]byte(`{"id":"compact-astra","object":"response.compaction","model":"gpt-6-astra","output":[{"type":"compaction","encrypted_content":"mock-compacted-content"}]}`))
+					return
+				}
+				w.Header().Set("Content-Type", "text/event-stream")
+				_, _ = w.Write([]byte("event: response.completed\ndata: {\"type\":\"response.completed\",\"response\":{\"id\":\"resp-astra\",\"object\":\"response\",\"model\":\"gpt-6-astra\",\"status\":\"completed\",\"output\":[],\"usage\":{\"input_tokens\":4,\"output_tokens\":2,\"total_tokens\":6}}}\n\n"))
+			}))
+			defer upstream.Close()
+			a := &cliproxyauth.Auth{ID: "astra-transport", Provider: "codex", ProxyURL: "direct",
+				Metadata: map[string]any{"access_token": "astra-mock-token", "account_id": "astra-mock-account"},
+				Attributes: map[string]string{"base_url": upstream.URL, cliproxyauth.AttributeAuthKind: cliproxyauth.AuthKindOAuth,
+					"header:Authorization": "Bearer forged", "header:Chatgpt-Account-Id": "forged-account", "header:X-Codex-Gateway-Affinity": "must-not-leak", "header:X-Codex-Upstream-Account": "must-not-leak"},
+			}
+			cliproxyauth.SetCodexOAuthAccountIndexSeed(a, "astra-mock-account")
+			e := NewCodexExecutor(&config.Config{SDKConfig: config.SDKConfig{DisableImageGeneration: config.DisableImageGenerationAll}})
+			req := cliproxyexecutor.Request{Model: "gpt-6-astra", Payload: []byte(`{"model":"gpt-6-astra","input":[{"role":"user","content":"hello"}],"reasoning":{"effort":"high"}}`)}
+			opts := cliproxyexecutor.Options{SourceFormat: sdktranslator.FromString("openai-response"), ResponseFormat: sdktranslator.FromString("openai-response")}
+			var response []byte
+			if mode == "sse" {
+				opts.Stream = true
+				result, err := e.ExecuteStream(context.Background(), a, req, opts)
+				if err != nil {
+					t.Fatal(err)
+				}
+				for chunk := range result.Chunks {
+					if chunk.Err != nil {
+						t.Fatal(chunk.Err)
+					}
+					response = append(response, chunk.Payload...)
+				}
+			} else {
+				if mode == "compact" {
+					opts.Alt = "responses/compact"
+				}
+				result, err := e.Execute(context.Background(), a, req, opts)
+				if err != nil {
+					t.Fatal(err)
+				}
+				response = result.Payload
+			}
+			var got capturedRequest
+			select {
+			case got = <-captured:
+			default:
+				t.Fatal("upstream was not called")
+			}
+			wantPath := "/responses"
+			if mode == "compact" {
+				wantPath += "/compact"
+			}
+			if got.path != wantPath {
+				t.Fatalf("path=%q want=%q", got.path, wantPath)
+			}
+			if gjson.GetBytes(got.body, "model").String() != "gpt-6-astra" {
+				t.Fatalf("upstream model changed: %s", got.body)
+			}
+			if gjson.GetBytes(got.body, "reasoning.effort").String() != "high" {
+				t.Fatalf("reasoning effort changed: %s", got.body)
+			}
+			if got.headers.Get("Authorization") != "Bearer astra-mock-token" || got.headers.Get("Chatgpt-Account-Id") != "astra-mock-account" {
+				t.Fatalf("canonical OAuth headers replaced: %v", got.headers)
+			}
+			for _, name := range []string{"X-Codex-Gateway-Affinity", "X-Codex-Upstream-Account"} {
+				if got.headers.Get(name) != "" {
+					t.Fatalf("internal header leaked: %s", name)
+				}
+			}
+			if !strings.Contains(string(response), "gpt-6-astra") {
+				t.Fatalf("response lost Astra model: %s", response)
+			}
+			if mode == "sse" && !strings.Contains(string(response), "response.completed") {
+				t.Fatalf("SSE completion lost: %s", response)
+			}
+			if mode == "compact" && gjson.GetBytes(response, "object").String() != "response.compaction" {
+				t.Fatalf("compact response=%s", response)
+			}
+		})
+	}
+}
