+func newCodexGatewayControlManager(t *testing.T, upstreamURL string) (*cliproxyauth.Manager, *cliproxyauth.Auth, string) {
+	t.Helper()
+	dir := t.TempDir()
+	manager := cliproxyauth.NewManager(nil, nil, nil)
+	if err := manager.LoadGatewayAccountState(dir); err != nil {
+		t.Fatal(err)
+	}
+	manager.SetRetryConfig(0, 0, 2)
+	manager.RegisterExecutor(NewCodexExecutor(&config.Config{}))
+	candidate := &cliproxyauth.Auth{
+		ID: uuid.NewString() + ".json", Provider: "codex", Status: cliproxyauth.StatusActive,
+		Metadata: map[string]any{"access_token": "test-access-token", "account_id": uuid.NewString()},
+		Attributes: map[string]string{
+			cliproxyauth.AttributeSourceBackend: cliproxyauth.AuthSourceFile,
+			cliproxyauth.AttributeAuthKind:      cliproxyauth.AuthKindOAuth, "base_url": upstreamURL,
+		},
+	}
+	registry.GetGlobalRegistry().RegisterClient(candidate.ID, "codex", []*registry.ModelInfo{{ID: "gpt-5.4"}})
+	t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(candidate.ID) })
+	saved, err := manager.Register(context.Background(), candidate)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := cliproxyauth.CodexOAuthAccountIndex(saved); !ok {
+		t.Fatal("test OAuth account has no stable identity")
+	}
+	return manager, saved, dir
+}
+
+func invokeCodexGatewayControl(manager *cliproxyauth.Manager, mode string) (string, error) {
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	req := cliproxyexecutor.Request{Model: "gpt-5.4", Payload: []byte(`{"model":"gpt-5.4","input":"hello"}`)}
+	opts := cliproxyexecutor.Options{SourceFormat: sdktranslator.FromString("openai-response")}
+	if mode == "compact" {
+		opts.Alt = "responses/compact"
+	}
+	if !strings.HasPrefix(mode, "sse") {
+		result, err := manager.Execute(ctx, []string{"codex"}, req, opts)
+		return string(result.Payload), err
+	}
+	opts.Stream = true
+	result, err := manager.ExecuteStream(ctx, []string{"codex"}, req, opts)
+	if err != nil {
+		return "", err
+	}
+	return drainChunks(result)
+}
