+	if winner == nil || byID["codex-old-plus.json"] != nil || byID["codex-other.json"] == nil {
+		t.Fatalf("deduplicated auth IDs = %#v", byID)
+	}
+	if index := winner.EnsureIndex(); len(index) != 16 {
+		t.Fatalf("winner index = %q, want 16 hex characters", index)
+	}
+}
