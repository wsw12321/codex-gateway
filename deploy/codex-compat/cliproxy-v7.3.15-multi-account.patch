+// Side conversations carry their own leaf identity while retaining the main
+// client's namespace, so an explicit parent can join the same root registry.
+func extractSideSessionInfo(headers http.Header, root, reqRoot gjson.Result, nested bool, parent string, info SessionInfo) (SessionInfo, bool) {
+	sideID := ""
+	for _, name := range []string{"X-Side-Session-Id", "X-Side-Thread-Id", "X-Claude-Code-Side-Session-Id"} {
+		if sideID = sessionHeaderValue(headers, name); sideID != "" {
+			break
+		}
+	}
+	if sideID == "" {
+		for _, path := range []string{"side_session_id", "sideSessionId", "side_thread_id", "sideThreadId", "metadata.side_session_id", "metadata.side_thread_id", "extra_body.side_session_id", "extra_body.side_thread_id"} {
+			sideID = normalizedSessionCandidate(root.Get(path).String())
+			if sideID == "" && nested {
+				sideID = normalizedSessionCandidate(reqRoot.Get(path).String())
+			}
+			if sideID != "" {
+				break
+			}
+		}
+	}
+	if sideID == "" {
+		return SessionInfo{}, false
+	}
+	prefix, mainID := "session:", ""
+	info.ClientType = "generic"
+	if sessionHeaderValue(headers, "X-Claude-Code-Side-Session-Id") != "" || sessionHeaderValue(headers, "X-Claude-Code-Parent-Session-Id") != "" || sessionHeaderValue(headers, "X-Claude-Parent-Session-Id") != "" {
+		prefix, info.ClientType = "claude:", "claude"
+	} else if sessionHeaderValue(headers, "X-Codex-Parent-Thread-Id") != "" {
+		prefix, info.ClientType = "codex:", "codex"
+	}
+	for _, source := range []struct{ header, prefix, client string }{
+		{"X-Claude-Code-Session-Id", "claude:", "claude"},
+		{"Session-Id", "codex:", "codex"}, {"Thread-Id", "codex:", "codex"},
+		{"X-Http-Session-Id", "agy:", "agy"}, {"X-Session-Id", "header:", "generic"},
+		{"X-Session-Affinity", "affinity:", "opencode"}, {"X-Slot-Session-Id", "slot:", "pi"},
+		{"X-Task-Id", "task:", "task"}, {"X-Conversation-Id", "conv:", "generic"},
+		{"X-Thread-Id", "thread:", "generic"}, {"X-Client-Request-Id", "clientreq:", "generic"},
+	} {
+		if mainID = sessionHeaderValue(headers, source.header); mainID != "" {
+			prefix, info.ClientType = source.prefix, source.client
+			break
+		}
+	}
+	if mainID == "" {
+		var turn gjson.Result
+		for name, values := range headers {
+			if strings.EqualFold(strings.ReplaceAll(name, "_", "-"), "X-Codex-Turn-Metadata") && len(values) > 0 {
+				turn = gjson.Parse(values[0])
+				break
+			}
+		}
+		if mainID = normalizedSessionCandidate(turn.Get("session_id").String()); mainID != "" {
+			prefix, info.ClientType = "codex:", "codex"
+		}
+	}
+	if mainID == "" {
+		if claudeID, _, _ := ClaudeMetadataIdentities([]byte(root.Raw)); claudeID != "" {
+			mainID, prefix, info.ClientType = claudeID, "claude:", "claude"
+		}
+	}
+	if mainID == "" {
+		for _, path := range []string{"session_id", "sessionId", "thread_id", "threadId"} {
+			mainID = normalizedSessionCandidate(root.Get(path).String())
+			if mainID == "" && nested {
+				mainID = normalizedSessionCandidate(reqRoot.Get(path).String())
+			}
+			if mainID != "" {
+				if strings.HasPrefix(path, "thread") {
+					prefix = "thread:"
+				}
+				break
+			}
+		}
+	}
+	if parent == "" {
+		parent = mainID
+	}
+	info.SessionID, info.AgentName, info.IsSubagent = prefix+sideID, "side", true
+	if parent != "" && parent != sideID {
+		info.ParentSessionID = prefix + parent
+	}
+	return info, true
+}
+
 func normalizedSessionCandidate(raw string) string {
 	return NormalizeExplicitID(raw)
 }
