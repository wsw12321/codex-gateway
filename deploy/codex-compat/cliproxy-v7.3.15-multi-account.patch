@@ -0,0 +1,720 @@
+package api
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"math"
+	"net/http"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/access"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+)
+
+const (
+	codexUsageURL                = "https://chatgpt.com/backend-api/wham/usage"
+	codexQuotaRPCMethod          = "account/rateLimits/read"
+	codexQuotaRPCID              = 6
+	codexQuotaTimeout            = 15 * time.Second
+	codexQuotaRequestMaxBodySize = 256
+	codexQuotaMaxBodyBytes       = 1 << 20
+	codexMaxExtraLimits          = 32
+	codexMaxLimitIDBytes         = 32
+	codexMaxWindowSeconds        = 31 * 24 * 60 * 60
+	codexMinResetUnix            = 946684800  // 2000-01-01T00:00:00Z
+	codexMaxResetUnix            = 4102444800 // 2100-01-01T00:00:00Z
+)
+
+var errQuotaRPCRequestTooLarge = errors.New("quota RPC request too large")
+
+// These errors identify failed schema checks without retaining upstream values.
+type quotaSchemaError string
+
+func (e quotaSchemaError) Error() string { return string(e) }
+
+func quotaSchemaErrorCode(err error) string {
+	var schemaErr quotaSchemaError
+	if errors.As(err, &schemaErr) {
+		switch schemaErr {
+		case "quota_json_invalid", "quota_field_type_invalid", "quota_rate_limit_missing",
+			"quota_percent_missing", "quota_percent_out_of_range", "quota_percent_fractional",
+			"quota_window_invalid", "quota_reset_invalid", "quota_limit_id_invalid",
+			"quota_limit_id_duplicate", "quota_limits_excessive":
+			return string(schemaErr)
+		}
+	}
+	return "quota_schema_changed"
+}
+
+type upstreamAccountView struct {
+	ID                  string `json:"id"`
+	MaskedEmail         string `json:"masked_email"`
+	Plan                string `json:"plan"`
+	Status              string `json:"status"`
+	CliproxyStatus      string `json:"cliproxy_status"`
+	GatewayManualStatus string `json:"gateway_manual_status"`
+	GatewayQuotaStatus  string `json:"gateway_quota_status"`
+	LastSyncedAt        string `json:"last_synced_at"`
+}
+
+type quotaRPCRequest struct {
+	Method string
+	ID     int
+}
+
+type quotaRPCResponse struct {
+	ID     int                   `json:"id"`
+	Result quotaRateLimitsResult `json:"result"`
+}
+
+type quotaRateLimitsResult struct {
+	RateLimits            quotaRateLimitView            `json:"rateLimits"`
+	RateLimitsByLimitID   map[string]quotaRateLimitView `json:"rateLimitsByLimitId"`
+	RateLimitResetCredits any                           `json:"rateLimitResetCredits"`
+}
+
+type quotaRateLimitView struct {
+	LimitID              string           `json:"limitId"`
+	LimitName            *string          `json:"limitName"`
+	Primary              *quotaWindowView `json:"primary"`
+	Secondary            *quotaWindowView `json:"secondary"`
+	RateLimitReachedType *string          `json:"rateLimitReachedType"`
+}
+
+type quotaWindowView struct {
+	UsedPercent        int    `json:"usedPercent"`
+	WindowDurationMins *int64 `json:"windowDurationMins"`
+	ResetsAt           *int64 `json:"resetsAt"`
+}
+
+type upstreamUsagePayload struct {
+	RateLimit            json.RawMessage               `json:"rate_limit"`
+	AdditionalRateLimits []upstreamAdditionalLimit     `json:"additional_rate_limits"`
+	RateLimitReachedType *upstreamRateLimitReachedType `json:"rate_limit_reached_type"`
+}
+
+type upstreamAdditionalLimit struct {
+	LimitName      string             `json:"limit_name"`
+	MeteredFeature string             `json:"metered_feature"`
+	RateLimit      *upstreamRateLimit `json:"rate_limit"`
+}
+
+type upstreamRateLimitReachedType struct {
+	Type string `json:"type"`
+}
+
+type upstreamRateLimit struct {
+	PrimaryWindow   *upstreamUsageWindow `json:"primary_window"`
+	SecondaryWindow *upstreamUsageWindow `json:"secondary_window"`
+}
+
+type upstreamUsageWindow struct {
+	UsedPercent        *float64 `json:"used_percent"`
+	LimitWindowSeconds *int64   `json:"limit_window_seconds"`
+	ResetAt            *int64   `json:"reset_at"`
+}
+
+func internalAccountAuthMiddleware(manager *access.Manager) gin.HandlerFunc {
+	return func(c *gin.Context) {
+		if manager == nil || len(manager.Providers()) == 0 {
+			c.AbortWithStatusJSON(http.StatusServiceUnavailable, gin.H{"error": "internal_auth_unavailable"})
+			return
+		}
+		values := c.Request.Header.Values("Authorization")
+		if len(values) != 1 {
+			c.AbortWithStatusJSON(http.StatusUnauthorized, gin.H{"error": "unauthorized"})
+			return
+		}
+		parts := strings.Fields(values[0])
+		if len(parts) != 2 || !strings.EqualFold(parts[0], "Bearer") || strings.TrimSpace(parts[1]) == "" {
+			c.AbortWithStatusJSON(http.StatusUnauthorized, gin.H{"error": "unauthorized"})
+			return
+		}
+		result, authErr := manager.Authenticate(c.Request.Context(), c.Request)
+		if authErr != nil {
+			status := http.StatusUnauthorized
+			if authErr.HTTPStatusCode() >= http.StatusInternalServerError {
+				status = http.StatusServiceUnavailable
+			}
+			c.AbortWithStatusJSON(status, gin.H{"error": "unauthorized"})
+			return
+		}
+		if result == nil || result.Principal != parts[1] || result.Metadata["source"] != "authorization" {
+			c.AbortWithStatusJSON(http.StatusUnauthorized, gin.H{"error": "unauthorized"})
+			return
+		}
+		c.Set("userApiKey", result.Principal)
+		c.Set("accessProvider", result.Provider)
+		if len(result.Metadata) > 0 {
+			c.Set("accessMetadata", result.Metadata)
+		}
+		c.Next()
+	}
+}
+
+func (s *Server) listUpstreamAccounts(c *gin.Context) {
+	c.Header("Cache-Control", "no-store")
+	if s == nil || s.handlers == nil || s.handlers.AuthManager == nil {
+		c.JSON(http.StatusServiceUnavailable, gin.H{"error": "account_registry_unavailable"})
+		return
+	}
+
+	observedAt := time.Now().UTC()
+	accountsByID := make(map[string]upstreamAccountView)
+	accountTimes := make(map[string]time.Time)
+	for _, candidate := range s.handlers.AuthManager.List() {
+		if !isCodexOAuthAccount(candidate) {
+			continue
+		}
+		id := stableCodexAccountID(candidate)
+		if id == "" {
+			continue
+		}
+		syncedAt := observedAuthSyncTime(candidate, observedAt)
+		if previous, ok := accountTimes[id]; ok && !syncedAt.After(previous) {
+			continue
+		}
+		accountTimes[id] = syncedAt
+		cliproxyStatus, gatewayManualStatus, gatewayQuotaStatus, finalStatus := upstreamAccountStatuses(s.handlers.AuthManager, candidate)
+		accountsByID[id] = upstreamAccountView{
+			ID:                  id,
+			MaskedEmail:         maskUpstreamEmail(authEmail(candidate)),
+			Plan:                accountPlanView(candidate.Attributes["plan_type"]),
+			Status:              finalStatus,
+			CliproxyStatus:      cliproxyStatus,
+			GatewayManualStatus: gatewayManualStatus,
+			GatewayQuotaStatus:  gatewayQuotaStatus,
+			LastSyncedAt:        formatOptionalTime(syncedAt),
+		}
+	}
+	accounts := make([]upstreamAccountView, 0, len(accountsByID))
+	for _, account := range accountsByID {
+		accounts = append(accounts, account)
+	}
+	sort.Slice(accounts, func(i, j int) bool { return accounts[i].ID < accounts[j].ID })
+	c.JSON(http.StatusOK, gin.H{"accounts": accounts})
+}
+
+func (s *Server) getUpstreamAccountQuota(c *gin.Context) {
+	c.Header("Cache-Control", "no-store")
+	if s == nil || s.handlers == nil || s.handlers.AuthManager == nil {
+		c.JSON(http.StatusServiceUnavailable, gin.H{"error": "account_registry_unavailable"})
+		return
+	}
+	rpcRequest, err := decodeQuotaRPCRequest(c.Request.Body)
+	if err != nil {
+		if errors.Is(err, errQuotaRPCRequestTooLarge) {
+			c.JSON(http.StatusRequestEntityTooLarge, gin.H{"error": "quota_request_too_large"})
+			return
+		}
+		c.JSON(http.StatusBadRequest, gin.H{"error": "quota_request_invalid"})
+		return
+	}
+	account := findCodexOAuthAccount(s.handlers.AuthManager.List(), strings.TrimSpace(c.Param("id")))
+	if account == nil {
+		c.JSON(http.StatusNotFound, gin.H{"error": "upstream_account_not_found"})
+		return
+	}
+	if account.Disabled || account.Status == auth.StatusDisabled {
+		c.JSON(http.StatusConflict, gin.H{"error": "upstream_account_disabled"})
+		return
+	}
+
+	ctx, cancel := context.WithTimeout(c.Request.Context(), codexQuotaTimeout)
+	defer cancel()
+	headers := make(http.Header)
+	headers.Set("Accept", "application/json")
+	accountID, ok := account.Metadata["account_id"].(string)
+	accountID = strings.TrimSpace(accountID)
+	if !ok || !safeOpaqueAccountID(accountID) {
+		c.JSON(http.StatusBadGateway, gin.H{"error": "quota_account_identity_unavailable"})
+		return
+	}
+	headers.Set("Chatgpt-Account-Id", accountID)
+	quotaAuth := account.Clone()
+	stripQuotaCustomHeaders(quotaAuth)
+	quotaAuth.ProxyURL = ""
+	accessToken, _ := quotaAuth.Metadata["access_token"].(string)
+	accessToken = strings.TrimSpace(accessToken)
+	if !safeBearerToken(accessToken) {
+		c.JSON(http.StatusBadGateway, gin.H{"error": "quota_credential_unavailable"})
+		return
+	}
+	req, err := s.handlers.AuthManager.NewHttpRequest(ctx, quotaAuth, http.MethodGet, codexUsageURL, nil, headers)
+	if err != nil {
+		c.JSON(http.StatusBadGateway, gin.H{"error": "quota_request_failed"})
+		return
+	}
+	// Reset the complete outbound header set after provider preparation. The
+	// executor prepares once more before sending, but quotaAuth has no custom
+	// header attributes, so these protected values cannot be overridden by an
+	// OAuth file or inbound caller.
+	req.Header = make(http.Header)
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set("Authorization", "Bearer "+accessToken)
+	req.Header.Set("Chatgpt-Account-Id", accountID)
+	req.Host = req.URL.Host
+	resp, err := s.handlers.AuthManager.HttpRequest(ctx, quotaAuth, req)
+	if err != nil {
+		if errors.Is(ctx.Err(), context.DeadlineExceeded) || errors.Is(err, context.DeadlineExceeded) {
+			c.JSON(http.StatusGatewayTimeout, gin.H{"error": "quota_upstream_timeout"})
+			return
+		}
+		c.JSON(http.StatusBadGateway, gin.H{"error": "quota_upstream_unavailable"})
+		return
+	}
+	defer func() { _ = resp.Body.Close() }()
+	if resp.StatusCode < http.StatusOK || resp.StatusCode >= http.StatusMultipleChoices {
+		_, _ = io.Copy(io.Discard, io.LimitReader(resp.Body, 64<<10))
+		switch resp.StatusCode {
+		case http.StatusUnauthorized:
+			c.JSON(http.StatusUnauthorized, gin.H{"error": "quota_reauthentication_required"})
+		case http.StatusForbidden:
+			c.JSON(http.StatusForbidden, gin.H{"error": "quota_reauthentication_required"})
+		case http.StatusTooManyRequests:
+			c.JSON(http.StatusTooManyRequests, gin.H{"error": "quota_upstream_rate_limited"})
+		case http.StatusRequestTimeout, http.StatusGatewayTimeout:
+			c.JSON(http.StatusGatewayTimeout, gin.H{"error": "quota_upstream_timeout"})
+		default:
+			c.JSON(http.StatusBadGateway, gin.H{"error": "quota_upstream_error"})
+		}
+		return
+	}
+
+	body, err := io.ReadAll(io.LimitReader(resp.Body, codexQuotaMaxBodyBytes+1))
+	if err != nil || len(body) > codexQuotaMaxBodyBytes {
+		c.JSON(http.StatusBadGateway, gin.H{"error": "quota_response_invalid"})
+		return
+	}
+	quota, err := normalizeUpstreamUsage(body)
+	if err != nil {
+		c.JSON(http.StatusBadGateway, gin.H{"error": quotaSchemaErrorCode(err)})
+		return
+	}
+	c.JSON(http.StatusOK, quotaRPCResponse{ID: rpcRequest.ID, Result: quota})
+}
+
+func decodeQuotaRPCRequest(body io.Reader) (quotaRPCRequest, error) {
+	data, err := io.ReadAll(io.LimitReader(body, codexQuotaRequestMaxBodySize+1))
+	if err != nil {
+		return quotaRPCRequest{}, err
+	}
+	if len(data) > codexQuotaRequestMaxBodySize {
+		return quotaRPCRequest{}, errQuotaRPCRequestTooLarge
+	}
+
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	start, err := decoder.Token()
+	if err != nil || start != json.Delim('{') {
+		return quotaRPCRequest{}, errors.New("quota RPC request must be an object")
+	}
+	var request quotaRPCRequest
+	var seenMethod, seenID bool
+	for decoder.More() {
+		keyToken, errToken := decoder.Token()
+		if errToken != nil {
+			return quotaRPCRequest{}, errToken
+		}
+		key, ok := keyToken.(string)
+		if !ok {
+			return quotaRPCRequest{}, errors.New("quota RPC request key must be a string")
+		}
+		switch key {
+		case "method":
+			if seenMethod {
+				return quotaRPCRequest{}, errors.New("duplicate quota RPC method")
+			}
+			seenMethod = true
+			if errDecode := decoder.Decode(&request.Method); errDecode != nil {
+				return quotaRPCRequest{}, errDecode
+			}
+		case "id":
+			if seenID {
+				return quotaRPCRequest{}, errors.New("duplicate quota RPC id")
+			}
+			seenID = true
+			if errDecode := decoder.Decode(&request.ID); errDecode != nil {
+				return quotaRPCRequest{}, errDecode
+			}
+		default:
+			return quotaRPCRequest{}, errors.New("unknown quota RPC field")
+		}
+	}
+	end, err := decoder.Token()
+	if err != nil || end != json.Delim('}') {
+		return quotaRPCRequest{}, errors.New("quota RPC request object was not closed")
+	}
+	if err := ensureJSONEOF(decoder); err != nil {
+		return quotaRPCRequest{}, err
+	}
+	if !seenMethod || !seenID || request.Method != codexQuotaRPCMethod || request.ID != codexQuotaRPCID {
+		return quotaRPCRequest{}, errors.New("unsupported quota RPC request")
+	}
+	return request, nil
+}
+
+func findCodexOAuthAccount(accounts []*auth.Auth, id string) *auth.Auth {
+	if id == "" {
+		return nil
+	}
+	var selected *auth.Auth
+	for _, candidate := range accounts {
+		if !isCodexOAuthAccount(candidate) {
+			continue
+		}
+		if stableCodexAccountID(candidate) == id && (selected == nil || latestAuthSyncTime(candidate).After(latestAuthSyncTime(selected))) {
+			selected = candidate
+		}
+	}
+	return selected
+}
+
+func stableCodexAccountID(candidate *auth.Auth) string {
+	id, _ := auth.CodexOAuthAccountIndex(candidate)
+	return id
+}
+
+func safeOpaqueAccountID(value string) bool {
+	return auth.ValidCodexOAuthAccountID(value)
+}
+
+func safeBearerToken(value string) bool {
+	if value == "" || len(value) > 16<<10 {
+		return false
+	}
+	for i := 0; i < len(value); i++ {
+		if value[i] <= 0x20 || value[i] >= 0x7f {
+			return false
+		}
+	}
+	return true
+}
+
+func stripQuotaCustomHeaders(candidate *auth.Auth) {
+	if candidate == nil || len(candidate.Attributes) == 0 {
+		return
+	}
+	for key := range candidate.Attributes {
+		normalized := strings.ToLower(strings.TrimSpace(key))
+		if strings.HasPrefix(normalized, "header:") || normalized == "api_key" || normalized == "base_url" ||
+			normalized == "compat_name" || normalized == "provider_key" {
+			delete(candidate.Attributes, key)
+		}
+	}
+}
+
+func isCodexOAuthAccount(candidate *auth.Auth) bool {
+	return candidate != nil && strings.EqualFold(strings.TrimSpace(candidate.Provider), "codex") && candidate.AuthKind() == auth.AuthKindOAuth
+}
+
+func authEmail(candidate *auth.Auth) string {
+	if candidate == nil {
+		return ""
+	}
+	if value := strings.TrimSpace(candidate.Attributes["email"]); value != "" {
+		return value
+	}
+	value, _ := candidate.Metadata["email"].(string)
+	return strings.TrimSpace(value)
+}
+
+func maskUpstreamEmail(email string) string {
+	const unknownMaskedEmail = "u***@unknown.invalid"
+
+	email = strings.TrimSpace(email)
+	if strings.Count(email, "@") != 1 {
+		return unknownMaskedEmail
+	}
+	local, domain, _ := strings.Cut(email, "@")
+	if local == "" || !asciiEmailLead(local[0]) || !safeASCIIDomain(domain) {
+		return unknownMaskedEmail
+	}
+	return string(local[0]) + "***@" + domain
+}
+
+func asciiEmailLead(value byte) bool {
+	return value >= 'a' && value <= 'z' || value >= 'A' && value <= 'Z' || value >= '0' && value <= '9'
+}
+
+func safeASCIIDomain(domain string) bool {
+	// The final mask is five bytes plus the unchanged domain. Keep it within
+	// the gateway/DB 7..254 byte contract.
+	if len(domain) < 2 || len(domain) > 249 || strings.HasPrefix(domain, ".") || strings.HasSuffix(domain, ".") || strings.Contains(domain, "..") {
+		return false
+	}
+	for _, label := range strings.Split(domain, ".") {
+		if label == "" || strings.HasPrefix(label, "-") || strings.HasSuffix(label, "-") {
+			return false
+		}
+		for i := 0; i < len(label); i++ {
+			value := label[i]
+			if !asciiEmailLead(value) && value != '-' {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func upstreamAccountStatuses(manager *auth.Manager, candidate *auth.Auth) (cliproxyStatus, gatewayManualStatus, gatewayQuotaStatus, finalStatus string) {
+	cliproxyStatus = upstreamCliproxyStatus(candidate)
+	index := stableCodexAccountID(candidate)
+	gatewayManualStatus, gatewayQuotaStatus = "unknown", "unknown"
+	if manager != nil && index != "" {
+		if manual, quota, ok := manager.GatewayAccountStatuses(index); ok {
+			gatewayManualStatus, gatewayQuotaStatus = manual, quota
+		}
+	}
+	if cliproxyStatus == "error" || gatewayManualStatus == "unknown" || gatewayQuotaStatus == "unknown" {
+		return cliproxyStatus, gatewayManualStatus, gatewayQuotaStatus, "unavailable"
+	}
+	finalStatus = "unavailable"
+	if cliproxyStatus == "active" && gatewayManualStatus == "enabled" && gatewayQuotaStatus == "available" {
+		finalStatus = "available"
+	}
+	return cliproxyStatus, gatewayManualStatus, gatewayQuotaStatus, finalStatus
+}
+
+// upstreamAccountStatus remains as a small compatibility helper for callers
+// that only have an Auth value. New account APIs must use
+// upstreamAccountStatuses so the two Gateway controls stay visible.
+func upstreamAccountStatus(candidate *auth.Auth) string {
+	if candidate == nil || !auth.GatewayAccountAvailable(candidate) {
+		return "unavailable"
+	}
+	return upstreamCliproxyStatus(candidate)
+}
+
+func upstreamCliproxyStatus(candidate *auth.Auth) string {
+	if candidate == nil {
+		return "error"
+	}
+	if candidate.Disabled || candidate.Status == auth.StatusDisabled {
+		return "disabled"
+	}
+	if candidate.Status == auth.StatusError || candidate.Status == auth.StatusUnknown || candidate.Status == "" {
+		return "error"
+	}
+	if candidate.Unavailable || candidate.Quota.Exceeded || candidate.Status == auth.StatusPending || candidate.Status == auth.StatusRefreshing {
+		return "unavailable"
+	}
+	if candidate.Status == auth.StatusActive {
+		return "active"
+	}
+	return "error"
+}
+
+func latestAuthSyncTime(candidate *auth.Auth) time.Time {
+	if candidate == nil {
+		return time.Time{}
+	}
+	latest := candidate.CreatedAt
+	for _, value := range []time.Time{candidate.UpdatedAt, candidate.LastRefreshedAt} {
+		if value.After(latest) {
+			latest = value
+		}
+	}
+	return latest
+}
+
+func observedAuthSyncTime(candidate *auth.Auth, observedAt time.Time) time.Time {
+	if syncedAt := latestAuthSyncTime(candidate); !syncedAt.IsZero() {
+		return syncedAt
+	}
+	if observedAt.IsZero() {
+		observedAt = time.Now().UTC()
+	}
+	return observedAt.UTC()
+}
+
+func formatOptionalTime(value time.Time) string {
+	if value.IsZero() {
+		return ""
+	}
+	return value.UTC().Format(time.RFC3339)
+}
+
+func normalizeUpstreamUsage(body []byte) (quotaRateLimitsResult, error) {
+	var payload upstreamUsagePayload
+	decoder := json.NewDecoder(bytes.NewReader(body))
+	if err := decoder.Decode(&payload); err != nil {
+		var typeErr *json.UnmarshalTypeError
+		if errors.As(err, &typeErr) {
+			return quotaRateLimitsResult{}, quotaSchemaError("quota_field_type_invalid")
+		}
+		return quotaRateLimitsResult{}, quotaSchemaError("quota_json_invalid")
+	}
+	if err := ensureJSONEOF(decoder); err != nil {
+		return quotaRateLimitsResult{}, quotaSchemaError("quota_json_invalid")
+	}
+	// Plan metadata does not determine usage. Require a quota field instead,
+	// retaining explicit null windows without accepting unrelated JSON as usage.
+	if len(payload.RateLimit) == 0 && payload.AdditionalRateLimits == nil {
+		return quotaRateLimitsResult{}, quotaSchemaError("quota_rate_limit_missing")
+	}
+	var rateLimit *upstreamRateLimit
+	if len(payload.RateLimit) != 0 {
+		// The outer decoder already validated the JSON syntax.
+		if err := json.Unmarshal(payload.RateLimit, &rateLimit); err != nil {
+			return quotaRateLimitsResult{}, quotaSchemaError("quota_field_type_invalid")
+		}
+	}
+
+	reachedType := normalizeRateLimitReachedType(payload.RateLimitReachedType)
+	primary, err := normalizeRateLimit("codex", rateLimit, reachedType)
+	if err != nil {
+		return quotaRateLimitsResult{}, err
+	}
+	byLimitID := map[string]quotaRateLimitView{"codex": primary}
+	if len(payload.AdditionalRateLimits) > codexMaxExtraLimits {
+		return quotaRateLimitsResult{}, quotaSchemaError("quota_limits_excessive")
+	}
+	for _, additional := range payload.AdditionalRateLimits {
+		limitID := strings.TrimSpace(additional.MeteredFeature)
+		if !validQuotaLimitID(limitID) {
+			return quotaRateLimitsResult{}, quotaSchemaError("quota_limit_id_invalid")
+		}
+		if _, exists := byLimitID[limitID]; exists {
+			return quotaRateLimitsResult{}, quotaSchemaError("quota_limit_id_duplicate")
+		}
+		normalized, errLimit := normalizeRateLimit(limitID, additional.RateLimit, nil)
+		if errLimit != nil {
+			return quotaRateLimitsResult{}, errLimit
+		}
+		byLimitID[limitID] = normalized
+	}
+	return quotaRateLimitsResult{
+		RateLimits:            primary,
+		RateLimitsByLimitID:   byLimitID,
+		RateLimitResetCredits: nil,
+	}, nil
+}
+
+func normalizeRateLimit(limitID string, limit *upstreamRateLimit, reachedType *string) (quotaRateLimitView, error) {
+	view := quotaRateLimitView{
+		LimitID:              limitID,
+		LimitName:            nil,
+		RateLimitReachedType: reachedType,
+	}
+	if limit == nil {
+		return view, nil
+	}
+	var err error
+	if view.Primary, err = normalizeQuotaWindow(limit.PrimaryWindow); err != nil {
+		return quotaRateLimitView{}, err
+	}
+	if view.Secondary, err = normalizeQuotaWindow(limit.SecondaryWindow); err != nil {
+		return quotaRateLimitView{}, err
+	}
+	return view, nil
+}
+
+func normalizeQuotaWindow(window *upstreamUsageWindow) (*quotaWindowView, error) {
+	if window == nil {
+		return nil, nil
+	}
+	if window.UsedPercent == nil {
+		return nil, quotaSchemaError("quota_percent_missing")
+	}
+	if math.IsNaN(*window.UsedPercent) || math.IsInf(*window.UsedPercent, 0) ||
+		*window.UsedPercent < 0 || *window.UsedPercent > 100 {
+		return nil, quotaSchemaError("quota_percent_out_of_range")
+	}
+	if math.Trunc(*window.UsedPercent) != *window.UsedPercent {
+		return nil, quotaSchemaError("quota_percent_fractional")
+	}
+	view := &quotaWindowView{UsedPercent: int(*window.UsedPercent)}
+	if window.LimitWindowSeconds != nil {
+		seconds := *window.LimitWindowSeconds
+		if seconds <= 0 || seconds > codexMaxWindowSeconds {
+			return nil, quotaSchemaError("quota_window_invalid")
+		}
+		minutes := (seconds + 59) / 60
+		view.WindowDurationMins = &minutes
+	}
+	if window.ResetAt != nil {
+		if *window.ResetAt < codexMinResetUnix || *window.ResetAt > codexMaxResetUnix {
+			return nil, quotaSchemaError("quota_reset_invalid")
+		}
+		resetAt := *window.ResetAt
+		view.ResetsAt = &resetAt
+	}
+	return view, nil
+}
+
+func validCodexAccountPlan(plan string) bool {
+	switch strings.ToLower(strings.TrimSpace(plan)) {
+	case "plus", "pro":
+		return true
+	default:
+		return false
+	}
+}
+
+func accountPlanView(plan string) string {
+	plan = strings.ToLower(strings.TrimSpace(plan))
+	if validCodexAccountPlan(plan) {
+		return plan
+	}
+	return "unknown"
+}
+
+func validQuotaLimitID(value string) bool {
+	if value == "" || len(value) > codexMaxLimitIDBytes || value[0] < 'a' || value[0] > 'z' {
+		return false
+	}
+	for i := 1; i < len(value); i++ {
+		candidate := value[i]
+		if candidate < 'a' || candidate > 'z' {
+			if candidate < '0' || candidate > '9' {
+				if candidate != '_' {
+					return false
+				}
+			}
+		}
+	}
+	return true
+}
+
+func normalizeRateLimitReachedType(details *upstreamRateLimitReachedType) *string {
+	if details == nil {
+		return nil
+	}
+	value := strings.TrimSpace(details.Type)
+	switch value {
+	case "rate_limit_reached",
+		"workspace_owner_credits_depleted",
+		"workspace_member_credits_depleted",
+		"workspace_owner_usage_limit_reached",
+		"workspace_member_usage_limit_reached":
+		return &value
+	default:
+		return nil
+	}
+}
+
+func ensureJSONEOF(decoder *json.Decoder) error {
+	var extra any
+	if err := decoder.Decode(&extra); !errors.Is(err, io.EOF) {
+		if err == nil {
+			return errors.New("multiple JSON values")
+		}
+		return err
+	}
+	return nil
+}
+
+func (s *Server) getUpstreamConcurrency(c *gin.Context) {
+	c.Header("Cache-Control", "no-store")
+	if s == nil || s.handlers == nil || s.handlers.AuthManager == nil {
+		c.JSON(http.StatusServiceUnavailable, gin.H{"error": "account_registry_unavailable"})
+		return
+	}
+	c.JSON(http.StatusOK, s.handlers.AuthManager.GatewayConcurrency())
+}
