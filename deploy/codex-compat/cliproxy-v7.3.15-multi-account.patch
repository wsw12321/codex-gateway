+func newGatewayPolicyManager(t *testing.T, executor *gatewayPolicyExecutor, accountCount int) *Manager {
+	t.Helper()
+	manager := NewManager(nil, nil, nil)
+	manager.SetRetryConfig(0, 0, 2)
+	manager.RegisterExecutor(executor)
+	prefix := uuid.NewString()
+	for i := 0; i < accountCount; i++ {
+		candidate := &Auth{ID: prefix + "-" + string(rune('a'+i)), Provider: executor.id, Status: StatusActive}
+		registry.GetGlobalRegistry().RegisterClient(candidate.ID, candidate.Provider, []*registry.ModelInfo{{ID: "gateway-model"}})
+		t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(candidate.ID) })
+		if _, err := manager.Register(context.Background(), candidate); err != nil {
+			t.Fatalf("Register(%s): %v", candidate.ID, err)
+		}
+	}
+	return manager
+}
