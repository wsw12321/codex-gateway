+func persistedCodexRevisionAuth(t *testing.T, w *Watcher, name, refreshed string) *coreauth.Auth {
+	t.Helper()
+	path := filepath.Join(w.authDir, name)
+	payload := []byte(`{"type":"codex","account_id":"same-account","access_token":"synthetic","last_refresh":"` + refreshed + `"}`)
+	if errWrite := os.WriteFile(path, payload, 0o600); errWrite != nil {
+		t.Fatal(errWrite)
+	}
+	auths, errSynthesize := synthesizer.SynthesizeAuthFile(&synthesizer.SynthesisContext{
+		Config: w.config, AuthDir: w.authDir, Now: time.Now(), IDGenerator: synthesizer.NewStableIDGenerator(),
+	}, path, payload)
+	if errSynthesize != nil || len(auths) != 1 {
+		t.Fatalf("synthesize persisted credential: count=%d, error=%v", len(auths), errSynthesize)
+	}
+	return auths[0]
+}
+
+func TestGatewayPersistedCodexReconciliationReturnsCanonicalRevision(t *testing.T) {
+	for _, queued := range []bool{false, true} {
+		name := "without_queue"
+		if queued {
+			name = "with_queue"
+		}
+		t.Run(name, func(t *testing.T) {
+			dir := t.TempDir()
+			w := &Watcher{authDir: dir, config: &config.Config{AuthDir: dir}}
+			if queued {
+				w.authQueue = make(chan AuthUpdate, 10)
+			}
+			old := persistedCodexRevisionAuth(t, w, "old.json", "2026-08-20T10:00:00Z")
+			w.addOrUpdateClient(filepath.Join(dir, old.ID))
+			fresh := persistedCodexRevisionAuth(t, w, "fresh.json", "2026-08-21T10:00:00Z")
+			update := AuthUpdate{Action: AuthUpdateActionAdd, ID: fresh.ID, Auth: fresh}
+			ok, revision := w.dispatchPersistedAuthUpdateWithRevision(&update)
+			if ok != queued || revision == 0 || update.Revision() != revision || revision != w.authRevisions[fresh.ID] {
+				t.Fatalf("persisted revision: queued=%t, revision=%d, update=%d", ok, revision, update.Revision())
+			}
+			if len(w.currentAuths) != 1 || w.currentAuths[fresh.ID] == nil || update.Auth == nil || update.Auth.ID != fresh.ID {
+				t.Fatal("persisted update did not retain only the reconciled winner")
+			}
+			if queued {
+				if len(w.pendingOrder) != 2 || w.pendingOrder[0] != old.ID || w.pendingOrder[1] != fresh.ID {
+					t.Fatalf("replacement order = %v, want old deletion before fresh addition", w.pendingOrder)
+				}
+				if w.pendingUpdates[old.ID].Action != AuthUpdateActionDelete || w.pendingUpdates[fresh.ID].Revision() != revision {
+					t.Fatal("replacement lost its deletion or canonical revision")
+				}
+			}
+
+			loser := AuthUpdate{Action: AuthUpdateActionAdd, ID: old.ID, Auth: old}
+			_, deletedRevision := w.dispatchPersistedAuthUpdateWithRevision(&loser)
+			if loser.Action != AuthUpdateActionDelete || loser.Auth != nil || deletedRevision == 0 || loser.Revision() != deletedRevision {
+				t.Fatalf("duplicate post-persist update could re-register the loser: action=%s, revision=%d", loser.Action, deletedRevision)
+			}
+			if len(w.currentAuths) != 1 || w.currentAuths[fresh.ID] == nil {
+				t.Fatal("persisted loser changed the selected credential")
+			}
+		})
+	}
+}
+
+func TestGatewayPersistedCodexUnobservedDuplicateReceivesDeletionRevision(t *testing.T) {
+	dir := t.TempDir()
+	w := &Watcher{authDir: dir, config: &config.Config{AuthDir: dir}, authQueue: make(chan AuthUpdate, 10)}
+	old := persistedCodexRevisionAuth(t, w, "old.json", "2026-08-20T10:00:00Z")
+	fresh := persistedCodexRevisionAuth(t, w, "fresh.json", "2026-08-21T10:00:00Z")
+	w.refreshAuthState(false)
+	if w.authRevisions[old.ID] != 0 {
+		t.Fatal("duplicate must begin without an observed revision")
+	}
+	update := AuthUpdate{Action: AuthUpdateActionAdd, ID: old.ID, Auth: old}
+	_, revision := w.dispatchPersistedAuthUpdateWithRevision(&update)
+	if update.Action != AuthUpdateActionDelete || update.Auth != nil || revision == 0 || w.authRevisions[old.ID] != revision {
+		t.Fatal("unobserved duplicate lacks a deletion tombstone for synchronous registration")
+	}
+	if len(w.currentAuths) != 1 || w.currentAuths[fresh.ID] == nil {
+		t.Fatal("unobserved duplicate replaced the selected credential")
+	}
+}
+
+func TestGatewayPersistedCodexRevisionSurvivesStaleSnapshot(t *testing.T) {
+	dir := t.TempDir()
+	w := &Watcher{authDir: dir, config: &config.Config{AuthDir: dir}, authQueue: make(chan AuthUpdate, 10)}
+	old := persistedCodexRevisionAuth(t, w, "old.json", "2026-08-20T10:00:00Z")
+	w.addOrUpdateClient(filepath.Join(dir, old.ID))
+	originalSnapshot := snapshotCoreAuthsFunc
+	t.Cleanup(func() { snapshotCoreAuthsFunc = originalSnapshot })
+	updated := false
+	var fresh *coreauth.Auth
+	var persistedRevision uint64
+	snapshotCoreAuthsFunc = func(cfg *config.Config, authDir string, parser synthesizer.PluginAuthParser) []*coreauth.Auth {
+		auths := originalSnapshot(cfg, authDir, parser)
+		if !updated {
+			updated = true
+			fresh = persistedCodexRevisionAuth(t, w, "fresh.json", "2026-08-21T10:00:00Z")
+			update := AuthUpdate{Action: AuthUpdateActionAdd, ID: fresh.ID, Auth: fresh}
+			_, persistedRevision = w.dispatchPersistedAuthUpdateWithRevision(&update)
+		}
+		return auths
+	}
+	w.refreshAuthState(false)
+	if len(w.currentAuths) != 1 || w.currentAuths[fresh.ID] == nil || w.currentAuths[old.ID] != nil {
+		t.Fatal("stale snapshot resurrected the previous duplicate winner")
+	}
+	if persistedRevision == 0 || w.authRevisions[fresh.ID] != persistedRevision || w.pendingUpdates[old.ID].Action != AuthUpdateActionDelete {
+		t.Fatal("stale snapshot changed the newer persisted revision or lost the old winner deletion")
+	}
+}
