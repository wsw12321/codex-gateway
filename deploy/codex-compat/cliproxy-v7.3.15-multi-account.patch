+				}
+				_, _ = m.Execute(context.Background(), []string{"codex"}, request, opts)
+			} else {
+				result, _ := m.ExecuteStream(context.Background(), []string{"codex"}, request, cliproxyexecutor.Options{Stream: true})
+				if result != nil {
+					for range result.Chunks {
+					}
+				}
+			}
+			current, _ := m.GetByID(candidate.ID)
+			if GatewayAccountAvailable(current) {
