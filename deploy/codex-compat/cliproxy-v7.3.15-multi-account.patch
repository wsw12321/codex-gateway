+		upstreamStatus: status,
+		code:           normalizedCodexOAuthErrorCode(body),
+	}
+}
+
+func normalizedCodexOAuthErrorCode(body []byte) string {
+	if len(body) == 0 || len(body) > codexOAuthMaxBody {
+		return ""
+	}
+	var payload map[string]json.RawMessage
+	if err := json.Unmarshal(body, &payload); err != nil {
+		return ""
+	}
+	candidates := make([]string, 0, 5)
+	appendString := func(raw json.RawMessage) {
+		var value string
+		if len(raw) > 0 && json.Unmarshal(raw, &value) == nil {
+			candidates = append(candidates, strings.ToLower(strings.TrimSpace(value)))
+		}
+	}
+	appendString(payload["code"])
+	appendString(payload["error"])
+	if rawError := payload["error"]; len(rawError) > 0 && len(rawError) <= 4096 {
+		var nested map[string]json.RawMessage
+		if json.Unmarshal(rawError, &nested) == nil {
+			appendString(nested["code"])
+			appendString(nested["type"])
+			appendString(nested["error"])
+		}
+	}
+	for _, preferred := range []string{"refresh_token_reused", "invalid_grant", "invalid_client", "unauthorized_client", "access_denied"} {
+		for _, candidate := range candidates {
+			if candidate == preferred {
+				return preferred
+			}
+		}
+	}
+	return ""
+}
+
+func readCodexOAuthResponseBody(body io.Reader) ([]byte, error) {
+	data, err := io.ReadAll(io.LimitReader(body, codexOAuthMaxBody+1))
+	if err != nil {
+		return nil, err
+	}
+	if len(data) > codexOAuthMaxBody {
+		return nil, fmt.Errorf("Codex OAuth response exceeded %d bytes", codexOAuthMaxBody)
+	}
+	return data, nil
+}
