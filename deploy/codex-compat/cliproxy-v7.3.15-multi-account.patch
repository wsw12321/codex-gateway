@@ -0,0 +1,18 @@
+package cliproxy
+
+import (
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/config"
+	"testing"
+)
+
+func TestGatewayAllocationRoutingStrategy(t *testing.T) {
+	cfg := &config.Config{}
+	cfg.Routing.Strategy = "gateway-allocation"
+	state := normalizedRoutingRuntimeState(cfg)
+	selector, ok := newRoutingSelector(state).(*coreauth.GatewayAllocationSelector)
+	if !ok {
+		t.Fatal("Gateway allocation strategy fell back to local selection")
+	}
+	selector.Stop()
+}
