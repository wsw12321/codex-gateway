+// gatewayRetryEligible is the fail-closed credential switching
+// policy used by ordinary requests and stream bootstrap failures. Only
+// authentication/quota failures, explicit timeouts, transport failures, and
+// upstream server errors may replay the request on another credential.
+func gatewayRetryEligible(err error, ctx context.Context) bool {
+	if err == nil || isRequestTerminatedError(err) {
+		return false
+	}
+	if ctx != nil && ctx.Err() != nil {
+		return false
+	}
+	if errors.Is(err, context.Canceled) {
+		return false
+	}
+	status := statusCodeFromError(err)
+	// Codex marks an incomplete pre-payload stream as request-scoped, but its
+	// explicit 408 status is the transport timeout signal that permits trying a
+	// second credential. Cancellation checks above still take precedence.
+	if status == http.StatusRequestTimeout {
+		return true
+	}
+	if status != 0 && isRequestInvalidError(err) {
+		return false
+	}
+	switch status {
+	case http.StatusUnauthorized, http.StatusPaymentRequired, http.StatusForbidden,
+		http.StatusTooManyRequests:
+		return true
+	}
+	if status >= http.StatusInternalServerError {
+		return true
+	}
+	if status != 0 {
+		return false
+	}
+	var urlErr *url.Error
+	if errors.As(err, &urlErr) && urlErr != nil {
+		return !errors.Is(urlErr.Err, context.Canceled)
+	}
+	if errors.Is(err, context.DeadlineExceeded) {
+		return false
+	}
+	var networkErr net.Error
+	if errors.As(err, &networkErr) && networkErr != nil {
+		return true
+	}
+	if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+		return true
+	}
+	if isRequestInvalidError(err) {
+		return false
+	}
+	return false
+}
