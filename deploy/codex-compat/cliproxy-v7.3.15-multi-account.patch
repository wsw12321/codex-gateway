+		SourceFormat:   sdktranslator.FromString("openai-response"),
+		ResponseFormat: sdktranslator.FromString("openai-response"),
+		Headers: http.Header{
+			"X-Codex-Turn-Metadata":         {"options-header-canary"},
+			"Authorization":                 {"Bearer options-override-token"},
+			"Chatgpt-Account-Id":            {"options-override-account"},
+			"X-Codex-Gateway-Affinity":      {"options-internal-canary"},
+			"X-Codex-Upstream-Account":      {"options-internal-canary"},
+			"X-Codex-Conversation-Hash":     {"options-internal-hash"},
+			"Thread_id":                     {"options-thread"},
+			"X-Parent-Session-Id":           {"options-parent"},
+			"X-Parent-Task-Id":              {"options-task"},
+			"X-Side-Session-Id":             {"options-side"},
+			"X-Claude-Code-Parent-Agent-Id": {"options-agent"},
