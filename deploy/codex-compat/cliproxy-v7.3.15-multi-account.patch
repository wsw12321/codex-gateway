+func TestManagerCanonicalizesCodexOAuthIdentityBeforeRuntimeClone(t *testing.T) {
+	manager := NewManager(nil, nil, nil)
+	created, err := manager.Register(context.Background(), &Auth{
+		ID:       "new-device-login.json",
+		Provider: "codex",
+		Status:   StatusActive,
+		Storage: &codexOAuthIdentityStorage{
+			accountID: "device-account",
+			idToken:   codexAccountJWT(t, "device-account"),
+		},
+		Metadata: map[string]any{"email": "masked@example.com"},
+		Attributes: map[string]string{
+			AttributeSourceBackend: AuthSourceFile,
+		},
+	})
+	if err != nil || created == nil {
+		t.Fatalf("Register() = %#v, %v", created, err)
+	}
+	deviceIndex, attributable := CodexOAuthAccountIndex(created)
+	if !attributable || deviceIndex == "" || created.Metadata["account_id"] != "device-account" {
+		t.Fatalf("registered identity/index = %#v / %q, attributable=%t", created.Metadata, deviceIndex, attributable)
+	}
+	if created.AuthKind() != AuthKindOAuth {
+		t.Fatalf("registered auth kind = %q, want OAuth", created.AuthKind())
+	}
+
+	refreshed, err := manager.Register(context.Background(), &Auth{
+		ID:       "refresh.json",
+		Provider: "codex",
+		Status:   StatusActive,
+		Metadata: map[string]any{
+			"access_token": "old-token",
+			"account_id":   "old-account",
+			"id_token":     codexAccountJWT(t, "old-account"),
+		},
+		Attributes: map[string]string{AttributeSourceBackend: AuthSourceFile},
+	})
+	if err != nil || refreshed == nil {
+		t.Fatalf("Register(refresh) = %#v, %v", refreshed, err)
+	}
+	oldIndex, _ := CodexOAuthAccountIndex(refreshed)
+	refreshed.Metadata["access_token"] = "new-token"
+	refreshed.Metadata["account_id"] = "new-account"
+	refreshed.Metadata["id_token"] = codexAccountJWT(t, "new-account")
+	refreshed, err = manager.Update(context.Background(), refreshed)
+	if err != nil || refreshed == nil {
+		t.Fatalf("Update(refresh) = %#v, %v", refreshed, err)
+	}
+	newIndex, attributable := CodexOAuthAccountIndex(refreshed)
+	if !attributable || newIndex == "" || newIndex == oldIndex {
+		t.Fatalf("refreshed index = %q, old=%q, attributable=%t", newIndex, oldIndex, attributable)
+	}
+
+	refreshed.Metadata["account_id"] = "new-account"
+	refreshed.Metadata["id_token"] = codexAccountJWT(t, "conflicting-account")
+	conflicted, err := manager.Update(context.Background(), refreshed)
+	if err != nil || conflicted == nil {
+		t.Fatalf("Update(conflict) = %#v, %v", conflicted, err)
+	}
+	if !conflicted.Disabled || conflicted.Status != StatusDisabled {
+		t.Fatalf("conflicting identity remained routable: %#v", conflicted)
+	}
+	if index, ok := CodexOAuthAccountIndex(conflicted); ok || index != "" {
+		t.Fatalf("conflicting identity remained attributable: %q", index)
+	}
+}
+
+func codexAccountJWT(t *testing.T, accountID string) string {
+	t.Helper()
+	payload, err := json.Marshal(map[string]any{
+		"https://api.openai.com/auth": map[string]any{"chatgpt_account_id": accountID},
+	})
+	if err != nil {
+		t.Fatalf("marshal JWT claims: %v", err)
+	}
+	return "e30." + base64.RawURLEncoding.EncodeToString(payload) + ".signature"
+}
