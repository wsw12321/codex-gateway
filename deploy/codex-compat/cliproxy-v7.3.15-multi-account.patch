+	})
+	for _, session := range []string{"current", "other"} {
+		if _, err := s.Pick(context.Background(), "codex", "gateway-model", allocationOptions(session), auths); err != nil {
+			t.Fatal(err)
+		}
+	}
+	allowed = []string{b}
+	got, err := s.Pick(context.Background(), "codex", "gateway-model", allocationOptions("current"), auths)
+	if err != nil || got.ID != auths[1].ID {
+		t.Fatalf("revoked binding reused: %v %v", got, err)
+	}
+	allowed = []string{a, b}
+	got, err = s.Pick(context.Background(), "codex", "gateway-model", allocationOptions("other"), auths)
+	if err != nil || got.ID != auths[0].ID {
+		t.Fatalf("unrelated session invalidated: %v %v", got, err)
+	}
+	fail = true
+	if _, err := s.Pick(context.Background(), "codex", "gateway-model", allocationOptions("other"), auths); err == nil {
+		t.Fatal("bound request bypassed failed permission lookup")
+	}
+	if lookups < 5 {
+		t.Fatal("permissions were cached across requests")
+	}
+}
+
+func TestGatewayAllocationAccessRejectsIdentityAndForgedEligibility(t *testing.T) {
+	for _, identity := range []string{"", "invalid", "00000000-0000-0000-0000-00000000000X"} {
+		s, auths := allocationFixture(t)
+		s.client.Transport = gatewayAccessTransport(func(*http.Request) (*http.Response, error) {
+			t.Fatal("invalid identity reached callback")
+			return nil, nil
+		})
+		opts := allocationOptions("identity")
+		opts.Metadata[cliproxyexecutor.GatewayUserIDMetadataKey] = identity
+		_, err := s.Pick(context.Background(), "codex", "gateway-model", opts, auths)
+		assertAllocation503(t, err)
+	}
+	for _, body := range []string{`{"account_ids":["ffffffffffffffff"]}`, `{"account_ids":[]}`, `{"account_ids":null}`, `{"accounts":[]}`, `{"accounts":null}`, `{"accounts":[{"id":"ffffffffffffffff","concurrent_limit":1}]}`, `{"accounts":[{"id":"allocation-account-a","concurrent_limit":0}]}`, `{"accounts":[{"id":"allocation-account-a","concurrent_limit":1},{"id":"allocation-account-a","concurrent_limit":1}]}`} {
+		s, auths := allocationFixture(t)
+		s.client.Transport = gatewayAccessTransport(func(*http.Request) (*http.Response, error) { return allocationResponse(200, body), nil })
+		_, err := s.Pick(context.Background(), "codex", "gateway-model", allocationOptions("denied"), auths)
+		assertAllocation503(t, err)
+	}
+}
diff --git a/sdk/cliproxy/auth/gateway_concurrency.go b/sdk/cliproxy/auth/gateway_concurrency.go
new file mode 100644
index 0000000..4001dab
--- /dev/null
+++ b/sdk/cliproxy/auth/gateway_concurrency.go
@@ -0,0 +1,246 @@
+package auth
+
+import (
+	"context"
+	"encoding/hex"
+	"fmt"
+	"net/http"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+)
+
+type GatewayAccountConcurrency struct {
+	ID string `json:"id"`
+	// ActiveRequests keeps the Gateway-compatible field name; it counts active
+	// root conversations, not overlapping executions within one root.
+	ActiveRequests  int64 `json:"active_requests"`
+	ConcurrentLimit int64 `json:"concurrent_limit"`
+}
+
+type GatewayConcurrencySnapshot struct {
+	SampledAt time.Time                   `json:"sampled_at"`
+	Accounts  []GatewayAccountConcurrency `json:"accounts"`
+}
+
+// GatewayConcurrency samples active root conversations, including the wait for
+// the first response and streaming. A root may have multiple overlapping
+// executions; they share one account slot while references are held.
+func (m *Manager) GatewayConcurrency() GatewayConcurrencySnapshot {
+	known := make(map[string]bool)
+	for _, candidate := range m.List() {
+		if id, ok := gatewayConcurrencyAccountID(candidate); ok {
+			known[id] = true
+		}
+	}
+	m.gatewayConcurrencyMu.Lock()
+	defer m.gatewayConcurrencyMu.Unlock()
+	result := GatewayConcurrencySnapshot{SampledAt: time.Now().UTC(), Accounts: make([]GatewayAccountConcurrency, 0, len(known))}
+	for id, roots := range m.gatewayConcurrency {
+		known[id] = true
+		result.Accounts = append(result.Accounts, GatewayAccountConcurrency{ID: id, ActiveRequests: int64(len(roots)), ConcurrentLimit: m.gatewayConcurrencyLimit(id)})
+	}
+	for id := range known {
+		if _, present := m.gatewayConcurrency[id]; !present {
+			result.Accounts = append(result.Accounts, GatewayAccountConcurrency{ID: id, ConcurrentLimit: m.gatewayConcurrencyLimit(id)})
+		}
+	}
+	sort.Slice(result.Accounts, func(i, j int) bool { return result.Accounts[i].ID < result.Accounts[j].ID })
+	return result
+}
+
+func (m *Manager) gatewayConcurrencyLimit(id string) int64 {
+	selector, _ := m.Selector().(*GatewayAllocationSelector)
+	if selector == nil {
+		return 0
+	}
+	return selector.concurrencyLimit(id)
+}
+
+func gatewayConcurrencyExceeded() error {
+	return &Error{Code: "upstream_concurrency_exceeded", Message: "upstream account concurrency limit reached", Retryable: true, HTTPStatus: http.StatusTooManyRequests}
+}
+
+// gatewayExecutionRootKey returns a trusted root conversation identity produced
+// by sidecar metadata. A missing identity deliberately gets a unique key so
+// legacy requests retain request-level admission behavior.
+func gatewayExecutionRootKey(opts cliproxyexecutor.Options) string {
+	if opts.Metadata != nil {
+		if raw, ok := opts.Metadata[cliproxyexecutor.ConversationHashMetadataKey].(string); ok {
+			if hash := strings.TrimSpace(raw); validGatewayConversationHash(hash) {
+				return "root:" + hash
+			}
+		}
+	}
+	return ""
+}
+
+func validGatewayConversationHash(value string) bool {
+	if len(value) != len("conv-")+32 || !strings.HasPrefix(value, "conv-") {
+		return false
+	}
+	digits := value[len("conv-"):]
+	if strings.ToLower(digits) != digits {
+		return false
+	}
+	_, err := hex.DecodeString(digits)
+	return err == nil
+}
+
+func (m *Manager) tryBeginGatewayExecution(_ context.Context, candidate *Auth, executionOpts cliproxyexecutor.Options) (func(), error) {
+	id, ok := gatewayConcurrencyAccountID(candidate)
+	if !ok {
+		return func() {}, nil
+	}
+	rootKey := gatewayExecutionRootKey(executionOpts)
+	if rootKey == "" {
+		rootKey = fmt.Sprintf("execution:%d", atomic.AddUint64(&m.gatewayConcurrencySeq, 1))
+	}
+	m.gatewayConcurrencyMu.Lock()
+	if m.gatewayConcurrency == nil {
+		m.gatewayConcurrency = make(map[string]map[string]int64)
+	}
+	roots := m.gatewayConcurrency[id]
+	if roots == nil {
+		roots = make(map[string]int64)
+		m.gatewayConcurrency[id] = roots
+	}
+	if refs, present := roots[rootKey]; present {
+		roots[rootKey] = refs + 1
+		m.gatewayConcurrencyMu.Unlock()
+		return gatewayConcurrencyRelease(m, id, rootKey), nil
+	}
+	limit := m.gatewayConcurrencyLimit(id)
+	if limit > 0 && int64(len(roots)) >= limit {
+		m.gatewayConcurrencyMu.Unlock()
+		return nil, gatewayConcurrencyExceeded()
+	}
+	roots[rootKey] = 1
+	m.gatewayConcurrencyMu.Unlock()
+	return gatewayConcurrencyRelease(m, id, rootKey), nil
+}
+
+func gatewayConcurrencyRelease(m *Manager, accountID, rootKey string) func() {
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			m.gatewayConcurrencyMu.Lock()
+			defer m.gatewayConcurrencyMu.Unlock()
+			roots := m.gatewayConcurrency[accountID]
+			if roots == nil {
+				return
+			}
+			if refs := roots[rootKey]; refs > 1 {
+				roots[rootKey] = refs - 1
+			} else {
+				delete(roots, rootKey)
+				if len(roots) == 0 {
+					delete(m.gatewayConcurrency, accountID)
+				}
+			}
+		})
+	}
+}
+
+func (m *Manager) beginGatewayExecution(ctx context.Context, candidate *Auth, executionOpts cliproxyexecutor.Options) func() {
+	release, err := m.tryBeginGatewayExecution(ctx, candidate, executionOpts)
+	if err != nil || release == nil {
+		return func() {}
+	}
+	if ctx == nil {
+		return release
+	}
+	stop := context.AfterFunc(ctx, release)
+	return func() { stop(); release() }
+}
+
+func (m *Manager) executeGatewayAttempt(ctx context.Context, executor ProviderExecutor, candidate *Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options, countTokens bool) (cliproxyexecutor.Response, error) {
+	if pinned, _ := opts.Metadata[cliproxyexecutor.PinnedGatewayAccountIndexMetadataKey].(string); pinned != "" && gatewayAccountResultIndex(candidate) != pinned {
+		return cliproxyexecutor.Response{}, &Error{Code: "auth_not_found", Message: "pinned upstream account changed"}
+	}
+	release, err := m.tryBeginGatewayExecution(ctx, candidate, opts)
+	if err != nil {
+		return cliproxyexecutor.Response{}, err
+	}
+	defer release()
+	if countTokens {
+		return executor.CountTokens(ctx, candidate, req, opts)
+	}
+	return executor.Execute(ctx, candidate, req, opts)
+}
+
+func (m *Manager) executeGatewayStreamAttempt(ctx context.Context, executor ProviderExecutor, candidate *Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error) {
+	// Non-Codex providers keep their existing channel and cancellation semantics.
+	if _, ok := gatewayConcurrencyAccountID(candidate); !ok {
+		return executor.ExecuteStream(ctx, candidate, req, opts)
+	}
+	release, acquireErr := m.tryBeginGatewayExecution(ctx, candidate, opts)
+	if acquireErr != nil {
+		return nil, acquireErr
+	}
+	handedOff := false
+	defer func() {
+		if !handedOff {
+			release()
+		}
+	}()
+	result, err := executor.ExecuteStream(ctx, candidate, req, opts)
+	if err != nil || result == nil || result.Chunks == nil {
+		return result, err
+	}
+	out := make(chan cliproxyexecutor.StreamChunk)
+	source := result.Chunks
+	var done <-chan struct{}
+	if ctx != nil {
+		done = ctx.Done()
+	}
+	go func() {
+		defer release()
+		outputClosed := false
+		closeOutput := func() {
+			if !outputClosed {
+				close(out)
+				outputClosed = true
+			}
+		}
+		for {
+			select {
+			case <-done:
+				// The client request has ended. Close the client-facing stream
+				// immediately and release the admission slot exactly once. The
+				// provider receives the same cancelled context and is responsible
+				// for stopping its own source.
+				closeOutput()
+				return
+			case chunk, ok := <-source:
+				if !ok {
+					closeOutput()
+					return
+				}
+				select {
+				case out <- chunk:
+				case <-done:
+					closeOutput()
+					return
+				}
+			}
+		}
+	}()
+	handedOff = true
+	return &cliproxyexecutor.StreamResult{Headers: result.Headers, Chunks: out}, nil
+}
+
+// CodexOAuthAccountIndex initializes index fields. Counters must never mutate a
+// snapshot shared by concurrent calls; the shallow copy is sufficient because
+// identity validation only reads the credential maps.
+func gatewayConcurrencyAccountID(candidate *Auth) (string, bool) {
+	if candidate == nil {
+		return "", false
+	}
+	snapshot := *candidate
+	return CodexOAuthAccountIndex(&snapshot)
+}
diff --git a/sdk/cliproxy/auth/gateway_concurrency_limit_test.go b/sdk/cliproxy/auth/gateway_concurrency_limit_test.go
new file mode 100644
index 0000000..1dc7ad4
--- /dev/null
+++ b/sdk/cliproxy/auth/gateway_concurrency_limit_test.go
@@ -0,0 +1,337 @@
+package auth
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+)
+
+const gatewayTestUserID = "00000000-0000-0000-0000-000000000001"
+
+type gatewayLimitTransport func(*http.Request) (*http.Response, error)
+
+func (f gatewayLimitTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	return f(r)
+}
+
+func gatewayLimitResponse(status int, body string) *http.Response {
+	return &http.Response{
+		StatusCode: status,
+		Header:     make(http.Header),
+		Body:       io.NopCloser(strings.NewReader(body)),
+	}
+}
+
+// newGatewayConcurrencyLimitFixture registers real Codex accounts with a
+// GatewayAllocationSelector and primes the selector from the same eligibility
+// payload used by the sidecar. This makes the admission tests exercise the
+// production account identity and per-account limit map.
+func newGatewayConcurrencyLimitFixture(t *testing.T) (*Manager, *GatewayAllocationSelector, []*Auth, map[string]int64) {
+	t.Helper()
+	selector, prototypes := allocationFixture(t)
+	manager := NewManager(nil, selector, nil)
+	manager.SetRetryConfig(0, 0, 0)
+	accounts := make([]*Auth, 0, len(prototypes))
+	for _, prototype := range prototypes {
+		accountID, _ := prototype.Metadata["account_id"].(string)
+		account := gatewayRegisterAccount(t, manager, prototype.ID, accountID)
+		accounts = append(accounts, account)
+	}
+	limits := make(map[string]int64, len(accounts))
+	for _, account := range accounts {
+		limits[gatewayAccountResultIndex(account)] = 1
+	}
+	selector.client.Transport = gatewayLimitTransport(func(r *http.Request) (*http.Response, error) {
+		if r.URL.String() != gatewayEligibilityURL {
+			return gatewayLimitResponse(http.StatusInternalServerError, `{}`), nil
+		}
+		var request struct {
+			AccountIDs []string `json:"account_ids"`
+			UserID     string   `json:"user_id"`
+		}
+		if err := json.NewDecoder(r.Body).Decode(&request); err != nil || request.UserID != gatewayTestUserID {
+			return gatewayLimitResponse(http.StatusBadRequest, `{}`), nil
+		}
+		payload := make([]map[string]any, 0, len(request.AccountIDs))
+		for _, id := range request.AccountIDs {
+			limit, ok := limits[id]
+			if !ok {
+				return gatewayLimitResponse(http.StatusOK, `{"accounts":[]}`), nil
+			}
+			payload = append(payload, map[string]any{"id": id, "concurrent_limit": limit})
+		}
+		body, _ := json.Marshal(map[string]any{"accounts": payload})
+		return gatewayLimitResponse(http.StatusOK, string(body)), nil
+	})
+	primeGatewayConcurrencyLimits(t, selector, accounts)
+	return manager, selector, accounts, limits
+}
+
+func primeGatewayConcurrencyLimits(t *testing.T, selector *GatewayAllocationSelector, accounts []*Auth) {
+	t.Helper()
+	if _, err := selector.eligibleAccounts(context.Background(), gatewayTestUserID, accounts); err != nil {
+		t.Fatalf("prime eligibility: %v", err)
+	}
+}
+
+func assertGatewayConcurrency429(t *testing.T, err error) {
+	t.Helper()
+	var apiErr *Error
+	if !errors.As(err, &apiErr) {
+		t.Fatalf("error = %v, want typed 429", err)
+	}
+	if apiErr.Code != "upstream_concurrency_exceeded" || apiErr.HTTPStatus != http.StatusTooManyRequests {
+		t.Fatalf("error = %#v, want upstream_concurrency_exceeded/429", apiErr)
+	}
+}
+
+func gatewayConcurrencySnapshotCount(t *testing.T, manager *Manager, id string) int64 {
+	t.Helper()
+	for _, account := range manager.GatewayConcurrency().Accounts {
+		if account.ID == id {
+			return account.ActiveRequests
+		}
+	}
+	return 0
+}
+
+type blockingGatewayLimitExecutor struct {
+	id      string
+	started chan string
+	release chan struct{}
+	calls   atomic.Int64
+}
+
+func (e *blockingGatewayLimitExecutor) Identifier() string { return e.id }
+
+func (e *blockingGatewayLimitExecutor) Execute(ctx context.Context, auth *Auth, _ cliproxyexecutor.Request, _ cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	e.calls.Add(1)
+	e.started <- auth.ID
+	select {
+	case <-ctx.Done():
+		return cliproxyexecutor.Response{}, ctx.Err()
+	case <-e.release:
+		return cliproxyexecutor.Response{Payload: []byte("ok")}, nil
+	}
+}
+
+func (e *blockingGatewayLimitExecutor) ExecuteStream(context.Context, *Auth, cliproxyexecutor.Request, cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error) {
+	return nil, errors.New("stream not used")
+}
+func (*blockingGatewayLimitExecutor) Refresh(context.Context, *Auth) (*Auth, error) { return nil, nil }
+func (e *blockingGatewayLimitExecutor) CountTokens(ctx context.Context, auth *Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	return e.Execute(ctx, auth, req, opts)
+}
+func (*blockingGatewayLimitExecutor) HttpRequest(context.Context, *Auth, *http.Request) (*http.Response, error) {
+	return nil, nil
+}
+
+func TestGatewayConcurrencyLimitIsAtomicAndReturns429WithoutCooldown(t *testing.T) {
+	manager, selector, accounts, _ := newGatewayConcurrencyLimitFixture(t)
+	account := accounts[0]
+	executor := &blockingGatewayLimitExecutor{id: "codex", started: make(chan string, 2), release: make(chan struct{})}
+	manager.RegisterExecutor(executor)
+
+	firstDone := make(chan error, 1)
+	go func() {
+		_, err := manager.executeGatewayAttempt(context.Background(), executor, account, cliproxyexecutor.Request{}, cliproxyexecutor.Options{}, false)
+		firstDone <- err
+	}()
+	select {
+	case <-executor.started:
+	case <-time.After(2 * time.Second):
+		t.Fatal("first execution did not start")
+	}
+	if got := gatewayConcurrencySnapshotCount(t, manager, gatewayAccountResultIndex(account)); got != 1 {
+		t.Fatalf("active count = %d, want 1", got)
+	}
+	if got := selector.concurrencyLimit(gatewayAccountResultIndex(account)); got != 1 {
+		t.Fatalf("configured limit = %d, want 1", got)
+	}
+
+	if _, err := manager.executeGatewayAttempt(context.Background(), executor, account, cliproxyexecutor.Request{}, cliproxyexecutor.Options{}, false); err == nil {
+		t.Fatal("second execution bypassed the account cap")
+	} else {
+		assertGatewayConcurrency429(t, err)
+	}
+	if got := executor.calls.Load(); got != 1 {
+		t.Fatalf("executor calls = %d, want 1", got)
+	}
+	current, ok := manager.GetByID(account.ID)
+	if !ok || !GatewayAccountAvailable(current) || current.Unavailable || current.Quota.Exceeded {
+		t.Fatalf("local cap rejection poisoned credential state: %#v", current)
+	}
+
+	close(executor.release)
+	if err := <-firstDone; err != nil {
+		t.Fatalf("first execution: %v", err)
+	}
+	if got := gatewayConcurrencySnapshotCount(t, manager, gatewayAccountResultIndex(account)); got != 0 {
+		t.Fatalf("active count after release = %d, want 0", got)
+	}
+
+	// A concurrent admission race must still admit no more than the configured
+	// one request. Hold the winner until every contender has attempted admission
+	// so a fast release cannot make the test accidentally sequential.
+	start := make(chan struct{})
+	winners := make(chan func(), 64)
+	var wg sync.WaitGroup
+	for range 64 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			release, err := manager.tryBeginGatewayExecution(context.Background(), account, cliproxyexecutor.Options{})
+			if err == nil {
+				winners <- release
+			}
+		}()
+	}
+	close(start)
+	wg.Wait()
+	if got := len(winners); got != 1 {
+		t.Fatalf("concurrent admissions = %d, want exactly one", got)
+	}
+	(<-winners)()
+}
+
+func TestGatewayConcurrencyLimitUsesFreeAccountAndRejectsWhenAllAreFull(t *testing.T) {
+	manager, selector, accounts, limits := newGatewayConcurrencyLimitFixture(t)
+	first, second := accounts[0], accounts[1]
+	firstIndex, secondIndex := gatewayAccountResultIndex(first), gatewayAccountResultIndex(second)
+	limits[firstIndex] = 1
+	limits[secondIndex] = 1
+	primeGatewayConcurrencyLimits(t, selector, accounts)
+
+	firstRelease, err := manager.tryBeginGatewayExecution(context.Background(), first, cliproxyexecutor.Options{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	secondRelease, err := manager.tryBeginGatewayExecution(context.Background(), second, cliproxyexecutor.Options{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := gatewayConcurrencySnapshotCount(t, manager, firstIndex); got != 1 {
+		t.Fatalf("first account count = %d, want 1", got)
+	}
+	if got := gatewayConcurrencySnapshotCount(t, manager, secondIndex); got != 1 {
+		t.Fatalf("second account count = %d, want 1", got)
+	}
+	if _, err := manager.tryBeginGatewayExecution(context.Background(), first, cliproxyexecutor.Options{}); err == nil {
+		t.Fatal("bound account admitted a second request")
+	} else {
+		assertGatewayConcurrency429(t, err)
+	}
+	firstRelease()
+	secondRelease()
+	if got := gatewayConcurrencySnapshotCount(t, manager, firstIndex) + gatewayConcurrencySnapshotCount(t, manager, secondIndex); got != 0 {
+		t.Fatalf("active count after releasing both accounts = %d", got)
+	}
+}
+
+type streamGatewayLimitExecutor struct {
+	id      string
+	started chan string
+	chunks  chan cliproxyexecutor.StreamChunk
+}
+
+func (e *streamGatewayLimitExecutor) Identifier() string { return e.id }
+func (e *streamGatewayLimitExecutor) Execute(context.Context, *Auth, cliproxyexecutor.Request, cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	return cliproxyexecutor.Response{}, errors.New("ordinary execution not used")
+}
+func (e *streamGatewayLimitExecutor) ExecuteStream(_ context.Context, auth *Auth, _ cliproxyexecutor.Request, _ cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error) {
+	e.started <- auth.ID
+	return &cliproxyexecutor.StreamResult{Chunks: e.chunks}, nil
+}
+func (*streamGatewayLimitExecutor) Refresh(context.Context, *Auth) (*Auth, error) { return nil, nil }
+func (*streamGatewayLimitExecutor) CountTokens(context.Context, *Auth, cliproxyexecutor.Request, cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	return cliproxyexecutor.Response{}, errors.New("count tokens not used")
+}
+func (*streamGatewayLimitExecutor) HttpRequest(context.Context, *Auth, *http.Request) (*http.Response, error) {
+	return nil, nil
+}
+
+func TestGatewayConcurrencyLimitCoversBoundStreamingUntilStreamTerminates(t *testing.T) {
+	manager, _, accounts, _ := newGatewayConcurrencyLimitFixture(t)
+	account := accounts[0]
+	executor := &streamGatewayLimitExecutor{id: "codex", started: make(chan string, 2), chunks: make(chan cliproxyexecutor.StreamChunk, 1)}
+	first, err := manager.executeGatewayStreamAttempt(context.Background(), executor, account, cliproxyexecutor.Request{}, cliproxyexecutor.Options{})
+	if err != nil {
+		t.Fatalf("first stream: %v", err)
+	}
+	<-executor.started
+	if first == nil || first.Chunks == nil {
+		t.Fatal("first stream has no chunk source")
+	}
+	if _, err := manager.executeGatewayStreamAttempt(context.Background(), executor, account, cliproxyexecutor.Request{}, cliproxyexecutor.Options{}); err == nil {
+		t.Fatal("second bound stream bypassed the cap")
+	} else {
+		assertGatewayConcurrency429(t, err)
+	}
+	if got := gatewayConcurrencySnapshotCount(t, manager, gatewayAccountResultIndex(account)); got != 1 {
+		t.Fatalf("active stream count = %d, want 1", got)
+	}
+
+	executor.chunks <- cliproxyexecutor.StreamChunk{Payload: []byte("one")}
+	if chunk, ok := <-first.Chunks; !ok || string(chunk.Payload) != "one" {
+		t.Fatalf("first stream chunk = %#v, open = %t", chunk, ok)
+	}
+	close(executor.chunks)
+	for range first.Chunks {
+	}
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) && gatewayConcurrencySnapshotCount(t, manager, gatewayAccountResultIndex(account)) != 0 {
+		time.Sleep(time.Millisecond)
+	}
+	if got := gatewayConcurrencySnapshotCount(t, manager, gatewayAccountResultIndex(account)); got != 0 {
+		t.Fatalf("active stream count after termination = %d, want 0", got)
+	}
+}
+
+func TestGatewayConcurrencyLimitAllAccountsFullReturns429FromAllocator(t *testing.T) {
+	manager, selector, accounts, limits := newGatewayConcurrencyLimitFixture(t)
+	firstRelease, err := manager.tryBeginGatewayExecution(context.Background(), accounts[0], cliproxyexecutor.Options{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	secondRelease, err := manager.tryBeginGatewayExecution(context.Background(), accounts[1], cliproxyexecutor.Options{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer firstRelease()
+	defer secondRelease()
+
+	selector.client.Transport = gatewayLimitTransport(func(r *http.Request) (*http.Response, error) {
+		var request struct {
+			AccountIDs []string `json:"account_ids"`
+			UserID     string   `json:"user_id"`
+		}
+		if err := json.NewDecoder(r.Body).Decode(&request); err != nil || request.UserID != gatewayTestUserID {
+			return gatewayLimitResponse(http.StatusBadRequest, `{}`), nil
+		}
+		if r.URL.String() == gatewayAllocationURL {
+			return gatewayLimitResponse(http.StatusTooManyRequests, `{"error":"upstream_concurrency_exceeded"}`), nil
+		}
+		if r.URL.String() != gatewayEligibilityURL {
+			return gatewayLimitResponse(http.StatusNotFound, `{}`), nil
+		}
+		payload := make([]map[string]any, 0, len(request.AccountIDs))
+		for _, id := range request.AccountIDs {
+			payload = append(payload, map[string]any{"id": id, "concurrent_limit": limits[id]})
+		}
+		body, _ := json.Marshal(map[string]any{"accounts": payload})
+		return gatewayLimitResponse(http.StatusOK, string(body)), nil
+	})
+	primeGatewayConcurrencyLimits(t, selector, accounts)
+	_, err = selector.Pick(context.Background(), "codex", "gateway-model", allocationOptions("all-full"), accounts)
+	assertGatewayConcurrency429(t, err)
+}
