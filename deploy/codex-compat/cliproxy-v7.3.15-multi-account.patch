diff --git a/internal/api/codex_gateway_probe.go b/internal/api/codex_gateway_probe.go
new file mode 100644
index 0000000..eed6e7e
--- /dev/null
+++ b/internal/api/codex_gateway_probe.go
@@ -0,0 +1,298 @@
+package api
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"sort"
+	"strings"
+	"time"
+	"unicode/utf8"
+
+	"github.com/gin-gonic/gin"
+	"github.com/google/uuid"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/api/handlers"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+)
+
+const (
+	probeRequestMaxBytes  = 36 << 10
+	probeInputMaxBytes    = 32 << 10
+	probeResponseMaxBytes = 512 << 10
+	// A UTF-8 output cannot contain more tokens than bytes. Codex removes
+	// max_output_tokens before sending to its upstream, so reject oversized
+	// completed answers locally as a fail-closed bound.
+	probeOutputMaxBytes  = 16 << 10
+	probeTimeout         = 180 * time.Second
+	probeMaxOutputTokens = 16384
+)
+
+type accountProbeRequest struct {
+	Model           string
+	Input           string
+	MaxOutputTokens int
+}
+
+type probeContentPart struct {
+	Type string `json:"type"`
+	Text string `json:"text"`
+}
+
+type probeInputMessage struct {
+	Role    string             `json:"role"`
+	Content []probeContentPart `json:"content"`
+}
+
+type probeResponsesRequest struct {
+	Model           string              `json:"model"`
+	Input           []probeInputMessage `json:"input"`
+	Stream          bool                `json:"stream"`
+	Tools           []any               `json:"tools"`
+	ToolChoice      string              `json:"tool_choice"`
+	MaxOutputTokens int                 `json:"max_output_tokens"`
+}
+
+func (s *Server) probeAccount(c *gin.Context) (*auth.Auth, string, bool) {
+	c.Header("Cache-Control", "no-store")
+	if s == nil || s.handlers == nil || s.handlers.AuthManager == nil {
+		c.JSON(http.StatusServiceUnavailable, gin.H{"error": "account_registry_unavailable"})
+		return nil, "", false
+	}
+	id := c.Param("id")
+	if !validGatewayAccountIndex(id) {
+		c.JSON(http.StatusNotFound, gin.H{"error": "upstream_account_not_found"})
+		return nil, "", false
+	}
+	if c.Request.URL.RawQuery != "" {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "probe_request_invalid"})
+		return nil, "", false
+	}
+	account := findCodexOAuthAccount(s.handlers.AuthManager.List(), id)
+	if account == nil {
+		c.JSON(http.StatusNotFound, gin.H{"error": "upstream_account_not_found"})
+		return nil, "", false
+	}
+	_, _, _, status := upstreamAccountStatuses(s.handlers.AuthManager, account)
+	if status != "available" {
+		c.JSON(http.StatusConflict, gin.H{"error": "upstream_account_unavailable"})
+		return nil, "", false
+	}
+	return account, id, true
+}
+
+func (s *Server) getUpstreamAccountModels(c *gin.Context) {
+	account, id, ok := s.probeAccount(c)
+	if !ok {
+		return
+	}
+	models := accountProbeModels(account)
+	c.JSON(http.StatusOK, gin.H{"account_id": id, "models": models})
+}
+
+func accountProbeModels(account *auth.Auth) []string {
+	models := make([]string, 0)
+	if account == nil {
+		return models
+	}
+	seen := make(map[string]struct{})
+	for _, info := range registry.GetGlobalRegistry().GetModelsForClient(account.ID) {
+		if info == nil || !validProbeModel(info.ID) {
+			continue
+		}
+		if _, exists := seen[info.ID]; exists {
+			continue
+		}
+		seen[info.ID] = struct{}{}
+		models = append(models, info.ID)
+	}
+	sort.Strings(models)
+	return models
+}
+
+func validProbeModel(model string) bool {
+	if model == "" || len(model) > 128 {
+		return false
+	}
+	for _, ch := range model {
+		if ch >= 'a' && ch <= 'z' || ch >= 'A' && ch <= 'Z' || ch >= '0' && ch <= '9' ||
+			ch == '-' || ch == '_' || ch == '.' || ch == '/' || ch == ':' {
+			continue
+		}
+		return false
+	}
+	return true
+}
+
+func (s *Server) probeUpstreamAccount(c *gin.Context) {
+	account, id, ok := s.probeAccount(c)
+	if !ok {
+		return
+	}
+	request, err := decodeAccountProbeRequest(c.Request.Body)
+	if err != nil {
+		if errors.Is(err, errQuotaRPCRequestTooLarge) {
+			c.JSON(http.StatusRequestEntityTooLarge, gin.H{"error": "probe_request_too_large"})
+		} else {
+			c.JSON(http.StatusBadRequest, gin.H{"error": "probe_request_invalid"})
+		}
+		return
+	}
+	available := false
+	for _, model := range accountProbeModels(account) {
+		if model == request.Model {
+			available = true
+			break
+		}
+	}
+	if !available {
+		c.JSON(http.StatusConflict, gin.H{"error": "probe_model_unavailable"})
+		return
+	}
+	payload, err := json.Marshal(probeResponsesRequest{
+		Model:  request.Model,
+		Input:  []probeInputMessage{{Role: "user", Content: []probeContentPart{{Type: "input_text", Text: request.Input}}}},
+		Stream: false, Tools: []any{}, ToolChoice: "none", MaxOutputTokens: request.MaxOutputTokens,
+	})
+	if err != nil {
+		c.JSON(http.StatusServiceUnavailable, gin.H{"error": "probe_unavailable"})
+		return
+	}
+	ctx, cancel := context.WithTimeout(c.Request.Context(), probeTimeout)
+	defer cancel()
+	selectedAuthID := ""
+	ctx = handlers.WithSelectedAuthIDCallback(ctx, func(authID string) { selectedAuthID = authID })
+	headers := make(http.Header)
+	headers.Set("X-OpenAI-Internal-Codex-Responses-Lite", "true")
+	headers.Set("Session-Id", uuid.NewString())
+	response, executeErr := s.handlers.ExecuteModel(ctx, handlers.ModelExecutionRequest{
+		EntryProtocol: "openai-response", ExitProtocol: "openai-response",
+		Model: request.Model, Body: payload, Headers: headers,
+		ForcedProvider: "codex", AuthID: account.ID,
+		PinnedGatewayAccountIndex: id, FirstAttemptOnly: true,
+	})
+	if errors.Is(ctx.Err(), context.DeadlineExceeded) {
+		c.JSON(http.StatusGatewayTimeout, gin.H{"error": "probe_timeout"})
+		return
+	}
+	if selectedAuthID != "" && selectedAuthID != account.ID {
+		c.JSON(http.StatusBadGateway, gin.H{"error": "probe_account_mismatch"})
+		return
+	}
+	if executeErr != nil {
+		c.JSON(http.StatusBadGateway, gin.H{"error": "probe_execution_failed"})
+		return
+	}
+	if selectedAuthID == "" {
+		c.JSON(http.StatusBadGateway, gin.H{"error": "probe_account_mismatch"})
+		return
+	}
+	text, err := extractProbeOutputText(response.Body)
+	if err != nil {
+		c.JSON(http.StatusBadGateway, gin.H{"error": "probe_invalid_response"})
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"account_id": id, "output_text": text})
+}
+
+func decodeAccountProbeRequest(body io.Reader) (accountProbeRequest, error) {
+	data, err := io.ReadAll(io.LimitReader(body, probeRequestMaxBytes+1))
+	if err != nil {
+		return accountProbeRequest{}, err
+	}
+	if len(data) > probeRequestMaxBytes {
+		return accountProbeRequest{}, errQuotaRPCRequestTooLarge
+	}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	start, err := decoder.Token()
+	if err != nil || start != json.Delim('{') {
+		return accountProbeRequest{}, errors.New("probe request object required")
+	}
+	var request accountProbeRequest
+	var fields int
+	for decoder.More() {
+		key, err := decoder.Token()
+		if err != nil {
+			return accountProbeRequest{}, err
+		}
+		switch key {
+		case "model":
+			if fields&1 != 0 {
+				return accountProbeRequest{}, errors.New("duplicate model")
+			}
+			fields |= 1
+			err = decoder.Decode(&request.Model)
+		case "input":
+			if fields&2 != 0 {
+				return accountProbeRequest{}, errors.New("duplicate input")
+			}
+			fields |= 2
+			err = decoder.Decode(&request.Input)
+		case "max_output_tokens":
+			if fields&4 != 0 {
+				return accountProbeRequest{}, errors.New("duplicate max output tokens")
+			}
+			fields |= 4
+			err = decoder.Decode(&request.MaxOutputTokens)
+		default:
+			return accountProbeRequest{}, errors.New("unknown probe field")
+		}
+		if err != nil {
+			return accountProbeRequest{}, err
+		}
+	}
+	end, err := decoder.Token()
+	if err != nil || end != json.Delim('}') || ensureJSONEOF(decoder) != nil ||
+		fields != 7 || !validProbeModel(request.Model) || request.Input == "" ||
+		len(request.Input) > probeInputMaxBytes || !utf8.ValidString(request.Input) ||
+		strings.ContainsRune(request.Input, 0) || request.MaxOutputTokens < 1 || request.MaxOutputTokens > probeMaxOutputTokens {
+		return accountProbeRequest{}, errors.New("invalid probe request")
+	}
+	return request, nil
+}
+
+func extractProbeOutputText(body []byte) (string, error) {
+	if len(body) == 0 || len(body) > probeResponseMaxBytes {
+		return "", errors.New("invalid probe response size")
+	}
+	var response struct {
+		Status string `json:"status"`
+		Usage  struct {
+			OutputTokens *int64 `json:"output_tokens"`
+		} `json:"usage"`
+		Output []struct {
+			Type    string `json:"type"`
+			Role    string `json:"role"`
+			Content []struct {
+				Type string `json:"type"`
+				Text string `json:"text"`
+			} `json:"content"`
+		} `json:"output"`
+	}
+	if err := json.Unmarshal(body, &response); err != nil || response.Status != "completed" ||
+		response.Usage.OutputTokens == nil || *response.Usage.OutputTokens < 0 || *response.Usage.OutputTokens > probeMaxOutputTokens {
+		return "", errors.New("probe did not complete")
+	}
+	var result strings.Builder
+	for _, item := range response.Output {
+		if item.Type == "reasoning" {
+			continue
+		}
+		if item.Type != "message" || item.Role != "assistant" {
+			return "", errors.New("unexpected probe output item")
+		}
+		for _, part := range item.Content {
+			if part.Type != "output_text" || !utf8.ValidString(part.Text) {
+				return "", errors.New("unexpected probe output part")
+			}
+			result.WriteString(part.Text)
+		}
+	}
+	if result.Len() == 0 || result.Len() > probeOutputMaxBytes || strings.TrimSpace(result.String()) == "" {
+		return "", errors.New("empty probe output")
+	}
+	return result.String(), nil
+}
