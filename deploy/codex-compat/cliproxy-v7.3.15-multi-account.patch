+func TestApplyRequestAfterAuthInterceptorPreservesCallerScope(t *testing.T) {
+	for _, mode := range []string{"headers", "body", "clear"} {
+		t.Run(mode, func(t *testing.T) {
+			opts := cliproxyexecutor.Options{
+				Headers:  http.Header{"X-Session-ID": {"old-session"}},
+				Metadata: map[string]any{cliproxyexecutor.CallerScopeMetadataKey: "caller-a"},
+				RequestAfterAuthInterceptor: func(context.Context, cliproxyexecutor.RequestAfterAuthInterceptRequest) cliproxyexecutor.RequestAfterAuthInterceptResponse {
+					switch mode {
+					case "headers":
+						return cliproxyexecutor.RequestAfterAuthInterceptResponse{Headers: http.Header{"Session-Id": {"child"}, "X-Codex-Parent-Thread-Id": {"parent"}}}
+					case "body":
+						return cliproxyexecutor.RequestAfterAuthInterceptResponse{ClearHeaders: []string{"X-Session-ID"}, Body: []byte(`{"session_id":"child","parent_session_id":"parent"}`)}
+					default:
+						return cliproxyexecutor.RequestAfterAuthInterceptResponse{ClearHeaders: []string{"X-Session-ID"}}
+					}
+				},
+			}
+			_, result, err := applyRequestAfterAuthInterceptor(context.Background(), nil, "codex", cliproxyexecutor.Request{}, opts, "gateway-model")
+			if err != nil {
+				t.Fatal(err)
+			}
+			if mode == "clear" {
+				if result.Metadata[cliproxyexecutor.CanonicalSessionIDMetadataKey] != nil {
+					t.Fatal("cleared session retained a canonical identity")
+				}
+				return
+			}
+			prefix := "caller:caller-a:codex:"
+			if mode == "body" {
+				prefix = "caller:caller-a:session:"
+			}
+			if result.Metadata[cliproxyexecutor.CanonicalSessionIDMetadataKey] != prefix+"child" || result.Metadata[cliproxyexecutor.ParentSessionIDMetadataKey] != prefix+"parent" {
+				t.Fatalf("interceptor lost caller isolation: %#v", result.Metadata)
+			}
+		})
+	}
