+func TestCodexGatewayQuotaSignal(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		status    int
+		body      string
+		exhausted bool
+	}{
+		{"quota", 429, `{"error":{"type":"usage_limit_reached","resets_in_seconds":1}}`, true},
+		{"quota bad request", 400, `{"error":{"type":"usage_limit_reached"}}`, true},
+		{"ordinary 429", 429, `{"error":{"type":"rate_limit_error"}}`, false},
+		{"message only", 429, `{"error":{"message":"usage_limit_reached"}}`, false},
+		{"capacity", 400, `{"error":{"message":"Selected model is at capacity"}}`, false},
+		{"unauthorized", 401, `{"error":{"type":"usage_limit_reached"}}`, false},
+		{"forbidden", 403, `{"error":{"type":"usage_limit_reached"}}`, false},
+		{"malformed", 429, `{"error":{"type":"usage_limit_reached"`, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got := newCodexStatusErr(tc.status, []byte(tc.body))
+			if got.QuotaExhausted() != tc.exhausted {
+				t.Fatalf("quota=%v want=%v", got.QuotaExhausted(), tc.exhausted)
+			}
+			if tc.status == 401 || tc.status == 403 {
+				if got.StatusCode() != tc.status {
+					t.Fatal("authentication status reclassified")
+				}
+			}
+		})
+	}
+}
