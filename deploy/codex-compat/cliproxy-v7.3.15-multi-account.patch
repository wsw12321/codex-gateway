+func TestGatewayQuotaSignalSurvivesErrorSnapshots(t *testing.T) {
+	upstream := &Error{Code: "usage_limit_reached", HTTPStatus: http.StatusTooManyRequests, QuotaExhausted: true}
+	for _, snapshot := range []*Error{
+		cloneError(upstream),
+		resultErrorFromError(upstream),
+		(&ModelState{LastError: upstream}).Clone().LastError,
+	} {
+		if snapshot == upstream || !snapshot.QuotaExhausted {
+			t.Fatal("error snapshot lost the explicit quota exhaustion signal")
+		}
+	}
+	m, candidate, _ := newGatewayAccountTestManager(t)
+	m.MarkResult(context.Background(), gatewayResult(candidate, resultErrorFromError(upstream)))
+	saved, ok := m.GetByID(candidate.ID)
+	if !ok || GatewayAccountAvailable(saved) {
+		t.Fatal("structured auth error did not lock the exhausted account")
