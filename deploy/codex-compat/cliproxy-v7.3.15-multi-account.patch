+func TestGatewayRetryEligible(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name string
+		err  error
+		want bool
+	}{
+		{name: "unauthorized", err: &Error{HTTPStatus: http.StatusUnauthorized}, want: true},
+		{name: "quota", err: &Error{HTTPStatus: http.StatusPaymentRequired}, want: true},
+		{name: "forbidden", err: &Error{HTTPStatus: http.StatusForbidden}, want: true},
+		{name: "request timeout", err: &Error{HTTPStatus: http.StatusRequestTimeout}, want: true},
+		{name: "rate limited", err: &Error{HTTPStatus: http.StatusTooManyRequests}, want: true},
+		{name: "server error", err: &Error{HTTPStatus: http.StatusBadGateway}, want: true},
+		{name: "network error", err: &url.Error{Op: "Post", URL: "https://example.invalid", Err: errors.New("connection reset")}, want: true},
+		{name: "network timeout", err: &url.Error{Op: "Post", URL: "https://example.invalid", Err: context.DeadlineExceeded}, want: true},
+		{name: "unexpected eof", err: io.ErrUnexpectedEOF, want: true},
+		{name: "request scoped timeout", err: &requestScopedStatusError{status: http.StatusRequestTimeout, message: "stream disconnected before completion"}, want: true},
+		{name: "untrusted invalid grant text", err: &Error{HTTPStatus: http.StatusBadRequest, Message: "invalid_grant"}, want: false},
+		{name: "unauthorized invalid grant", err: &Error{HTTPStatus: http.StatusUnauthorized, Message: "invalid_grant"}, want: true},
+		{name: "statusless typed retryable", err: &Error{Retryable: true}, want: false},
+		{name: "redirect", err: &Error{HTTPStatus: http.StatusTemporaryRedirect}, want: false},
+		{name: "bad request", err: &Error{HTTPStatus: http.StatusBadRequest}, want: false},
+		{name: "not found", err: &Error{HTTPStatus: http.StatusNotFound}, want: false},
+		{name: "conflict", err: &Error{HTTPStatus: http.StatusConflict}, want: false},
+		{name: "client canceled", err: context.Canceled, want: false},
+		{name: "client deadline", err: context.DeadlineExceeded, want: false},
+		{name: "unclassified", err: errors.New("unknown failure"), want: false},
+	}
+
+	for _, test := range tests {
