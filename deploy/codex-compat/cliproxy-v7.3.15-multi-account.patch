@@ -0,0 +1,43 @@
+package api
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+)
+
+func TestInternalUpstreamConcurrencyRequiresBearerAndReturnsOnlyCounters(t *testing.T) {
+	server := newTestServer(t)
+	registered := registerQuotaTestAccount(t, server, &quotaCaptureExecutor{})
+	for _, token := range []string{"", "wrong", "test-key"} {
+		request := httptest.NewRequest(http.MethodGet, "/internal/upstream-accounts/concurrency", nil)
+		if token != "" {
+			request.Header.Set("Authorization", "Bearer "+token)
+		}
+		recorder := httptest.NewRecorder()
+		server.engine.ServeHTTP(recorder, request)
+		if token != "test-key" {
+			if recorder.Code != http.StatusUnauthorized {
+				t.Fatalf("unauthorized status %d", recorder.Code)
+			}
+			continue
+		}
+		if recorder.Code != http.StatusOK || recorder.Header().Get("Cache-Control") != "no-store" {
+			t.Fatalf("status %d body %s", recorder.Code, recorder.Body.String())
+		}
+		var snapshot auth.GatewayConcurrencySnapshot
+		if err := json.Unmarshal(recorder.Body.Bytes(), &snapshot); err != nil {
+			t.Fatal(err)
+		}
+		if snapshot.SampledAt.IsZero() || len(snapshot.Accounts) != 1 || snapshot.Accounts[0].ID != registered.EnsureIndex() || snapshot.Accounts[0].ActiveRequests != 0 {
+			t.Fatalf("snapshot %+v", snapshot)
+		}
+		if strings.Contains(recorder.Body.String(), "email") || strings.Contains(recorder.Body.String(), "token") {
+			t.Fatalf("identity leak: %s", recorder.Body.String())
+		}
+	}
+}
