+		{name: "network error", err: &url.Error{Op: "Post", URL: "https://example.invalid", Err: errors.New("connection reset")}, want: true},
+		{name: "network timeout", err: &url.Error{Op: "Post", URL: "https://example.invalid", Err: context.DeadlineExceeded}, want: true},
+		{name: "unexpected eof", err: io.ErrUnexpectedEOF, want: true},
+		{name: "request scoped timeout", err: &requestScopedStatusError{status: http.StatusRequestTimeout, message: "stream disconnected before completion"}, want: true},
+		{name: "untrusted invalid grant text", err: &Error{HTTPStatus: http.StatusBadRequest, Message: "invalid_grant"}, want: false},
+		{name: "unauthorized invalid grant", err: &Error{HTTPStatus: http.StatusUnauthorized, Message: "invalid_grant"}, want: true},
+		{name: "statusless typed retryable", err: &Error{Retryable: true}, want: false},
