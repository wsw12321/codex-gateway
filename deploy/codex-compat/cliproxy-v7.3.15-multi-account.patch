+			body:         `{"error":"invalid_grant","error_description":"secret-refresh-token must not leak"}`,
+			wantStatus:   http.StatusUnauthorized,
+			nonRetryable: true,
+		},
+		{
+			name:         "nested reused token",
+			status:       http.StatusBadRequest,
+			body:         `{"error":{"type":"invalid_grant","code":"refresh_token_reused","message":"secret-body"}}`,
+			wantStatus:   http.StatusUnauthorized,
+			nonRetryable: true,
+		},
+		{
+			name:       "untrusted text is not classified",
+			status:     http.StatusBadRequest,
+			body:       `invalid_grant secret-body`,
+			wantStatus: http.StatusBadRequest,
+		},
+		{
+			name:       "server failure",
+			status:     http.StatusBadGateway,
+			body:       `{"error":"server_error","detail":"secret-body"}`,
