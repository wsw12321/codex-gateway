diff --git a/internal/api/codex_gateway_status.go b/internal/api/codex_gateway_status.go
new file mode 100644
index 0000000..1249e91
--- /dev/null
+++ b/internal/api/codex_gateway_status.go
@@ -0,0 +1,97 @@
+package api
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+)
+
+var errAccountStatusRequestInvalid = errors.New("account status request invalid")
+
+func (s *Server) setUpstreamAccountStatus(c *gin.Context) {
+	c.Header("Cache-Control", "no-store")
+	if s == nil || s.handlers == nil || s.handlers.AuthManager == nil {
+		c.JSON(http.StatusServiceUnavailable, gin.H{"error": "account_registry_unavailable"})
+		return
+	}
+	id := c.Param("id")
+	if !validGatewayAccountIndex(id) {
+		c.JSON(http.StatusNotFound, gin.H{"error": "upstream_account_not_found"})
+		return
+	}
+	if c.Request.URL.RawQuery != "" {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "account_status_request_invalid"})
+		return
+	}
+	enabled, err := decodeAccountStatusRequest(c.Request.Body)
+	if err != nil {
+		if errors.Is(err, errQuotaRPCRequestTooLarge) {
+			c.JSON(http.StatusRequestEntityTooLarge, gin.H{"error": "account_status_request_too_large"})
+		} else {
+			c.JSON(http.StatusBadRequest, gin.H{"error": "account_status_request_invalid"})
+		}
+		return
+	}
+	_, err = s.handlers.AuthManager.SetGatewayAccountEnabled(id, enabled)
+	if err != nil {
+		switch {
+		case errors.Is(err, auth.ErrGatewayAccountNotFound):
+			c.JSON(http.StatusNotFound, gin.H{"error": "upstream_account_not_found"})
+		case errors.Is(err, auth.ErrGatewayAccountIdentityInvalid):
+			c.JSON(http.StatusConflict, gin.H{"error": "account_status_identity_invalid"})
+		default:
+			c.JSON(http.StatusServiceUnavailable, gin.H{"error": "account_status_persistence_failed"})
+		}
+		return
+	}
+	candidate := findCodexOAuthAccount(s.handlers.AuthManager.List(), id)
+	cliproxyStatus, gatewayManualStatus, gatewayQuotaStatus, finalStatus := upstreamAccountStatuses(s.handlers.AuthManager, candidate)
+	c.JSON(http.StatusOK, gin.H{"id": id, "status": finalStatus,
+		"cliproxy_status": cliproxyStatus, "gateway_manual_status": gatewayManualStatus,
+		"gateway_quota_status": gatewayQuotaStatus})
+}
+
+func validGatewayAccountIndex(id string) bool {
+	if len(id) != 16 {
+		return false
+	}
+	for _, ch := range id {
+		if !(ch >= '0' && ch <= '9' || ch >= 'a' && ch <= 'f') {
+			return false
+		}
+	}
+	return true
+}
+
+func decodeAccountStatusRequest(body io.Reader) (bool, error) {
+	data, err := io.ReadAll(io.LimitReader(body, codexQuotaRequestMaxBodySize+1))
+	if err != nil {
+		return false, errAccountStatusRequestInvalid
+	}
+	if len(data) > codexQuotaRequestMaxBodySize {
+		return false, errQuotaRPCRequestTooLarge
+	}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	start, err := decoder.Token()
+	if err != nil || start != json.Delim('{') {
+		return false, errAccountStatusRequestInvalid
+	}
+	key, err := decoder.Token()
+	if err != nil || key != "enabled" {
+		return false, errAccountStatusRequestInvalid
+	}
+	var enabled *bool
+	if err = decoder.Decode(&enabled); err != nil || enabled == nil || decoder.More() {
+		return false, errAccountStatusRequestInvalid
+	}
+	end, err := decoder.Token()
+	if err != nil || end != json.Delim('}') || ensureJSONEOF(decoder) != nil {
+		return false, errAccountStatusRequestInvalid
+	}
+	return *enabled, nil
+}
