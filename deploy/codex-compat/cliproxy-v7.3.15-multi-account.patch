+}
+
+func TestDeduplicateCodexOAuthAuthsPrefersNewestRefreshDeterministically(t *testing.T) {
+	older := codexOAuthDedupeAuth("z-old.json", "same-account", "2026-08-20T10:00:00Z")
+	newer := codexOAuthDedupeAuth("y-new.json", "same-account", "2026-08-21T10:00:00Z")
+	tieWinner := codexOAuthDedupeAuth("a-tie.json", "same-account", "2026-08-21T10:00:00Z")
+	other := codexOAuthDedupeAuth("other.json", "other-account", "2026-08-19T10:00:00Z")
+	nonFile := codexOAuthDedupeAuth("runtime", "same-account", "2026-08-22T10:00:00Z")
+	nonFile.Attributes[AttributeSourceBackend] = AuthSourceMemory
+
+	for _, input := range [][]*Auth{
+		{older, tieWinner, newer, other, nonFile},
+		{nonFile, other, newer, older, tieWinner},
+	} {
+		got := DeduplicateCodexOAuthAuths(input)
+		if len(got) != 3 {
+			t.Fatalf("DeduplicateCodexOAuthAuths() len = %d, want 3", len(got))
+		}
+		ids := make(map[string]bool, len(got))
+		for _, auth := range got {
+			ids[auth.ID] = true
+		}
+		if !ids[tieWinner.ID] || !ids[other.ID] || !ids[nonFile.ID] {
+			t.Fatalf("deduplicated IDs = %#v, want tie winner, other account, and runtime auth", ids)
+		}
+		if ids[older.ID] || ids[newer.ID] {
+			t.Fatalf("stale duplicate remained: %#v", ids)
+		}
+	}
+}
+
+func TestManagerLoadDoesNotDoubleWeightDuplicateCodexOAuthFiles(t *testing.T) {
+	older := codexOAuthDedupeAuth("old-plus.json", "same-account", "2026-08-20T10:00:00Z")
+	newer := codexOAuthDedupeAuth("new-pro.json", "same-account", "2026-08-21T10:00:00Z")
+	manager := NewManager(&codexOAuthDedupeStore{auths: []*Auth{older, newer}}, nil, nil)
+
+	if err := manager.Load(context.Background()); err != nil {
+		t.Fatalf("Load() error = %v", err)
+	}
+	list := manager.List()
+	if len(list) != 1 || list[0].ID != newer.ID {
+		t.Fatalf("loaded auths = %#v, want only %q", list, newer.ID)
+	}
+	if got := list[0].EnsureIndex(); got == "" || got != older.EnsureIndex() {
+		t.Fatalf("stable account index = %q, older = %q", got, older.EnsureIndex())
+	}
+}
+
+func TestSetCodexOAuthAccountIndexSeedReplacesPathDerivedIndex(t *testing.T) {
+	auth := &Auth{
+		ID:       "before.json",
+		Provider: "codex",
+		Metadata: map[string]any{"access_token": "token"},
+		Attributes: map[string]string{
+			AttributeSourceBackend: AuthSourceFile,
+			AttributePath:          "/tokens/before.json",
+		},
+	}
+	pathIndex := auth.EnsureIndex()
+	SetCodexOAuthAccountIndexSeed(auth, "account-id")
+	accountIndex := auth.EnsureIndex()
+	if accountIndex == "" || accountIndex == pathIndex {
+		t.Fatalf("account index = %q, path index = %q", accountIndex, pathIndex)
+	}
+}
