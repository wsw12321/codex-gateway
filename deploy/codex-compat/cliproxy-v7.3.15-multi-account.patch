+// StatusCode exposes only the normalized failure category. A trusted token
+// endpoint invalid_grant is authentication failure even though OAuth commonly
+// carries it in an HTTP 400 response.
+func (e *codexOAuthTokenError) StatusCode() int {
+	if e == nil {
+		return 0
+	}
+	switch e.code {
+	case "invalid_grant", "refresh_token_reused", "invalid_client", "unauthorized_client":
+		return http.StatusUnauthorized
+	case "access_denied":
+		return http.StatusForbidden
+	default:
+		return e.upstreamStatus
+	}
