+func TestCodexGatewayQuotaWebsocketSignal(t *testing.T) {
+	for _, modelCooling := range []bool{false, true} {
+		for _, tc := range []struct {
+			name      string
+			status    int
+			errorBody string
+			exhausted bool
+		}{
+			{"quota", 429, `{"type":"usage_limit_reached","resets_in_seconds":3600}`, true},
+			{"quota bad request", 400, `{"type":"usage_limit_reached"}`, true},
+			{"ordinary rate limit", 429, `{"type":"rate_limit_error"}`, false},
+			{"message only", 429, `{"message":"usage_limit_reached"}`, false},
+			{"unauthorized", 401, `{"type":"usage_limit_reached"}`, false},
+			{"forbidden", 403, `{"type":"usage_limit_reached"}`, false},
+		} {
+			t.Run(fmt.Sprintf("%s/model-cooling=%t", tc.name, modelCooling), func(t *testing.T) {
+				for _, nested := range []bool{false, true} {
+					body := fmt.Sprintf(`{"type":"error","status":%d,"error":%s}`, tc.status, tc.errorBody)
+					if nested {
+						body = fmt.Sprintf(`{"type":"error","status":%d,"body":{"error":%s}}`, tc.status, tc.errorBody)
+					}
+					got, ok := parseCodexWebsocketErrorWithCooling([]byte(body), modelCooling)
+					if !ok {
+						t.Fatal("websocket error not recognized")
+					}
+					var signal interface{ QuotaExhausted() bool }
+					if !errors.As(got, &signal) || signal.QuotaExhausted() != tc.exhausted {
+						t.Fatalf("quota signal lost: %v", got)
+					}
+					var scoped interface{ IsCredentialScoped() bool }
+					if !errors.As(got, &scoped) || scoped.IsCredentialScoped() != (tc.exhausted && !modelCooling) {
+						t.Fatalf("quota cooling scope changed: %v", got)
+					}
+					var status interface{ StatusCode() int }
+					wantStatus := tc.status
+					if tc.exhausted {
+						wantStatus = http.StatusTooManyRequests
+					}
+					if !errors.As(got, &status) || status.StatusCode() != wantStatus {
+						t.Fatalf("status lost: %v", got)
+					}
+				}
+			})
+		}
+	}
+}
