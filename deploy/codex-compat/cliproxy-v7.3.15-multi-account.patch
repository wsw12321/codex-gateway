+type gatewayPolicyExecutor struct {
+	id            string
+	err           error
+	tailErr       error
+	empty         bool
+	missingSource bool
+
+	mu    sync.Mutex
+	calls []string
+}
+
+func (e *gatewayPolicyExecutor) Identifier() string { return e.id }
+
+func (e *gatewayPolicyExecutor) Execute(_ context.Context, candidate *Auth, _ cliproxyexecutor.Request, _ cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	e.record(candidate.ID)
+	if e.err != nil {
+		return cliproxyexecutor.Response{}, e.err
+	}
+	return cliproxyexecutor.Response{Payload: []byte("ok")}, nil
+}
+
+func (e *gatewayPolicyExecutor) ExecuteStream(_ context.Context, candidate *Auth, _ cliproxyexecutor.Request, _ cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error) {
+	e.record(candidate.ID)
+	if e.missingSource {
+		return &cliproxyexecutor.StreamResult{}, nil
+	}
+	chunks := make(chan cliproxyexecutor.StreamChunk, 2)
+	if e.empty {
+		close(chunks)
+		return &cliproxyexecutor.StreamResult{Chunks: chunks}, nil
+	}
+	if e.err != nil {
+		chunks <- cliproxyexecutor.StreamChunk{Err: e.err}
+		close(chunks)
+		return &cliproxyexecutor.StreamResult{Chunks: chunks}, nil
+	}
+	chunks <- cliproxyexecutor.StreamChunk{Payload: []byte("first")}
+	if e.tailErr != nil {
+		chunks <- cliproxyexecutor.StreamChunk{Err: e.tailErr}
+	}
+	close(chunks)
+	return &cliproxyexecutor.StreamResult{Chunks: chunks}, nil
+}
