+package cliproxy
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+)
+
+func TestServiceRunRejectsCorruptGatewayAccountState(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, coreauth.GatewayAccountStateFile), []byte(`{"version":1,"accounts":null}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	service := &Service{cfg: &config.Config{AuthDir: dir}, coreManager: coreauth.NewManager(nil, nil, nil)}
+	if err := service.Run(context.Background()); !errors.Is(err, coreauth.ErrGatewayAccountStateUnavailable) {
+		t.Fatalf("corrupt state did not fail service startup: %v", err)
+	}
+}
