+func TestCodexGatewayQuotaHTTPTransports(t *testing.T) {
+	for _, mode := range []string{"ordinary", "compact", "sse"} {
+		for _, wire := range []string{"http-quota", "http-rate", "embedded-quota", "late-quota"} {
+			if mode == "compact" && wire == "late-quota" {
+				continue
+			}
+			t.Run(mode+"/"+wire, func(t *testing.T) {
+				upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					switch wire {
+					case "http-quota":
+						w.WriteHeader(429)
+						_, _ = w.Write([]byte(`{"error":{"type":"usage_limit_reached"}}`))
+					case "http-rate":
+						w.WriteHeader(429)
+						_, _ = w.Write([]byte(`{"error":{"type":"rate_limit_error"}}`))
+					default:
+						if mode == "compact" {
+							_, _ = w.Write([]byte(`{"error":{"type":"usage_limit_reached"}}`))
+							return
+						}
+						w.Header().Set("Content-Type", "text/event-stream")
+						if wire == "late-quota" {
+							_, _ = w.Write([]byte("data: {\"type\":\"response.output_text.delta\",\"delta\":\"hello\"}\n\n"))
+							w.(http.Flusher).Flush()
+						}
+						_, _ = w.Write([]byte("data: {\"type\":\"response.failed\",\"response\":{\"error\":{\"type\":\"usage_limit_reached\"}}}\n\n"))
+					}
+				}))
+				defer upstream.Close()
+				a := &cliproxyauth.Auth{ID: "quota-transport", Provider: "codex", ProxyURL: "direct", Metadata: map[string]any{"access_token": "mock-token", "account_id": "mock-account"}, Attributes: map[string]string{"base_url": upstream.URL, cliproxyauth.AttributeAuthKind: cliproxyauth.AuthKindOAuth}}
+				e := NewCodexExecutor(&config.Config{SDKConfig: config.SDKConfig{DisableImageGeneration: config.DisableImageGenerationAll}})
+				req := cliproxyexecutor.Request{Model: "gpt-6-astra", Payload: []byte(`{"model":"gpt-6-astra","input":"hello"}`)}
+				opts := cliproxyexecutor.Options{SourceFormat: sdktranslator.FromString("openai-response"), ResponseFormat: sdktranslator.FromString("openai-response")}
+				var got error
+				if mode == "sse" {
+					opts.Stream = true
+					var result *cliproxyexecutor.StreamResult
+					result, got = e.ExecuteStream(context.Background(), a, req, opts)
+					if got == nil {
+						for chunk := range result.Chunks {
+							if chunk.Err != nil {
+								got = chunk.Err
+							}
+						}
+					}
+				} else {
+					if mode == "compact" {
+						opts.Alt = "responses/compact"
+					}
+					_, got = e.Execute(context.Background(), a, req, opts)
+				}
+				var signal interface{ QuotaExhausted() bool }
+				if !errors.As(got, &signal) {
+					t.Fatalf("missing quota classification: %v", got)
+				}
+				if signal.QuotaExhausted() != (wire != "http-rate") {
+					t.Fatalf("quota signal=%v wire=%s", signal.QuotaExhausted(), wire)
+				}
+			})
+		}
+	}
+}
