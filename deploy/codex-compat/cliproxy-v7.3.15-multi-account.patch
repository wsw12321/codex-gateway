+					}
+					results <- a
+				}()
+			}
+			for i := 0; i < 2; i++ {
+				select {
+				case <-entered:
+				case <-time.After(time.Second):
+					t.Fatal("callback held binding lock")
+				}
+			}
+			close(release)
+			a, b := <-results, <-results
+			if a == nil || b == nil || a.ID != b.ID {
