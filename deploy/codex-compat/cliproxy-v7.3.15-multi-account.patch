+func TestCodexGatewayDuplexQuotaPersists(t *testing.T) {
+	for _, modelCooling := range []bool{false, true} {
+		for _, eventType := range []string{"error", "response.failed"} {
+			t.Run(fmt.Sprintf("%s/model-cooling=%t", eventType, modelCooling), func(t *testing.T) {
+				var attempts atomic.Int32
+				upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					attempts.Add(1)
+					conn, err := (&websocket.Upgrader{}).Upgrade(w, r, nil)
+					if err != nil {
+						t.Error(err)
+						return
+					}
+					defer func() { _ = conn.Close() }()
+					_ = conn.SetReadDeadline(time.Now().Add(5 * time.Second))
+					if _, _, err = conn.ReadMessage(); err != nil {
+						t.Error(err)
+						return
+					}
+					events := []string{
+						`{"type":"response.created","response":{"id":"started","output":[]}}`,
+						`{"type":"response.completed","response":{"id":"started","output":[]}}`,
+						`{"type":"error","status":400,"error":{"type":"usage_limit_reached","resets_in_seconds":3600}}`,
+					}
+					if eventType == "response.failed" {
+						events[2] = `{"type":"response.failed","response":{"id":"started","error":{"type":"usage_limit_reached","resets_in_seconds":3600}}}`
+					}
+					for _, event := range events {
+						if err = conn.WriteMessage(websocket.TextMessage, []byte(event)); err != nil {
+							t.Error(err)
+							return
+						}
+					}
+					_, _, _ = conn.ReadMessage()
+				}))
+				defer upstream.Close()
+				manager, candidate, dir := newCodexGatewayControlManager(t, upstream.URL)
+				cfg := &config.Config{Codex: config.CodexConfig{ResponseSteering: true, ModelLevelCooling: modelCooling}}
+				manager.SetConfig(cfg)
+				executor := NewCodexWebsocketsExecutor(cfg)
+				executor.store = &codexWebsocketSessionStore{sessions: make(map[string]*codexWebsocketSession)}
+				manager.RegisterExecutor(executor)
+				ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+				defer cancel()
+				ctx = cliproxyexecutor.WithWebsocketInput(cliproxyexecutor.WithDownstreamWebsocket(ctx), make(chan cliproxyexecutor.WebsocketInput))
+				req := cliproxyexecutor.Request{Model: "gpt-5.4", Payload: []byte(`{"model":"gpt-5.4","input":[]}`)}
+				opts := cliproxyexecutor.Options{SourceFormat: sdktranslator.FromString("codex")}
+				result, err := manager.ExecuteStream(ctx, []string{"codex"}, req, opts)
+				if err != nil {
+					t.Fatal(err)
+				}
+				var terminal error
+				seenFailure := false
+				for chunk := range result.Chunks {
+					if chunk.Err != nil {
+						terminal = chunk.Err
+					}
+					if gjson.GetBytes(chunk.Payload, "type").String() == eventType {
+						seenFailure = true
+					}
+				}
+				var signal interface{ QuotaExhausted() bool }
+				if !seenFailure || !errors.As(terminal, &signal) || !signal.QuotaExhausted() {
+					t.Fatalf("late quota failure lost: payload=%t, terminal=%v", seenFailure, terminal)
+				}
+				current, _ := manager.GetByID(candidate.ID)
+				if cliproxyauth.GatewayAccountAvailable(current) {
+					t.Fatal("late duplex quota did not block gateway account")
+				}
+				stateBytes, err := os.ReadFile(filepath.Join(dir, cliproxyauth.GatewayAccountStateFile))
+				if err != nil {
+					t.Fatal(err)
+				}
+				var document struct {
+					Accounts map[string]struct {
+						Enabled        bool `json:"enabled"`
+						QuotaExhausted bool `json:"quota_exhausted"`
+					} `json:"accounts"`
+				}
+				if json.Unmarshal(stateBytes, &document) != nil || document.Accounts[candidate.Index].Enabled || !document.Accounts[candidate.Index].QuotaExhausted {
+					t.Fatalf("duplex quota lock was not durable: %s", stateBytes)
+				}
+				if attempts.Load() != 1 {
+					t.Fatalf("started duplex response retried %d times", attempts.Load())
+				}
+			})
+		}
+	}
+}
