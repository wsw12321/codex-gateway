+	if executeErr == nil || executor.calls != 0 {
+		t.Fatalf("stable account pin failed: error=%v calls=%d", executeErr, executor.calls)
+	}
+	if text, err := extractProbeOutputText([]byte(`{"status":"completed","usage":{"output_tokens":2},"output":[{"type":"reasoning"},{"type":"message","role":"assistant","content":[{"type":"output_text","text":"ok"}]}]}`)); err != nil || text != "ok" {
+		t.Fatalf("valid output text=%q err=%v", text, err)
+	}
+	for _, body := range []string{
+		`{"status":"completed","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"unmetered"}]}]}`,
+		`{"status":"completed","usage":{"output_tokens":16385},"output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"too many tokens"}]}]}`,
+		`{"status":"incomplete","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"partial"}]}]}`,
+		`{"status":"completed","usage":{"output_tokens":1},"output":[{"type":"function_call","name":"danger"}]}`,
+		`{"status":"completed","usage":{"output_tokens":0},"output":[]}`,
