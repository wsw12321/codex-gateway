+	if !GatewayAccountAvailable(current) {
+		t.Fatal("ordinary 429 acquired persistent lock")
+	}
+	if _, err := os.Stat(filepath.Join(dir, GatewayAccountStateFile)); !errors.Is(err, os.ErrNotExist) {
