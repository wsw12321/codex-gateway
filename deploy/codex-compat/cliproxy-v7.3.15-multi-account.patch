+)
+
+func TestInternalUpstreamAccountStatus(t *testing.T) {
+	s := newTestServer(t)
+	dir := t.TempDir()
+	if err := s.handlers.AuthManager.LoadGatewayAccountState(dir); err != nil {
+		t.Fatal(err)
+	}
+	a := registerQuotaTestAccount(t, s, &quotaCaptureExecutor{})
+	id := stableCodexAccountID(a)
+	for _, enabled := range []bool{false, true, false} {
+		body := `{"enabled":false}`
+		want := "unavailable"
+		if enabled {
+			body = `{"enabled":true}`
+			want = "available"
+		}
+		r := httptest.NewRequest(http.MethodPut, "/internal/upstream-accounts/"+id+"/status", strings.NewReader(body))
+		r.Header.Set("Authorization", "Bearer test-key")
+		w := httptest.NewRecorder()
+		s.engine.ServeHTTP(w, r)
+		if w.Code != 200 || w.Header().Get("Cache-Control") != "no-store" {
+			t.Fatalf("status=%d body=%s", w.Code, w.Body)
+		}
+		var got struct{ ID, Status string }
+		if err := json.Unmarshal(w.Body.Bytes(), &got); err != nil {
+			t.Fatal(err)
+		}
+		if got.ID != id || got.Status != want {
+			t.Fatalf("response=%+v", got)
+		}
+		listed := findCodexOAuthAccount(s.handlers.AuthManager.List(), id)
+		if auth.GatewayAccountAvailable(listed) != enabled {
+			t.Fatalf("confirmed status disagrees with manager")
+		}
+		if !enabled && upstreamAccountStatus(listed) != "unavailable" {
+			t.Fatal("list missed durable block")
+		}
+	}
+	stat, err := os.Stat(filepath.Join(dir, ".gateway-account-state"))
+	if err != nil || stat.Mode().Perm() != 0600 {
+		t.Fatalf("state permissions: %v %v", stat, err)
+	}
+}
+
+func TestInternalUpstreamAccountStatusRejectsInvalidRequests(t *testing.T) {
+	s := newTestServer(t)
+	if err := s.handlers.AuthManager.LoadGatewayAccountState(t.TempDir()); err != nil {
+		t.Fatal(err)
+	}
+	a := registerQuotaTestAccount(t, s, &quotaCaptureExecutor{})
+	id := stableCodexAccountID(a)
+	for _, tc := range []struct {
+		name, body, key, suffix string
+		status                  int
+	}{
+		{"no bearer", `{"enabled":false}`, "", "", 401},
+		{"wrong bearer", `{"enabled":false}`, "Bearer wrong", "", 401},
+		{"missing", `{}`, "Bearer test-key", "", 400},
+		{"null", `{"enabled":null}`, "Bearer test-key", "", 400},
+		{"duplicate", `{"enabled":false,"enabled":true}`, "Bearer test-key", "", 400},
+		{"unknown", `{"enabled":false,"token":"sensitive"}`, "Bearer test-key", "", 400},
+		{"case", `{"Enabled":false}`, "Bearer test-key", "", 400},
+		{"string", `{"enabled":"false"}`, "Bearer test-key", "", 400},
+		{"array", `[false]`, "Bearer test-key", "", 400},
+		{"trailing", `{"enabled":false}{}`, "Bearer test-key", "", 400},
+		{"oversized", strings.Repeat("sensitive", 40), "Bearer test-key", "", 413},
+		{"query", `{"enabled":false}`, "Bearer test-key", "?key=test-key", 400},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			r := httptest.NewRequest(http.MethodPut, "/internal/upstream-accounts/"+id+"/status"+tc.suffix, strings.NewReader(tc.body))
+			if tc.key != "" {
+				r.Header.Set("Authorization", tc.key)
+			}
+			w := httptest.NewRecorder()
+			s.engine.ServeHTTP(w, r)
+			if w.Code != tc.status || strings.Contains(w.Body.String(), "sensitive") {
+				t.Fatalf("status=%d body=%s", w.Code, w.Body)
+			}
+		})
+	}
+	for _, id := range []string{"0123456789abcdef", "ABCDEF0123456789", "short", "0123456789abcdef%20"} {
+		r := httptest.NewRequest(http.MethodPut, "/internal/upstream-accounts/"+id+"/status", strings.NewReader(`{"enabled":true}`))
+		r.Header.Set("Authorization", "Bearer test-key")
+		w := httptest.NewRecorder()
+		s.engine.ServeHTTP(w, r)
+		if w.Code != 404 {
+			t.Fatalf("id=%s status=%d body=%s", id, w.Code, w.Body)
+		}
+	}
+}
+
+func TestInternalUpstreamAccountStatusPersistenceFailure(t *testing.T) {
+	s := newTestServer(t)
+	dir := t.TempDir()
+	if err := s.handlers.AuthManager.LoadGatewayAccountState(dir); err != nil {
+		t.Fatal(err)
+	}
+	a := registerQuotaTestAccount(t, s, &quotaCaptureExecutor{})
+	id := stableCodexAccountID(a)
+	if _, err := s.handlers.AuthManager.SetGatewayAccountEnabled(id, false); err != nil {
+		t.Fatal(err)
