+package util
+
+import (
+	"net/http"
+	"testing"
+)
+
+func TestRemoveCodexInternalHeadersConsumesConversationRelations(t *testing.T) {
+	headers := http.Header{}
+	for _, name := range []string{
+		"Thread-Id", "Thread_id", "X-Codex-Parent-Thread-Id", "X-Openai-Subagent",
+		"X-Claude-Code-Session-Id", "X-Claude-Code-Agent-Id", "X-Claude-Code-Parent-Agent-Id",
+		"X-Claude-Code-Parent-Session-Id", "X-Claude-Parent-Session-Id", "X-Claude-Code-Side-Session-Id",
+		"X-Http-Session-Id", "X-Session-Id", "X-Session-Affinity", "X-Slot-Session-Id", "X-Task_id",
+		"X-Conversation-Id", "X-Thread-Id", "X-Client-Request-Id", "X-Side-Session-Id", "X-Side-Thread-Id",
+		"X-Parent-Id", "X-Parent-Session", "X-Parent-Session_id", "X-Parent-Thread-Id", "X-Parent-Task-Id",
+		"X-Parent-Conversation-Id", "X-Parent-Session-Affinity", "X-Parent-Slot-Session-Id",
+		"X-Parent-Side-Session-Id", "X-Parent-Side-Thread-Id",
+		CodexGatewayUserHeader, CodexGatewayAffinityHeader, CodexUpstreamAccountHeader, "x-codex-conversation-hash",
+	} {
+		headers[name] = []string{"internal"}
+	}
+	headers.Set("Session_id", "provider-cache-session")
+	headers.Set("Session-Id", "provider-http-cache-session")
+	headers.Set("Content-Type", "application/json")
+	headers.Set("X-Codex-Turn-Metadata", `{"turn_id":"provider-turn"}`)
+	RemoveCodexInternalHeaders(headers)
+	if len(headers) != 4 || headers.Get("Session_id") != "provider-cache-session" || headers.Get("Session-Id") != "provider-http-cache-session" || headers.Get("Content-Type") != "application/json" || headers.Get("X-Codex-Turn-Metadata") != `{"turn_id":"provider-turn"}` {
+		t.Fatalf("outbound headers=%v; want only provider session, native turn metadata, and content type", headers)
+	}
+}
