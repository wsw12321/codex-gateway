+func TestConversationRootInterceptorRewritesAndClears(t *testing.T) {
+	for _, mode := range []string{"headers", "body", "clear", "parent-only", "remove-parent"} {
+		t.Run(mode, func(t *testing.T) {
+			scope := t.Name()
+			headers := http.Header{"Session-Id": {"old-child"}, "X-Codex-Parent-Thread-Id": {"old-root"}}
+			meta := rootRequestMetadata(scope, headers, "")
+			originalHash := meta[cliproxyexecutor.ConversationHashMetadataKey]
+			opts := cliproxyexecutor.Options{Headers: headers, Metadata: meta, RequestAfterAuthInterceptor: func(context.Context, cliproxyexecutor.RequestAfterAuthInterceptRequest) cliproxyexecutor.RequestAfterAuthInterceptResponse {
+				switch mode {
+				case "headers":
+					return cliproxyexecutor.RequestAfterAuthInterceptResponse{Headers: http.Header{"Session-Id": {"new-root"}}, ClearHeaders: []string{"X-Codex-Parent-Thread-Id"}}
+				case "body":
+					return cliproxyexecutor.RequestAfterAuthInterceptResponse{Body: []byte(`{"session_id":"new-root"}`), ClearHeaders: []string{"Session-Id", "X-Codex-Parent-Thread-Id"}}
+				case "remove-parent":
+					return cliproxyexecutor.RequestAfterAuthInterceptResponse{ClearHeaders: []string{"X-Codex-Parent-Thread-Id"}}
+				case "parent-only":
+					return cliproxyexecutor.RequestAfterAuthInterceptResponse{Headers: http.Header{"X-Codex-Parent-Thread-Id": {"new-root"}}}
+				default:
+					return cliproxyexecutor.RequestAfterAuthInterceptResponse{ClearHeaders: []string{"Session-Id", "X-Codex-Parent-Thread-Id"}}
+				}
+			}}
+			_, changed, err := applyRequestAfterAuthInterceptor(context.Background(), nil, "codex", cliproxyexecutor.Request{}, opts, "model")
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got := changed.Metadata[cliproxyexecutor.ConversationHashMetadataKey]; got == originalHash {
+				t.Fatal("interceptor retained old root hash")
+			}
+			if mode == "clear" {
+				if changed.Metadata[cliproxyexecutor.ConversationHashMetadataKey] != nil {
+					t.Fatal("cleared request hash survived")
+				}
+				return
+			}
+			prefix := "codex:"
+			if mode == "body" {
+				prefix = "session:"
+			}
+			rootID := "new-root"
+			if mode == "remove-parent" {
+				rootID = "old-child"
+			}
+			wantRoot := cliproxysession.BoundSessionIdentity("caller:" + scope + ":" + prefix + rootID)
+			if got := changed.Metadata[cliproxyexecutor.ConversationRootSessionIDMetadataKey]; got != wantRoot {
+				t.Fatalf("rewritten root=%v want=%s", got, wantRoot)
+			}
+		})
+	}
+}
