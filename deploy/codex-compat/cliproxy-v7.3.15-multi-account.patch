+func TestGatewayAccountOrdinary429RecoversWithoutPersistentLock(t *testing.T) {
+	m, candidate, dir := newGatewayAccountTestManager(t)
+	result := gatewayResult(candidate, &Error{HTTPStatus: 429})
+	wait := time.Hour
+	result.RetryAfter = &wait
+	m.MarkResult(context.Background(), result)
+	current, _ := m.GetByID(candidate.ID)
+	if blocked, reason, _ := isAuthBlockedForModel(current, "gateway-model", time.Now()); !blocked || reason != blockReasonCooldown {
+		t.Fatalf("ordinary 429 = %v %v, want cooldown", blocked, reason)
