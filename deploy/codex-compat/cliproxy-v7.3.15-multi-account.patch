+	candidate.Metadata["account_id"] = "account-b"
+	if index, ok := CodexOAuthAccountIndex(candidate); ok || index != "" {
+		t.Fatalf("mismatched account identity remained attributable: %q", index)
+	}
+}
+
+func TestCodexOAuthAccountIndexRejectsForgedExistingIndex(t *testing.T) {
+	candidate := &Auth{
+		ID:         "forged-index.json",
+		Provider:   "codex",
+		Metadata:   map[string]any{"access_token": "token"},
+		Attributes: map[string]string{AttributeSourceBackend: AuthSourceFile},
+	}
+	SetCodexOAuthAccountIndexSeed(candidate, "account-a")
+	expected, ok := CodexOAuthAccountIndex(candidate)
+	if !ok || expected == "" {
+		t.Fatalf("canonical account index = %q, attributable=%t", expected, ok)
+	}
+	forged := "ffffffffffffffff"
+	if forged == expected {
+		forged = "0000000000000000"
+	}
+	candidate.Index = forged
+	candidate.indexAssigned = true
+	if index, attributable := CodexOAuthAccountIndex(candidate); attributable || index != "" {
+		t.Fatalf("forged existing index remained attributable: %q", index)
+	}
+}
+
+func codexOAuthDedupeAuth(id, accountID, lastRefresh string) *Auth {
+	auth := &Auth{
+		ID:         id,
+		Provider:   "codex",
+		Status:     StatusActive,
+		Metadata:   map[string]any{"access_token": "token", "account_id": accountID, "last_refresh": lastRefresh},
+		Attributes: map[string]string{AttributeSourceBackend: AuthSourceFile},
+		UpdatedAt:  time.Now(),
+	}
+	SetCodexOAuthAccountIndexSeed(auth, accountID)
+	return auth
+}
