+func TestGatewayAccountSessionAffinityStopsUsingDisabledAccount(t *testing.T) {
+	m, _, _ := newGatewayAccountTestManager(t)
+	gatewayRegisterAccount(t, m, uuid.NewString()+".json", uuid.NewString())
+	affinity := NewSessionAffinitySelectorWithConfig(SessionAffinityConfig{Fallback: &RoundRobinSelector{}, TTL: time.Hour})
+	t.Cleanup(affinity.Stop)
+	m.SetSelector(affinity)
+	opts := cliproxyexecutor.Options{Metadata: map[string]any{cliproxyexecutor.DerivedSessionIDMetadataKey: "gateway-session"}}
+	first, err := m.SelectAuth(context.Background(), "codex", "gateway-model", opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = m.SetGatewayAccountEnabled(first.Index, false); err != nil {
+		t.Fatal(err)
+	}
+	second, err := m.SelectAuth(context.Background(), "codex", "gateway-model", opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if second.Index == first.Index {
+		t.Fatal("affinity retained disabled account")
+	}
+	if _, err = m.SetGatewayAccountEnabled(second.Index, false); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = m.SelectAuth(context.Background(), "codex", "gateway-model", opts); err == nil {
+		t.Fatal("affinity selected while all accounts disabled")
+	}
+	if _, err = m.SetGatewayAccountEnabled(first.Index, true); err != nil {
+		t.Fatal(err)
+	}
+	resumed, err := m.SelectAuth(context.Background(), "codex", "gateway-model", opts)
+	if err != nil || resumed.Index != first.Index {
+		t.Fatalf("affinity did not resume enabled account: %v %v", resumed, err)
+	}
+}
