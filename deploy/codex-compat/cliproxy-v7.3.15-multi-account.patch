diff --git a/internal/api/astra_upgrade_smoke_test.go b/internal/api/astra_upgrade_smoke_test.go
new file mode 100644
index 0000000..8fbfb6e
--- /dev/null
+++ b/internal/api/astra_upgrade_smoke_test.go
@@ -0,0 +1,183 @@
+package api
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+)
+
+type astraUpgradeExecutor struct {
+	codexSearchCaptureExecutor
+	mu       sync.Mutex
+	calls    []string
+	indices  []string
+	alts     []string
+	models   []string
+	failures int
+}
+
+func (e *astraUpgradeExecutor) record(a *auth.Auth, req coreexecutor.Request, opts coreexecutor.Options) error {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	e.calls = append(e.calls, a.ID)
+	e.indices = append(e.indices, a.EnsureIndex())
+	e.alts = append(e.alts, opts.Alt)
+	e.models = append(e.models, req.Model)
+	if len(e.calls) <= e.failures {
+		return &auth.Error{HTTPStatus: http.StatusBadGateway, Message: "mock upstream unavailable"}
+	}
+	return nil
+}
+
+func (e *astraUpgradeExecutor) Execute(_ context.Context, a *auth.Auth, req coreexecutor.Request, opts coreexecutor.Options) (coreexecutor.Response, error) {
+	if err := e.record(a, req, opts); err != nil {
+		return coreexecutor.Response{}, err
+	}
+	return coreexecutor.Response{Payload: []byte(`{"id":"resp-astra","object":"response","model":"gpt-6-astra","status":"completed","output":[]}`)}, nil
+}
+
+func (e *astraUpgradeExecutor) ExecuteStream(_ context.Context, a *auth.Auth, req coreexecutor.Request, opts coreexecutor.Options) (*coreexecutor.StreamResult, error) {
+	if err := e.record(a, req, opts); err != nil {
+		return nil, err
+	}
+	chunks := make(chan coreexecutor.StreamChunk, 1)
+	chunks <- coreexecutor.StreamChunk{Payload: []byte("event: response.completed\ndata: {\"type\":\"response.completed\",\"response\":{\"id\":\"resp-astra\",\"model\":\"gpt-6-astra\",\"status\":\"completed\",\"output\":[]}}\n\n")}
+	close(chunks)
+	return &coreexecutor.StreamResult{Chunks: chunks}, nil
+}
+
+func newAstraUpgradeServer(t *testing.T, failures int) (*Server, *astraUpgradeExecutor) {
+	t.Helper()
+	s := newTestServer(t)
+	e := &astraUpgradeExecutor{failures: failures}
+	s.handlers.AuthManager.RegisterExecutor(e)
+	s.handlers.AuthManager.SetRetryConfig(0, 0, 2)
+	models := registry.GetCodexPlusModels()
+	found := false
+	for _, model := range models {
+		if model.ID == "gpt-6-astra" {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatal("Astra is absent from upstream Codex Plus registry")
+	}
+	for i := 0; i < 3; i++ {
+		id := fmt.Sprintf("astra-upgrade-%d", i)
+		a := &auth.Auth{ID: id, Provider: "codex", Status: auth.StatusActive,
+			Attributes: map[string]string{auth.AttributeAuthKind: auth.AuthKindOAuth, "plan_type": "plus"},
+			Metadata:   map[string]any{"type": "codex", "access_token": "mock-token", "account_id": id, "email": "mock@example.com"},
+		}
+		if _, err := s.handlers.AuthManager.Register(context.Background(), a); err != nil {
+			t.Fatal(err)
+		}
+		registry.GetGlobalRegistry().RegisterClient(id, "codex", models)
+		t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(id) })
+	}
+	return s, e
+}
+
+func TestAstraUpgradeModels(t *testing.T) {
+	s, _ := newAstraUpgradeServer(t, 0)
+	for _, clientVersion := range []string{"", "0.153.3"} {
+		t.Run("client="+clientVersion, func(t *testing.T) {
+			path := "/v1/models"
+			if clientVersion != "" {
+				path += "?client_version=" + clientVersion
+			}
+			req := httptest.NewRequest(http.MethodGet, path, nil)
+			req.Header.Set("Authorization", "Bearer test-key")
+			rr := httptest.NewRecorder()
+			s.engine.ServeHTTP(rr, req)
+			if rr.Code != http.StatusOK {
+				t.Fatalf("status=%d body=%s", rr.Code, rr.Body.String())
+			}
+			var doc map[string]json.RawMessage
+			if err := json.Unmarshal(rr.Body.Bytes(), &doc); err != nil {
+				t.Fatal(err)
+			}
+			key, identity := "data", "id"
+			if clientVersion != "" {
+				key, identity = "models", "slug"
+			}
+			var models []map[string]any
+			if err := json.Unmarshal(doc[key], &models); err != nil {
+				t.Fatal(err)
+			}
+			for _, model := range models {
+				if model[identity] == "gpt-6-astra" {
+					return
+				}
+			}
+			t.Fatalf("Astra is absent from %s catalog", key)
+		})
+	}
+}
+
+func TestAstraUpgradeResponses(t *testing.T) {
+	for _, mode := range []string{"ordinary", "sse", "compact"} {
+		for _, failures := range []int{0, 1, 3} {
+			t.Run(fmt.Sprintf("%s/failures=%d", mode, failures), func(t *testing.T) {
+				s, e := newAstraUpgradeServer(t, failures)
+				path := "/v1/responses"
+				if mode == "compact" {
+					path += "/compact"
+				}
+				payload := fmt.Sprintf(`{"model":"gpt-6-astra","input":"hello","stream":%t}`, mode == "sse")
+				req := httptest.NewRequest(http.MethodPost, path, strings.NewReader(payload))
+				req.Header.Set("Authorization", "Bearer test-key")
+				req.Header.Set("Content-Type", "application/json")
+				req.Header.Set("X-Codex-Upstream-Account", "spoofed")
+				rr := httptest.NewRecorder()
+				s.engine.ServeHTTP(rr, req)
+				wantCalls, wantStatus := failures+1, http.StatusOK
+				if failures == 3 {
+					wantCalls, wantStatus = 2, http.StatusBadGateway
+				}
+				if rr.Code != wantStatus {
+					t.Fatalf("status=%d want=%d body=%s", rr.Code, wantStatus, rr.Body.String())
+				}
+				e.mu.Lock()
+				defer e.mu.Unlock()
+				if len(e.calls) != wantCalls {
+					t.Fatalf("calls=%v want count=%d", e.calls, wantCalls)
+				}
+				if len(e.calls) == 2 && e.calls[0] == e.calls[1] {
+					t.Fatalf("same account replayed: %v", e.calls)
+				}
+				for i, model := range e.models {
+					if model != "gpt-6-astra" {
+						t.Fatalf("request %d model=%q", i, model)
+					}
+					if mode == "compact" && e.alts[i] != "responses/compact" {
+						t.Fatalf("compact alt=%q", e.alts[i])
+					}
+				}
+				wantIndex := e.indices[len(e.indices)-1]
+				if got := rr.Header().Get("X-Codex-Upstream-Account"); got != wantIndex {
+					t.Fatalf("attribution=%q want=%q", got, wantIndex)
+				}
+				if failures < 3 && !strings.Contains(rr.Body.String(), "gpt-6-astra") {
+					t.Fatalf("model lost: %s", rr.Body.String())
+				}
+				if mode == "sse" && failures < 3 {
+					if !strings.HasPrefix(rr.Header().Get("Content-Type"), "text/event-stream") {
+						t.Fatalf("content type=%q", rr.Header().Get("Content-Type"))
+					}
+					if !strings.Contains(rr.Body.String(), "response.completed") {
+						t.Fatalf("missing completion: %s", rr.Body.String())
+					}
+				}
+			})
+		}
+	}
+}
