+func TestGatewayAccountConcurrentControlsRemainDurable(t *testing.T) {
+	m, candidate, dir := newGatewayAccountTestManager(t)
+	var wg sync.WaitGroup
+	for i := range 20 {
+		wg.Add(1)
+		go func() {
