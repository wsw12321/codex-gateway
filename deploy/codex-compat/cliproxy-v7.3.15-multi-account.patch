+func writeGatewayControlSuccess(w http.ResponseWriter, mode string) {
+	if mode == "compact" {
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = io.WriteString(w, `{"id":"resp_1","object":"response.compaction","output":[],"usage":{"input_tokens":1,"output_tokens":1,"total_tokens":2}}`)
+		return
+	}
+	w.Header().Set("Content-Type", "text/event-stream")
+	_, _ = fmt.Fprintf(w, "data: %s\n\n", codexCompletedEventBody)
+}
+
+func writeGatewayControlQuota(w http.ResponseWriter, mode string) {
+	if !strings.HasPrefix(mode, "sse") {
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(http.StatusTooManyRequests)
+		_, _ = io.WriteString(w, gatewayControlQuotaBody)
+		return
+	}
+	w.Header().Set("Content-Type", "text/event-stream")
+	if mode == "sse-tail" {
+		_, _ = fmt.Fprintf(w, "data: %s\n\n", gatewayControlDeltaEvent)
+		w.(http.Flusher).Flush()
+	}
+	_, _ = fmt.Fprintf(w, "data: %s\n\n", gatewayControlQuotaEvent)
+}
+
+func TestCodexGatewayControlQuotaPersistsAcrossExecutionModes(t *testing.T) {
+	for _, mode := range []string{"ordinary", "compact", "sse-early", "sse-tail"} {
+		t.Run(mode, func(t *testing.T) {
+			var quota atomic.Bool
+			quota.Store(true)
+			var calls atomic.Int32
+			upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				calls.Add(1)
+				wantPath := "/responses"
+				if mode == "compact" {
+					wantPath += "/compact"
+				}
+				if r.URL.Path != wantPath || r.Header.Get("Authorization") != "Bearer test-access-token" || r.Header.Get("ChatGPT-Account-ID") == "" {
+					t.Errorf("unexpected upstream request %s; OAuth identity header present=%t", r.URL.Path, r.Header.Get("ChatGPT-Account-ID") != "")
+				}
+				if quota.Load() {
+					writeGatewayControlQuota(w, mode)
+				} else {
+					writeGatewayControlSuccess(w, mode)
+				}
+			}))
+			defer upstream.Close()
+			manager, candidate, dir := newCodexGatewayControlManager(t, upstream.URL)
+			payload, err := invokeCodexGatewayControl(manager, mode)
+			if err == nil {
+				t.Fatalf("quota response succeeded: %s", payload)
+			}
+			if mode == "sse-tail" && !strings.Contains(payload, "hello") {
+				t.Fatalf("stream payload before quota error was lost: %s; %v", payload, err)
+			}
+			current, _ := manager.GetByID(candidate.ID)
+			if cliproxyauth.GatewayAccountAvailable(current) {
+				t.Fatalf("real executor quota error did not block manager account: %v", err)
+			}
+			stateBytes, err := os.ReadFile(filepath.Join(dir, cliproxyauth.GatewayAccountStateFile))
+			if err != nil {
+				t.Fatal(err)
+			}
+			var document struct {
+				Accounts map[string]struct {
+					Enabled        bool `json:"enabled"`
+					QuotaExhausted bool `json:"quota_exhausted"`
+				} `json:"accounts"`
+			}
+			if json.Unmarshal(stateBytes, &document) != nil || document.Accounts[candidate.Index].Enabled || !document.Accounts[candidate.Index].QuotaExhausted {
+				t.Fatalf("quota lock was not durable: %s", stateBytes)
+			}
+			if _, err := invokeCodexGatewayControl(manager, mode); err == nil || calls.Load() != 1 {
+				t.Fatalf("locked account was retried: error=%v upstream calls=%d", err, calls.Load())
+			}
+			quota.Store(false)
+			if status, err := manager.SetGatewayAccountEnabled(candidate.Index, true); err != nil || status != "available" {
+				t.Fatalf("re-enable failed: %s %v", status, err)
+			}
+			if _, err := invokeCodexGatewayControl(manager, mode); err != nil || calls.Load() != 2 {
+				t.Fatalf("re-enabled account did not resume: error=%v upstream calls=%d", err, calls.Load())
+			}
+			quota.Store(true)
+			if _, err := invokeCodexGatewayControl(manager, mode); err == nil {
+				t.Fatal("second quota failure unexpectedly succeeded")
+			}
+			current, _ = manager.GetByID(candidate.ID)
+			if cliproxyauth.GatewayAccountAvailable(current) || calls.Load() != 3 {
+				t.Fatalf("new quota after enable failed to lock: available=%t upstream calls=%d", cliproxyauth.GatewayAccountAvailable(current), calls.Load())
+			}
+		})
+	}
+}
+
+func TestCodexGatewayControlKeepsInFlightRequestsAndRejectsStaleQuota(t *testing.T) {
+	for _, mode := range []string{"ordinary", "sse-tail"} {
+		for _, oldQuota := range []bool{false, true} {
+			name := mode + "/success-after-disable"
+			if oldQuota {
+				name = mode + "/quota-after-reenable"
+			}
+			t.Run(name, func(t *testing.T) {
+				started, release := make(chan struct{}), make(chan struct{})
+				var releaseOnce sync.Once
+				unblock := func() { releaseOnce.Do(func() { close(release) }) }
+				var calls atomic.Int32
+				upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					if calls.Add(1) != 1 {
+						writeGatewayControlSuccess(w, mode)
+						return
+					}
+					if mode == "sse-tail" {
+						w.Header().Set("Content-Type", "text/event-stream")
+						_, _ = fmt.Fprintf(w, "data: %s\n\n", gatewayControlDeltaEvent)
+						w.(http.Flusher).Flush()
+					}
+					close(started)
+					select {
+					case <-release:
+					case <-r.Context().Done():
+						return
+					}
+					if oldQuota {
+						if mode == "sse-tail" {
+							_, _ = fmt.Fprintf(w, "data: %s\n\n", gatewayControlQuotaEvent)
+						} else {
+							writeGatewayControlQuota(w, mode)
+						}
+					} else {
+						writeGatewayControlSuccess(w, mode)
+					}
+				}))
+				defer upstream.Close()
+				defer unblock()
+				manager, candidate, _ := newCodexGatewayControlManager(t, upstream.URL)
+				type completion struct {
+					payload string
+					err     error
+				}
+				done := make(chan completion, 1)
+				go func() {
+					payload, err := invokeCodexGatewayControl(manager, mode)
+					done <- completion{payload: payload, err: err}
+				}()
+				select {
+				case <-started:
+				case result := <-done:
+					t.Fatalf("request never reached upstream: %v", result.err)
+				case <-time.After(5 * time.Second):
+					t.Fatal("request did not start")
+				}
+				if _, err := manager.SetGatewayAccountEnabled(candidate.Index, false); err != nil {
+					t.Fatal(err)
+				}
+				if _, err := invokeCodexGatewayControl(manager, mode); err == nil || calls.Load() != 1 {
+					t.Fatalf("disabled account accepted a subsequent request: %v calls=%d", err, calls.Load())
+				}
+				if oldQuota {
+					if _, err := manager.SetGatewayAccountEnabled(candidate.Index, true); err != nil {
+						t.Fatal(err)
+					}
+				}
+				unblock()
+				result := <-done
+				if (result.err != nil) != oldQuota {
+					t.Fatalf("in-flight completion changed: error=%v payload=%s", result.err, result.payload)
+				}
+				if mode == "sse-tail" && !strings.Contains(result.payload, "hello") {
+					t.Fatalf("in-flight stream lost already-started payload: %s", result.payload)
+				}
+				current, _ := manager.GetByID(candidate.ID)
+				if cliproxyauth.GatewayAccountAvailable(current) != oldQuota {
+					t.Fatalf("old completion overrode administrator control: available=%t", cliproxyauth.GatewayAccountAvailable(current))
+				}
+				if oldQuota {
+					if _, err := invokeCodexGatewayControl(manager, mode); err != nil || calls.Load() != 2 {
+						t.Fatalf("stale quota prevented new request after enable: %v calls=%d", err, calls.Load())
+					}
+				}
+			})
+		}
+	}
+}
