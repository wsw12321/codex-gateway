+func TestGatewayAccountQuotaLocksDuplicatesRestartAndReplacement(t *testing.T) {
+	m, candidate, dir := newGatewayAccountTestManager(t)
+	accountID := candidate.Metadata["account_id"].(string)
+	duplicate := gatewayRegisterAccount(t, m, uuid.NewString()+".json", accountID)
+	m.MarkResult(context.Background(), gatewayResult(candidate, &Error{HTTPStatus: 429, QuotaExhausted: true}))
+	for _, id := range []string{candidate.ID, duplicate.ID} {
+		current, _ := m.GetByID(id)
+		if GatewayAccountAvailable(current) {
+			t.Fatalf("quota left duplicate %s available", id)
+		}
+		if blocked, reason, _ := isAuthBlockedForModel(current, "other-model", time.Now().Add(365*24*time.Hour)); !blocked || reason != blockReasonDisabled {
+			t.Fatal("persistent quota lock expired")
+		}
+	}
+	assertGatewayRoutable(t, m, false)
+	fresh := codexOAuthDedupeAuth(candidate.ID, accountID, "2026-08-21T00:00:00Z")
+	if _, err := m.Update(context.Background(), fresh); err != nil {
+		t.Fatal(err)
+	}
+	assertGatewayRoutable(t, m, false)
+	m.Remove(context.Background(), candidate.ID)
+	m.Remove(context.Background(), duplicate.ID)
+	if _, err := m.SetGatewayAccountEnabled(candidate.Index, true); !errors.Is(err, ErrGatewayAccountNotFound) {
+		t.Fatalf("missing account enable = %v", err)
+	}
+	replacement := codexOAuthDedupeAuth(uuid.NewString()+".json", accountID, "2026-08-22T00:00:00Z")
+	restarted := NewManager(&codexOAuthDedupeStore{auths: []*Auth{replacement}}, nil, nil)
+	if err := restarted.LoadGatewayAccountState(dir); err != nil {
+		t.Fatal(err)
+	}
+	if err := restarted.Load(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	loaded, _ := restarted.GetByID(replacement.ID)
+	if GatewayAccountAvailable(loaded) || loaded.Index != candidate.Index {
+		t.Fatalf("restart or file replacement cleared lock: %#v", loaded)
+	}
+}
