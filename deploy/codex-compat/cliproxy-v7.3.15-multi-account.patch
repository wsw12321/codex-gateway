+type gatewayAllocationExecutor struct {
+	gatewayPolicyExecutor
+	failedID     string
+	afterPayload bool
+}
+
+func (e *gatewayAllocationExecutor) Execute(_ context.Context, a *Auth, _ cliproxyexecutor.Request, _ cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	e.record(a.ID)
+	if a.ID == e.failedID {
+		return cliproxyexecutor.Response{}, &Error{HTTPStatus: 502}
+	}
+	return cliproxyexecutor.Response{Payload: []byte("ok")}, nil
+}
+
+func (e *gatewayAllocationExecutor) ExecuteStream(_ context.Context, a *Auth, _ cliproxyexecutor.Request, _ cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error) {
+	e.record(a.ID)
+	chunks := make(chan cliproxyexecutor.StreamChunk, 2)
+	if a.ID != e.failedID || e.afterPayload {
+		chunks <- cliproxyexecutor.StreamChunk{Payload: []byte("first")}
+	}
+	if a.ID == e.failedID {
+		chunks <- cliproxyexecutor.StreamChunk{Err: &Error{HTTPStatus: 502}}
+	}
+	close(chunks)
+	return &cliproxyexecutor.StreamResult{Chunks: chunks}, nil
+}
