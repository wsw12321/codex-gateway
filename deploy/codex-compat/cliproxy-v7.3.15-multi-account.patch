+func TestFileTokenStoreListRestoresLegacyCodexClaimAndQuarantinesConflict(t *testing.T) {
+	baseDir := t.TempDir()
+	legacyToken := filestoreCodexAccountJWT(t, "legacy-account")
+	conflictToken := filestoreCodexAccountJWT(t, "claim-account")
+	for name, payload := range map[string]string{
+		"codex-legacy.json":   `{"type":"codex","access_token":"legacy","id_token":"` + legacyToken + `"}`,
+		"codex-conflict.json": `{"type":"codex","access_token":"conflict","account_id":"top-account","id_token":"` + conflictToken + `"}`,
+	} {
+		if err := os.WriteFile(filepath.Join(baseDir, name), []byte(payload), 0o600); err != nil {
+			t.Fatalf("write %s: %v", name, err)
+		}
+	}
+
+	store := NewFileTokenStore()
+	store.SetBaseDir(baseDir)
+	auths, err := store.List(context.Background())
+	if err != nil {
+		t.Fatalf("List() error = %v", err)
+	}
+	byID := make(map[string]*cliproxyauth.Auth, len(auths))
+	for _, candidate := range auths {
+		byID[candidate.ID] = candidate
+	}
+	legacy := byID["codex-legacy.json"]
+	if legacy == nil {
+		t.Fatal("legacy claim-only account was not loaded")
+	}
+	if index, ok := cliproxyauth.CodexOAuthAccountIndex(legacy); !ok || index == "" || legacy.Metadata["account_id"] != "legacy-account" {
+		t.Fatalf("legacy account identity = %#v, index=%q attributable=%t", legacy.Metadata, index, ok)
+	}
+	conflict := byID["codex-conflict.json"]
+	if conflict == nil || !conflict.Disabled || conflict.Status != cliproxyauth.StatusDisabled {
+		t.Fatalf("conflicting account was not quarantined: %#v", conflict)
+	}
+	if index, ok := cliproxyauth.CodexOAuthAccountIndex(conflict); ok || index != "" {
+		t.Fatalf("conflicting account remained attributable: %q", index)
+	}
+}
+
+func filestoreCodexAccountJWT(t *testing.T, accountID string) string {
+	t.Helper()
+	payload, err := json.Marshal(map[string]any{
+		"https://api.openai.com/auth": map[string]any{"chatgpt_account_id": accountID},
+	})
+	if err != nil {
+		t.Fatalf("marshal JWT claims: %v", err)
+	}
+	return "e30." + base64.RawURLEncoding.EncodeToString(payload) + ".signature"
+}
