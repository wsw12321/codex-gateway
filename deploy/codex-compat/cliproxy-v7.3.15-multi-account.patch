+	body, _ := json.Marshal(map[string]any{"model": "gpt-5.6-sol", "input": "fixed question", "max_output_tokens": 16384})
+	result := probeRequest(t, server, http.MethodPost, "/internal/upstream-accounts/"+id+"/probe", string(body))
+	if result.Code != http.StatusOK || gjson.GetBytes(result.Body.Bytes(), "account_id").String() != id ||
+		gjson.GetBytes(result.Body.Bytes(), "output_text").String() != "answer" {
+		t.Fatalf("probe status=%d body=%s", result.Code, result.Body.String())
+	}
+	if executor.calls != 1 || len(executor.selected) != 1 || executor.selected[0] != account.ID {
+		t.Fatalf("selected=%v calls=%d", executor.selected, executor.calls)
+	}
+	if gjson.GetBytes(executor.body, "input.0.content.0.text").String() != "fixed question" ||
