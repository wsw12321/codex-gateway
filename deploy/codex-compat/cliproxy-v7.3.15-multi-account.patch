+func (e *conversationRootExecutionCapture) Execute(_ context.Context, _ *Auth, _ cliproxyexecutor.Request, opts cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	e.capture(opts)
+	return cliproxyexecutor.Response{Payload: []byte("ok")}, nil
+}
+
+func (e *conversationRootExecutionCapture) ExecuteStream(_ context.Context, _ *Auth, _ cliproxyexecutor.Request, opts cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error) {
+	e.capture(opts)
+	chunks := make(chan cliproxyexecutor.StreamChunk, 1)
+	chunks <- cliproxyexecutor.StreamChunk{Payload: []byte("ok")}
+	close(chunks)
+	return &cliproxyexecutor.StreamResult{Chunks: chunks}, nil
+}
+
+func (e *conversationRootExecutionCapture) CountTokens(_ context.Context, _ *Auth, _ cliproxyexecutor.Request, opts cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	e.capture(opts)
+	return cliproxyexecutor.Response{Payload: []byte("ok")}, nil
+}
+
+func TestConversationRootInheritedExecutionMetadata(t *testing.T) {
+	for _, mode := range []string{"json", "stream", "count"} {
+		t.Run(mode, func(t *testing.T) {
+			manager, _, _ := newGatewayAccountTestManager(t)
+			capture := &conversationRootExecutionCapture{gatewayPolicyExecutor: gatewayPolicyExecutor{id: "codex"}}
+			manager.RegisterExecutor(capture)
+			scope := uuid.NewString()
+			var rootHash string
+			for _, node := range []struct{ session, parent string }{
+				{session: "session:root"},
+				{session: "session:worker", parent: "session:root"},
+				{session: "session:nested-worker", parent: "session:worker"},
+			} {
+				var published string
+				options := cliproxyexecutor.Options{Metadata: map[string]any{
+					cliproxyexecutor.CallerScopeMetadataKey:              scope,
+					cliproxyexecutor.CanonicalSessionIDMetadataKey:       node.session,
+					cliproxyexecutor.ParentSessionIDMetadataKey:          node.parent,
+					cliproxyexecutor.ConversationHashCallbackMetadataKey: func(hash string) { published = hash },
+				}}
+				request := cliproxyexecutor.Request{Model: "gateway-model"}
+				var err error
+				switch mode {
+				case "stream":
+					var result *cliproxyexecutor.StreamResult
+					result, err = manager.ExecuteStream(context.Background(), []string{"codex"}, request, options)
+					if result != nil {
+						for chunk := range result.Chunks {
+							if chunk.Err != nil {
+								err = chunk.Err
+							}
+						}
+					}
+				case "count":
+					_, err = manager.ExecuteCount(context.Background(), []string{"codex"}, request, options)
+				default:
+					_, err = manager.Execute(context.Background(), []string{"codex"}, request, options)
+				}
+				if err != nil {
+					t.Fatalf("%s execution: %v", node.session, err)
+				}
+				capture.mu.Lock()
+				metadata := cloneRequestMetadata(capture.metadata)
+				capture.mu.Unlock()
+				gotHash, _ := metadata[cliproxyexecutor.ConversationHashMetadataKey].(string)
+				if gotHash == "" || gotHash != published {
+					t.Fatalf("%s executor hash=%q published=%q", node.session, gotHash, published)
+				}
+				if rootHash == "" {
+					rootHash = gotHash
+				} else if gotHash != rootHash {
+					t.Fatalf("%s lost inherited root hash: got=%q root=%q", node.session, gotHash, rootHash)
+				}
+				if got := metadata[cliproxyexecutor.CanonicalSessionIDMetadataKey]; got != node.session {
+					t.Fatalf("%s leaf identity changed: %v", node.session, got)
+				}
+			}
+		})
+	}
+}
+
+func TestConversationRootConcurrentManagerExecutions(t *testing.T) {
+	manager, selector, accounts, _ := newGatewayConcurrencyLimitFixture(t)
+	previousTransport := selector.client.Transport
+	selector.client.Transport = gatewayLimitTransport(func(r *http.Request) (*http.Response, error) {
+		if r.URL.String() == gatewayAllocationURL {
+			return gatewayLimitResponse(http.StatusOK, fmt.Sprintf(`{"account_id":%q}`, gatewayAccountResultIndex(accounts[0]))), nil
+		}
+		return previousTransport.RoundTrip(r)
+	})
+	blocking := &gatewayConcurrencyExecutor{gatewayPolicyExecutor: gatewayPolicyExecutor{id: "codex"}, started: make(chan string, 2), release: make(chan struct{})}
+	manager.RegisterExecutor(blocking)
+	done := make(chan error, 2)
+	defer func() {
+		close(blocking.release)
+		for range 2 {
+			select {
+			case <-done:
+			case <-time.After(2 * time.Second):
+				t.Error("execution cleanup timed out")
+			}
+		}
+	}()
+	scope := t.Name()
+	start := func(session, parent string) {
+		go func() {
+			headers := http.Header{"Session-Id": {session}}
+			if parent != "" {
+				headers.Set("X-Codex-Parent-Thread-Id", parent)
+			}
+			_, err := manager.Execute(context.Background(), []string{"codex"}, cliproxyexecutor.Request{Model: "gateway-model"}, cliproxyexecutor.Options{Headers: headers, Metadata: map[string]any{cliproxyexecutor.CallerScopeMetadataKey: scope, cliproxyexecutor.GatewayUserIDMetadataKey: gatewayTestUserID}})
+			done <- err
+		}()
+	}
+	start("root", "")
+	select {
+	case <-blocking.started:
+	case err := <-done:
+		t.Fatalf("root failed: %v", err)
+	case <-time.After(2 * time.Second):
+		t.Fatal("root did not start")
+	}
+	start("child", "root")
+	select {
+	case <-blocking.started:
+	case err := <-done:
+		t.Fatalf("child failed at account limit: %v", err)
+	case <-time.After(2 * time.Second):
+		t.Fatal("child did not start")
+	}
+	if got := gatewayConcurrencySnapshotCount(t, manager, gatewayAccountResultIndex(accounts[0])); got != 1 {
+		t.Fatalf("manager root count=%d, want 1", got)
+	}
+	// Releasing the executors is deferred; references remain active throughout
+	// both admissions, so passing cannot be an accidentally sequential result.
+}
