+func TestGatewayRefreshPatchCannotCrossCredentialVersion(t *testing.T) {
+	m, base, _ := newGatewayAccountTestManager(t)
+	updated := base.Clone()
+	updated.Metadata["access_token"] = "late-outer-token"
+	updated.CodexRefreshPatch = codexauth.NewCredentialRefreshPatch(base.Metadata, updated.Metadata, true, false)
+	current := base.Clone()
+	current.Metadata["siwc"] = map[string]any{"access_token": "newly-authorized-siwc"}
+	current, err := m.Update(t.Context(), current)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !updated.CodexRefreshPatch.CanApplyTo(current.Metadata) {
+		t.Fatal("fixture must exercise the standalone partial-refresh exception")
+	}
+	if _, err := m.UpdateRefreshedAuth(t.Context(), base, updated); err != nil {
+		t.Fatal(err)
+	}
+	final, _ := m.GetByID(base.ID)
+	if final.CredentialVersion != current.CredentialVersion || authAccessToken(final) != authAccessToken(current) || !reflect.DeepEqual(final.Metadata, current.Metadata) {
+		t.Fatal("late partial refresh changed the reauthorized Gateway credential")
+	}
+}
+
+// Exercise credential and Gateway control versions together: a token refresh
+// may finish after new authorization, account controls, or a new registration.
+func TestGatewayRefreshConcurrentCredentialAndControlChanges(t *testing.T) {
+	outcomes := []struct {
+		name string
+		err  error
+	}{
+		{"success", nil},
+		{"unauthorized", &Error{HTTPStatus: http.StatusUnauthorized, Message: "expired token"}},
+		{"invalid_grant", errors.New("invalid_grant")},
+		{"canceled", context.Canceled},
+	}
+	for _, outcome := range outcomes {
+		for _, change := range []string{"reauthorize", "disable", "disable_enable", "reregister"} {
+			t.Run(outcome.name+"/"+change, func(t *testing.T) {
+				m, candidate, _ := newGatewayAccountTestManager(t)
+				entered, release := make(chan struct{}), make(chan struct{})
+				var once sync.Once
+				releaseRefresh := func() { once.Do(func() { close(release) }) }
+				defer releaseRefresh()
+				exec := &unauthorizedRefreshExecutor{id: "codex", refreshErr: outcome.err, onRefresh: func() { close(entered); <-release }}
+				m.RegisterExecutor(exec)
+				done := make(chan error, 1)
+				go func() { _, err := m.refreshAuthForRequest(context.Background(), candidate.ID, ""); done <- err }()
+				<-entered
+				current := candidate.Clone()
+				switch change {
+				case "reauthorize":
+					current.Metadata["access_token"] = "reauthorized-token"
+					var err error
+					current, err = m.Update(context.Background(), current)
+					if err != nil {
+						t.Fatal(err)
+					}
+				case "disable", "disable_enable":
+					if _, err := m.SetGatewayAccountEnabled(candidate.Index, false); err != nil {
+						t.Fatal(err)
+					}
+					if change == "disable_enable" {
+						if _, err := m.SetGatewayAccountEnabled(candidate.Index, true); err != nil {
+							t.Fatal(err)
+						}
+					}
+					current, _ = m.GetByID(candidate.ID)
+				case "reregister":
+					m.Remove(context.Background(), candidate.ID)
+					current = gatewayRegisterAccount(t, m, candidate.ID, candidate.Metadata["account_id"].(string))
+				}
+				releaseRefresh()
+				err := <-done
+				if outcome.err != nil && err == nil {
+					t.Fatal("refresh error was lost")
+				}
+				final, _ := m.GetByID(candidate.ID)
+				if final.LastError != nil || final.Unavailable || !final.NextRefreshAfter.IsZero() {
+					t.Fatalf("late refresh changed availability: %+v", final)
+				}
+				if final.RegistrationEpoch != current.RegistrationEpoch || final.GatewayAccountVersion != current.GatewayAccountVersion || final.GatewayAccountBlocked != current.GatewayAccountBlocked {
+					t.Fatalf("late refresh changed registration/control: before=%+v after=%+v", current, final)
+				}
+				wantToken := authAccessToken(current)
+				if outcome.err == nil && (change == "disable" || change == "disable_enable") {
+					wantToken = "refreshed-access-token"
+				}
+				if authAccessToken(final) != wantToken {
+					t.Fatalf("token = %q, want %q", authAccessToken(final), wantToken)
+				}
+				if change == "reauthorize" && final.CredentialVersion != current.CredentialVersion {
+					t.Fatal("late refresh advanced new credential version")
+				}
+			})
+		}
+	}
+}
