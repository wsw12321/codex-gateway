index 0000000..dcd3437
--- /dev/null
+++ b/sdk/cliproxy/auth/conversation_root_test.go
@@ -0,0 +1,260 @@
+package auth
+
+import (
+	"context"
+	"net/http"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	cliproxysession "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/session"
+)
+
+func rootRequestMetadata(scope string, headers http.Header, body string) map[string]any {
+	return ensureCanonicalSessionMetadata(map[string]any{cliproxyexecutor.CallerScopeMetadataKey: scope}, headers, []byte(body))
+}
+
+func TestConversationRootRecognizedHierarchy(t *testing.T) {
+	scope := t.Name()
+	root := rootRequestMetadata(scope, http.Header{"Session-Id": {"main"}}, "")
+	want := root[cliproxyexecutor.ConversationHashMetadataKey]
+	for _, tc := range []struct {
+		name    string
+		headers http.Header
+		body    string
+	}{
+		{name: "ultra", headers: http.Header{"Session-Id": {"main"}, "X-Codex-Turn-Metadata": {`{"session_id":"main","thread_id":"worker-thread","parent_thread_id":"main","agent_name":"/root/worker","subagent_kind":"thread_spawn"}`}}},
+		{name: "nested agent", headers: http.Header{"Session-Id": {"main:agent:worker:agent:nested"}}},
+		{name: "fork", headers: http.Header{"Session-Id": {"main"}, "X-Codex-Turn-Metadata": {`{"session_id":"main","thread_id":"fork-thread","forked_from_thread_id":"main"}`}}},
+		{name: "child", headers: http.Header{"Session-Id": {"child"}, "X-Codex-Parent-Thread-Id": {"main"}}},
+		{name: "side", headers: http.Header{"Session-Id": {"main"}, "X-Side-Session-Id": {"side"}}},
+		{name: "grandchild", headers: http.Header{"Session-Id": {"grandchild"}, "X-Codex-Parent-Thread-Id": {"child"}}},
+		{name: "remembered child", headers: http.Header{"Session-Id": {"grandchild"}}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			meta := rootRequestMetadata(scope, tc.headers, tc.body)
+			if got := meta[cliproxyexecutor.ConversationHashMetadataKey]; got != want {
+				t.Fatalf("hash=%v want=%v metadata=%v", got, want, meta)
+			}
+			if meta[cliproxyexecutor.CanonicalSessionIDMetadataKey] == root[cliproxyexecutor.CanonicalSessionIDMetadataKey] {
+				t.Fatal("child lost its leaf affinity identity")
+			}
+		})
+	}
+	for _, meta := range []map[string]any{
+		rootRequestMetadata(scope+"-other", http.Header{"Session-Id": {"main"}}, ""),
+		rootRequestMetadata(scope, http.Header{"Session-Id": {"other"}}, ""),
+	} {
+		if meta[cliproxyexecutor.ConversationHashMetadataKey] == want {
+			t.Fatal("distinct caller/root merged")
+		}
+	}
+}
+
+func TestConversationRootClaudeLongHierarchy(t *testing.T) {
+	for _, length := range []int{8, 240} {
+		session := strings.Repeat("s", length)
+		scope := t.Name() + session
+		main := rootRequestMetadata(scope, http.Header{"X-Claude-Code-Session-Id": {session}}, "")
+		for _, headers := range []http.Header{
+			{"X-Claude-Code-Session-Id": {session}, "X-Claude-Code-Agent-Id": {"worker"}},
+			{"X-Claude-Code-Session-Id": {session}, "X-Claude-Code-Agent-Id": {"nested"}, "X-Claude-Code-Parent-Agent-Id": {"worker"}},
+		} {
+			meta := rootRequestMetadata(scope, headers, "")
+			if meta[cliproxyexecutor.ConversationHashMetadataKey] != main[cliproxyexecutor.ConversationHashMetadataKey] {
+				t.Fatalf("long hierarchy root lost: %v", meta)
+			}
+			canonical := meta[cliproxyexecutor.CanonicalSessionIDMetadataKey].(string)
+			if len(canonical) > 256 {
+				t.Fatalf("affinity canonical no longer bounded: %d", len(canonical))
+			}
+			publishConversationHashMetadata(meta)
+			if meta[cliproxyexecutor.ConversationHashMetadataKey] != main[cliproxyexecutor.ConversationHashMetadataKey] {
+				t.Fatal("publishing compressed leaf lost root")
+			}
+		}
+	}
+}
+
+func TestConversationRootLCPAndInvalidMetadata(t *testing.T) {
+	scope := t.Name()
+	hashes := []any{}
+	for _, pair := range [][2]string{{"lcp:v1:root", ""}, {"lcp:v1:child", "lcp:v1:root"}, {"lcp:v1:grandchild", "lcp:v1:child"}} {
+		meta := map[string]any{cliproxyexecutor.CallerScopeMetadataKey: scope, cliproxyexecutor.CanonicalSessionIDMetadataKey: pair[0], cliproxyexecutor.LCPAffinitySessionIDMetadataKey: pair[0], cliproxyexecutor.ParentSessionIDMetadataKey: pair[1]}
+		meta = ensureCanonicalSessionMetadata(meta, nil, nil)
+		hashes = append(hashes, meta[cliproxyexecutor.ConversationHashMetadataKey])
+	}
+	if hashes[0] == nil || hashes[0] != hashes[1] || hashes[0] != hashes[2] {
+		t.Fatalf("LCP root hashes=%v", hashes)
+	}
+	meta := rootRequestMetadata(scope, http.Header{"Session-Id": {"valid"}}, "")
+	oldHash := meta[cliproxyexecutor.ConversationHashMetadataKey]
+	meta[cliproxyexecutor.CanonicalSessionIDMetadataKey] = "codex:different"
+	meta[cliproxyexecutor.ConversationRootSessionIDMetadataKey] = "caller:" + scope + ":codex:valid"
+	publishConversationHashMetadata(meta)
+	if meta[cliproxyexecutor.ConversationHashMetadataKey] == oldHash {
+		t.Fatal("stale root reused for changed leaf")
+	}
+	for _, parent := range []string{"caller:another-caller:codex:valid", "invalid\nparent"} {
+		meta[cliproxyexecutor.ParentSessionIDMetadataKey] = parent
+		publishConversationHashMetadata(meta)
+		if meta[cliproxyexecutor.ConversationHashMetadataKey] == oldHash {
+			t.Fatal("invalid parent merged with root")
+		}
+	}
+	delete(meta, cliproxyexecutor.CanonicalSessionIDMetadataKey)
+	publishConversationHashMetadata(meta)
+	if meta[cliproxyexecutor.ConversationHashMetadataKey] != nil || meta[cliproxyexecutor.ConversationRootSessionIDMetadataKey] != nil {
+		t.Fatal("identity-free request retained stale root/hash")
+	}
+	if got := rootRequestMetadata(scope, nil, `{}`)[cliproxyexecutor.ConversationHashMetadataKey]; got != nil {
+		t.Fatalf("session-free request hash=%v", got)
+	}
+}
+
+func TestConversationRootRegistryCycleTTLAndCapacity(t *testing.T) {
+	now := time.Now()
+	r := newConversationRootRegistry(3, time.Hour)
+	if got := r.resolve("scope", "a", "b", now); got != "b" {
+		t.Fatal(got)
+	}
+	if got := r.resolve("scope", "b", "a", now); got != "b" {
+		t.Fatalf("cycle root=%q", got)
+	}
+	if got := r.resolve("scope", "a", "", now); got != "a" {
+		t.Fatalf("cycle left stale edge=%q", got)
+	}
+	r.resolve("scope", "a", "root", now)
+	if got := r.resolve("scope", "a", "", now.Add(30*time.Minute)); got != "root" {
+		t.Fatal("lost remembered relation")
+	}
+	if got := r.resolve("other", "a", "", now.Add(30*time.Minute)); got != "a" {
+		t.Fatal("registry leaked caller")
+	}
+	if got := r.resolve("scope", "a", "", now.Add(2*time.Hour)); got != "a" {
+		t.Fatal("expired relation survived")
+	}
+	for _, id := range []string{"a", "b", "c", "d"} {
+		r.resolve("scope", id, "root", now.Add(3*time.Hour))
+	}
+	if len(r.entries) != 3 {
+		t.Fatalf("capacity=%d", len(r.entries))
+	}
+	if got := r.resolve("scope", "a", "", now.Add(3*time.Hour)); got != "a" {
+		t.Fatal("oldest relation not evicted")
+	}
+}
+
+func TestConversationRootRegistryConcurrentAccess(t *testing.T) {
+	r := newConversationRootRegistry(65536, time.Hour)
+	var wg sync.WaitGroup
+	for range 32 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for range 100 {
+				if got := r.resolve("scope", "child:agent:nested", "root:agent:worker", time.Now()); got != "root" {
+					t.Errorf("root=%s", got)
+				}
+			}
+		}()
+	}
+	wg.Wait()
+}
+
+func TestConversationRootRegistrySelfParentClearsOnlyCurrentCallerEdge(t *testing.T) {
+	now := time.Now()
+	r := newConversationRootRegistry(8, time.Hour)
+	r.resolve("other", "child", "other-root", now)
+	if got := r.resolve("scope", "child", "old-root", now); got != "old-root" {
+		t.Fatalf("initial root=%q", got)
+	}
+	if got := r.resolve("scope", "child", "child", now); got != "child" {
+		t.Fatalf("self-parent root=%q", got)
+	}
+	if got := r.resolve("scope", "child", "", now); got != "child" {
+		t.Fatalf("self-parent left stale edge=%q", got)
+	}
+	if got := r.resolve("other", "child", "", now); got != "other-root" {
+		t.Fatalf("self-parent removed another caller's edge=%q", got)
+	}
+}
+
+func TestConversationRootInvalidParentClearsOnlyCurrentCallerEdge(t *testing.T) {
+	for _, test := range []struct{ name, parent string }{
+		{name: "control", parent: "invalid\nparent"},
+		{name: "long", parent: strings.Repeat("p", 4097)},
+		{name: "foreign-caller", parent: "caller:other:codex:root"},
+	} {
+		scope := t.Name() + "-" + test.name
+		metadata := map[string]any{cliproxyexecutor.CallerScopeMetadataKey: scope}
+		otherMetadata := map[string]any{cliproxyexecutor.CallerScopeMetadataKey: scope + "-other"}
+		wantOther := resolveConversationRootSessionID("codex:child", "codex:other-root", otherMetadata)
+		old := resolveConversationRootSessionID("codex:child", "codex:old-root", metadata)
+		wantLeaf := cliproxysession.BoundSessionIdentity("caller:" + scope + ":codex:child")
+		if old == wantLeaf {
+			t.Fatal("initial parent relationship was not recorded")
+		}
+		if got := resolveConversationRootSessionID("codex:child", test.parent, metadata); got != wantLeaf {
+			t.Fatalf("invalid parent root=%q want=%q", got, wantLeaf)
+		}
+		if got := resolveConversationRootSessionID("codex:child", "", metadata); got != wantLeaf {
+			t.Fatalf("invalid parent left stale edge=%q", got)
+		}
+		if got := resolveConversationRootSessionID("codex:child", "", otherMetadata); got != wantOther {
+			t.Fatalf("invalid parent removed another caller's edge=%q want=%q", got, wantOther)
+		}
+	}
+}
+
+func TestConversationRootInterceptorRewritesAndClears(t *testing.T) {
+	for _, mode := range []string{"headers", "body", "clear", "parent-only", "remove-parent"} {
+		t.Run(mode, func(t *testing.T) {
+			scope := t.Name()
+			headers := http.Header{"Session-Id": {"old-child"}, "X-Codex-Parent-Thread-Id": {"old-root"}}
+			meta := rootRequestMetadata(scope, headers, "")
+			originalHash := meta[cliproxyexecutor.ConversationHashMetadataKey]
+			opts := cliproxyexecutor.Options{Headers: headers, Metadata: meta, RequestAfterAuthInterceptor: func(context.Context, cliproxyexecutor.RequestAfterAuthInterceptRequest) cliproxyexecutor.RequestAfterAuthInterceptResponse {
+				switch mode {
+				case "headers":
+					return cliproxyexecutor.RequestAfterAuthInterceptResponse{Headers: http.Header{"Session-Id": {"new-root"}}, ClearHeaders: []string{"X-Codex-Parent-Thread-Id"}}
+				case "body":
+					return cliproxyexecutor.RequestAfterAuthInterceptResponse{Body: []byte(`{"session_id":"new-root"}`), ClearHeaders: []string{"Session-Id", "X-Codex-Parent-Thread-Id"}}
+				case "remove-parent":
+					return cliproxyexecutor.RequestAfterAuthInterceptResponse{ClearHeaders: []string{"X-Codex-Parent-Thread-Id"}}
+				case "parent-only":
+					return cliproxyexecutor.RequestAfterAuthInterceptResponse{Headers: http.Header{"X-Codex-Parent-Thread-Id": {"new-root"}}}
+				default:
+					return cliproxyexecutor.RequestAfterAuthInterceptResponse{ClearHeaders: []string{"Session-Id", "X-Codex-Parent-Thread-Id"}}
+				}
+			}}
+			_, changed, err := applyRequestAfterAuthInterceptor(context.Background(), nil, "codex", cliproxyexecutor.Request{}, opts, "model")
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got := changed.Metadata[cliproxyexecutor.ConversationHashMetadataKey]; got == originalHash {
+				t.Fatal("interceptor retained old root hash")
+			}
+			if mode == "clear" {
+				if changed.Metadata[cliproxyexecutor.ConversationHashMetadataKey] != nil {
+					t.Fatal("cleared request hash survived")
+				}
+				return
+			}
+			prefix := "codex:"
+			if mode == "body" {
+				prefix = "session:"
+			}
+			rootID := "new-root"
+			if mode == "remove-parent" {
+				rootID = "old-child"
+			}
+			wantRoot := cliproxysession.BoundSessionIdentity("caller:" + scope + ":" + prefix + rootID)
+			if got := changed.Metadata[cliproxyexecutor.ConversationRootSessionIDMetadataKey]; got != wantRoot {
+				t.Fatalf("rewritten root=%v want=%s", got, wantRoot)
+			}
+		})
+	}
+}
