new file mode 100644
index 0000000..3fcb1d8
--- /dev/null
+++ b/sdk/cliproxy/auth/conversation_hash_test.go
@@ -0,0 +1,72 @@
+package auth
+
+import (
+	"net/http"
+	"regexp"
+	"testing"
+
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+func TestPublishConversationHashMetadataIsScopedAndOpaque(t *testing.T) {
+	const canonical = "caller:scope-a:codex:session-1"
+	pattern := regexp.MustCompile(`^conv-[0-9a-f]{32}$`)
+	values := make([]string, 0, 5)
+	for _, tc := range []struct {
+		canonical string
+		scope     string
+	}{
+		{canonical: canonical, scope: "scope-a"},
+		{canonical: canonical, scope: "scope-a"},
+		{canonical: canonical, scope: "scope-b"},
+		{canonical: "caller:scope-a:codex:session-2", scope: "scope-a"},
+		{canonical: "lcp:v1:9b8c7d6e", scope: "scope-a"},
+	} {
+		metadata := map[string]any{
+			cliproxyexecutor.CanonicalSessionIDMetadataKey: tc.canonical,
+			cliproxyexecutor.CallerScopeMetadataKey:        tc.scope,
+			cliproxyexecutor.ConversationHashCallbackMetadataKey: func(value string) {
+				values = append(values, value)
+			},
+		}
+		publishConversationHashMetadata(metadata)
+		got, _ := metadata[cliproxyexecutor.ConversationHashMetadataKey].(string)
+		if !pattern.MatchString(got) {
+			t.Fatalf("canonical %q scope %q hash = %q, want conv- plus 32 lowercase hex characters", tc.canonical, tc.scope, got)
+		}
+	}
+	if len(values) != 5 || values[0] != values[1] || values[0] == values[2] || values[0] == values[3] || values[0] == values[4] {
+		t.Fatalf("conversation hash scope/session/LCP behavior = %#v", values)
+	}
+}
+
+func TestPublishConversationHashMetadataClearsWithoutCanonicalIdentity(t *testing.T) {
+	called := "stale"
+	metadata := map[string]any{
+		cliproxyexecutor.ConversationHashMetadataKey:         "conv-0123456789abcdef0123456789abcdef",
+		cliproxyexecutor.ConversationHashCallbackMetadataKey: func(value string) { called = value },
+	}
+	publishConversationHashMetadata(metadata)
+	if called != "" {
+		t.Fatalf("clear callback value = %q, want empty", called)
+	}
+	if _, exists := metadata[cliproxyexecutor.ConversationHashMetadataKey]; exists {
+		t.Fatal("conversation hash metadata survived canonical identity removal")
+	}
+}
+
+func TestEnsureCanonicalSessionMetadataStripsForgedConversationHashHeader(t *testing.T) {
+	headers := http.Header{
+		"X-Session-ID":              []string{"session-1"},
+		"x-codex-conversation-hash": []string{"conv-forged-by-client"},
+	}
+	metadata := ensureCanonicalSessionMetadata(nil, headers, nil)
+	for key := range headers {
+		if regexp.MustCompile(`(?i)^x-codex-conversation-hash$`).MatchString(key) {
+			t.Fatalf("conversation hash request header %q survived, want stripped", key)
+		}
+	}
+	if got, _ := metadata[cliproxyexecutor.CanonicalSessionIDMetadataKey].(string); got == "" {
+		t.Fatal("canonical session identity was not derived after stripping forged hash")
+	}
+}
