+package synthesizer
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+func TestFileSynthesizerIgnoresGatewayAccountState(t *testing.T) {
+	dir := t.TempDir()
+	ctx := &SynthesisContext{Config: &config.Config{}, AuthDir: dir, Now: time.Now(), IDGenerator: NewStableIDGenerator()}
+	payload := []byte(`{"type":"codex","access_token":"token","account_id":"account"}`)
+	for _, name := range []string{coreauth.GatewayAccountStateFile, coreauth.GatewayAccountStateFile + ".tmp.json"} {
+		path := filepath.Join(dir, name)
+		if err := os.WriteFile(path, payload, 0o600); err != nil {
+			t.Fatal(err)
+		}
+		if auths, err := SynthesizeAuthFile(ctx, path, payload); err != nil || len(auths) != 0 {
+			t.Fatalf("state synthesized as OAuth: %v, %v", auths, err)
+		}
+	}
+	if auths, err := NewFileSynthesizer().Synthesize(ctx); err != nil || len(auths) != 0 {
+		t.Fatalf("state directory synthesized as OAuth: %v, %v", auths, err)
+	}
+}
diff --git a/sdk/cliproxy/auth/codex_oauth_dedupe.go b/sdk/cliproxy/auth/codex_oauth_dedupe.go
new file mode 100644
index 0000000..902e96f
--- /dev/null
+++ b/sdk/cliproxy/auth/codex_oauth_dedupe.go
@@ -0,0 +1,350 @@
+package auth
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"strings"
+	"time"
+)
+
+const codexAccountIndexSeedPrefix = "codex-account:"
+
+// SetCodexOAuthAccountIndexSeed binds a file-backed Codex OAuth credential to
+// the intrinsic ChatGPT account identity instead of its local file name.
+func SetCodexOAuthAccountIndexSeed(candidate *Auth, accountID string) {
+	if candidate == nil || !strings.EqualFold(strings.TrimSpace(candidate.Provider), "codex") {
+		return
+	}
+	if candidate.AuthKind() != AuthKindOAuth {
+		return
+	}
+	accountID = strings.TrimSpace(accountID)
+	if !ValidCodexOAuthAccountID(accountID) {
+		if candidate.Attributes != nil {
+			delete(candidate.Attributes, AttributeAuthIndexSeed)
+		}
+		if candidate.Metadata != nil {
+			delete(candidate.Metadata, "account_id")
+		}
+		candidate.Index = ""
+		candidate.indexAssigned = false
+		return
+	}
+	if candidate.Attributes == nil {
+		candidate.Attributes = make(map[string]string)
+	}
+	if candidate.Metadata == nil {
+		candidate.Metadata = make(map[string]any)
+	}
+	digest := sha256.Sum256([]byte(accountID))
+	candidate.Attributes[AttributeAuthIndexSeed] = codexAccountIndexSeedPrefix + hex.EncodeToString(digest[:])
+	candidate.Metadata["account_id"] = accountID
+	// Clear a previously derived path-based index defensively so EnsureIndex
+	// uses the intrinsic account seed.
+	candidate.Index = ""
+	candidate.indexAssigned = false
+}
+
+// ValidCodexOAuthAccountID applies the fixed ASCII contract used both when
+// deriving a stable account index and when sending Chatgpt-Account-Id to the
+// fixed quota endpoint.
+func ValidCodexOAuthAccountID(value string) bool {
+	value = strings.TrimSpace(value)
+	if value == "" || len(value) > 128 {
+		return false
+	}
+	for i := 0; i < len(value); i++ {
+		char := value[i]
+		if char >= 'a' && char <= 'z' || char >= 'A' && char <= 'Z' || char >= '0' && char <= '9' ||
+			char == '-' || char == '_' || char == '.' || char == ':' {
+			continue
+		}
+		return false
+	}
+	return true
+}
+
+// ApplyCodexOAuthAccountIdentity resolves a Codex OAuth account identity from
+// the current top-level account_id and the legacy intrinsic ID-token claim. A
+// malformed identity or conflicting values quarantine the credential; a
+// genuinely missing identity remains routable but deliberately unattributed.
+func ApplyCodexOAuthAccountIdentity(candidate *Auth, metadata map[string]any) bool {
+	if candidate == nil || !strings.EqualFold(strings.TrimSpace(candidate.Provider), "codex") {
+		return false
+	}
+	storage, hasStorageIdentity := candidate.Storage.(interface {
+		CodexOAuthAccountIdentity() (accountID, idToken string)
+	})
+	if candidate.AuthKind() == AuthKindAPIKey || candidate.AuthKind() != AuthKindOAuth && !hasStorageIdentity {
+		return false
+	}
+	if candidate.Attributes == nil {
+		candidate.Attributes = make(map[string]string)
+	}
+	candidate.Attributes[AttributeAuthKind] = AuthKindOAuth
+
+	topID, topPresent, topValid := codexTopLevelAccountID(metadata)
+	claimID, claimPresent, claimValid := codexIDTokenAccountID(metadata)
+	storageID, storageIDPresent, storageIDValid := "", false, true
+	storageClaimID, storageClaimPresent, storageClaimValid := "", false, true
+	if hasStorageIdentity {
+		rawStorageID, storageIDToken := storage.CodexOAuthAccountIdentity()
+		storageID = strings.TrimSpace(rawStorageID)
+		storageIDPresent = storageID != ""
+		storageIDValid = !storageIDPresent || ValidCodexOAuthAccountID(storageID)
+		storageClaimID, storageClaimPresent, storageClaimValid = codexAccountIDFromTokenValue(storageIDToken, strings.TrimSpace(storageIDToken) != "")
+	}
+	identities := make([]string, 0, 4)
+	for _, identity := range []struct {
+		value   string
+		present bool
+		valid   bool
+	}{
+		{value: topID, present: topPresent, valid: topValid},
+		{value: claimID, present: claimPresent, valid: claimValid},
+		{value: storageID, present: storageIDPresent, valid: storageIDValid},
+		{value: storageClaimID, present: storageClaimPresent, valid: storageClaimValid},
+	} {
+		if !identity.valid {
+			quarantineCodexOAuthIdentity(candidate)
+			return false
+		}
+		if identity.present {
+			identities = append(identities, identity.value)
+		}
+	}
+	if len(identities) > 1 {
+		for _, identity := range identities[1:] {
+			if identity != identities[0] {
+				quarantineCodexOAuthIdentity(candidate)
+				return false
+			}
+		}
+	}
+
+	accountID := ""
+	if len(identities) > 0 {
+		accountID = identities[0]
+	}
+	SetCodexOAuthAccountIndexSeed(candidate, accountID)
+	if candidate.Metadata == nil {
+		candidate.Metadata = make(map[string]any)
+	}
+	if accountID == "" {
+		delete(candidate.Metadata, "account_id")
+		return false
+	}
+	candidate.Metadata["account_id"] = accountID
+	return true
+}
+
+func quarantineCodexOAuthIdentity(candidate *Auth) {
+	if candidate == nil {
+		return
+	}
+	SetCodexOAuthAccountIndexSeed(candidate, "")
+	candidate.Disabled = true
+	candidate.Status = StatusDisabled
+	if candidate.Metadata != nil {
+		delete(candidate.Metadata, "account_id")
+	}
+}
+
+func codexTopLevelAccountID(metadata map[string]any) (accountID string, present, valid bool) {
+	if metadata == nil {
+		return "", false, true
+	}
+	raw, present := metadata["account_id"]
+	if !present {
+		return "", false, true
+	}
+	accountID, ok := raw.(string)
+	accountID = strings.TrimSpace(accountID)
+	return accountID, true, ok && ValidCodexOAuthAccountID(accountID)
+}
+
+func codexIDTokenAccountID(metadata map[string]any) (accountID string, present, valid bool) {
+	if metadata == nil {
+		return "", false, true
+	}
+	rawToken, tokenPresent := metadata["id_token"]
+	if !tokenPresent {
+		return "", false, true
+	}
+	token, ok := rawToken.(string)
+	token = strings.TrimSpace(token)
+	if !ok {
+		return "", false, false
+	}
+	return codexAccountIDFromTokenValue(token, true)
+}
+
+func codexAccountIDFromTokenValue(token string, tokenPresent bool) (accountID string, present, valid bool) {
+	token = strings.TrimSpace(token)
+	if !tokenPresent {
+		return "", false, true
+	}
+	if token == "" {
+		return "", false, false
+	}
+	parts := strings.Split(token, ".")
+	if len(parts) != 3 {
+		return "", false, false
+	}
+	payload, err := base64.RawURLEncoding.DecodeString(parts[1])
+	if err != nil {
+		payload, err = base64.URLEncoding.DecodeString(parts[1])
+	}
+	if err != nil {
+		return "", false, false
+	}
+	var claims map[string]any
+	if err = json.Unmarshal(payload, &claims); err != nil {
+		return "", false, false
+	}
+	rawAuth, authPresent := claims["https://api.openai.com/auth"]
+	if !authPresent {
+		return "", false, true
+	}
+	authClaims, ok := rawAuth.(map[string]any)
+	if !ok {
+		return "", false, false
+	}
+	rawAccountID, accountPresent := authClaims["chatgpt_account_id"]
+	if !accountPresent {
+		return "", false, true
+	}
+	accountID, ok = rawAccountID.(string)
+	accountID = strings.TrimSpace(accountID)
+	return accountID, true, ok && ValidCodexOAuthAccountID(accountID)
+}
+
+// CodexOAuthDeduplicationKey returns the high-entropy intrinsic identity used
+// to collapse duplicate OAuth files for one ChatGPT account.
+func CodexOAuthDeduplicationKey(candidate *Auth) (string, bool) {
+	seed, ok := codexOAuthAccountIndexSeed(candidate)
+	if !ok {
+		return "", false
+	}
+	if !strings.EqualFold(strings.TrimSpace(candidate.Attributes[AttributeSourceBackend]), AuthSourceFile) {
+		return "", false
+	}
+	return seed, true
+}
+
+// CodexOAuthAccountIndex returns the stable, non-secret attribution index only
+// when a Codex OAuth credential carries a valid intrinsic account seed. This
+// deliberately rejects EnsureIndex's path/ID fallback so malformed OAuth files
+// cannot produce attributed-but-unlistable phantom accounts.
+func CodexOAuthAccountIndex(candidate *Auth) (string, bool) {
+	seed, ok := codexOAuthAccountIndexSeed(candidate)
+	if !ok {
+		return "", false
+	}
+	expected := stableAuthIndex(AttributeAuthIndexSeed + ":" + seed)
+	if len(expected) != 16 || !isLowerHexString(expected) {
+		return "", false
+	}
+	if existing := strings.TrimSpace(candidate.Index); existing != "" && existing != expected {
+		return "", false
+	}
+	candidate.Index = expected
+	candidate.indexAssigned = true
+	return expected, true
+}
+
+func codexOAuthAccountIndexSeed(candidate *Auth) (string, bool) {
+	if candidate == nil || !strings.EqualFold(strings.TrimSpace(candidate.Provider), "codex") {
+		return "", false
+	}
+	if candidate.AuthKind() != AuthKindOAuth {
+		return "", false
+	}
+	seed := strings.TrimSpace(candidate.Attributes[AttributeAuthIndexSeed])
+	if !strings.HasPrefix(seed, codexAccountIndexSeedPrefix) {
+		return "", false
+	}
+	digest := strings.TrimPrefix(seed, codexAccountIndexSeedPrefix)
+	if len(digest) != sha256.Size*2 || !isLowerHexString(digest) {
+		return "", false
+	}
+	accountID, ok := candidate.Metadata["account_id"].(string)
+	accountID = strings.TrimSpace(accountID)
+	if !ok || !ValidCodexOAuthAccountID(accountID) {
+		return "", false
+	}
+	expected := sha256.Sum256([]byte(accountID))
+	if digest != hex.EncodeToString(expected[:]) {
+		return "", false
+	}
+	return seed, true
+}
+
+// DeduplicateCodexOAuthAuths keeps one routable file credential for each real
+// ChatGPT account. The most recent last_refresh wins; equal or missing refresh
+// timestamps use the auth ID as a deterministic tie-breaker. Non-Codex and
+// non-file credentials retain their original order and multiplicity.
+func DeduplicateCodexOAuthAuths(auths []*Auth) []*Auth {
+	quarantineDuplicateAntigravityIdentities(auths)
+	quarantineDuplicateAnthropicIdentities(auths)
+	if len(auths) < 2 {
+		return auths
+	}
+	out := make([]*Auth, 0, len(auths))
+	positions := make(map[string]int)
+	for _, candidate := range auths {
+		key, deduplicate := CodexOAuthDeduplicationKey(candidate)
+		if !deduplicate {
+			out = append(out, candidate)
+			continue
+		}
+		position, exists := positions[key]
+		if !exists {
+			positions[key] = len(out)
+			out = append(out, candidate)
+			continue
+		}
+		if preferCodexOAuthCandidate(candidate, out[position]) {
+			out[position] = candidate
+		}
+	}
+	return out
+}
+
+func preferCodexOAuthCandidate(candidate, current *Auth) bool {
+	candidateRefresh, candidateHasRefresh := codexOAuthRefreshTime(candidate)
+	currentRefresh, currentHasRefresh := codexOAuthRefreshTime(current)
+	if candidateHasRefresh != currentHasRefresh {
+		return candidateHasRefresh
+	}
+	if candidateHasRefresh && !candidateRefresh.Equal(currentRefresh) {
+		return candidateRefresh.After(currentRefresh)
+	}
+	candidateID := strings.TrimSpace(candidate.ID)
+	currentID := strings.TrimSpace(current.ID)
+	if candidateID != currentID {
+		return candidateID < currentID
+	}
+	return false
+}
+
+func codexOAuthRefreshTime(candidate *Auth) (time.Time, bool) {
+	if refresh, ok := authLastRefreshTimestamp(candidate); ok && !refresh.IsZero() {
+		return refresh.UTC(), true
+	}
+	if candidate != nil && !candidate.LastRefreshedAt.IsZero() {
+		return candidate.LastRefreshedAt.UTC(), true
+	}
+	return time.Time{}, false
+}
+
+func isLowerHexString(value string) bool {
+	for _, char := range value {
+		if (char < '0' || char > '9') && (char < 'a' || char > 'f') {
+			return false
+		}
+	}
+	return value != ""
+}
diff --git a/sdk/cliproxy/auth/codex_oauth_dedupe_test.go b/sdk/cliproxy/auth/codex_oauth_dedupe_test.go
new file mode 100644
index 0000000..d89da81
--- /dev/null
+++ b/sdk/cliproxy/auth/codex_oauth_dedupe_test.go
@@ -0,0 +1,358 @@
+package auth
+
+import (
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"strings"
+	"testing"
+	"time"
+)
+
+type codexOAuthDedupeStore struct {
+	auths []*Auth
+}
+
+type codexOAuthIdentityStorage struct {
+	accountID string
+	idToken   string
+}
+
+func (*codexOAuthIdentityStorage) SaveTokenToFile(string) error { return nil }
+
+func (s *codexOAuthIdentityStorage) CodexOAuthAccountIdentity() (string, string) {
+	return s.accountID, s.idToken
+}
+
+func (s *codexOAuthDedupeStore) List(context.Context) ([]*Auth, error) {
+	return s.auths, nil
+}
+
+func (*codexOAuthDedupeStore) Save(context.Context, *Auth) (string, error) {
+	return "", nil
+}
+
+func (*codexOAuthDedupeStore) Delete(context.Context, string) error {
+	return nil
+}
+
+func TestDeduplicateCodexOAuthAuthsPrefersNewestRefreshDeterministically(t *testing.T) {
+	older := codexOAuthDedupeAuth("z-old.json", "same-account", "2026-08-20T10:00:00Z")
+	newer := codexOAuthDedupeAuth("y-new.json", "same-account", "2026-08-21T10:00:00Z")
+	tieWinner := codexOAuthDedupeAuth("a-tie.json", "same-account", "2026-08-21T10:00:00Z")
+	other := codexOAuthDedupeAuth("other.json", "other-account", "2026-08-19T10:00:00Z")
+	nonFile := codexOAuthDedupeAuth("runtime", "same-account", "2026-08-22T10:00:00Z")
+	nonFile.Attributes[AttributeSourceBackend] = AuthSourceMemory
+
+	for _, input := range [][]*Auth{
+		{older, tieWinner, newer, other, nonFile},
+		{nonFile, other, newer, older, tieWinner},
+	} {
+		got := DeduplicateCodexOAuthAuths(input)
+		if len(got) != 3 {
+			t.Fatalf("DeduplicateCodexOAuthAuths() len = %d, want 3", len(got))
+		}
+		ids := make(map[string]bool, len(got))
+		for _, auth := range got {
+			ids[auth.ID] = true
+		}
+		if !ids[tieWinner.ID] || !ids[other.ID] || !ids[nonFile.ID] {
+			t.Fatalf("deduplicated IDs = %#v, want tie winner, other account, and runtime auth", ids)
+		}
+		if ids[older.ID] || ids[newer.ID] {
+			t.Fatalf("stale duplicate remained: %#v", ids)
+		}
+	}
+}
+
+func TestManagerLoadDoesNotDoubleWeightDuplicateCodexOAuthFiles(t *testing.T) {
+	older := codexOAuthDedupeAuth("old-plus.json", "same-account", "2026-08-20T10:00:00Z")
+	newer := codexOAuthDedupeAuth("new-pro.json", "same-account", "2026-08-21T10:00:00Z")
+	manager := NewManager(&codexOAuthDedupeStore{auths: []*Auth{older, newer}}, nil, nil)
+
+	if err := manager.Load(context.Background()); err != nil {
+		t.Fatalf("Load() error = %v", err)
+	}
+	list := manager.List()
+	if len(list) != 1 || list[0].ID != newer.ID {
+		t.Fatalf("loaded auths = %#v, want only %q", list, newer.ID)
+	}
+	if got := list[0].EnsureIndex(); got == "" || got != older.EnsureIndex() {
+		t.Fatalf("stable account index = %q, older = %q", got, older.EnsureIndex())
+	}
+}
+
+func TestSetCodexOAuthAccountIndexSeedReplacesPathDerivedIndex(t *testing.T) {
+	auth := &Auth{
+		ID:       "before.json",
+		Provider: "codex",
+		Metadata: map[string]any{"access_token": "token"},
+		Attributes: map[string]string{
+			AttributeSourceBackend: AuthSourceFile,
+			AttributePath:          "/tokens/before.json",
+		},
+	}
+	pathIndex := auth.EnsureIndex()
+	SetCodexOAuthAccountIndexSeed(auth, "account-id")
+	accountIndex := auth.EnsureIndex()
+	if accountIndex == "" || accountIndex == pathIndex {
+		t.Fatalf("account index = %q, path index = %q", accountIndex, pathIndex)
+	}
+}
+
+func TestSetCodexOAuthAccountIndexSeedRejectsUnsafeAccountID(t *testing.T) {
+	auth := &Auth{
+		ID:       "unsafe.json",
+		Provider: "codex",
+		Metadata: map[string]any{"access_token": "token"},
+		Attributes: map[string]string{
+			AttributeSourceBackend: AuthSourceFile,
+			AttributePath:          "/tokens/unsafe.json",
+		},
+	}
+	SetCodexOAuthAccountIndexSeed(auth, "safe-account")
+	if _, ok := CodexOAuthAccountIndex(auth); !ok {
+		t.Fatal("safe account ID did not produce an intrinsic account index")
+	}
+
+	SetCodexOAuthAccountIndexSeed(auth, "unsafe/account\r\nX-Leak: token")
+	if seed := auth.Attributes[AttributeAuthIndexSeed]; seed != "" {
+		t.Fatalf("unsafe account ID retained seed %q", seed)
+	}
+	if index, ok := CodexOAuthAccountIndex(auth); ok || index != "" {
+		t.Fatalf("unsafe account ID produced attributable index %q", index)
+	}
+}
+
+func TestValidCodexOAuthAccountID(t *testing.T) {
+	for _, test := range []struct {
+		value string
+		want  bool
+	}{
+		{value: "account-123:workspace_1", want: true},
+		{value: "", want: false},
+		{value: "account/123", want: false},
+		{value: "account-123\r\nX-Leak: token", want: false},
+		{value: strings.Repeat("a", 129), want: false},
+	} {
+		if got := ValidCodexOAuthAccountID(test.value); got != test.want {
+			t.Fatalf("ValidCodexOAuthAccountID(%q) = %t, want %t", test.value, got, test.want)
+		}
+	}
+}
+
+func TestApplyCodexOAuthAccountIdentitySupportsLegacyClaimAndRejectsConflict(t *testing.T) {
+	for _, test := range []struct {
+		name         string
+		metadata     map[string]any
+		wantAccount  bool
+		wantDisabled bool
+	}{
+		{
+			name:        "top level only",
+			metadata:    map[string]any{"access_token": "token", "account_id": "account-a"},
+			wantAccount: true,
+		},
+		{
+			name:        "legacy claim only",
+			metadata:    map[string]any{"access_token": "token", "id_token": codexAccountJWT(t, "account-a")},
+			wantAccount: true,
+		},
+		{
+			name:        "matching top level and claim",
+			metadata:    map[string]any{"access_token": "token", "account_id": "account-a", "id_token": codexAccountJWT(t, "account-a")},
+			wantAccount: true,
+		},
+		{
+			name:         "conflicting top level and claim",
+			metadata:     map[string]any{"access_token": "token", "account_id": "account-a", "id_token": codexAccountJWT(t, "account-b")},
+			wantDisabled: true,
+		},
+		{
+			name:         "unsafe top level",
+			metadata:     map[string]any{"access_token": "token", "account_id": "account/a", "id_token": codexAccountJWT(t, "account-a")},
+			wantDisabled: true,
+		},
+		{
+			name:         "malformed ID token",
+			metadata:     map[string]any{"access_token": "token", "id_token": "not-a-jwt"},
+			wantDisabled: true,
+		},
+		{
+			name:     "missing identity stays unattributed",
+			metadata: map[string]any{"access_token": "token"},
+		},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			candidate := &Auth{
+				ID:         "codex.json",
+				Provider:   "codex",
+				Status:     StatusActive,
+				Metadata:   test.metadata,
+				Attributes: map[string]string{AttributeSourceBackend: AuthSourceFile},
+			}
+			gotAccount := ApplyCodexOAuthAccountIdentity(candidate, test.metadata)
+			if gotAccount != test.wantAccount {
+				t.Fatalf("ApplyCodexOAuthAccountIdentity() = %t, want %t", gotAccount, test.wantAccount)
+			}
+			if candidate.Disabled != test.wantDisabled || (test.wantDisabled && candidate.Status != StatusDisabled) {
+				t.Fatalf("disabled/status = %t/%q, want disabled=%t", candidate.Disabled, candidate.Status, test.wantDisabled)
+			}
+			index, attributable := CodexOAuthAccountIndex(candidate)
+			if attributable != test.wantAccount || (test.wantAccount && index == "") {
+				t.Fatalf("CodexOAuthAccountIndex() = %q, %t, want attributable=%t", index, attributable, test.wantAccount)
+			}
+		})
+	}
+}
