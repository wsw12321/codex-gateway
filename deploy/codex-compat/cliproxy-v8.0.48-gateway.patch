+package auth
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+func gatewayRootOptions(hash string) cliproxyexecutor.Options {
+	return cliproxyexecutor.Options{Metadata: map[string]any{
+		cliproxyexecutor.ConversationHashMetadataKey: hash,
+	}}
+}
+
+func TestGatewayConcurrencyDeduplicatesRootExecutions(t *testing.T) {
+	manager, _, accounts, _ := newGatewayConcurrencyLimitFixture(t)
+	account := accounts[0]
+	accountID := gatewayAccountResultIndex(account)
+	first, err := manager.tryBeginGatewayExecution(context.Background(), account, gatewayRootOptions("conv-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
+	if err != nil {
+		t.Fatalf("first root execution: %v", err)
+	}
+	second, err := manager.tryBeginGatewayExecution(context.Background(), account, gatewayRootOptions("conv-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
+	if err != nil {
+		t.Fatalf("second execution of same root: %v", err)
+	}
+	if got := gatewayConcurrencySnapshotCount(t, manager, accountID); got != 1 {
+		t.Fatalf("same-root active count = %d, want 1", got)
+	}
+	first()
+	if got := gatewayConcurrencySnapshotCount(t, manager, accountID); got != 1 {
+		t.Fatalf("count after first reference release = %d, want 1", got)
+	}
+	first() // release is idempotent and must not consume the second reference.
+	second()
+	if got := gatewayConcurrencySnapshotCount(t, manager, accountID); got != 0 {
+		t.Fatalf("count after final root release = %d, want 0", got)
+	}
+}
+
+func TestGatewayConcurrencyRejectsDifferentRootAtLimit(t *testing.T) {
+	manager, _, accounts, _ := newGatewayConcurrencyLimitFixture(t)
+	account := accounts[0]
+	accountID := gatewayAccountResultIndex(account)
+	release, err := manager.tryBeginGatewayExecution(context.Background(), account, gatewayRootOptions("conv-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
+	if err != nil {
+		t.Fatalf("first root execution: %v", err)
+	}
+	defer release()
+	if _, err := manager.tryBeginGatewayExecution(context.Background(), account, gatewayRootOptions("conv-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")); err == nil {
+		t.Fatal("different root bypassed account limit")
+	} else {
+		assertGatewayConcurrency429(t, err)
+	}
+	if got := gatewayConcurrencySnapshotCount(t, manager, accountID); got != 1 {
+		t.Fatalf("different-root rejection changed count = %d, want 1", got)
+	}
+}
+
+func TestGatewayConcurrencySameRootCountsPerAccount(t *testing.T) {
+	manager, _, accounts, _ := newGatewayConcurrencyLimitFixture(t)
+	root := gatewayRootOptions("conv-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
+	first, err := manager.tryBeginGatewayExecution(context.Background(), accounts[0], root)
+	if err != nil {
+		t.Fatalf("first account execution: %v", err)
+	}
+	second, err := manager.tryBeginGatewayExecution(context.Background(), accounts[1], root)
+	if err != nil {
+		t.Fatalf("second account execution: %v", err)
+	}
+	if got := gatewayConcurrencySnapshotCount(t, manager, gatewayAccountResultIndex(accounts[0])); got != 1 {
+		t.Fatalf("first account count = %d, want 1", got)
+	}
+	if got := gatewayConcurrencySnapshotCount(t, manager, gatewayAccountResultIndex(accounts[1])); got != 1 {
+		t.Fatalf("second account count = %d, want 1", got)
+	}
+	first()
+	second()
+}
+
+func TestGatewayConcurrencyParallelJSONSameRootSharesOneSlot(t *testing.T) {
+	manager, _, accounts, _ := newGatewayConcurrencyLimitFixture(t)
+	account := accounts[0]
+	executor := &gatewayConcurrencyExecutor{
+		gatewayPolicyExecutor: gatewayPolicyExecutor{id: "codex"},
+		started:               make(chan string, 2),
+		release:               make(chan struct{}),
+	}
+	root := gatewayRootOptions("conv-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
+	results := make(chan error, 2)
+	for range 2 {
+		go func() {
+			_, err := manager.executeGatewayAttempt(context.Background(), executor, account, cliproxyexecutor.Request{}, root, false)
+			results <- err
+		}()
+	}
+	for range 2 {
+		select {
+		case <-executor.started:
+		case <-time.After(2 * time.Second):
+			t.Fatal("same-root JSON execution did not start")
+		}
+	}
+	if got := gatewayConcurrencySnapshotCount(t, manager, gatewayAccountResultIndex(account)); got != 1 {
+		t.Fatalf("same-root JSON active count = %d, want 1", got)
+	}
+	close(executor.release)
+	for range 2 {
+		if err := <-results; err != nil {
+			t.Fatalf("same-root JSON execution: %v", err)
+		}
+	}
+	if got := gatewayConcurrencySnapshotCount(t, manager, gatewayAccountResultIndex(account)); got != 0 {
+		t.Fatalf("same-root JSON final count = %d, want 0", got)
+	}
+}
+
+type heldRootStreamExecutor struct {
+	gatewayPolicyExecutor
+	started   chan struct{}
+	bootstrap chan struct{}
+	sources   chan chan cliproxyexecutor.StreamChunk
+}
+
+func (e *heldRootStreamExecutor) ExecuteStream(ctx context.Context, _ *Auth, _ cliproxyexecutor.Request, _ cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error) {
+	e.started <- struct{}{}
+	select {
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	case <-e.bootstrap:
+	}
+	source := make(chan cliproxyexecutor.StreamChunk)
+	e.sources <- source
+	return &cliproxyexecutor.StreamResult{Chunks: source}, nil
+}
+
+func TestGatewayConcurrencyParallelSSESameRootSharesOneSlot(t *testing.T) {
+	manager, _, accounts, _ := newGatewayConcurrencyLimitFixture(t)
+	account := accounts[0]
+	executor := &heldRootStreamExecutor{
+		gatewayPolicyExecutor: gatewayPolicyExecutor{id: "codex"},
+		started:               make(chan struct{}, 2),
+		bootstrap:             make(chan struct{}),
+		sources:               make(chan chan cliproxyexecutor.StreamChunk, 2),
+	}
+	root := gatewayRootOptions("conv-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
+	results := make(chan *cliproxyexecutor.StreamResult, 2)
+	errorsOut := make(chan error, 2)
+	for range 2 {
+		go func() {
+			result, err := manager.executeGatewayStreamAttempt(context.Background(), executor, account, cliproxyexecutor.Request{}, root)
+			results <- result
+			errorsOut <- err
+		}()
+	}
+	for range 2 {
+		select {
+		case <-executor.started:
+		case <-time.After(2 * time.Second):
+			t.Fatal("same-root SSE execution did not start")
+		}
+	}
+	close(executor.bootstrap)
+	sources := []chan cliproxyexecutor.StreamChunk{<-executor.sources, <-executor.sources}
+	streams := []*cliproxyexecutor.StreamResult{<-results, <-results}
+	for i, err := range []error{<-errorsOut, <-errorsOut} {
+		if err != nil || streams[i] == nil || streams[i].Chunks == nil {
+			t.Fatalf("same-root SSE execution %d: result=%v err=%v", i, streams[i], err)
+		}
+	}
+	if got := gatewayConcurrencySnapshotCount(t, manager, gatewayAccountResultIndex(account)); got != 1 {
+		t.Fatalf("same-root SSE active count = %d, want 1", got)
+	}
+	for _, source := range sources {
+		close(source)
+	}
+	for _, stream := range streams {
+		for range stream.Chunks {
+		}
+	}
+	if got := gatewayConcurrencySnapshotCount(t, manager, gatewayAccountResultIndex(account)); got != 0 {
+		t.Fatalf("same-root SSE final count = %d, want 0", got)
+	}
+}
+
+func TestGatewayConcurrencyRootFailureCancelAndRetryReleaseReferences(t *testing.T) {
+	manager, _, accounts, _ := newGatewayConcurrencyLimitFixture(t)
+	account := accounts[0]
+	root := gatewayRootOptions("conv-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
+	executor := &gatewayPolicyExecutor{id: "codex", err: errors.New("upstream failed")}
+	if _, err := manager.executeGatewayAttempt(context.Background(), executor, account, cliproxyexecutor.Request{}, root, false); err == nil {
+		t.Fatal("failed root execution returned nil error")
+	}
+	if got := gatewayConcurrencySnapshotCount(t, manager, gatewayAccountResultIndex(account)); got != 0 {
+		t.Fatalf("failed root leaked count = %d", got)
+	}
+	executor.err = nil
+	if _, err := manager.executeGatewayAttempt(context.Background(), executor, account, cliproxyexecutor.Request{}, root, false); err != nil {
+		t.Fatalf("retry root execution: %v", err)
+	}
+	if got := gatewayConcurrencySnapshotCount(t, manager, gatewayAccountResultIndex(account)); got != 0 {
+		t.Fatalf("retried root leaked count = %d", got)
+	}
+
+	blocking := &gatewayConcurrencyExecutor{
+		gatewayPolicyExecutor: gatewayPolicyExecutor{id: "codex"},
+		started:               make(chan string, 1),
+		release:               make(chan struct{}),
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	result := make(chan error, 1)
+	go func() {
+		_, err := manager.executeGatewayAttempt(ctx, blocking, account, cliproxyexecutor.Request{}, root, false)
+		result <- err
+	}()
+	select {
+	case <-blocking.started:
+	case <-time.After(2 * time.Second):
+		t.Fatal("cancel test execution did not start")
+	}
+	if got := gatewayConcurrencySnapshotCount(t, manager, gatewayAccountResultIndex(account)); got != 1 {
+		t.Fatalf("cancel test active count = %d, want 1", got)
+	}
+	cancel()
+	if err := <-result; !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancel test error = %v, want context canceled", err)
+	}
+	if got := gatewayConcurrencySnapshotCount(t, manager, gatewayAccountResultIndex(account)); got != 0 {
+		t.Fatalf("cancelled root leaked count = %d", got)
+	}
+}
+
+func TestGatewayConcurrencyMalformedConversationHashFallsBackToExecution(t *testing.T) {
+	manager, _, accounts, _ := newGatewayConcurrencyLimitFixture(t)
+	account := accounts[0]
+	malformed := gatewayRootOptions("conv-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA")
+	first, err := manager.tryBeginGatewayExecution(context.Background(), account, malformed)
+	if err != nil {
+		t.Fatalf("first malformed-hash execution: %v", err)
+	}
+	defer first()
+	if _, err := manager.tryBeginGatewayExecution(context.Background(), account, malformed); err == nil {
+		t.Fatal("malformed hashes were incorrectly deduplicated")
+	} else {
+		assertGatewayConcurrency429(t, err)
+	}
+}
