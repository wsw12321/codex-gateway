+type gatewayAllocationTransport func(*http.Request) (*http.Response, error)
+
+func (f gatewayAllocationTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	if r.URL.String() == gatewayEligibilityURL {
+		var request struct {
+			AccountIDs []string `json:"account_ids"`
+			UserID     string   `json:"user_id"`
+		}
+		if err := json.NewDecoder(r.Body).Decode(&request); err != nil || request.UserID != "00000000-0000-0000-0000-000000000001" {
+			return allocationResponse(400, `{}`), nil
+		}
+		accounts := make([]map[string]any, 0, len(request.AccountIDs))
+		for _, id := range request.AccountIDs {
+			accounts = append(accounts, map[string]any{"id": id, "concurrent_limit": 1})
+		}
+		data, _ := json.Marshal(map[string]any{"accounts": accounts})
+		return allocationResponse(200, string(data)), nil
+	}
+	return f(r)
+}
+
+func allocationResponse(status int, body string) *http.Response {
+	return &http.Response{StatusCode: status, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(body))}
+}
