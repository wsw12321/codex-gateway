+package auth
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+type gatewayConcurrencyExecutor struct {
+	gatewayPolicyExecutor
+	started chan string
+	release chan struct{}
+	chunks  chan cliproxyexecutor.StreamChunk
+}
+
+func (e *gatewayConcurrencyExecutor) Execute(ctx context.Context, candidate *Auth, _ cliproxyexecutor.Request, _ cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	e.started <- candidate.ID
+	select {
+	case <-ctx.Done():
+		return cliproxyexecutor.Response{}, ctx.Err()
+	case <-e.release:
+		return cliproxyexecutor.Response{Payload: []byte("ok")}, e.err
+	}
+}
+func (e *gatewayConcurrencyExecutor) ExecuteStream(ctx context.Context, candidate *Auth, _ cliproxyexecutor.Request, _ cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error) {
+	e.started <- candidate.ID
+	select {
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	case <-e.release:
+	}
+	if e.err != nil {
+		return nil, e.err
+	}
+	return &cliproxyexecutor.StreamResult{Chunks: e.chunks}, nil
+}
+func concurrencyCount(t *testing.T, m *Manager, id string) int64 {
+	t.Helper()
+	snapshot := m.GatewayConcurrency()
+	if snapshot.SampledAt.IsZero() {
+		t.Fatal("missing sample time")
+	}
+	for _, item := range snapshot.Accounts {
+		if item.ID == id {
+			return item.ActiveRequests
+		}
+	}
+	t.Fatalf("registered account %s absent from snapshot %+v", id, snapshot)
+	return -1
+}
+func awaitConcurrency(t *testing.T, m *Manager, id string, want int64) {
+	t.Helper()
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		if concurrencyCount(t, m, id) == want {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatalf("count=%d want=%d", concurrencyCount(t, m, id), want)
+}
+func TestGatewayConcurrencyWaitingSimultaneousAndDisabled(t *testing.T) {
+	m, a, _ := newGatewayAccountTestManager(t)
+	executor := &gatewayConcurrencyExecutor{gatewayPolicyExecutor: gatewayPolicyExecutor{id: "codex"}, started: make(chan string, 2), release: make(chan struct{})}
+	m.RegisterExecutor(executor)
+	var wg sync.WaitGroup
+	for range 2 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			_, err := m.Execute(context.Background(), []string{"codex"}, cliproxyexecutor.Request{Model: "gateway-model"}, cliproxyexecutor.Options{})
+			if err != nil {
+				t.Error(err)
+			}
+		}()
+	}
+	for range 2 {
+		select {
+		case <-executor.started:
+		case <-time.After(2 * time.Second):
+			t.Fatal("execution did not start")
+		}
+	}
+	if got := concurrencyCount(t, m, a.Index); got != 2 {
+		t.Fatalf("waiting count=%d", got)
+	}
+	if _, err := m.SetGatewayAccountEnabled(a.Index, false); err != nil {
+		t.Fatal(err)
+	}
+	if got := concurrencyCount(t, m, a.Index); got != 2 {
+		t.Fatalf("disable hid in-flight requests: %d", got)
+	}
+	close(executor.release)
+	wg.Wait()
+	awaitConcurrency(t, m, a.Index, 0)
+}
+func TestGatewayConcurrencyStreamWaitOutputCloseCancelAndFailure(t *testing.T) {
+	for _, mode := range []string{"close", "cancel", "deadline", "error", "bootstrap-failure"} {
+		t.Run(mode, func(t *testing.T) {
+			m, a, _ := newGatewayAccountTestManager(t)
+			executor := &gatewayConcurrencyExecutor{gatewayPolicyExecutor: gatewayPolicyExecutor{id: "codex"}, started: make(chan string, 1), release: make(chan struct{}), chunks: make(chan cliproxyexecutor.StreamChunk, 2)}
+			if mode == "bootstrap-failure" {
+				executor.err = errors.New("failed")
+			}
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			if mode == "deadline" {
+				var deadlineCancel context.CancelFunc
+				ctx, deadlineCancel = context.WithTimeout(context.Background(), 200*time.Millisecond)
+				defer deadlineCancel()
+			}
+			ready := make(chan *cliproxyexecutor.StreamResult, 1)
+			go func() {
+				result, _ := m.executeGatewayStreamAttempt(ctx, executor, a, cliproxyexecutor.Request{}, cliproxyexecutor.Options{})
+				ready <- result
+			}()
+			<-executor.started
+			if got := concurrencyCount(t, m, a.Index); got != 1 {
+				t.Fatalf("first response wait count=%d", got)
+			}
+			close(executor.release)
+			result := <-ready
+			if mode == "bootstrap-failure" {
+				awaitConcurrency(t, m, a.Index, 0)
+				return
+			}
+			executor.chunks <- cliproxyexecutor.StreamChunk{Payload: []byte("first")}
+			<-result.Chunks
+			if got := concurrencyCount(t, m, a.Index); got != 1 {
+				t.Fatalf("stream count=%d", got)
+			}
+			switch mode {
+			case "close":
+				close(executor.chunks)
+			case "cancel":
+				cancel()
+			case "deadline":
+				<-ctx.Done()
+			case "error":
+				executor.chunks <- cliproxyexecutor.StreamChunk{Err: errors.New("stream failed")}
+				close(executor.chunks)
+			}
+			for range result.Chunks {
+			}
+			awaitConcurrency(t, m, a.Index, 0)
+		})
+	}
+}
+func TestGatewayConcurrencyRepeatedReleaseAndRaces(t *testing.T) {
+	m, a, _ := newGatewayAccountTestManager(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	release := m.beginGatewayExecution(ctx, a, cliproxyexecutor.Options{})
+	var wg sync.WaitGroup
+	for range 64 {
+		wg.Add(1)
+		go func() { defer wg.Done(); release(); _ = m.GatewayConcurrency() }()
+	}
+	cancel()
+	wg.Wait()
+	awaitConcurrency(t, m, a.Index, 0)
+	var calls sync.WaitGroup
+	for range 64 {
+		calls.Add(1)
+		go func() {
+			defer calls.Done()
+			end := m.beginGatewayExecution(context.Background(), a, cliproxyexecutor.Options{})
+			_ = m.GatewayConcurrency()
+			end()
+			end()
+		}()
+	}
+	calls.Wait()
+	awaitConcurrency(t, m, a.Index, 0)
+}
+
+func TestGatewayConcurrencyFailoverSettlesEachAccount(t *testing.T) {
+	m, a, _ := newGatewayAccountTestManager(t)
+	b := gatewayRegisterAccount(t, m, "concurrency-b-"+a.ID, "concurrency-b-"+a.ID)
+	executor := &gatewayPolicyExecutor{id: "codex", err: errors.New("failed")}
+	for _, stream := range []bool{false, true} {
+		if stream {
+			result, _ := m.executeGatewayStreamAttempt(context.Background(), executor, a, cliproxyexecutor.Request{}, cliproxyexecutor.Options{})
+			for range result.Chunks {
+			}
+		} else {
+			_, _ = m.executeGatewayAttempt(context.Background(), executor, a, cliproxyexecutor.Request{}, cliproxyexecutor.Options{}, false)
+		}
+		if got := concurrencyCount(t, m, a.Index); got != 0 {
+			t.Fatalf("failed attempt remained active: %d", got)
+		}
+		release := m.beginGatewayExecution(context.Background(), b, cliproxyexecutor.Options{})
+		if concurrencyCount(t, m, a.Index) != 0 || concurrencyCount(t, m, b.Index) != 1 {
+			t.Fatal("retry counted under previous account")
+		}
+		release()
+	}
+}
+
+func TestGatewayConcurrencyFailedAndCancelledFinalAttribution(t *testing.T) {
+	for _, stream := range []bool{false, true} {
+		for _, failure := range []struct {
+			name     string
+			err      error
+			attempts int
+		}{
+			{name: "client failure", err: &Error{HTTPStatus: 400}, attempts: 1},
+			{name: "cancelled", err: context.Canceled, attempts: 1},
+			{name: "all accounts failed", err: &Error{HTTPStatus: 502}, attempts: 2},
+		} {
+			t.Run(failure.name+map[bool]string{false: "/json", true: "/stream"}[stream], func(t *testing.T) {
+				m, a, _ := newGatewayAccountTestManager(t)
+				gatewayRegisterAccount(t, m, "attribution-b-"+a.ID, "attribution-b-"+a.ID)
+				executor := &gatewayPolicyExecutor{id: "codex", err: failure.err}
+				m.RegisterExecutor(executor)
+				var attributed string
+				opts := cliproxyexecutor.Options{Metadata: map[string]any{cliproxyexecutor.UpstreamAccountIndexCallbackMetadataKey: func(id string) { attributed = id }}}
+				var err error
+				request := cliproxyexecutor.Request{Model: "gateway-model"}
+				if stream {
+					var result *cliproxyexecutor.StreamResult
+					result, err = m.ExecuteStream(context.Background(), []string{"codex"}, request, opts)
+					if result != nil {
+						for chunk := range result.Chunks {
+							if chunk.Err != nil {
+								err = chunk.Err
+							}
+						}
+					}
+				} else {
+					_, err = m.Execute(context.Background(), []string{"codex"}, request, opts)
+				}
+				calls := executor.Calls()
+				if err == nil || len(calls) != failure.attempts {
+					t.Fatalf("calls=%v error=%v", calls, err)
+				}
+				last, ok := m.GetByID(calls[len(calls)-1])
+				if !ok {
+					t.Fatal("last attempted account missing")
+				}
+				if attributed != last.Index {
+					t.Fatalf("attributed=%s want last attempt=%s", attributed, last.Index)
+				}
+				for _, item := range m.GatewayConcurrency().Accounts {
+					if item.ActiveRequests != 0 {
+						t.Fatalf("terminal attempt leaked count: %+v", item)
+					}
+				}
+			})
+		}
+	}
+}
