+func TestGatewayAllocationTransportAndCancellation(t *testing.T) {
+	s, auths := allocationFixture(t)
+	transport := s.client.Transport.(*http.Transport)
+	if transport.Proxy != nil || s.client.Timeout != 2*time.Second || s.client.CheckRedirect(nil, nil) != http.ErrUseLastResponse {
+		t.Fatal("callback transport is not bounded/direct")
+	}
+	var calls atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		w.Header().Set("Location", "http://other.invalid/secret")
+		w.WriteHeader(http.StatusTemporaryRedirect)
+	}))
+	defer server.Close()
+	transport.DialContext = func(ctx context.Context, network, _ string) (net.Conn, error) {
+		return (&net.Dialer{}).DialContext(ctx, network, strings.TrimPrefix(server.URL, "http://"))
+	}
+	_, err := s.Pick(context.Background(), "codex", "gateway-model", allocationOptions(""), auths)
+	assertAllocation503(t, err)
+	if calls.Load() != 1 {
+		t.Fatalf("redirect followed %d times", calls.Load())
+	}
+	transport.CloseIdleConnections()
+	entered := make(chan struct{})
+	s.client.Transport = gatewayAllocationTransport(func(r *http.Request) (*http.Response, error) {
+		close(entered)
+		<-r.Context().Done()
+		return nil, r.Context().Err()
+	})
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() {
+		_, err := s.Pick(ctx, "codex", "gateway-model", allocationOptions(""), auths)
+		done <- err
+	}()
+	<-entered
+	cancel()
+	select {
+	case err := <-done:
+		assertAllocation503(t, err)
+	case <-time.After(time.Second):
+		t.Fatal("request cancellation not propagated")
+	}
