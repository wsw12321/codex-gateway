new file mode 100644
index 0000000..d09d38f
--- /dev/null
+++ b/internal/auth/antigravity/gateway_identity.go
@@ -0,0 +1,130 @@
+package antigravity
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/proxyutil"
+)
+
+type gatewayOAuthTransport struct{ base http.RoundTripper }
+
+func (t gatewayOAuthTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	if t.base == nil || r.URL == nil || r.URL.Scheme != "https" || r.URL.User != nil || r.URL.Port() != "" && r.URL.Port() != "443" || r.Host != "" && r.Host != r.URL.Host {
+		return nil, errors.New("Google OAuth egress unavailable")
+	}
+	switch r.URL.Hostname() {
+	case "oauth2.googleapis.com", "www.googleapis.com", "cloudcode-pa.googleapis.com", "daily-cloudcode-pa.googleapis.com", "daily-cloudcode-pa.sandbox.googleapis.com":
+	default:
+		return nil, errors.New("Google OAuth endpoint rejected")
+	}
+	return t.base.RoundTrip(r)
+}
+func gatewayOAuthHTTPClient(raw string) *http.Client {
+	client := &http.Client{Timeout: 30 * time.Second, Transport: gatewayOAuthTransport{}, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	u, err := url.Parse(raw)
+	if err != nil || u.Hostname() == "" || (u.Scheme != "http" && u.Scheme != "https" && u.Scheme != "socks5" && u.Scheme != "socks5h") {
+		return client
+	}
+	transport, _, err := proxyutil.BuildHTTPTransport(raw)
+	if err != nil || transport == nil {
+		return client
+	}
+	client.Transport = gatewayOAuthTransport{base: transport}
+	return client
+}
+
+// FetchVerifiedIdentity deliberately excludes provider response bodies from
+// errors. Only Google's fixed endpoint may establish a durable account ID.
+func (o *AntigravityAuth) FetchVerifiedIdentity(ctx context.Context, accessToken string) (string, string, error) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, UserInfoEndpoint, nil)
+	if err != nil || strings.TrimSpace(accessToken) == "" {
+		return "", "", errors.New("Google identity unavailable")
+	}
+	req.Header.Set("Authorization", "Bearer "+accessToken)
+	client := *o.httpClient
+	client.CheckRedirect = func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }
+	resp, err := client.Do(req)
+	if err != nil {
+		return "", "", errors.New("Google identity unavailable")
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return "", "", errors.New("Google identity rejected")
+	}
+	data, err := io.ReadAll(io.LimitReader(resp.Body, (64<<10)+1))
+	if err != nil || len(data) > 64<<10 {
+		return "", "", errors.New("Google identity invalid")
+	}
+	var info struct {
+		ID       string `json:"id"`
+		Email    string `json:"email"`
+		Verified bool   `json:"verified_email"`
+	}
+	if json.Unmarshal(data, &info) != nil || !info.Verified || info.ID == "" || info.Email == "" {
+		return "", "", errors.New("Google identity unverified")
+	}
+	return strings.TrimSpace(info.Email), strings.TrimSpace(info.ID), nil
+}
+
+type GatewayQuotaWindow struct {
+	Model             string  `json:"model"`
+	RemainingFraction float64 `json:"remaining_fraction"`
+	ResetTime         string  `json:"reset_time,omitempty"`
+}
+
+func (o *AntigravityAuth) FetchGatewayQuota(ctx context.Context, accessToken, project string) ([]GatewayQuotaWindow, error) {
+	if accessToken == "" || project == "" {
+		return nil, errors.New("quota credential unavailable")
+	}
+	body, _ := json.Marshal(map[string]string{"project": project})
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, "https://cloudcode-pa.googleapis.com/v1internal:fetchAvailableModels", bytes.NewReader(body))
+	if err != nil {
+		return nil, errors.New("quota unavailable")
+	}
+	req.Header.Set("Authorization", "Bearer "+accessToken)
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("User-Agent", o.shortUserAgent())
+	client := *o.httpClient
+	client.CheckRedirect = func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }
+	resp, err := client.Do(req)
+	if err != nil {
+		return nil, errors.New("quota unavailable")
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return nil, errors.New("quota rejected")
+	}
+	data, err := io.ReadAll(io.LimitReader(resp.Body, (1<<20)+1))
+	if err != nil || len(data) > 1<<20 {
+		return nil, errors.New("quota invalid")
+	}
+	var payload struct {
+		Models map[string]struct {
+			Quota *struct {
+				Remaining *float64 `json:"remainingFraction"`
+				Reset     string   `json:"resetTime"`
+			} `json:"quotaInfo"`
+		} `json:"models"`
+	}
+	if json.Unmarshal(data, &payload) != nil || payload.Models == nil {
+		return nil, errors.New("quota invalid")
+	}
+	result := make([]GatewayQuotaWindow, 0, len(payload.Models))
+	for model, value := range payload.Models {
+		if value.Quota != nil && value.Quota.Remaining != nil && *value.Quota.Remaining >= 0 && *value.Quota.Remaining <= 1 && strings.HasPrefix(model, "gemini-") {
+			result = append(result, GatewayQuotaWindow{Model: model, RemainingFraction: *value.Quota.Remaining, ResetTime: value.Quota.Reset})
+		}
+	}
+	if len(result) == 0 {
+		return nil, errors.New("Gemini quota unavailable")
+	}
+	return result, nil
+}
