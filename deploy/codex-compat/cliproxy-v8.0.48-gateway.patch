+func (e *gatewayPolicyExecutor) Calls() []string {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	return append([]string(nil), e.calls...)
+}
+
+func newGatewayPolicyManager(t *testing.T, executor *gatewayPolicyExecutor, accountCount int) *Manager {
+	t.Helper()
+	manager := NewManager(nil, nil, nil)
+	manager.SetRetryConfig(0, 0, 2)
+	manager.RegisterExecutor(executor)
+	prefix := uuid.NewString()
+	for i := 0; i < accountCount; i++ {
+		candidate := &Auth{ID: prefix + "-" + string(rune('a'+i)), Provider: executor.id, Status: StatusActive}
+		registry.GetGlobalRegistry().RegisterClient(candidate.ID, candidate.Provider, []*registry.ModelInfo{{ID: "gateway-model"}})
+		t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(candidate.ID) })
+		if _, err := manager.Register(context.Background(), candidate); err != nil {
+			t.Fatalf("Register(%s): %v", candidate.ID, err)
+		}
+	}
+	return manager
+}
+
+func TestGatewayRetryPolicyDoesNotReplayClientFailures(t *testing.T) {
+	for _, stream := range []bool{false, true} {
+		mode := "ordinary"
+		if stream {
+			mode = "stream bootstrap"
+		}
+		for _, test := range []struct {
+			name string
+			err  error
+		}{
+			{name: "bad request", err: &Error{HTTPStatus: http.StatusBadRequest, Message: "bad request"}},
+			{name: "conflict", err: &Error{HTTPStatus: http.StatusConflict, Message: "conflict"}},
+			{name: "upgrade required", err: &Error{HTTPStatus: http.StatusUpgradeRequired, Message: "websocket upgrade required"}},
+			{name: "client cancellation", err: context.Canceled},
+		} {
+			t.Run(mode+"/"+test.name, func(t *testing.T) {
+				executor := &gatewayPolicyExecutor{id: "codex", err: test.err}
+				manager := newGatewayPolicyManager(t, executor, 2)
+				request := cliproxyexecutor.Request{Model: "gateway-model"}
+				if stream {
+					_, _ = manager.ExecuteStream(context.Background(), []string{executor.id}, request, cliproxyexecutor.Options{Stream: true})
+				} else {
+					_, _ = manager.Execute(context.Background(), []string{executor.id}, request, cliproxyexecutor.Options{})
+				}
+				if calls := executor.Calls(); len(calls) != 1 {
+					t.Fatalf("upstream calls = %v, want exactly one", calls)
+				}
+			})
+		}
+	}
+}
+
+func TestGatewayRetryPolicyEligibleFailuresTouchAtMostTwoAccounts(t *testing.T) {
+	for _, failure := range []struct {
+		name string
+		err  error
+	}{
+		{name: "server error", err: &Error{HTTPStatus: http.StatusBadGateway, Message: "upstream failed"}},
+		{name: "request scoped 408", err: &requestScopedStatusError{status: http.StatusRequestTimeout, message: "stream disconnected before completion"}},
+	} {
+		for _, stream := range []bool{false, true} {
+			mode := "ordinary"
+			if stream {
+				mode = "stream bootstrap"
+			}
+			t.Run(failure.name+"/"+mode, func(t *testing.T) {
+				executor := &gatewayPolicyExecutor{id: "codex", err: failure.err}
+				manager := newGatewayPolicyManager(t, executor, 3)
+				request := cliproxyexecutor.Request{Model: "gateway-model"}
+				if stream {
+					_, _ = manager.ExecuteStream(context.Background(), []string{executor.id}, request, cliproxyexecutor.Options{Stream: true})
+				} else {
+					_, _ = manager.Execute(context.Background(), []string{executor.id}, request, cliproxyexecutor.Options{})
+				}
+				calls := executor.Calls()
+				if len(calls) != 2 || calls[0] == calls[1] {
+					t.Fatalf("upstream calls = %v, want two distinct accounts", calls)
+				}
+				if failure.name == "request scoped 408" {
+					for _, id := range calls {
+						candidate, ok := manager.GetByID(id)
+						if !ok || candidate == nil {
+							t.Fatalf("attempted account %q is missing", id)
+						}
+						if candidate.Unavailable || candidate.Status == StatusError {
+							t.Fatalf("request-scoped 408 poisoned account %q: %#v", id, candidate)
+						}
+						if state := candidate.ModelStates["gateway-model"]; state != nil && state.Unavailable {
+							t.Fatalf("request-scoped 408 poisoned model on %q: %#v", id, state)
+						}
+					}
+				}
+			})
+		}
+	}
+}
+
+func TestGatewayRetryPolicyNonEligibleFailureDoesNotPoisonAccount(t *testing.T) {
+	for _, status := range []int{http.StatusTemporaryRedirect, http.StatusNotFound} {
+		for _, stream := range []bool{false, true} {
+			name := http.StatusText(status) + "/ordinary"
+			if stream {
+				name = http.StatusText(status) + "/stream bootstrap"
+			}
+			t.Run(name, func(t *testing.T) {
+				executor := &gatewayPolicyExecutor{id: "codex", err: &Error{HTTPStatus: status, Message: "non-retryable"}}
+				manager := newGatewayPolicyManager(t, executor, 2)
+				request := cliproxyexecutor.Request{Model: "gateway-model"}
+				if stream {
+					_, _ = manager.ExecuteStream(context.Background(), []string{"codex"}, request, cliproxyexecutor.Options{Stream: true})
+				} else {
+					_, _ = manager.Execute(context.Background(), []string{"codex"}, request, cliproxyexecutor.Options{})
+				}
+				calls := executor.Calls()
+				if len(calls) != 1 {
+					t.Fatalf("upstream calls = %v, want one", calls)
+				}
+				candidate, ok := manager.GetByID(calls[0])
+				if !ok || candidate == nil {
+					t.Fatalf("selected account %q is missing", calls[0])
+				}
+				if candidate.Unavailable || candidate.Status == StatusError {
+					t.Fatalf("non-retryable request error poisoned account: %#v", candidate)
+				}
+				if state := candidate.ModelStates["gateway-model"]; state != nil && state.Unavailable {
+					t.Fatalf("non-retryable request error poisoned model state: %#v", state)
+				}
+			})
+		}
+	}
+}
+
+func TestGatewayRetryPolicyNeverReplaysAfterStreamPayload(t *testing.T) {
+	executor := &gatewayPolicyExecutor{id: "codex", tailErr: &Error{HTTPStatus: http.StatusBadGateway, Message: "late failure"}}
+	manager := newGatewayPolicyManager(t, executor, 2)
+	result, err := manager.ExecuteStream(context.Background(), []string{executor.id}, cliproxyexecutor.Request{Model: "gateway-model"}, cliproxyexecutor.Options{Stream: true})
+	if err != nil {
+		t.Fatalf("ExecuteStream() error = %v", err)
+	}
+	for range result.Chunks {
+	}
+	if calls := executor.Calls(); len(calls) != 1 {
+		t.Fatalf("upstream calls = %v, want one after first payload", calls)
+	}
+}
