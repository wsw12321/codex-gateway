+// callerScopedSessionIDs keeps inferred and explicit identities isolated for
+// each authenticated downstream caller before they enter affinity/root state.
+// The scope is supplied by trusted gateway metadata; an absent scope keeps the
+// upstream identity unchanged for backwards compatibility.
+func callerScopedSessionIDs(primary, fallback string, metadata map[string]any) (string, string) {
+	callerScope, _ := metadata[cliproxyexecutor.CallerScopeMetadataKey].(string)
+	callerScope = strings.TrimSpace(callerScope)
+	if callerScope == "" {
+		return primary, fallback
+	}
+	prefix := "caller:" + callerScope + ":"
+	if primary != "" {
+		primary = prefix + primary
+	}
+	if fallback != "" {
+		fallback = prefix + fallback
+	}
+	return primary, fallback
+}
