+func assertAllocation503(t *testing.T, err error) {
+	t.Helper()
+	var apiErr *Error
+	if !errors.As(err, &apiErr) || apiErr.HTTPStatus != http.StatusServiceUnavailable {
+		t.Fatalf("error = %v, want 503", err)
+	}
+}
