+	s := NewGatewayAllocationSelector(time.Hour, true)
+	s.key = "synthetic-key"
+	t.Cleanup(s.Stop)
+	return s, []*Auth{
+		codexOAuthDedupeAuth("allocation-a.json", "allocation-account-a", "2026-08-20T00:00:00Z"),
+		codexOAuthDedupeAuth("allocation-b.json", "allocation-account-b", "2026-08-20T00:00:00Z"),
+	}
+}
