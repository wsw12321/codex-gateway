+func TestGatewayAllocationConcurrentFirstBinding(t *testing.T) {
+	for _, lcp := range []bool{false, true} {
+		t.Run(fmt.Sprint(lcp), func(t *testing.T) {
+			s, auths := allocationFixture(t)
+			entered := make(chan struct{}, 2)
+			release := make(chan struct{})
+			var calls atomic.Int32
+			s.client.Transport = gatewayAllocationTransport(func(r *http.Request) (*http.Response, error) {
+				i := calls.Add(1) - 1
+				entered <- struct{}{}
+				select {
+				case <-release:
+				case <-r.Context().Done():
+					return nil, r.Context().Err()
+				}
+				return allocationResponse(200, fmt.Sprintf(`{"account_id":%q}`, gatewayAccountResultIndex(auths[i]))), nil
+			})
+			results := make(chan *Auth, 2)
+			for i := 0; i < 2; i++ {
+				go func() {
+					opts := allocationOptions("concurrent")
+					if lcp {
+						opts = cliproxyexecutor.Options{SourceFormat: "openai", OriginalRequest: []byte(`{"messages":[{"role":"user","content":"hello"}]}`), Metadata: map[string]any{cliproxyexecutor.GatewayUserIDMetadataKey: "00000000-0000-0000-0000-000000000001", cliproxyexecutor.CallerScopeMetadataKey: "caller"}}
+					}
+					a, err := s.Pick(context.Background(), "codex", "gateway-model", opts, auths)
+					if err != nil {
+						t.Errorf("Pick: %v", err)
+					}
+					results <- a
+				}()
+			}
+			for i := 0; i < 2; i++ {
+				select {
+				case <-entered:
+				case <-time.After(time.Second):
+					t.Fatal("callback held binding lock")
+				}
+			}
+			close(release)
+			a, b := <-results, <-results
+			if a == nil || b == nil || a.ID != b.ID {
+				t.Fatalf("conflicting first bindings: %v / %v", a, b)
+			}
+		})
+	}
+}
