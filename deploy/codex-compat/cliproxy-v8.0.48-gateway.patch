--- /dev/null
+++ b/sdk/cliproxy/auth/gateway_catalog_test.go
@@ -0,0 +1,48 @@
+package auth
+
+import "testing"
+
+func TestGatewayCatalogPublicationSerializesCredentialMutation(t *testing.T) {
+	auth := mappedAntigravity(t, t.TempDir(), "catalog-publication-subject")
+	auth.Metadata["access_token"] = "old-token"
+	manager := NewManager(nil, nil, nil)
+	registered, err := manager.Register(WithSkipPersist(t.Context()), auth)
+	if err != nil {
+		t.Fatal(err)
+	}
+	started, release := make(chan struct{}), make(chan struct{})
+	published := make(chan bool, 1)
+	go func() {
+		published <- manager.WithCurrentGatewayCatalogSnapshot(registered, true, func() bool {
+			close(started)
+			<-release
+			return true
+		})
+	}()
+	<-started
+	// Observe the critical section without relying on sleeps or scheduling.
+	if manager.mu.TryLock() {
+		manager.mu.Unlock()
+		close(release)
+		<-published
+		t.Fatal("credential mutations can race the catalog registry CAS")
+	}
+	updated := make(chan error, 1)
+	go func() {
+		next := registered.Clone()
+		next.Metadata["access_token"] = "new-token"
+		_, errUpdate := manager.Update(WithSkipPersist(t.Context()), next)
+		updated <- errUpdate
+	}()
+	close(release)
+	if !<-published {
+		t.Fatal("current catalog snapshot was rejected")
+	}
+	if err := <-updated; err != nil {
+		t.Fatal(err)
+	}
+	called := false
+	if manager.WithCurrentGatewayCatalogSnapshot(registered, true, func() bool { called = true; return true }) || called {
+		t.Fatal("replaced credentials entered catalog publication")
+	}
+}
diff --git a/sdk/cliproxy/auth/gateway_concurrency.go b/sdk/cliproxy/auth/gateway_concurrency.go
new file mode 100644
index 0000000..3e70f37
--- /dev/null
+++ b/sdk/cliproxy/auth/gateway_concurrency.go
@@ -0,0 +1,288 @@
+package auth
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/cache"
+	"net/http"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+type GatewayAccountConcurrency struct {
+	ID string `json:"id"`
+	// ActiveRequests keeps the Gateway-compatible field name; it counts active
+	// root conversations, not overlapping executions within one root.
+	ActiveRequests  int64 `json:"active_requests"`
+	ConcurrentLimit int64 `json:"concurrent_limit"`
+}
+
+type GatewayConcurrencySnapshot struct {
+	SampledAt time.Time                   `json:"sampled_at"`
+	Accounts  []GatewayAccountConcurrency `json:"accounts"`
+}
+
+// GatewayConcurrency samples active root conversations, including the wait for
+// the first response and streaming. A root may have multiple overlapping
+// executions; they share one account slot while references are held.
+func (m *Manager) GatewayConcurrency() GatewayConcurrencySnapshot {
+	known := make(map[string]bool)
+	for _, candidate := range m.List() {
+		if id, ok := gatewayConcurrencyAccountID(candidate); ok {
+			known[id] = true
+		}
+	}
+	m.gatewayConcurrencyMu.Lock()
+	defer m.gatewayConcurrencyMu.Unlock()
+	result := GatewayConcurrencySnapshot{SampledAt: time.Now().UTC(), Accounts: make([]GatewayAccountConcurrency, 0, len(known))}
+	for id, roots := range m.gatewayConcurrency {
+		known[id] = true
+		result.Accounts = append(result.Accounts, GatewayAccountConcurrency{ID: id, ActiveRequests: int64(len(roots)), ConcurrentLimit: m.gatewayConcurrencyLimit(id)})
+	}
+	for id := range known {
+		if _, present := m.gatewayConcurrency[id]; !present {
+			result.Accounts = append(result.Accounts, GatewayAccountConcurrency{ID: id, ConcurrentLimit: m.gatewayConcurrencyLimit(id)})
+		}
+	}
+	sort.Slice(result.Accounts, func(i, j int) bool { return result.Accounts[i].ID < result.Accounts[j].ID })
+	return result
+}
+
+func (m *Manager) gatewayConcurrencyLimit(id string) int64 {
+	selector, _ := m.Selector().(*GatewayAllocationSelector)
+	if selector == nil {
+		return 0
+	}
+	return selector.concurrencyLimit(id)
+}
+
+func gatewayConcurrencyExceeded() error {
+	return &Error{Code: "upstream_concurrency_exceeded", Message: "upstream account concurrency limit reached", Retryable: true, HTTPStatus: http.StatusTooManyRequests}
+}
+
+// gatewayExecutionRootKey returns a trusted root conversation identity produced
+// by sidecar metadata. A missing identity deliberately gets a unique key so
+// legacy requests retain request-level admission behavior.
+func gatewayExecutionRootKey(opts cliproxyexecutor.Options) string {
+	if opts.Metadata != nil {
+		if raw, ok := opts.Metadata[cliproxyexecutor.ConversationHashMetadataKey].(string); ok {
+			if hash := strings.TrimSpace(raw); validGatewayConversationHash(hash) {
+				return "root:" + hash
+			}
+		}
+	}
+	return ""
+}
+
+func validGatewayConversationHash(value string) bool {
+	if len(value) != len("conv-")+32 || !strings.HasPrefix(value, "conv-") {
+		return false
+	}
+	digits := value[len("conv-"):]
+	if strings.ToLower(digits) != digits {
+		return false
+	}
+	_, err := hex.DecodeString(digits)
+	return err == nil
+}
+
+func (m *Manager) tryBeginGatewayExecution(_ context.Context, candidate *Auth, executionOpts cliproxyexecutor.Options) (func(), error) {
+	id, ok := gatewayConcurrencyAccountID(candidate)
+	if !ok {
+		return func() {}, nil
+	}
+	rootKey := gatewayExecutionRootKey(executionOpts)
+	if rootKey == "" {
+		rootKey = fmt.Sprintf("execution:%d", atomic.AddUint64(&m.gatewayConcurrencySeq, 1))
+	}
+	m.gatewayConcurrencyMu.Lock()
+	if m.gatewayConcurrency == nil {
+		m.gatewayConcurrency = make(map[string]map[string]int64)
+	}
+	roots := m.gatewayConcurrency[id]
+	if roots == nil {
+		roots = make(map[string]int64)
+		m.gatewayConcurrency[id] = roots
+	}
+	if refs, present := roots[rootKey]; present {
+		roots[rootKey] = refs + 1
+		m.gatewayConcurrencyMu.Unlock()
+		return gatewayConcurrencyRelease(m, id, rootKey), nil
+	}
+	limit := m.gatewayConcurrencyLimit(id)
+	if limit > 0 && int64(len(roots)) >= limit {
+		m.gatewayConcurrencyMu.Unlock()
+		return nil, gatewayConcurrencyExceeded()
+	}
+	roots[rootKey] = 1
+	m.gatewayConcurrencyMu.Unlock()
+	return gatewayConcurrencyRelease(m, id, rootKey), nil
+}
+
+func gatewayConcurrencyRelease(m *Manager, accountID, rootKey string) func() {
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			m.gatewayConcurrencyMu.Lock()
+			defer m.gatewayConcurrencyMu.Unlock()
+			roots := m.gatewayConcurrency[accountID]
+			if roots == nil {
+				return
+			}
+			if refs := roots[rootKey]; refs > 1 {
+				roots[rootKey] = refs - 1
+			} else {
+				delete(roots, rootKey)
+				if len(roots) == 0 {
+					delete(m.gatewayConcurrency, accountID)
+				}
+			}
+		})
+	}
+}
+
+func (m *Manager) beginGatewayExecution(ctx context.Context, candidate *Auth, executionOpts cliproxyexecutor.Options) func() {
+	release, err := m.tryBeginGatewayExecution(ctx, candidate, executionOpts)
+	if err != nil || release == nil {
+		return func() {}
+	}
+	if ctx == nil {
+		return release
+	}
+	stop := context.AfterFunc(ctx, release)
+	return func() { stop(); release() }
+}
+
+func (m *Manager) executeGatewayAttempt(ctx context.Context, executor ProviderExecutor, candidate *Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options, countTokens bool) (cliproxyexecutor.Response, error) {
+	req = gatewayExecutionRequest(candidate, req, opts)
+	ctx = gatewayExecutionCacheContext(ctx, candidate, opts)
+	if pinned, _ := opts.Metadata[cliproxyexecutor.PinnedGatewayAccountIndexMetadataKey].(string); pinned != "" && gatewayAccountResultIndex(candidate) != pinned {
+		return cliproxyexecutor.Response{}, &Error{Code: "auth_not_found", Message: "pinned upstream account changed"}
+	}
+	release, err := m.tryBeginGatewayExecution(ctx, candidate, opts)
+	if err != nil {
+		return cliproxyexecutor.Response{}, err
+	}
+	defer release()
+	if countTokens {
+		return executor.CountTokens(ctx, candidate, req, opts)
+	}
+	return executor.Execute(ctx, candidate, req, opts)
+}
+
+func (m *Manager) executeGatewayStreamAttempt(ctx context.Context, executor ProviderExecutor, candidate *Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error) {
+	req = gatewayExecutionRequest(candidate, req, opts)
+	ctx = gatewayExecutionCacheContext(ctx, candidate, opts)
+	// Non-Codex providers keep their existing channel and cancellation semantics.
+	if _, ok := gatewayConcurrencyAccountID(candidate); !ok {
+		return executor.ExecuteStream(ctx, candidate, req, opts)
+	}
+	release, acquireErr := m.tryBeginGatewayExecution(ctx, candidate, opts)
+	if acquireErr != nil {
+		return nil, acquireErr
+	}
+	handedOff := false
+	defer func() {
+		if !handedOff {
+			release()
+		}
+	}()
+	result, err := executor.ExecuteStream(ctx, candidate, req, opts)
+	if err != nil || result == nil || result.Chunks == nil {
+		return result, err
+	}
+	out := make(chan cliproxyexecutor.StreamChunk)
+	source := result.Chunks
+	var done <-chan struct{}
+	if ctx != nil {
+		done = ctx.Done()
+	}
+	go func() {
+		defer release()
+		outputClosed := false
+		closeOutput := func() {
+			if !outputClosed {
+				close(out)
+				outputClosed = true
+			}
+		}
+		for {
+			select {
+			case <-done:
+				// The client request has ended. Close the client-facing stream
+				// immediately and release the admission slot exactly once. The
+				// provider receives the same cancelled context and is responsible
+				// for stopping its own source.
+				closeOutput()
+				return
+			case chunk, ok := <-source:
+				if !ok {
+					closeOutput()
+					return
+				}
+				select {
+				case out <- chunk:
+				case <-done:
+					closeOutput()
+					return
+				}
+			}
+		}
+	}()
+	handedOff = true
+	return &cliproxyexecutor.StreamResult{Headers: result.Headers, Chunks: out}, nil
+}
+
+// CodexOAuthAccountIndex initializes index fields. Counters must never mutate a
+// snapshot shared by concurrent calls; the shallow copy is sufficient because
+// identity validation only reads the credential maps.
+func gatewayConcurrencyAccountID(candidate *Auth) (string, bool) {
+	if candidate == nil {
+		return "", false
+	}
+	snapshot := *candidate
+	return GatewayOAuthAccountIndex(&snapshot)
+}
+
+func gatewayExecutionRequest(candidate *Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) cliproxyexecutor.Request {
+	req.Metadata = cloneRequestMetadata(req.Metadata)
+	// Cache identities come from authenticated options and the selected account,
+	// never from a previous attempt or request-supplied metadata.
+	for _, key := range []string{cliproxyexecutor.GatewayUserIDMetadataKey, cliproxyexecutor.CallerScopeMetadataKey, cliproxyexecutor.UpstreamAccountIndexMetadataKey} {
+		delete(req.Metadata, key)
+	}
+	if caller, ok := opts.Metadata[cliproxyexecutor.CallerScopeMetadataKey].(string); ok && caller != "" {
+		req.Metadata[cliproxyexecutor.CallerScopeMetadataKey] = caller
+	}
+	if user, ok := opts.Metadata[cliproxyexecutor.GatewayUserIDMetadataKey].(string); ok && user != "" {
+		req.Metadata[cliproxyexecutor.GatewayUserIDMetadataKey] = user
+		if index := gatewayAccountResultIndex(candidate); index != "" {
+			req.Metadata[cliproxyexecutor.UpstreamAccountIndexMetadataKey] = index
+		}
+	}
+	return req
+}
+
+func gatewayExecutionCacheContext(ctx context.Context, candidate *Auth, opts cliproxyexecutor.Options) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	user, _ := opts.Metadata[cliproxyexecutor.GatewayUserIDMetadataKey].(string)
+	if user == "" || candidate == nil {
+		return ctx
+	}
+	index, ok := GatewayOAuthAccountIndex(candidate)
+	if !ok {
+		return ctx
+	}
+	caller, _ := opts.Metadata[cliproxyexecutor.CallerScopeMetadataKey].(string)
+	digest := sha256.Sum256([]byte("gateway-signature-cache-v1\x00" + caller + "\x00" + user + "\x00" + candidate.Provider + "\x00" + index))
+	return cache.WithGatewayScope(ctx, hex.EncodeToString(digest[:]))
+}
