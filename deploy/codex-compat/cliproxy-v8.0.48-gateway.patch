+func TestGatewayAllocationBindingDrainAndEveryColdBranch(t *testing.T) {
+	for _, mode := range []string{"explicit", "no-session", "singleton", "body-derived", "lcp"} {
+		t.Run(mode, func(t *testing.T) {
+			s, auths := allocationFixture(t)
+			opts := allocationOptions("existing")
+			if mode == "no-session" || mode == "singleton" {
+				opts = allocationOptions("")
+			}
+			if mode == "singleton" {
+				auths = auths[:1]
+			}
+			if mode == "body-derived" {
+				opts = cliproxyexecutor.Options{Metadata: map[string]any{cliproxyexecutor.GatewayUserIDMetadataKey: "00000000-0000-0000-0000-000000000001"}, OriginalRequest: []byte(`{"messages":[{"role":"user","content":"hello"}]}`)}
+			}
+			if mode == "lcp" {
+				opts = cliproxyexecutor.Options{SourceFormat: "openai", OriginalRequest: []byte(`{"messages":[{"role":"user","content":"hello"}]}`), Metadata: map[string]any{cliproxyexecutor.GatewayUserIDMetadataKey: "00000000-0000-0000-0000-000000000001", cliproxyexecutor.CallerScopeMetadataKey: "caller"}}
+			}
+			var calls int
+			s.client.Transport = gatewayAllocationTransport(func(r *http.Request) (*http.Response, error) {
+				calls++
+				if r.Method != http.MethodPost || r.URL.String() != gatewayAllocationURL || r.Header.Get("Authorization") != "Bearer synthetic-key" {
+					t.Errorf("invalid callback contract")
+				}
+				var request struct {
+					AccountIDs []string `json:"account_ids"`
+				}
+				if err := json.NewDecoder(r.Body).Decode(&request); err != nil || len(request.AccountIDs) != len(auths) {
+					t.Errorf("candidates = %+v: %v", request, err)
+				}
+				if calls > 1 {
+					return allocationResponse(503, `{}`), nil
+				}
+				return allocationResponse(200, fmt.Sprintf(`{"account_id":%q}`, gatewayAccountResultIndex(auths[0]))), nil
+			})
+			first, err := s.Pick(context.Background(), "codex", "gateway-model", opts, auths)
+			if err != nil || first.ID != auths[0].ID || calls != 1 {
+				t.Fatalf("first = %v, %v; calls %d", first, err, calls)
+			}
+			second, err := s.Pick(context.Background(), "codex", "gateway-model", opts, auths)
+			if mode == "no-session" || mode == "singleton" {
+				assertAllocation503(t, err)
+				return
+			}
+			if err != nil || second.ID != first.ID || calls != 1 {
+				t.Fatalf("weight-zero drain lost binding: %v, %v, calls %d", second, err, calls)
+			}
+			s.InvalidateAuth(first.ID)
+			_, err = s.Pick(context.Background(), "codex", "gateway-model", opts, auths)
+			assertAllocation503(t, err)
+		})
+	}
+}
