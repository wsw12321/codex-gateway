new file mode 100644
index 0000000..ef0c015
--- /dev/null
+++ b/sdk/cliproxy/auth/conversation_root.go
@@ -0,0 +1,240 @@
+package auth
+
+import (
+	"container/list"
+	"strings"
+	"sync"
+	"time"
+	"unicode"
+
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	cliproxysession "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/session"
+)
+
+const (
+	conversationRootSessionTTL      = time.Hour
+	conversationRootSessionCapacity = 65536
+	conversationRootStateKey        = "gateway_conversation_root_state"
+)
+
+type conversationRootKey struct{ scope, session string }
+type conversationRootEntry struct {
+	key     conversationRootKey
+	parent  string
+	expires time.Time
+}
+
+// Parent relationships are process-local and bounded like session affinity.
+// The LRU list keeps expiration and eviction independent of registry capacity.
+type conversationRootParentRegistry struct {
+	mu       sync.Mutex
+	entries  map[conversationRootKey]*list.Element
+	lru      list.List
+	ttl      time.Duration
+	capacity int
+}
+
+var conversationRoots = newConversationRootRegistry(conversationRootSessionCapacity, conversationRootSessionTTL)
+
+func newConversationRootRegistry(capacity int, ttl time.Duration) *conversationRootParentRegistry {
+	return &conversationRootParentRegistry{entries: make(map[conversationRootKey]*list.Element), capacity: capacity, ttl: ttl}
+}
+
+// A private typed value ties the uncompressed result to the exact leaf metadata.
+// Copying an old public root/hash string onto a different leaf cannot reuse it.
+type conversationRootState struct{ canonical, parent, scope, root, rawSession, rawParent string }
+
+func conversationRootMetadataState(metadata map[string]any) conversationRootState {
+	canonical, _ := metadata[cliproxyexecutor.CanonicalSessionIDMetadataKey].(string)
+	parent, _ := metadata[cliproxyexecutor.ParentSessionIDMetadataKey].(string)
+	scope, _ := metadata[cliproxyexecutor.CallerScopeMetadataKey].(string)
+	return conversationRootState{canonical: canonical, parent: parent, scope: scope}
+}
+
+func recordConversationRootSessionMetadata(metadata map[string]any, primary, parent string) {
+	if metadata == nil {
+		return
+	}
+	state := conversationRootMetadataState(metadata)
+	if state.canonical == "" {
+		delete(metadata, cliproxyexecutor.ConversationRootSessionIDMetadataKey)
+		delete(metadata, conversationRootStateKey)
+		return
+	}
+	state.rawSession, state.rawParent = primary, parent
+	state.root = resolveConversationRootSessionID(primary, parent, metadata)
+	metadata[cliproxyexecutor.ConversationRootSessionIDMetadataKey] = state.root
+	metadata[conversationRootStateKey] = state
+}
+
+func ensureConversationRootSessionMetadata(metadata map[string]any) {
+	if metadata == nil {
+		return
+	}
+	state := conversationRootMetadataState(metadata)
+	if prior, ok := metadata[conversationRootStateKey].(conversationRootState); ok && state.canonical != "" && prior.canonical == state.canonical && prior.parent == state.parent && prior.scope == state.scope {
+		recordConversationRootSessionMetadata(metadata, prior.rawSession, prior.rawParent)
+		return
+	}
+	recordConversationRootSessionMetadata(metadata, state.canonical, state.parent)
+}
+
+func resolveConversationRootSessionID(primary, parent string, metadata map[string]any) string {
+	scope, _ := metadata[cliproxyexecutor.CallerScopeMetadataKey].(string)
+	scope = strings.TrimSpace(scope)
+	primary = strings.TrimSpace(primary)
+	parent = strings.TrimSpace(parent)
+	if !validConversationSessionID(primary) {
+		return ""
+	}
+	// Caller prefixes are internal; reject conflicting parent namespaces. Keep
+	// the leaf itself scoped by the authenticated metadata even if it is stale.
+	prefix := "caller:" + scope + ":"
+	scoped := func(id string) (string, bool) {
+		if !validConversationSessionID(id) {
+			return "", false
+		}
+		if strings.HasPrefix(id, "caller:") {
+			parts := strings.SplitN(id, ":", 3)
+			if len(parts) != 3 || parts[1] != scope {
+				return "", false
+			}
+			return id, true
+		}
+		if scope != "" {
+			return prefix + id, true
+		}
+		return id, true
+	}
+	child, ok := scoped(primary)
+	if !ok {
+		child = prefix + primary
+	}
+	if parent != "" {
+		var valid bool
+		parent, valid = scoped(parent)
+		if !valid {
+			conversationRoots.forget(scope, child)
+			return cliproxysession.BoundSessionIdentity(child)
+		}
+	}
+	return conversationRoots.resolve(scope, child, parent, time.Now())
+}
+
+// An interceptor explicitly removing a parent must also invalidate the old
+// edge, even though ordinary requests can reuse remembered parent relations.
+func forgetConversationRootRelation(metadata map[string]any, primary string) {
+	scope, _ := metadata[cliproxyexecutor.CallerScopeMetadataKey].(string)
+	primary, _ = callerScopedSessionIDs(primary, "", metadata)
+	conversationRoots.forget(strings.TrimSpace(scope), primary)
+}
+
+func (r *conversationRootParentRegistry) forget(scope, child string) {
+	key := conversationRootKey{scope, cliproxysession.BoundSessionIdentity(child)}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.remove(r.entries[key])
+}
+
+func validConversationSessionID(id string) bool {
+	if id == "" || len(id) > 4096 {
+		return false
+	}
+	for _, c := range id {
+		if unicode.IsControl(c) {
+			return false
+		}
+	}
+	return true
+}
+
+// Hierarchy is decoded before bounding either key, including when the parent
+// itself is a nested agent not yet seen by this process.
+func conversationHierarchyParent(id string) string {
+	if i := strings.LastIndex(id, ":agent:"); i > 0 {
+		return id[:i]
+	}
+	return ""
+}
+
+func (r *conversationRootParentRegistry) resolve(scope, child, parent string, now time.Time) string {
+	leaf := cliproxysession.BoundSessionIdentity(child)
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	for e := r.lru.Front(); e != nil; e = r.lru.Front() {
+		if e.Value.(conversationRootEntry).expires.After(now) {
+			break
+		}
+		r.remove(e)
+	}
+	// Store explicit relationships and the parent hierarchy, not affinity aliases.
+	if parent == "" {
+		parent = conversationHierarchyParent(child)
+	}
+	if parent != "" {
+		if child == parent {
+			r.remove(r.entries[conversationRootKey{scope, leaf}])
+			return leaf
+		}
+		r.set(scope, child, parent, now)
+		for ancestor := parent; ; {
+			next := conversationHierarchyParent(ancestor)
+			if next == "" {
+				break
+			}
+			key := conversationRootKey{scope, cliproxysession.BoundSessionIdentity(ancestor)}
+			if _, known := r.entries[key]; !known {
+				r.set(scope, ancestor, next, now)
+			}
+			ancestor = next
+		}
+	}
+	current := leaf
+	seen := make(map[conversationRootKey]bool)
+	for len(seen) <= r.capacity {
+		key := conversationRootKey{scope, current}
+		if seen[key] {
+			// Remove every edge in an invalid chain so later requests cannot
+			// accidentally treat another member of the cycle as a valid root.
+			for invalid := range seen {
+				if e := r.entries[invalid]; e != nil {
+					r.remove(e)
+				}
+			}
+			return leaf
+		}
+		seen[key] = true
+		e := r.entries[key]
+		if e == nil {
+			return current
+		}
+		entry := e.Value.(conversationRootEntry)
+		entry.expires = now.Add(r.ttl)
+		e.Value = entry
+		r.lru.MoveToBack(e)
+		current = entry.parent
+	}
+	return leaf
+}
+
+func (r *conversationRootParentRegistry) set(scope, child, parent string, now time.Time) {
+	key := conversationRootKey{scope, cliproxysession.BoundSessionIdentity(child)}
+	entry := conversationRootEntry{key: key, parent: cliproxysession.BoundSessionIdentity(parent), expires: now.Add(r.ttl)}
+	if e := r.entries[key]; e != nil {
+		e.Value = entry
+		r.lru.MoveToBack(e)
+		return
+	}
+	if len(r.entries) >= r.capacity {
+		r.remove(r.lru.Front())
+	}
+	r.entries[key] = r.lru.PushBack(entry)
+}
+
+func (r *conversationRootParentRegistry) remove(e *list.Element) {
+	if e == nil {
+		return
+	}
+	delete(r.entries, e.Value.(conversationRootEntry).key)
+	r.lru.Remove(e)
+}
diff --git a/sdk/cliproxy/auth/conversation_root_execution_test.go b/sdk/cliproxy/auth/conversation_root_execution_test.go
new file mode 100644
