+		payload := make([]map[string]any, 0, len(request.AccountIDs))
+		for _, id := range request.AccountIDs {
+			payload = append(payload, map[string]any{"id": id, "concurrent_limit": limits[id]})
+		}
+		body, _ := json.Marshal(map[string]any{"accounts": payload})
+		return gatewayLimitResponse(http.StatusOK, string(body)), nil
+	})
+	primeGatewayConcurrencyLimits(t, selector, accounts)
+	_, err = selector.Pick(context.Background(), "codex", "gateway-model", allocationOptions("all-full"), accounts)
+	assertGatewayConcurrency429(t, err)
+}
