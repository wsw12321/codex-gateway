+func TestGatewayConcurrencyLimitIsAtomicAndReturns429WithoutCooldown(t *testing.T) {
+	manager, selector, accounts, _ := newGatewayConcurrencyLimitFixture(t)
+	account := accounts[0]
+	executor := &blockingGatewayLimitExecutor{id: "codex", started: make(chan string, 2), release: make(chan struct{})}
+	manager.RegisterExecutor(executor)
+
+	firstDone := make(chan error, 1)
+	go func() {
+		_, err := manager.executeGatewayAttempt(context.Background(), executor, account, cliproxyexecutor.Request{}, cliproxyexecutor.Options{}, false)
+		firstDone <- err
+	}()
+	select {
+	case <-executor.started:
+	case <-time.After(2 * time.Second):
+		t.Fatal("first execution did not start")
+	}
+	if got := gatewayConcurrencySnapshotCount(t, manager, gatewayAccountResultIndex(account)); got != 1 {
+		t.Fatalf("active count = %d, want 1", got)
+	}
+	if got := selector.concurrencyLimit(gatewayAccountResultIndex(account)); got != 1 {
+		t.Fatalf("configured limit = %d, want 1", got)
+	}
+
+	if _, err := manager.executeGatewayAttempt(context.Background(), executor, account, cliproxyexecutor.Request{}, cliproxyexecutor.Options{}, false); err == nil {
+		t.Fatal("second execution bypassed the account cap")
+	} else {
+		assertGatewayConcurrency429(t, err)
+	}
+	if got := executor.calls.Load(); got != 1 {
+		t.Fatalf("executor calls = %d, want 1", got)
+	}
+	current, ok := manager.GetByID(account.ID)
+	if !ok || !GatewayAccountAvailable(current) || current.Unavailable || current.Quota.Exceeded {
+		t.Fatalf("local cap rejection poisoned credential state: %#v", current)
+	}
+
+	close(executor.release)
+	if err := <-firstDone; err != nil {
+		t.Fatalf("first execution: %v", err)
+	}
+	if got := gatewayConcurrencySnapshotCount(t, manager, gatewayAccountResultIndex(account)); got != 0 {
+		t.Fatalf("active count after release = %d, want 0", got)
+	}
+
+	// A concurrent admission race must still admit no more than the configured
+	// one request. Hold the winner until every contender has attempted admission
+	// so a fast release cannot make the test accidentally sequential.
+	start := make(chan struct{})
+	winners := make(chan func(), 64)
+	var wg sync.WaitGroup
+	for range 64 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			release, err := manager.tryBeginGatewayExecution(context.Background(), account, cliproxyexecutor.Options{})
+			if err == nil {
+				winners <- release
+			}
+		}()
+	}
+	close(start)
+	wg.Wait()
+	if got := len(winners); got != 1 {
+		t.Fatalf("concurrent admissions = %d, want exactly one", got)
+	}
+	(<-winners)()
+}
