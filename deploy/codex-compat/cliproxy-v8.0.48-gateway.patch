+package auth
+
+import (
+	"context"
+	"net/http"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+const gatewayAnthropicAccount = "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
+const gatewayAnthropicOrganization = "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb"
+
+func gatewayAnthropicTestAuth(t *testing.T, m *Manager, id, organization string) *Auth {
+	t.Helper()
+	subject := AnthropicIdentitySubject(gatewayAnthropicAccount, organization)
+	if _, err := m.RegisterAnthropicIdentity(subject); err != nil {
+		t.Fatal(err)
+	}
+	a := &Auth{ID: id, FileName: id, Provider: "claude", Status: StatusActive, Metadata: map[string]any{"type": "claude", "access_token": "synthetic", "account_uuid": gatewayAnthropicAccount, "organization_uuid": organization, "gateway_anthropic_subject": subject}}
+	if !ApplyGatewayOAuthAccountIdentity(a, a.Metadata) {
+		t.Fatal("verified identity rejected")
+	}
+	return a
+}
+func TestGatewayAnthropicIdentityStableAndOrganizationScoped(t *testing.T) {
+	m := NewManager(nil, nil, nil)
+	dir := t.TempDir()
+	if err := m.LoadGatewayAccountState(dir); err != nil {
+		t.Fatal(err)
+	}
+	a := gatewayAnthropicTestAuth(t, m, "first.json", gatewayAnthropicOrganization)
+	first, _ := GatewayOAuthAccountIndex(a)
+	a.ID = "renamed.json"
+	a.Metadata["access_token"] = "rotated"
+	a.Metadata["email"] = "changed@example.com"
+	if got, _ := GatewayOAuthAccountIndex(a); got != first {
+		t.Fatal("identity changed after token rotation")
+	}
+	second := gatewayAnthropicTestAuth(t, m, "second.json", "cccccccc-cccc-4ccc-8ccc-cccccccccccc")
+	if got, _ := GatewayOAuthAccountIndex(second); got == first {
+		t.Fatal("organizations share identity")
+	}
+	if err := loadGatewayAnthropicIdentities(dir); err != nil {
+		t.Fatal(err)
+	}
+	if got, _ := GatewayOAuthAccountIndex(a); got != first {
+		t.Fatal("identity changed after restart")
+	}
+	info, err := os.Stat(filepath.Join(dir, GatewayAnthropicIdentityFile))
+	if err != nil || info.Mode().Perm() != 0600 {
+		t.Fatal("identity file permissions")
+	}
+	a.Metadata["organization_uuid"] = "cccccccc-cccc-4ccc-8ccc-cccccccccccc"
+	if ApplyGatewayOAuthAccountIdentity(a, a.Metadata) || GatewayAccountAvailable(a) {
+		t.Fatal("changed identity remained routable")
+	}
+}
+func TestGatewayAnthropicDuplicateAndUnverifiedFailClosed(t *testing.T) {
+	m := NewManager(nil, nil, nil)
+	if err := m.LoadGatewayAccountState(t.TempDir()); err != nil {
+		t.Fatal(err)
+	}
+	a := gatewayAnthropicTestAuth(t, m, "first.json", gatewayAnthropicOrganization)
+	b := gatewayAnthropicTestAuth(t, m, "second.json", gatewayAnthropicOrganization)
+	DeduplicateCodexOAuthAuths([]*Auth{a, b})
+	for _, candidate := range []*Auth{a, b} {
+		if _, ok := GatewayOAuthAccountIndex(candidate); ok || GatewayAccountAvailable(candidate) {
+			t.Fatal("duplicate identity routable")
+		}
+	}
+	unverified := &Auth{Provider: "claude", Metadata: map[string]any{"account_uuid": gatewayAnthropicAccount, "organization_uuid": gatewayAnthropicOrganization}}
+	if ApplyGatewayOAuthAccountIdentity(unverified, unverified.Metadata) {
+		t.Fatal("uploaded identity accepted")
+	}
+}
+func TestGatewayAnthropicProviderAllocationAndCooldown(t *testing.T) {
+	m := NewManager(nil, nil, nil)
+	if err := m.LoadGatewayAccountState(t.TempDir()); err != nil {
+		t.Fatal(err)
+	}
+	a := gatewayAnthropicTestAuth(t, m, "one.json", gatewayAnthropicOrganization)
+	if got := gatewayAllocationEndpoint([]*Auth{a}, "select"); got != "http://gateway:8080/internal/anthropic-accounts/select" {
+		t.Fatal(got)
+	}
+	if got := gatewayAllocationEndpoint([]*Auth{a, {Provider: "codex"}}, "select"); got != "" {
+		t.Fatal("mixed providers accepted")
+	}
+	if _, err := m.Register(context.Background(), a); err != nil {
+		t.Fatal(err)
+	}
+	id, _ := GatewayOAuthAccountIndex(a)
+	m.markGatewayQuotaExhaustedLocked(a)
+	_, quota, _ := m.GatewayAccountStatuses(id)
+	if quota != "available" {
+		t.Fatal("native recovery replaced with permanent lock")
+	}
+}
+func TestGatewayAnthropicQuotaUsesOnlyObservedSignals(t *testing.T) {
+	a := &Auth{Provider: "claude"}
+	if got := GatewayAnthropicQuota(a); got.ObservedAt != "" || len(got.Windows) != 0 {
+		t.Fatal("invented unknown quota")
+	}
+	now := time.Now().UTC().Truncate(time.Second)
+	a.Quota.ObserveResponseHeadersForProvider("claude", http.Header{"Anthropic-Ratelimit-Unified-5h-Utilization": {"0.35"}, "Anthropic-Ratelimit-Unified-5h-Status": {"allowed"}, "Anthropic-Ratelimit-Unified-7d-Utilization": {"NaN"}, "Anthropic-Ratelimit-Unified-7d-Status": {"rejected"}}, now)
+	a.NextRetryAfter = now.Add(time.Hour)
+	got := GatewayAnthropicQuota(a)
+	if got.ObservedAt != now.Format(time.RFC3339) || len(got.Windows) != 2 || got.Windows[0].UsedPercent == nil || *got.Windows[0].UsedPercent != 35 || got.Windows[1].UsedPercent != nil || got.CooldownUntil == "" {
+		t.Fatalf("snapshot=%+v", got)
+	}
+	if !a.NextRetryAfter.Equal(now.Add(time.Hour)) {
+		t.Fatal("quota snapshot changed cooldown")
+	}
+}
+
+func TestGatewayAnthropicUsesSharedRetryPolicy(t *testing.T) {
+	ctx := context.WithValue(context.Background(), gatewayManagedRequestKey{}, true)
+	if !isGatewayProvider("claude", ctx) || isGatewayProvider("claude", context.Background()) {
+		t.Fatal("gateway provider classification")
+	}
+	for _, status := range []int{400, 404, 409, 422} {
+		if credentialSwitchEligible("claude", &Error{HTTPStatus: status}, ctx) {
+			t.Fatalf("client failure %d permitted replay", status)
+		}
+	}
+	for _, status := range []int{401, 402, 403, 429, 500, 502, 503} {
+		if !credentialSwitchEligible("claude", &Error{HTTPStatus: status}, ctx) {
+			t.Fatalf("retryable %d rejected", status)
+		}
+	}
+	cancelled, cancel := context.WithCancel(ctx)
+	cancel()
+	if credentialSwitchEligible("claude", &Error{HTTPStatus: 502}, cancelled) {
+		t.Fatal("cancelled request replayed")
+	}
+}
diff --git a/sdk/cliproxy/auth/gateway_anthropic_quota.go b/sdk/cliproxy/auth/gateway_anthropic_quota.go
new file mode 100644
index 0000000..0f7a033
--- /dev/null
+++ b/sdk/cliproxy/auth/gateway_anthropic_quota.go
@@ -0,0 +1,71 @@
+package auth
+
+import (
+	"math"
+	"net/http"
+	"strconv"
+	"time"
+)
+
+type GatewayAnthropicWindow struct {
+	Window      string   `json:"window"`
+	UsedPercent *float64 `json:"used_percent,omitempty"`
+	ResetAt     string   `json:"reset_at,omitempty"`
+	Status      string   `json:"status"`
+}
+type GatewayAnthropicSnapshot struct {
+	ObservedAt    string                   `json:"observed_at,omitempty"`
+	CooldownUntil string                   `json:"cooldown_until,omitempty"`
+	Windows       []GatewayAnthropicWindow `json:"windows"`
+}
+
+// GatewayAnthropicQuota is a projection of CPA's passive observations. It never
+// issues an upstream call, guesses a subscription plan or mutates cooldown.
+func GatewayAnthropicQuota(a *Auth) GatewayAnthropicSnapshot {
+	out := GatewayAnthropicSnapshot{Windows: []GatewayAnthropicWindow{}}
+	if a == nil || a.Provider != "claude" {
+		return out
+	}
+	quota := a.Quota
+	for _, state := range a.ModelStates {
+		if state != nil && state.Quota.ObservedAt.After(quota.ObservedAt) {
+			quota = state.Quota
+		}
+	}
+	cooldown := a.NextRetryAfter
+	if a.Quota.NextRecoverAt.After(cooldown) {
+		cooldown = a.Quota.NextRecoverAt
+	}
+	for _, state := range a.ModelStates {
+		if state != nil && state.NextRetryAfter.After(cooldown) {
+			cooldown = state.NextRetryAfter
+		}
+	}
+	if cooldown.After(time.Now()) {
+		out.CooldownUntil = cooldown.UTC().Format(time.RFC3339)
+	}
+	if quota.ObservedAt.IsZero() {
+		return out
+	}
+	out.ObservedAt = quota.ObservedAt.UTC().Format(time.RFC3339)
+	for _, pair := range [][2]string{{"5h", "five_hour"}, {"7d", "seven_day"}} {
+		prefix := "Anthropic-Ratelimit-Unified-" + pair[0] + "-"
+		read := func(suffix string) string { return quota.Signals[http.CanonicalHeaderKey(prefix+suffix)] }
+		window := GatewayAnthropicWindow{Window: pair[1], Status: "unknown"}
+		switch status := read("Status"); status {
+		case "allowed", "allowed_warning", "rejected":
+			window.Status = status
+		}
+		if value, err := strconv.ParseFloat(read("Utilization"), 64); err == nil && !math.IsNaN(value) && !math.IsInf(value, 0) && value >= 0 && value <= 1 {
+			value *= 100
+			window.UsedPercent = &value
+		}
+		if value, err := strconv.ParseInt(read("Reset"), 10, 64); err == nil && value >= 946684800 && value <= 4102444800 {
+			window.ResetAt = time.Unix(value, 0).UTC().Format(time.RFC3339)
+		}
+		if window.Status != "unknown" || window.UsedPercent != nil || window.ResetAt != "" {
+			out.Windows = append(out.Windows, window)
+		}
+	}
+	return out
+}
diff --git a/sdk/cliproxy/auth/gateway_antigravity_identity.go b/sdk/cliproxy/auth/gateway_antigravity_identity.go
new file mode 100644
index 0000000..e7308f3
--- /dev/null
+++ b/sdk/cliproxy/auth/gateway_antigravity_identity.go
@@ -0,0 +1,242 @@
+package auth
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+)
+
+const GatewayAntigravityIdentityFile = ".gateway-antigravity-identities"
+
+type gatewayAntigravityIdentityDocument struct {
+	Version  int               `json:"version"`
+	Accounts map[string]string `json:"accounts"`
+}
+
+// Identity mappings are independent of filenames, OAuth refreshes and credentials.
+// The server has one auth directory. Imports can only add verified Google subjects.
+var gatewayAntigravityIdentities = struct {
+	sync.RWMutex
+	path     string
+	accounts map[string]string
+}{}
+
+func validGoogleSubject(subject string) bool {
+	if subject == "" || len(subject) > 128 {
+		return false
+	}
+	for _, ch := range subject {
+		if !(ch >= 'a' && ch <= 'z' || ch >= 'A' && ch <= 'Z' || ch >= '0' && ch <= '9' || ch == '-' || ch == '_') {
+			return false
+		}
+	}
+	return true
+}
+
+func loadGatewayAntigravityIdentities(authDir string) error {
+	path := filepath.Join(authDir, GatewayAntigravityIdentityFile)
+	doc := gatewayAntigravityIdentityDocument{Version: 1, Accounts: map[string]string{}}
+	info, err := os.Lstat(path)
+	if err == nil {
+		if !info.Mode().IsRegular() || info.Mode().Perm() != 0600 || info.Size() > 4<<20 {
+			return ErrGatewayAccountIdentityInvalid
+		}
+		data, readErr := os.ReadFile(path)
+		if readErr != nil {
+			return ErrGatewayAccountStateUnavailable
+		}
+		fields, decodeErr := decodeGatewayObject(data, "version", "accounts")
+		if decodeErr != nil || json.Unmarshal(fields["version"], &doc.Version) != nil || doc.Version != 1 {
+			return ErrGatewayAccountIdentityInvalid
+		}
+		rawAccounts, decodeErr := decodeGatewayObject(fields["accounts"])
+		if decodeErr != nil {
+			return ErrGatewayAccountIdentityInvalid
+		}
+		seen := map[string]bool{}
+		for subject, value := range rawAccounts {
+			var id string
+			if !validGoogleSubject(subject) || json.Unmarshal(value, &id) != nil || len(id) != 16 || !isLowerHexString(id) || seen[id] {
+				return ErrGatewayAccountIdentityInvalid
+			}
+			doc.Accounts[subject] = id
+			seen[id] = true
+		}
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return ErrGatewayAccountStateUnavailable
+	}
+	gatewayAntigravityIdentities.Lock()
+	defer gatewayAntigravityIdentities.Unlock()
+	gatewayAntigravityIdentities.path = path
+	gatewayAntigravityIdentities.accounts = doc.Accounts
+	return nil
+}
+
+// RegisterAntigravityIdentity accepts only a subject verified with Google's
+// fixed userinfo endpoint by the server-side OAuth/import flow.
+func (m *Manager) RegisterAntigravityIdentity(subject string) (string, error) {
+	if m == nil || !validGoogleSubject(subject) {
+		return "", ErrGatewayAccountIdentityInvalid
+	}
+	gatewayAntigravityIdentities.Lock()
+	defer gatewayAntigravityIdentities.Unlock()
+	if gatewayAntigravityIdentities.path == "" {
+		return "", ErrGatewayAccountStateUnavailable
+	}
+	if id := gatewayAntigravityIdentities.accounts[subject]; id != "" {
+		return id, nil
+	}
+	sum := sha256.Sum256([]byte("codex-gateway-antigravity-google-subject:\x00" + subject))
+	id := hex.EncodeToString(sum[:8])
+	for _, existing := range gatewayAntigravityIdentities.accounts {
+		if existing == id {
+			return "", ErrGatewayAccountIdentityInvalid
+		}
+	}
+	next := make(map[string]string, len(gatewayAntigravityIdentities.accounts)+1)
+	for subject, id := range gatewayAntigravityIdentities.accounts {
+		next[subject] = id
+	}
+	next[subject] = id
+	data, err := json.Marshal(gatewayAntigravityIdentityDocument{Version: 1, Accounts: next})
+	if err != nil {
+		return "", err
+	}
+	dir := filepath.Dir(gatewayAntigravityIdentities.path)
+	file, err := os.CreateTemp(dir, GatewayAntigravityIdentityFile+".")
+	if err != nil {
+		return "", ErrGatewayAccountStateUnavailable
+	}
+	name := file.Name()
+	defer os.Remove(name)
+	if err = file.Chmod(0600); err == nil {
+		_, err = file.Write(data)
+	}
+	if err == nil {
+		err = file.Sync()
+	}
+	closeErr := file.Close()
+	if err != nil || closeErr != nil {
+		return "", ErrGatewayAccountStateUnavailable
+	}
+	if err = os.Rename(name, gatewayAntigravityIdentities.path); err != nil {
+		return "", ErrGatewayAccountStateUnavailable
+	}
+	d, err := os.Open(dir)
+	if err != nil {
+		return "", ErrGatewayAccountStateUnavailable
+	}
+	err = d.Sync()
+	_ = d.Close()
+	if err != nil {
+		return "", ErrGatewayAccountStateUnavailable
+	}
+	gatewayAntigravityIdentities.accounts = next
+	return id, nil
+}
+
+func antigravityOAuthAccountIndex(candidate *Auth) (string, bool) {
+	if candidate == nil || !strings.EqualFold(strings.TrimSpace(candidate.Provider), "antigravity") || candidate.AuthKind() != AuthKindOAuth {
+		return "", false
+	}
+	if strings.EqualFold(strings.TrimSpace(os.Getenv("CPA_ANTIGRAVITY_ENABLED")), "false") || candidate.Attributes["gateway_provider_disabled"] == "true" || candidate.Attributes["gateway_identity_conflict"] == "true" {
+		return "", false
+	}
+	subject, _ := candidate.Metadata["google_subject"].(string)
+	if !validGoogleSubject(subject) {
+		return "", false
+	}
+	gatewayAntigravityIdentities.RLock()
+	id := gatewayAntigravityIdentities.accounts[subject]
+	gatewayAntigravityIdentities.RUnlock()
+	if len(id) != 16 || !isLowerHexString(id) {
+		return "", false
+	}
+	return id, true
+}
+
+func GatewayOAuthAccountIndex(candidate *Auth) (string, bool) {
+	if candidate != nil && strings.EqualFold(strings.TrimSpace(candidate.Provider), "claude") {
+		return anthropicOAuthAccountIndex(candidate)
+	}
+	if candidate != nil && strings.EqualFold(strings.TrimSpace(candidate.Provider), "antigravity") {
+		return antigravityOAuthAccountIndex(candidate)
+	}
+	return CodexOAuthAccountIndex(candidate)
+}
+
+func ApplyGatewayOAuthAccountIdentity(candidate *Auth, metadata map[string]any) bool {
+	if candidate != nil && strings.EqualFold(strings.TrimSpace(candidate.Provider), "claude") {
+		return applyAnthropicOAuthAccountIdentity(candidate, metadata)
+	}
+	if candidate == nil {
+		return false
+	}
+	if !strings.EqualFold(strings.TrimSpace(candidate.Provider), "antigravity") {
+		return ApplyCodexOAuthAccountIdentity(candidate, metadata)
+	}
+	if strings.EqualFold(strings.TrimSpace(os.Getenv("CPA_ANTIGRAVITY_ENABLED")), "false") {
+		if candidate.Attributes == nil {
+			candidate.Attributes = map[string]string{}
+		}
+		candidate.Attributes["gateway_provider_disabled"] = "true"
+		candidate.Disabled = true
+		candidate.Status = StatusDisabled
+		candidate.GatewayAccountBlocked = true
+		return false
+	}
+	// Unmapped legacy credentials have no Gateway account index. The Gateway
+	// selector and registry filter reject them, while standalone CPA retains
+	// upstream provider behavior outside the gateway-allocation deployment.
+	if subject, _ := metadata["google_subject"].(string); subject == "" {
+		return false
+	}
+	if candidate.Attributes == nil {
+		candidate.Attributes = map[string]string{}
+	}
+	candidate.Attributes[AttributeAuthKind] = AuthKindOAuth
+	id, ok := antigravityOAuthAccountIndex(candidate)
+	if !ok {
+		candidate.GatewayAccountBlocked = true
+		candidate.Disabled = true
+		candidate.Status = StatusDisabled
+		candidate.Index = ""
+		candidate.indexAssigned = false
+		return false
+	}
+	candidate.Index = id
+	candidate.indexAssigned = true
+	return true
+}
+
+func quarantineDuplicateAntigravityIdentities(auths []*Auth) {
+	groups := map[string][]*Auth{}
+	for _, candidate := range auths {
+		if candidate == nil || !strings.EqualFold(strings.TrimSpace(candidate.Provider), "antigravity") {
+			continue
+		}
+		subject, _ := candidate.Metadata["google_subject"].(string)
+		if subject != "" {
+			groups[subject] = append(groups[subject], candidate)
+		}
+	}
+	for _, group := range groups {
+		if len(group) < 2 {
+			continue
+		}
+		for _, candidate := range group {
+			if candidate.Attributes == nil {
+				candidate.Attributes = map[string]string{}
+			}
+			candidate.Attributes["gateway_identity_conflict"] = "true"
+			candidate.Disabled = true
+			candidate.Status = StatusDisabled
+			candidate.GatewayAccountBlocked = true
+		}
+	}
+}
diff --git a/sdk/cliproxy/auth/gateway_antigravity_identity_test.go b/sdk/cliproxy/auth/gateway_antigravity_identity_test.go
new file mode 100644
index 0000000..390815b
--- /dev/null
+++ b/sdk/cliproxy/auth/gateway_antigravity_identity_test.go
@@ -0,0 +1,119 @@
+package auth
+
+import (
+	"context"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func mappedAntigravity(t *testing.T, dir, subject string) *Auth {
+	t.Helper()
+	m := NewManager(nil, nil, nil)
+	if err := m.LoadGatewayAccountState(dir); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := m.RegisterAntigravityIdentity(subject); err != nil {
+		t.Fatal(err)
+	}
+	a := &Auth{ID: "original.json", FileName: "original.json", Provider: "antigravity", Status: StatusActive, Attributes: map[string]string{AttributeAuthKind: AuthKindOAuth}, Metadata: map[string]any{"google_subject": subject}}
+	if !ApplyGatewayOAuthAccountIdentity(a, a.Metadata) {
+		t.Fatal("identity not applied")
+	}
+	return a
+}
+func TestGatewayAntigravityIdentityStableAndConflicts(t *testing.T) {
+	dir := t.TempDir()
+	a := mappedAntigravity(t, dir, "google-subject-1")
+	before, ok := GatewayOAuthAccountIndex(a)
+	if !ok {
+		t.Fatal("missing index")
+	}
+	a.ID = "renamed.json"
+	a.FileName = "renamed.json"
+	a.Metadata["access_token"] = "rotated"
+	if after, _ := GatewayOAuthAccountIndex(a); after != before {
+		t.Fatal("stable identity changed")
+	}
+	info, err := os.Stat(filepath.Join(dir, GatewayAntigravityIdentityFile))
+	if err != nil || info.Mode().Perm() != 0600 {
+		t.Fatal("unsafe identity file")
+	}
+	duplicate := a.Clone()
+	duplicate.ID = "duplicate.json"
+	DeduplicateCodexOAuthAuths([]*Auth{a, duplicate})
+	if _, ok := GatewayOAuthAccountIndex(a); ok {
+		t.Fatal("duplicate identity accepted")
+	}
+	if _, ok := GatewayOAuthAccountIndex(duplicate); ok {
+		t.Fatal("duplicate identity accepted")
+	}
+}
+func TestGatewayAntigravityMappingRejectsConflictingIDs(t *testing.T) {
+	dir := t.TempDir()
+	data := `{"version":1,"accounts":{"subject1":"0123456789abcdef","subject2":"0123456789abcdef"}}`
+	if err := os.WriteFile(filepath.Join(dir, GatewayAntigravityIdentityFile), []byte(data), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := loadGatewayAntigravityIdentities(dir); err == nil {
+		t.Fatal("conflicting mapping accepted")
+	}
+}
+func TestGatewayAntigravitySelectorTrustedProviderAndReauthorization(t *testing.T) {
+	a := mappedAntigravity(t, t.TempDir(), "selector-subject")
+	index, _ := GatewayOAuthAccountIndex(a)
+	s := NewGatewayAllocationSelector(time.Hour, true)
+	defer s.Stop()
+	s.key = "test-key"
+	allowed := true
+	calls := 0
+	s.client.Transport = rawGatewayTransport(func(req *http.Request) (*http.Response, error) {
+		if !strings.HasPrefix(req.URL.String(), "http://gateway:8080/internal/antigravity-accounts/") {
+			t.Fatalf("wrong provider callback: %s", req.URL)
+		}
+		if strings.HasSuffix(req.URL.Path, "/eligible") {
+			if !allowed {
+				return allocationResponse(200, `{"accounts":[]}`), nil
+			}
+			return allocationResponse(200, `{"accounts":[{"id":"`+index+`","concurrent_limit":1}]}`), nil
+		}
+		calls++
+		return allocationResponse(200, `{"account_id":"`+index+`"}`), nil
+	})
+	opts := allocationOptions("same-session")
+	opts.Headers.Set("X-Provider", "codex")
+	if _, err := s.Pick(context.Background(), "antigravity", "gemini-3-flash", opts, []*Auth{a}); err != nil {
+		t.Fatal(err)
+	}
+	allowed = false
+	if _, err := s.Pick(context.Background(), "antigravity", "gemini-3-flash", opts, []*Auth{a}); err == nil {
+		t.Fatal("revoked account reused")
+	}
+	if calls != 1 {
+		t.Fatal("unexpected allocation callback")
+	}
+	if got := gatewayAllocationEndpoint([]*Auth{a, {Provider: "codex"}}, "select"); got != "" {
+		t.Fatal("mixed provider allowed")
+	}
+}
+
+type rawGatewayTransport func(*http.Request) (*http.Response, error)
+
+func (f rawGatewayTransport) RoundTrip(req *http.Request) (*http.Response, error) { return f(req) }
+
+func TestGatewayAntigravityRollbackDisablesRefreshAndAllocation(t *testing.T) {
+	a := mappedAntigravity(t, t.TempDir(), "rollback-subject")
+	t.Setenv("CPA_ANTIGRAVITY_ENABLED", "false")
+	if ApplyGatewayOAuthAccountIdentity(a, a.Metadata) {
+		t.Fatal("rollback retained active identity")
+	}
+	if !a.Disabled || a.Status != StatusDisabled || !a.GatewayAccountBlocked {
+		t.Fatal("rollback credential can refresh")
+	}
+	if _, ok := GatewayOAuthAccountIndex(a); ok {
+		t.Fatal("rollback account can be selected")
+	}
+}
diff --git a/sdk/cliproxy/auth/gateway_catalog.go b/sdk/cliproxy/auth/gateway_catalog.go
new file mode 100644
index 0000000..0144061
--- /dev/null
+++ b/sdk/cliproxy/auth/gateway_catalog.go
@@ -0,0 +1,46 @@
+package auth
+
+import (
+	"maps"
+	"strings"
+)
+
+// WithCurrentGatewayCatalogSnapshot fences catalog publication against account
+// replacement, credential rotation, stable identity and source disabled state.
+// A current verified capability may cross
+// manual/quota control changes: it only updates models, never account control.
+// Failed probes and identity revocation still require the exact control snapshot.
+// publish must only perform a registry CAS, without manager calls or I/O.
+// Registry reconciliation and scheduler refresh happen after this lock releases.
+func (m *Manager) WithCurrentGatewayCatalogSnapshot(expected *Auth, verifiedCapability bool, publish func() bool) bool {
+	if m == nil || expected == nil || publish == nil {
+		return false
+	}
+	m.mu.RLock()
+	defer m.mu.RUnlock()
+	current := m.auths[expected.ID]
+	if current == nil || current.Disabled != expected.Disabled ||
+		(current.Status == StatusDisabled) != (expected.Status == StatusDisabled) ||
+		current.Provider != expected.Provider || current.Prefix != expected.Prefix ||
+		current.RegistrationEpoch != expected.RegistrationEpoch || current.CredentialVersion != expected.CredentialVersion ||
+		current.AuthKind() != expected.AuthKind() ||
+		!maps.Equal(current.Attributes, expected.Attributes) {
+		return false
+	}
+	if !verifiedCapability && (current.GatewayAccountVersion != expected.GatewayAccountVersion || current.GatewayAccountBlocked != expected.GatewayAccountBlocked) {
+		return false
+	}
+	for _, key := range []string{"access_token", "project_id", "google_subject"} {
+		actual, _ := current.Metadata[key].(string)
+		previous, _ := expected.Metadata[key].(string)
+		if strings.TrimSpace(actual) != strings.TrimSpace(previous) {
+			return false
+		}
+	}
+	account, ok := GatewayOAuthAccountIndex(current)
+	expectedAccount, expectedOK := GatewayOAuthAccountIndex(expected)
+	if ok != expectedOK || account != expectedAccount || (verifiedCapability && !ok) {
+		return false
+	}
+	return publish()
+}
diff --git a/sdk/cliproxy/auth/gateway_catalog_test.go b/sdk/cliproxy/auth/gateway_catalog_test.go
