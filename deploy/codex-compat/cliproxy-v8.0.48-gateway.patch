+package helps
+
+import (
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"net/http"
+	"testing"
+)
+
+func TestGatewayCacheIsolation(t *testing.T) {
+	scope := func(user, account, provider string) string {
+		return GatewayCacheIdentity(map[string]any{cliproxyexecutor.GatewayUserIDMetadataKey: user, cliproxyexecutor.UpstreamAccountIndexMetadataKey: account}, provider, "same-session-or-tool")
+	}
+	seen := map[string]bool{}
+	for _, tuple := range [][3]string{{"u1", "a1", "codex"}, {"u2", "a1", "codex"}, {"u1", "a2", "codex"}, {"u1", "a1", "antigravity"}} {
+		value := scope(tuple[0], tuple[1], tuple[2])
+		if value == "" || seen[value] {
+			t.Fatal("cache scope collision")
+		}
+		seen[value] = true
+	}
+	if scope("u1", "", "antigravity") != "" {
+		t.Fatal("missing stable account allowed cache")
+	}
+}
+func TestGatewayGoogleEgressRejectsUnexpectedHosts(t *testing.T) {
+	for _, target := range []string{"https://evil.invalid/token", "http://oauth2.googleapis.com/token", "https://oauth2.googleapis.com:444/token", "https://user@oauth2.googleapis.com/token"} {
+		req, _ := http.NewRequest(http.MethodPost, target, nil)
+		if _, err := (GatewayGoogleTransport{}).RoundTrip(req); err == nil {
+			t.Fatalf("accepted %s", target)
+		}
+	}
+	if ValidGatewayProxy(":broken") || ValidGatewayProxy("direct") || ValidGatewayProxy("") {
+		t.Fatal("invalid proxy accepted")
+	}
+}
+func TestGatewayGeminiHistoryRequiresRealSignatures(t *testing.T) {
+	for _, signature := range []string{"", "skip_thought_signature_validator"} {
+		payload := []byte(`{"request":{"contents":[{"role":"model","parts":[{"functionCall":{"name":"run","args":{}},"thoughtSignature":"` + signature + `"}]}]}}`)
+		if ValidateGatewayGeminiHistory(payload) == nil {
+			t.Fatal("missing signature accepted")
+		}
+	}
+	if err := ValidateGatewayGeminiHistory([]byte(`{"request":{"contents":[{"role":"model","parts":[{"functionCall":{"name":"run","args":{}},"thoughtSignature":"real-signature"},{"functionCall":{"name":"run","args":{}}}]}]}}`)); err != nil {
+		t.Fatal(err)
+	}
+}
