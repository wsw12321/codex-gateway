+func allocationOptions(session string) cliproxyexecutor.Options {
+	return cliproxyexecutor.Options{Metadata: map[string]any{cliproxyexecutor.GatewayUserIDMetadataKey: "00000000-0000-0000-0000-000000000001"}, Headers: http.Header{"Session_id": []string{session}}}
+}
