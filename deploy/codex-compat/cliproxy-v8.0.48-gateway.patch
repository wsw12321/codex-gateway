diff --git a/sdk/cliproxy/auth/gateway_anthropic_identity.go b/sdk/cliproxy/auth/gateway_anthropic_identity.go
new file mode 100644
index 0000000..db89c17
--- /dev/null
+++ b/sdk/cliproxy/auth/gateway_anthropic_identity.go
@@ -0,0 +1,249 @@
+package auth
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+)
+
+const GatewayAnthropicIdentityFile = ".gateway-anthropic-identities"
+
+type gatewayAnthropicIdentityDocument struct {
+	Version  int               `json:"version"`
+	Accounts map[string]string `json:"accounts"`
+}
+
+// Identity mappings are independent of filenames, OAuth refreshes and credentials.
+// The server has one auth directory. Imports can only add verified Anthropic account and organization UUIDs.
+var gatewayAnthropicIdentities = struct {
+	sync.RWMutex
+	path     string
+	accounts map[string]string
+}{}
+
+func validAnthropicSubject(subject string) bool {
+	parts := strings.Split(subject, ":")
+	if len(parts) != 2 {
+		return false
+	}
+	for _, part := range parts {
+		if len(part) != 36 || part[8] != '-' || part[13] != '-' || part[18] != '-' || part[23] != '-' {
+			return false
+		}
+		if !isLowerHexString(strings.ReplaceAll(part, "-", "")) {
+			return false
+		}
+	}
+	return true
+}
+
+func AnthropicIdentitySubject(account, organization string) string {
+	subject := strings.ToLower(strings.TrimSpace(account)) + ":" + strings.ToLower(strings.TrimSpace(organization))
+	if !validAnthropicSubject(subject) {
+		return ""
+	}
+	return subject
+}
+
+func loadGatewayAnthropicIdentities(authDir string) error {
+	path := filepath.Join(authDir, GatewayAnthropicIdentityFile)
+	doc := gatewayAnthropicIdentityDocument{Version: 1, Accounts: map[string]string{}}
+	info, err := os.Lstat(path)
+	if err == nil {
+		if !info.Mode().IsRegular() || info.Mode().Perm() != 0600 || info.Size() > 4<<20 {
+			return ErrGatewayAccountIdentityInvalid
+		}
+		data, readErr := os.ReadFile(path)
+		if readErr != nil {
+			return ErrGatewayAccountStateUnavailable
+		}
+		fields, decodeErr := decodeGatewayObject(data, "version", "accounts")
+		if decodeErr != nil || json.Unmarshal(fields["version"], &doc.Version) != nil || doc.Version != 1 {
+			return ErrGatewayAccountIdentityInvalid
+		}
+		rawAccounts, decodeErr := decodeGatewayObject(fields["accounts"])
+		if decodeErr != nil {
+			return ErrGatewayAccountIdentityInvalid
+		}
+		seen := map[string]bool{}
+		for subject, value := range rawAccounts {
+			var id string
+			if !validAnthropicSubject(subject) || json.Unmarshal(value, &id) != nil || len(id) != 16 || !isLowerHexString(id) || seen[id] {
+				return ErrGatewayAccountIdentityInvalid
+			}
+			doc.Accounts[subject] = id
+			seen[id] = true
+		}
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return ErrGatewayAccountStateUnavailable
+	}
+	gatewayAnthropicIdentities.Lock()
+	defer gatewayAnthropicIdentities.Unlock()
+	gatewayAnthropicIdentities.path = path
+	gatewayAnthropicIdentities.accounts = doc.Accounts
+	return nil
+}
+
+// RegisterAnthropicIdentity accepts only a subject verified with Anthropic's
+// fixed userinfo endpoint by the server-side OAuth/import flow.
+func (m *Manager) RegisterAnthropicIdentity(subject string) (string, error) {
+	if m == nil || !validAnthropicSubject(subject) {
+		return "", ErrGatewayAccountIdentityInvalid
+	}
+	gatewayAnthropicIdentities.Lock()
+	defer gatewayAnthropicIdentities.Unlock()
+	if gatewayAnthropicIdentities.path == "" {
+		return "", ErrGatewayAccountStateUnavailable
+	}
+	if id := gatewayAnthropicIdentities.accounts[subject]; id != "" {
+		return id, nil
+	}
+	sum := sha256.Sum256([]byte("codex-gateway-anthropic-account-organization:\x00" + subject))
+	id := hex.EncodeToString(sum[:8])
+	for _, existing := range gatewayAnthropicIdentities.accounts {
+		if existing == id {
+			return "", ErrGatewayAccountIdentityInvalid
+		}
+	}
+	next := make(map[string]string, len(gatewayAnthropicIdentities.accounts)+1)
+	for subject, id := range gatewayAnthropicIdentities.accounts {
+		next[subject] = id
+	}
+	next[subject] = id
+	data, err := json.Marshal(gatewayAnthropicIdentityDocument{Version: 1, Accounts: next})
+	if err != nil {
+		return "", err
+	}
+	dir := filepath.Dir(gatewayAnthropicIdentities.path)
+	file, err := os.CreateTemp(dir, GatewayAnthropicIdentityFile+".")
+	if err != nil {
+		return "", ErrGatewayAccountStateUnavailable
+	}
+	name := file.Name()
+	defer os.Remove(name)
+	if err = file.Chmod(0600); err == nil {
+		_, err = file.Write(data)
+	}
+	if err == nil {
+		err = file.Sync()
+	}
+	closeErr := file.Close()
+	if err != nil || closeErr != nil {
+		return "", ErrGatewayAccountStateUnavailable
+	}
+	if err = os.Rename(name, gatewayAnthropicIdentities.path); err != nil {
+		return "", ErrGatewayAccountStateUnavailable
+	}
+	d, err := os.Open(dir)
+	if err != nil {
+		return "", ErrGatewayAccountStateUnavailable
+	}
+	err = d.Sync()
+	_ = d.Close()
+	if err != nil {
+		return "", ErrGatewayAccountStateUnavailable
+	}
+	gatewayAnthropicIdentities.accounts = next
+	return id, nil
+}
+
+func anthropicOAuthAccountIndex(candidate *Auth) (string, bool) {
+	if candidate == nil || !strings.EqualFold(strings.TrimSpace(candidate.Provider), "claude") || candidate.AuthKind() != AuthKindOAuth {
+		return "", false
+	}
+	if strings.EqualFold(strings.TrimSpace(os.Getenv("CPA_ANTIGRAVITY_ENABLED")), "false") || candidate.Attributes["gateway_provider_disabled"] == "true" || candidate.Attributes["gateway_identity_conflict"] == "true" || candidate.Metadata["gateway_identity_conflict"] == true {
+		return "", false
+	}
+	subject, _ := candidate.Metadata["gateway_anthropic_subject"].(string)
+	account, _ := candidate.Metadata["account_uuid"].(string)
+	organization, _ := candidate.Metadata["organization_uuid"].(string)
+	if !validAnthropicSubject(subject) || subject != AnthropicIdentitySubject(account, organization) {
+		return "", false
+	}
+	gatewayAnthropicIdentities.RLock()
+	id := gatewayAnthropicIdentities.accounts[subject]
+	gatewayAnthropicIdentities.RUnlock()
+	if len(id) != 16 || !isLowerHexString(id) {
+		return "", false
+	}
+	return id, true
+}
+
+func applyAnthropicOAuthAccountIdentity(candidate *Auth, metadata map[string]any) bool {
+	if candidate == nil {
+		return false
+	}
+	if !strings.EqualFold(strings.TrimSpace(candidate.Provider), "claude") {
+		return false
+	}
+	if strings.EqualFold(strings.TrimSpace(os.Getenv("CPA_ANTHROPIC_ENABLED")), "false") {
+		if candidate.Attributes == nil {
+			candidate.Attributes = map[string]string{}
+		}
+		candidate.Attributes["gateway_provider_disabled"] = "true"
+		candidate.Disabled = true
+		candidate.Status = StatusDisabled
+		candidate.GatewayAccountBlocked = true
+		return false
+	}
+	// Unmapped legacy credentials have no Gateway account index. The Gateway
+	// selector and registry filter reject them, while standalone CPA retains
+	// upstream provider behavior outside the gateway-allocation deployment.
+	if subject, _ := metadata["gateway_anthropic_subject"].(string); subject == "" {
+		return false
+	}
+	if metadata["gateway_identity_conflict"] == true {
+		candidate.Disabled = true
+		candidate.Status = StatusDisabled
+		candidate.GatewayAccountBlocked = true
+		return false
+	}
+	if candidate.Attributes == nil {
+		candidate.Attributes = map[string]string{}
+	}
+	candidate.Attributes[AttributeAuthKind] = AuthKindOAuth
+	id, ok := anthropicOAuthAccountIndex(candidate)
+	if !ok {
+		candidate.GatewayAccountBlocked = true
+		candidate.Disabled = true
+		candidate.Status = StatusDisabled
+		candidate.Index = ""
+		candidate.indexAssigned = false
+		return false
+	}
+	candidate.Index = id
+	candidate.indexAssigned = true
+	return true
+}
+
+func quarantineDuplicateAnthropicIdentities(auths []*Auth) {
+	groups := map[string][]*Auth{}
+	for _, candidate := range auths {
+		if candidate == nil || !strings.EqualFold(strings.TrimSpace(candidate.Provider), "claude") {
+			continue
+		}
+		subject, _ := candidate.Metadata["gateway_anthropic_subject"].(string)
+		if subject != "" {
+			groups[subject] = append(groups[subject], candidate)
+		}
+	}
+	for _, group := range groups {
+		if len(group) < 2 {
+			continue
+		}
+		for _, candidate := range group {
+			if candidate.Attributes == nil {
+				candidate.Attributes = map[string]string{}
+			}
+			candidate.Attributes["gateway_identity_conflict"] = "true"
+			candidate.Disabled = true
+			candidate.Status = StatusDisabled
+			candidate.GatewayAccountBlocked = true
+		}
+	}
+}
