+func TestGatewayExecutionRequestUsesTrustedCallerAndAccountScope(t *testing.T) {
+	candidate := codexOAuthDedupeAuth("caller-scope.json", "scope-account", "2026-10-08T00:00:00Z")
+	untrusted := map[string]any{
+		cliproxyexecutor.GatewayUserIDMetadataKey:        "forged-user",
+		cliproxyexecutor.CallerScopeMetadataKey:          "forged-caller",
+		cliproxyexecutor.UpstreamAccountIndexMetadataKey: "forged-account",
+		"unrelated": "preserved",
+	}
+	trusted := cliproxyexecutor.Options{Metadata: map[string]any{
+		cliproxyexecutor.GatewayUserIDMetadataKey:        "trusted-user",
+		cliproxyexecutor.CallerScopeMetadataKey:          "trusted-caller",
+		cliproxyexecutor.UpstreamAccountIndexMetadataKey: "stale-account",
+	}}
+	request := cliproxyexecutor.Request{Metadata: untrusted}
+	prepared := gatewayExecutionRequest(candidate, request, trusted)
+	if prepared.Metadata[cliproxyexecutor.GatewayUserIDMetadataKey] != "trusted-user" || prepared.Metadata[cliproxyexecutor.CallerScopeMetadataKey] != "trusted-caller" || prepared.Metadata[cliproxyexecutor.UpstreamAccountIndexMetadataKey] != gatewayAccountResultIndex(candidate) {
+		t.Fatalf("executor received untrusted cache scope: %#v", prepared.Metadata)
+	}
+	if untrusted[cliproxyexecutor.CallerScopeMetadataKey] != "forged-caller" || prepared.Metadata["unrelated"] != "preserved" {
+		t.Fatal("preparing request mutated input metadata or dropped unrelated fields")
+	}
+	prepared = gatewayExecutionRequest(nil, request, trusted)
+	if _, exists := prepared.Metadata[cliproxyexecutor.UpstreamAccountIndexMetadataKey]; exists {
+		t.Fatal("missing account retained an untrusted account cache scope")
+	}
+	prepared = gatewayExecutionRequest(candidate, request, cliproxyexecutor.Options{})
+	for _, key := range []string{cliproxyexecutor.GatewayUserIDMetadataKey, cliproxyexecutor.CallerScopeMetadataKey, cliproxyexecutor.UpstreamAccountIndexMetadataKey} {
+		if _, exists := prepared.Metadata[key]; exists {
+			t.Fatalf("missing trusted options retained %s", key)
+		}
