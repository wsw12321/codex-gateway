+func (e *gatewayAllocationExecutor) ExecuteStream(_ context.Context, a *Auth, _ cliproxyexecutor.Request, _ cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error) {
+	e.record(a.ID)
+	chunks := make(chan cliproxyexecutor.StreamChunk, 2)
+	if a.ID != e.failedID || e.afterPayload {
+		chunks <- cliproxyexecutor.StreamChunk{Payload: []byte("first")}
+	}
+	if a.ID == e.failedID {
+		chunks <- cliproxyexecutor.StreamChunk{Err: &Error{HTTPStatus: 502}}
+	}
+	close(chunks)
+	return &cliproxyexecutor.StreamResult{Chunks: chunks}, nil
+}
+
+func TestGatewayAllocationFailoverFinalAttribution(t *testing.T) {
+	for _, mode := range []string{"json", "stream-bootstrap", "stream-after-payload", "callback-fails-on-retry"} {
+		t.Run(mode, func(t *testing.T) {
+			m, a, _ := newGatewayAccountTestManager(t)
+			b := gatewayRegisterAccount(t, m, "failover-b-"+a.ID, "failover-b-"+a.ID)
+			e := &gatewayAllocationExecutor{gatewayPolicyExecutor: gatewayPolicyExecutor{id: "codex"}, failedID: a.ID, afterPayload: mode == "stream-after-payload"}
+			m.RegisterExecutor(e)
+			s, _ := allocationFixture(t)
+			m.SetSelector(s)
+			var callbacks int
+			s.client.Transport = gatewayAllocationTransport(func(r *http.Request) (*http.Response, error) {
+				callbacks++
+				var body struct {
+					AccountIDs []string `json:"account_ids"`
+				}
+				if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+					t.Fatal(err)
+				}
+				index := a.Index
+				if callbacks > 1 {
+					if len(body.AccountIDs) != 1 || body.AccountIDs[0] != b.Index {
+						t.Errorf("retry candidates = %v", body.AccountIDs)
+					}
+					if mode == "callback-fails-on-retry" {
+						return allocationResponse(503, `{}`), nil
+					}
+					index = b.Index
+				}
+				return allocationResponse(200, fmt.Sprintf(`{"account_id":%q}`, index)), nil
+			})
+			var attribution string
+			opts := allocationOptions("failover")
+			opts.Metadata = map[string]any{cliproxyexecutor.GatewayUserIDMetadataKey: "00000000-0000-0000-0000-000000000001", cliproxyexecutor.UpstreamAccountIndexCallbackMetadataKey: func(id string) { attribution = id }}
+			request := cliproxyexecutor.Request{Model: "gateway-model"}
+			var err error
+			if strings.HasPrefix(mode, "stream") {
+				opts.Stream = true
+				var result *cliproxyexecutor.StreamResult
+				result, err = m.ExecuteStream(context.Background(), []string{"codex"}, request, opts)
+				if result != nil {
+					for range result.Chunks {
+					}
+				}
+			} else {
+				_, err = m.Execute(context.Background(), []string{"codex"}, request, opts)
+			}
+			if mode == "callback-fails-on-retry" {
+				assertAllocation503(t, err)
+				if len(e.Calls()) != 1 {
+					t.Fatalf("callback error replayed account: %v", e.Calls())
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			wantIndex, wantCalls := b.Index, 2
+			if mode == "stream-after-payload" {
+				wantIndex, wantCalls = a.Index, 1
+			}
+			if attribution != wantIndex || len(e.Calls()) != wantCalls || callbacks != wantCalls {
+				t.Fatalf("attribution=%s calls=%v callbacks=%d", attribution, e.Calls(), callbacks)
+			}
+		})
+	}
+}
+
+type gatewayAccessTransport func(*http.Request) (*http.Response, error)
+
+func (f gatewayAccessTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestGatewayAllocationAccessRechecksBindingsAndPreservesOtherSessions(t *testing.T) {
+	s, auths := allocationFixture(t)
+	a, b := gatewayAccountResultIndex(auths[0]), gatewayAccountResultIndex(auths[1])
+	allowed := []string{a, b}
+	lookups := 0
+	fail := false
+	s.client.Transport = gatewayAccessTransport(func(r *http.Request) (*http.Response, error) {
+		var req struct {
+			AccountIDs []string `json:"account_ids"`
+			UserID     string   `json:"user_id"`
+		}
+		if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.UserID != "00000000-0000-0000-0000-000000000001" {
+			t.Fatal("identity omitted from callback")
+		}
+		if r.URL.String() == gatewayEligibilityURL {
+			lookups++
+			if fail {
+				return allocationResponse(503, `{}`), nil
+			}
+			accounts := make([]map[string]any, 0, len(allowed))
+			for _, id := range allowed {
+				accounts = append(accounts, map[string]any{"id": id, "concurrent_limit": 1})
+			}
+			data, _ := json.Marshal(map[string]any{"accounts": accounts})
+			return allocationResponse(200, string(data)), nil
+		}
+		if len(allowed) == 1 && (len(req.AccountIDs) != 1 || req.AccountIDs[0] != b) {
+			t.Fatalf("allocation candidates include denied account: %v", req.AccountIDs)
+		}
+		return allocationResponse(200, fmt.Sprintf(`{"account_id":%q}`, allowed[0])), nil
+	})
+	for _, session := range []string{"current", "other"} {
+		if _, err := s.Pick(context.Background(), "codex", "gateway-model", allocationOptions(session), auths); err != nil {
+			t.Fatal(err)
+		}
+	}
+	allowed = []string{b}
+	got, err := s.Pick(context.Background(), "codex", "gateway-model", allocationOptions("current"), auths)
+	if err != nil || got.ID != auths[1].ID {
+		t.Fatalf("revoked binding reused: %v %v", got, err)
+	}
+	allowed = []string{a, b}
+	got, err = s.Pick(context.Background(), "codex", "gateway-model", allocationOptions("other"), auths)
+	if err != nil || got.ID != auths[0].ID {
+		t.Fatalf("unrelated session invalidated: %v %v", got, err)
+	}
+	fail = true
+	if _, err := s.Pick(context.Background(), "codex", "gateway-model", allocationOptions("other"), auths); err == nil {
+		t.Fatal("bound request bypassed failed permission lookup")
+	}
+	if lookups < 5 {
+		t.Fatal("permissions were cached across requests")
+	}
+}
+
+func TestGatewayAllocationAccessRejectsIdentityAndForgedEligibility(t *testing.T) {
+	for _, identity := range []string{"", "invalid", "00000000-0000-0000-0000-00000000000X"} {
+		s, auths := allocationFixture(t)
+		s.client.Transport = gatewayAccessTransport(func(*http.Request) (*http.Response, error) {
+			t.Fatal("invalid identity reached callback")
+			return nil, nil
+		})
+		opts := allocationOptions("identity")
+		opts.Metadata[cliproxyexecutor.GatewayUserIDMetadataKey] = identity
+		_, err := s.Pick(context.Background(), "codex", "gateway-model", opts, auths)
+		assertAllocation503(t, err)
+	}
+	for _, body := range []string{`{"account_ids":["ffffffffffffffff"]}`, `{"account_ids":[]}`, `{"account_ids":null}`, `{"accounts":[]}`, `{"accounts":null}`, `{"accounts":[{"id":"ffffffffffffffff","concurrent_limit":1}]}`, `{"accounts":[{"id":"allocation-account-a","concurrent_limit":0}]}`, `{"accounts":[{"id":"allocation-account-a","concurrent_limit":1},{"id":"allocation-account-a","concurrent_limit":1}]}`} {
+		s, auths := allocationFixture(t)
+		s.client.Transport = gatewayAccessTransport(func(*http.Request) (*http.Response, error) { return allocationResponse(200, body), nil })
+		_, err := s.Pick(context.Background(), "codex", "gateway-model", allocationOptions("denied"), auths)
+		assertAllocation503(t, err)
+	}
