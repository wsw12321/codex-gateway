diff --git a/sdk/cliproxy/auth/gateway_account_state.go b/sdk/cliproxy/auth/gateway_account_state.go
new file mode 100644
index 0000000..9611139
--- /dev/null
+++ b/sdk/cliproxy/auth/gateway_account_state.go
@@ -0,0 +1,448 @@
+package auth
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+)
+
+const GatewayAccountStateFile = ".gateway-account-state"
+
+var (
+	ErrGatewayAccountNotFound         = errors.New("gateway account not found")
+	ErrGatewayAccountIdentityInvalid  = errors.New("gateway account identity invalid")
+	ErrGatewayAccountStateUnavailable = errors.New("gateway account state unavailable")
+)
+
+type gatewayAccountState struct {
+	Enabled        bool      `json:"enabled"`
+	ManualDisabled bool      `json:"manual_disabled"`
+	QuotaExhausted bool      `json:"quota_exhausted"`
+	Version        uint64    `json:"version"`
+	UpdatedAt      time.Time `json:"updated_at"`
+}
+
+type gatewayAccountStateDocument struct {
+	Version  int                            `json:"version"`
+	Accounts map[string]gatewayAccountState `json:"accounts"`
+}
+
+// IsGatewayAccountStateFile also excludes temporary files used for atomic replacement.
+func IsGatewayAccountStateFile(name string) bool {
+	name = filepath.Base(name)
+	return name == GatewayAnthropicIdentityFile || strings.HasPrefix(name, GatewayAnthropicIdentityFile+".") || name == GatewayAccountStateFile || strings.HasPrefix(name, GatewayAccountStateFile+".") || name == GatewayAntigravityIdentityFile || strings.HasPrefix(name, GatewayAntigravityIdentityFile+".")
+}
+
+// GatewayAccountAvailable reports the persistent control and credential identity gates.
+// Transient cooldown remains the responsibility of the ordinary availability code.
+func GatewayAccountAvailable(auth *Auth) bool {
+	return auth != nil && !auth.GatewayAccountBlocked && !auth.Disabled && auth.Status != StatusDisabled
+}
+
+// GatewayAccountStatuses exposes the two durable Gateway controls without
+// exposing the state document or allowing callers to infer them from the
+// merged routing result. Missing state means both controls are healthy.
+func (m *Manager) GatewayAccountStatuses(index string) (manual, quota string, ok bool) {
+	if m == nil || len(index) != 16 || !isLowerHexString(index) {
+		return "unknown", "unknown", false
+	}
+	m.mu.RLock()
+	defer m.mu.RUnlock()
+	state, exists := m.gatewayAccountStates[index]
+	if !exists {
+		return "enabled", "available", true
+	}
+	manual = "enabled"
+	if state.ManualDisabled {
+		manual = "manual_disabled"
+	}
+	quota = "available"
+	if state.QuotaExhausted {
+		quota = "quota_exhausted"
+	}
+	return manual, quota, true
+}
+
+// LoadGatewayAccountState must complete before credentials are loaded or served.
+// An unreadable or malformed existing file is fatal; missing state starts empty.
+func (m *Manager) LoadGatewayAccountState(authDir string) error {
+	if m == nil || strings.TrimSpace(authDir) == "" {
+		return ErrGatewayAccountStateUnavailable
+	}
+	if err := loadGatewayAnthropicIdentities(authDir); err != nil {
+		return err
+	}
+	if err := loadGatewayAntigravityIdentities(authDir); err != nil {
+		return err
+	}
+	path := filepath.Join(authDir, GatewayAccountStateFile)
+	doc := gatewayAccountStateDocument{Version: 1, Accounts: make(map[string]gatewayAccountState)}
+	info, err := os.Lstat(path)
+	if err == nil {
+		if !info.Mode().IsRegular() || info.Size() > 4<<20 {
+			return ErrGatewayAccountStateUnavailable
+		}
+		data, errRead := os.ReadFile(path)
+		if errRead != nil {
+			return ErrGatewayAccountStateUnavailable
+		}
+		doc, err = decodeGatewayAccountState(data)
+		if err != nil {
+			return ErrGatewayAccountStateUnavailable
+		}
+		if errChmod := os.Chmod(path, 0o600); errChmod != nil {
+			return ErrGatewayAccountStateUnavailable
+		}
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return ErrGatewayAccountStateUnavailable
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	// Prevent a runtime reload from rolling account versions backwards.
+	if m.gatewayAccountStatePath != "" {
+		if m.gatewayAccountStatePath == path {
+			return nil
+		}
+		return ErrGatewayAccountStateUnavailable
+	}
+	m.gatewayAccountStatePath = path
+	m.gatewayAccountStates = doc.Accounts
+	for _, auth := range m.auths {
+		if auth == nil {
+			continue
+		}
+		m.applyGatewayAccountStateLocked(auth)
+		auth.Generation++
+		m.publishGatewayAccountAuthLocked(auth)
+	}
+	return nil
+}
+
+// decodeGatewayObject rejects duplicate and case-alias keys rather than letting
+// encoding/json silently choose the last value of an ambiguous control file.
+func decodeGatewayObject(data []byte, fields ...string) (map[string]json.RawMessage, error) {
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	token, err := decoder.Token()
+	if err != nil || token != json.Delim('{') {
+		return nil, ErrGatewayAccountStateUnavailable
+	}
+	object := make(map[string]json.RawMessage)
+	for decoder.More() {
+		token, err = decoder.Token()
+		key, ok := token.(string)
+		if err != nil || !ok {
+			return nil, ErrGatewayAccountStateUnavailable
+		}
+		if _, exists := object[key]; exists {
+			return nil, ErrGatewayAccountStateUnavailable
+		}
+		if len(fields) > 0 {
+			allowed := false
+			for _, field := range fields {
+				allowed = allowed || key == field
+			}
+			if !allowed {
+				return nil, ErrGatewayAccountStateUnavailable
+			}
+		}
+		var value json.RawMessage
+		if err = decoder.Decode(&value); err != nil {
+			return nil, ErrGatewayAccountStateUnavailable
+		}
+		object[key] = value
+	}
+	if token, err = decoder.Token(); err != nil || token != json.Delim('}') {
+		return nil, ErrGatewayAccountStateUnavailable
+	}
+	if _, err = decoder.Token(); err != io.EOF || len(fields) > 0 && len(object) != len(fields) {
+		return nil, ErrGatewayAccountStateUnavailable
+	}
+	return object, nil
+}
+
+func decodeGatewayAccountState(data []byte) (gatewayAccountStateDocument, error) {
+	doc := gatewayAccountStateDocument{Version: 1, Accounts: make(map[string]gatewayAccountState)}
+	root, err := decodeGatewayObject(data, "version", "accounts")
+	if err != nil || string(root["version"]) != "1" {
+		return doc, ErrGatewayAccountStateUnavailable
+	}
+	accounts, err := decodeGatewayObject(root["accounts"])
+	if err != nil {
+		return doc, err
+	}
+	for index, raw := range accounts {
+		if len(index) != 16 || !isLowerHexString(index) {
+			return doc, ErrGatewayAccountStateUnavailable
+		}
+		fields, err := decodeGatewayObject(raw, "enabled", "manual_disabled", "quota_exhausted", "version", "updated_at")
+		if err != nil {
+			return doc, err
+		}
+		for _, field := range []string{"enabled", "manual_disabled", "quota_exhausted"} {
+			if value := string(fields[field]); value != "true" && value != "false" {
+				return doc, ErrGatewayAccountStateUnavailable
+			}
+		}
+		var state gatewayAccountState
+		if err = json.Unmarshal(raw, &state); err != nil || state.Version == 0 || state.UpdatedAt.IsZero() || state.Enabled == (state.ManualDisabled || state.QuotaExhausted) {
+			return doc, ErrGatewayAccountStateUnavailable
+		}
+		doc.Accounts[index] = state
+	}
+	return doc, nil
+}
+
+func (m *Manager) applyGatewayAccountStateLocked(auth *Auth) {
+	if auth == nil {
+		return
+	}
+	index, valid := GatewayOAuthAccountIndex(auth)
+	if !valid {
+		auth.GatewayAccountBlocked = false
+		auth.GatewayAccountVersion = 0
+		return
+	}
+	state, exists := m.gatewayAccountStates[index]
+	if !exists {
+		auth.GatewayAccountBlocked = false
+		auth.GatewayAccountVersion = 0
+		return
+	}
+	if state.Enabled {
+		// A confirmed administrator enable overrides file-level disable, after
+		// intrinsic identity validation has succeeded.
+		auth.Disabled = false
+		if auth.Status == StatusDisabled {
+			auth.Status = StatusActive
+		}
+	}
+	auth.GatewayAccountBlocked = !state.Enabled || state.ManualDisabled || state.QuotaExhausted
+	auth.GatewayAccountVersion = state.Version
+}
+
+// SetGatewayAccountEnabled atomically persists the control change before acknowledging it.
+// All duplicate OAuth records share the stable intrinsic account index.
+func (m *Manager) SetGatewayAccountEnabled(index string, enabled bool) (string, error) {
+	if m == nil || len(index) != 16 || !isLowerHexString(index) {
+		return "", ErrGatewayAccountNotFound
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	found := false
+	for _, auth := range m.auths {
+		if auth == nil {
+			continue
+		}
+		candidateIndex, valid := GatewayOAuthAccountIndex(auth)
+		if auth.Index == index && !valid {
+			return "", ErrGatewayAccountIdentityInvalid
+		}
+		if valid && candidateIndex == index {
+			verified := auth.Clone()
+			if !ApplyGatewayOAuthAccountIdentity(verified, verified.Metadata) {
+				return "", ErrGatewayAccountIdentityInvalid
+			}
+			verifiedIndex, validIdentity := GatewayOAuthAccountIndex(verified)
+			if !validIdentity || verifiedIndex != index {
+				return "", ErrGatewayAccountIdentityInvalid
+			}
+			found = true
+		}
+	}
+	if !found {
+		return "", ErrGatewayAccountNotFound
+	}
+	previous := m.gatewayAccountStates[index]
+	state := gatewayAccountState{Enabled: enabled, ManualDisabled: !enabled, Version: previous.Version + 1, UpdatedAt: time.Now().UTC()}
+	if m.gatewayAccountStates == nil {
+		m.gatewayAccountStates = make(map[string]gatewayAccountState)
+	}
+	m.gatewayAccountStates[index] = state
+	if err := m.persistGatewayAccountStatesLocked(); err != nil {
+		// Never let failed enable participate in routing. Also retain a failed
+		// disable in memory, while reporting that durability was not confirmed.
+		state.Enabled = false
+		state.ManualDisabled = true
+		state.QuotaExhausted = previous.QuotaExhausted
+		m.gatewayAccountStates[index] = state
+		// A directory-sync failure may happen after rename; best effort rewrites
+		// the conservative state so a later restart does not observe an enable.
+		_ = m.persistGatewayAccountStatesLocked()
+		m.publishGatewayAccountStateLocked(index, false)
+		return "", ErrGatewayAccountStateUnavailable
+	}
+	m.publishGatewayAccountStateLocked(index, enabled)
+	if enabled {
+		return "available", nil
+	}
+	return "unavailable", nil
+}
+
+func (m *Manager) publishGatewayAccountStateLocked(index string, clearCooldown bool) {
+	now := time.Now()
+	for _, auth := range m.auths {
+		candidateIndex, valid := GatewayOAuthAccountIndex(auth)
+		if !valid || candidateIndex != index {
+			continue
+		}
+		m.applyGatewayAccountStateLocked(auth)
+		if clearCooldown {
+			auth.Unavailable = false
+			auth.NextRetryAfter = time.Time{}
+			auth.Quota = QuotaState{}
+			auth.LastError = nil
+			auth.StatusMessage = ""
+			auth.Status = StatusActive
+			for _, state := range auth.ModelStates {
+				if state != nil {
+					resetModelState(state, now)
+					state.Quota = QuotaState{}
+				}
+			}
+		}
+		auth.Generation++
+		auth.UpdatedAt = now
+		m.publishGatewayAccountAuthLocked(auth)
+	}
+}
+
+func (m *Manager) publishGatewayAccountAuthLocked(auth *Auth) {
+	snapshot := auth.Clone()
+	if m.scheduler != nil {
+		m.scheduler.upsertAuth(snapshot)
+	}
+	models, epoch := registry.GetGlobalRegistry().GetModelsAndEpochForClient(auth.ID)
+	projections := make([]registry.ClientModelProjection, 0, len(models))
+	for _, model := range models {
+		if model != nil && strings.TrimSpace(model.ID) != "" {
+			projections = append(projections, m.clientModelProjectionForAuth(snapshot, model.ID, time.Now()))
+		}
+	}
+	registry.GetGlobalRegistry().ApplyClientModelProjections(auth.ID, epoch, snapshot.Generation, projections)
+}
+
+// markGatewayQuotaExhaustedLocked acts only on explicit generation failures;
+// the quota query endpoint never calls this result-processing path.
+func (m *Manager) markGatewayQuotaExhaustedLocked(auth *Auth) {
+	// Anthropic retains its native time-based automatic cooldown recovery.
+	if auth != nil && auth.Provider == "claude" {
+		return
+	}
+	index, valid := GatewayOAuthAccountIndex(auth)
+	if !valid {
+		return
+	}
+	state := m.gatewayAccountStates[index]
+	if state.QuotaExhausted {
+		return
+	}
+	state.Enabled = false
+	state.QuotaExhausted = true
+	state.Version++
+	state.UpdatedAt = time.Now().UTC()
+	if m.gatewayAccountStates == nil {
+		m.gatewayAccountStates = make(map[string]gatewayAccountState)
+	}
+	m.gatewayAccountStates[index] = state
+	// A quota lock is a Gateway control state. Clear the transient sidecar
+	// cooldown markers so the account view does not report that lock as a
+	// CLIProxyAPI outage.
+	auth.Unavailable = false
+	auth.NextRetryAfter = time.Time{}
+	auth.Quota = QuotaState{}
+	if auth.Status == StatusPending || auth.Status == StatusRefreshing {
+		auth.Status = StatusActive
+	}
+	if err := m.persistGatewayAccountStatesLocked(); err != nil {
+		logEntryWithRequestID(nil).Error("gateway account quota state persistence failed")
+	}
+	m.publishGatewayAccountStateLocked(index, false)
+}
+
+func gatewayAccountResultIndex(auth *Auth) string {
+	if auth == nil {
+		return ""
+	}
+	// CodexOAuthAccountIndex initializes runtime index fields. Do that on a
+	// shallow copy because one immutable selected auth can feed concurrent results.
+	copyAuth := *auth
+	index, valid := GatewayOAuthAccountIndex(&copyAuth)
+	if !valid {
+		return ""
+	}
+	return index
+}
+
+func (m *Manager) gatewayResultCurrentLocked(auth *Auth, result Result) bool {
+	if auth == nil || auth.GatewayAccountBlocked || auth.GatewayAccountVersion != result.GatewayAccountVersion {
+		return false
+	}
+	if result.GatewayAccountIndex != "" {
+		index, valid := GatewayOAuthAccountIndex(auth)
+		return valid && index == result.GatewayAccountIndex
+	}
+	return true
+}
+
+func (m *Manager) gatewayCooldownRecordCurrentLocked(auth *Auth, record CooldownStateRecord) bool {
+	if !GatewayAccountAvailable(auth) {
+		return false
+	}
+	index, valid := GatewayOAuthAccountIndex(auth)
+	if !valid {
+		return true
+	}
+	state, exists := m.gatewayAccountStates[index]
+	return !exists || !state.Enabled || record.UpdatedAt.After(state.UpdatedAt)
+}
+
+func (m *Manager) persistGatewayAccountStatesLocked() error {
+	if m.gatewayAccountStatePath == "" {
+		return ErrGatewayAccountStateUnavailable
+	}
+	data, err := json.Marshal(gatewayAccountStateDocument{Version: 1, Accounts: m.gatewayAccountStates})
+	if err != nil {
+		return err
+	}
+	dir := filepath.Dir(m.gatewayAccountStatePath)
+	file, err := os.CreateTemp(dir, GatewayAccountStateFile+".")
+	if err != nil {
+		return err
+	}
+	temp := file.Name()
+	defer func() { _ = os.Remove(temp) }()
+	if err = file.Chmod(0o600); err == nil {
+		_, err = file.Write(data)
+	}
+	if err == nil {
+		err = file.Sync()
+	}
+	errClose := file.Close()
+	if err == nil {
+		err = errClose
+	}
+	if err != nil {
+		return err
+	}
+	if err = os.Rename(temp, m.gatewayAccountStatePath); err != nil {
+		return err
+	}
+	directory, err := os.Open(dir)
+	if err != nil {
+		return err
+	}
+	err = directory.Sync()
+	errClose = directory.Close()
+	if err != nil {
+		return fmt.Errorf("sync account state directory: %w", err)
+	}
+	return errClose
+}
diff --git a/sdk/cliproxy/auth/gateway_account_state_test.go b/sdk/cliproxy/auth/gateway_account_state_test.go
new file mode 100644
index 0000000..774ed31
--- /dev/null
+++ b/sdk/cliproxy/auth/gateway_account_state_test.go
@@ -0,0 +1,418 @@
+package auth
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+func newGatewayAccountTestManager(t *testing.T) (*Manager, *Auth, string) {
+	t.Helper()
+	dir := t.TempDir()
+	m := NewManager(nil, nil, nil)
+	if err := m.LoadGatewayAccountState(dir); err != nil {
+		t.Fatal(err)
+	}
+	candidate := gatewayRegisterAccount(t, m, uuid.NewString()+".json", uuid.NewString())
+	m.RegisterExecutor(&gatewayPolicyExecutor{id: "codex"})
+	m.SetRetryConfig(0, 0, 2)
+	return m, candidate, dir
+}
+
+func gatewayRegisterAccount(t *testing.T, m *Manager, id, accountID string) *Auth {
+	t.Helper()
+	candidate := codexOAuthDedupeAuth(id, accountID, "2026-08-20T00:00:00Z")
+	registry.GetGlobalRegistry().RegisterClient(id, "codex", []*registry.ModelInfo{{ID: "gateway-model"}, {ID: "other-model"}})
+	t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(id) })
+	saved, err := m.Register(context.Background(), candidate)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return saved
+}
+
+func gatewayResult(candidate *Auth, err *Error) Result {
+	return Result{AuthID: candidate.ID, CredentialVersion: candidate.CredentialVersion, RegistrationEpoch: candidate.RegistrationEpoch, GatewayAccountIndex: gatewayAccountResultIndex(candidate), GatewayAccountVersion: candidate.GatewayAccountVersion,
+		Provider: "codex", Model: "gateway-model", Success: err == nil, Error: err}
+}
+
+func assertGatewayRoutable(t *testing.T, m *Manager, want bool) {
+	t.Helper()
+	_, err := m.Execute(context.Background(), []string{"codex"}, cliproxyexecutor.Request{Model: "gateway-model"}, cliproxyexecutor.Options{})
+	if (err == nil) != want {
+		t.Fatalf("request error = %v, want routable %v", err, want)
+	}
+}
+
+func TestGatewayAccountManualDisableEnableRestoresAllModels(t *testing.T) {
+	m, candidate, dir := newGatewayAccountTestManager(t)
+	assertGatewayRoutable(t, m, true)
+	if status, err := m.SetGatewayAccountEnabled(candidate.Index, false); err != nil || status != "unavailable" {
+		t.Fatalf("disable = %s, %v", status, err)
+	}
+	assertGatewayRoutable(t, m, false)
+	if m.HasProviderAuth("codex") || len(m.AvailableProviders()) != 0 {
+		t.Fatal("disabled account remained in provider availability")
+	}
+	info, err := os.Stat(filepath.Join(dir, GatewayAccountStateFile))
+	if err != nil || info.Mode().Perm() != 0o600 {
+		t.Fatalf("state permissions = %v, %v", info, err)
+	}
+	m.MarkResult(context.Background(), gatewayResult(candidate, nil))
+	assertGatewayRoutable(t, m, false)
+	m.mu.Lock()
+	current := m.auths[candidate.ID]
+	current.Unavailable = true
+	current.NextRetryAfter = time.Now().Add(time.Hour)
+	current.Quota = QuotaState{Exceeded: true, Reason: "credential_quota", NextRecoverAt: current.NextRetryAfter}
+	current.ModelStates = map[string]*ModelState{"gateway-model": {Status: StatusDisabled, Unavailable: true, NextRetryAfter: current.NextRetryAfter, Quota: current.Quota}, "other-model": {Unavailable: true, NextRetryAfter: current.NextRetryAfter}}
+	m.mu.Unlock()
+	if status, err := m.SetGatewayAccountEnabled(candidate.Index, true); err != nil || status != "available" {
+		t.Fatalf("enable = %s, %v", status, err)
+	}
+	current, _ = m.GetByID(candidate.ID)
+	if current.Unavailable || !current.NextRetryAfter.IsZero() || current.Quota.Exceeded || !GatewayAccountAvailable(current) {
+		t.Fatalf("enable retained account cooldown: %#v", current)
+	}
+	for _, model := range []string{"gateway-model", "other-model"} {
+		if blocked, _, _ := isAuthBlockedForModel(current, model, time.Now()); blocked {
+			t.Fatalf("enable retained model block for %s", model)
+		}
+		if projection := m.clientModelProjectionForAuth(current, model, time.Now()); projection.Suspended || projection.QuotaExceeded {
+			t.Fatalf("enable retained registry block for %s: %#v", model, projection)
+		}
+	}
+	assertGatewayRoutable(t, m, true)
+}
+
+func TestGatewayAccountQuotaLocksDuplicatesRestartAndReplacement(t *testing.T) {
+	m, candidate, dir := newGatewayAccountTestManager(t)
+	accountID := candidate.Metadata["account_id"].(string)
+	duplicate := gatewayRegisterAccount(t, m, uuid.NewString()+".json", accountID)
+	m.MarkResult(context.Background(), gatewayResult(candidate, &Error{HTTPStatus: 429, QuotaExhausted: true}))
+	for _, id := range []string{candidate.ID, duplicate.ID} {
+		current, _ := m.GetByID(id)
+		if GatewayAccountAvailable(current) {
+			t.Fatalf("quota left duplicate %s available", id)
+		}
+		if blocked, reason, _ := isAuthBlockedForModel(current, "other-model", time.Now().Add(365*24*time.Hour)); !blocked || reason != blockReasonDisabled {
+			t.Fatal("persistent quota lock expired")
+		}
+	}
+	assertGatewayRoutable(t, m, false)
+	fresh := codexOAuthDedupeAuth(candidate.ID, accountID, "2026-08-21T00:00:00Z")
+	if _, err := m.Update(context.Background(), fresh); err != nil {
+		t.Fatal(err)
+	}
+	assertGatewayRoutable(t, m, false)
+	m.Remove(context.Background(), candidate.ID)
+	m.Remove(context.Background(), duplicate.ID)
+	if _, err := m.SetGatewayAccountEnabled(candidate.Index, true); !errors.Is(err, ErrGatewayAccountNotFound) {
+		t.Fatalf("missing account enable = %v", err)
+	}
+	replacement := codexOAuthDedupeAuth(uuid.NewString()+".json", accountID, "2026-08-22T00:00:00Z")
