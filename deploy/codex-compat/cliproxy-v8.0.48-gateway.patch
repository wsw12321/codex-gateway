+)
+
+func TestHandleEventIgnoresGatewayAccountState(t *testing.T) {
+	dir := t.TempDir()
+	w := &Watcher{authDir: dir, configPath: filepath.Join(dir, "config.yaml"), lastAuthHashes: make(map[string]string)}
+	w.SetConfig(&config.Config{AuthDir: dir})
