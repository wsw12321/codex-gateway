+func isCodexInternalHeader(name string) bool {
+	return strings.EqualFold(strings.TrimSpace(name), "X-Codex-Diagnostic-Run") || strings.EqualFold(strings.TrimSpace(name), "X-Codex-Diagnostic-Probe") || strings.EqualFold(strings.TrimSpace(name), CodexGatewayUserHeader) || strings.EqualFold(strings.TrimSpace(name), CodexGatewayAffinityHeader) ||
