new file mode 100644
index 0000000..a3084c5
--- /dev/null
+++ b/internal/runtime/executor/helps/gateway_cache.go
@@ -0,0 +1,23 @@
+package helps
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+// GatewayCacheIdentity isolates provider cache state by the authenticated user
+// and stable account; client-controlled session and tool IDs are only suffixes.
+func GatewayCacheIdentity(metadata map[string]any, provider, value string) string {
+	user, _ := metadata[cliproxyexecutor.GatewayUserIDMetadataKey].(string)
+	if user == "" || value == "" {
+		return value
+	}
+	account, _ := metadata[cliproxyexecutor.UpstreamAccountIndexMetadataKey].(string)
+	if account == "" {
+		return ""
+	}
+	caller, _ := metadata[cliproxyexecutor.CallerScopeMetadataKey].(string)
+	sum := sha256.Sum256([]byte("gateway-provider-cache-v1\x00" + caller + "\x00" + user + "\x00" + provider + "\x00" + account + "\x00" + value))
+	return "gateway-" + hex.EncodeToString(sum[:])
+}
