+func TestGatewayControlChangeDuringCredentialSave(t *testing.T) {
+	for _, operation := range []string{"register", "update", "refresh"} {
+		t.Run(operation, func(t *testing.T) {
+			m, candidate, _ := newGatewayAccountTestManager(t)
+			entered, release := make(chan struct{}), make(chan struct{})
+			var once sync.Once
+			releaseSave := func() { once.Do(func() { close(release) }) }
+			defer releaseSave()
+			m.SetStore(&callbackAuthStore{save: func(saved *Auth) error {
+				close(entered)
+				<-release
+				// A store must not own control fields even if it returns them.
+				saved.GatewayAccountVersion = 999
+				saved.GatewayAccountBlocked = false
+				return nil
+			}})
+			next := candidate.Clone()
+			next.Metadata["access_token"] = "new-token"
+			done := make(chan error, 1)
+			go func() {
+				var err error
+				switch operation {
+				case "register":
+					_, err = m.Register(context.Background(), next)
+				case "update":
+					_, err = m.Update(context.Background(), next)
+				case "refresh":
+					_, err = m.UpdateRefreshedAuth(context.Background(), candidate, next)
+				}
+				done <- err
+			}()
+			<-entered
+			if _, err := m.SetGatewayAccountEnabled(candidate.Index, false); err != nil {
+				t.Fatal(err)
+			}
+			releaseSave()
+			if err := <-done; err != nil {
+				t.Fatal(err)
+			}
+			final, _ := m.GetByID(candidate.ID)
+			if !final.GatewayAccountBlocked || final.GatewayAccountVersion != 1 || authAccessToken(final) != "new-token" {
+				t.Fatalf("save replaced administrator control or lost rotated token: %+v", final)
+			}
+			assertGatewayRoutable(t, m, false)
+		})
+	}
+}
+
+func TestGatewayRefreshFailureWaitsForReauthorizationSave(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		m, candidate, _ := newGatewayAccountTestManager(t)
+		refreshEntered, refreshRelease := make(chan struct{}), make(chan struct{})
+		exec := &unauthorizedRefreshExecutor{id: "codex", refreshErr: &Error{HTTPStatus: http.StatusUnauthorized, Message: "expired token"}, onRefresh: func() { close(refreshEntered); <-refreshRelease }}
+		m.RegisterExecutor(exec)
+		refreshDone := make(chan error, 1)
+		go func() { _, err := m.refreshAuthForRequest(context.Background(), candidate.ID, ""); refreshDone <- err }()
+		<-refreshEntered
+		saveEntered, saveRelease := make(chan struct{}), make(chan struct{})
+		m.SetStore(&callbackAuthStore{save: func(*Auth) error { close(saveEntered); <-saveRelease; return nil }})
+		next := candidate.Clone()
+		next.Metadata["access_token"] = "reauthorized-token"
+		updateDone := make(chan error, 1)
+		go func() { _, err := m.Update(context.Background(), next); updateDone <- err }()
+		<-saveEntered
+		close(refreshRelease)
+		synctest.Wait()
+		select {
+		case <-refreshDone:
+			t.Fatal("refresh error bypassed the credential save gate")
+		default:
+		}
+		close(saveRelease)
+		if err := <-updateDone; err != nil {
+			t.Fatal(err)
+		}
+		if err := <-refreshDone; err == nil {
+			t.Fatal("expected refresh error")
+		}
+		final, _ := m.GetByID(candidate.ID)
+		if final.LastError != nil || final.Unavailable || authAccessToken(final) != "reauthorized-token" {
+			t.Fatalf("late failure was merged into new authorization: %+v", final)
+		}
+	})
+}
+
+func TestGatewayLateExecutionResultsRespectAllVersions(t *testing.T) {
+	for _, change := range []string{"reauthorize", "disable_enable", "reregister"} {
+		for _, failure := range []*Error{nil, {HTTPStatus: http.StatusUnauthorized, Message: "unauthorized"}, {HTTPStatus: http.StatusTooManyRequests, QuotaExhausted: true, Message: "quota exhausted"}} {
+			t.Run(change+"/"+func() string {
+				if failure == nil {
+					return "success"
+				}
+				return failure.Message
+			}(), func(t *testing.T) {
+				m, candidate, _ := newGatewayAccountTestManager(t)
+				switch change {
+				case "reauthorize":
+					next := candidate.Clone()
+					next.Metadata["access_token"] = "reauthorized-token"
+					if _, err := m.Update(context.Background(), next); err != nil {
+						t.Fatal(err)
+					}
+				case "disable_enable":
+					for _, enabled := range []bool{false, true} {
+						if _, err := m.SetGatewayAccountEnabled(candidate.Index, enabled); err != nil {
+							t.Fatal(err)
+						}
+					}
+				case "reregister":
+					m.Remove(context.Background(), candidate.ID)
+					gatewayRegisterAccount(t, m, candidate.ID, candidate.Metadata["account_id"].(string))
+				}
+				before, _ := m.GetByID(candidate.ID)
+				m.MarkResult(context.Background(), gatewayResult(candidate, failure))
+				m.recordAvailabilityNeutralResult(context.Background(), gatewayResult(candidate, failure))
+				after, _ := m.GetByID(candidate.ID)
+				if !reflect.DeepEqual(before, after) {
+					t.Fatal("stale execution result changed replacement credential/control state")
+				}
+			})
+		}
+	}
+}
+
+func TestGatewayLateUnauthorizedDoesNotRefreshReplacement(t *testing.T) {
+	for _, change := range []string{"reauthorize", "disable_enable", "reregister"} {
+		t.Run(change, func(t *testing.T) {
+			m, candidate, _ := newGatewayAccountTestManager(t)
+			candidate.Metadata["refresh_token"] = "old-refresh-token"
+			var err error
+			candidate, err = m.Update(context.Background(), candidate)
+			if err != nil {
+				t.Fatal(err)
+			}
+			exec := &unauthorizedRefreshExecutor{id: "codex"}
+			m.RegisterExecutor(exec)
+			switch change {
+			case "reauthorize":
+				next := candidate.Clone()
+				next.Metadata["refresh_token"] = "new-refresh-token"
+				if _, err := m.Update(context.Background(), next); err != nil {
+					t.Fatal(err)
+				}
+			case "disable_enable":
+				for _, enabled := range []bool{false, true} {
+					if _, err := m.SetGatewayAccountEnabled(candidate.Index, enabled); err != nil {
+						t.Fatal(err)
+					}
+				}
+			case "reregister":
+				m.Remove(context.Background(), candidate.ID)
+				if _, err := m.Register(context.Background(), candidate.Clone()); err != nil {
+					t.Fatal(err)
+				}
+			}
+			before, _ := m.GetByID(candidate.ID)
+			_, reused := m.tryRefreshAfterUnauthorized(context.Background(), candidate, &Error{HTTPStatus: http.StatusUnauthorized}, false)
+			if exec.RefreshCalls() != 0 {
+				t.Fatal("late unauthorized triggered refresh of replacement credentials")
+			}
+			if reused != (change == "reauthorize") {
+				t.Fatalf("reused snapshot = %t for %s", reused, change)
+			}
+			after, _ := m.GetByID(candidate.ID)
+			if !reflect.DeepEqual(before, after) {
+				t.Fatal("late unauthorized rejected replacement token")
+			}
+		})
+	}
+}
