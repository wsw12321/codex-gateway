@@ -0,0 +1,58 @@
+package antigravity
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+type gatewayIdentityRoundTrip func(*http.Request) (*http.Response, error)
+
+func (f gatewayIdentityRoundTrip) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestGatewayManagementGoogleIdentityMustBeVerified(t *testing.T) {
+	for _, test := range []struct {
+		body  string
+		valid bool
+	}{{`{"id":"123456","email":"fixture@example.test","verified_email":true}`, true}, {`{"email":"fixture@example.test","verified_email":true}`, false}, {`{"id":"123456","email":"fixture@example.test","verified_email":false}`, false}, {`{"id":"123456","email":"fixture@example.test"}`, false}} {
+		service := NewAntigravityAuth(nil, &http.Client{Transport: gatewayIdentityRoundTrip(func(r *http.Request) (*http.Response, error) {
+			if r.URL.String() != UserInfoEndpoint || r.Header.Get("Authorization") != "Bearer synthetic" {
+				t.Error("wrong identity boundary")
+			}
+			return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader(test.body))}, nil
+		})})
+		_, _, err := service.FetchVerifiedIdentity(context.Background(), "synthetic")
+		if (err == nil) != test.valid {
+			t.Errorf("body=%s valid=%v err=%v", test.body, test.valid, err)
+		}
+	}
+}
+
+func TestGatewayManagementOAuthRejectsMissingOrInvalidProxy(t *testing.T) {
+	for _, raw := range []string{"", "direct", "ftp://proxy.invalid", ":invalid"} {
+		client := gatewayOAuthHTTPClient(raw)
+		req, _ := http.NewRequest("GET", UserInfoEndpoint, nil)
+		if _, err := client.Do(req); err == nil {
+			t.Errorf("proxy %q unexpectedly accepted", raw)
+		}
+	}
+}
+
+func TestGatewayManagementOAuthRejectsForeignHosts(t *testing.T) {
+	called := false
+	transport := gatewayOAuthTransport{base: gatewayIdentityRoundTrip(func(*http.Request) (*http.Response, error) {
+		called = true
+		return &http.Response{StatusCode: 200}, nil
+	})}
+	for _, target := range []string{"http://www.googleapis.com/", "https://www.googleapis.com.attacker.example/", "https://attacker@www.googleapis.com/", "https://www.googleapis.com:444/"} {
+		r, _ := http.NewRequest("GET", target, nil)
+		if _, err := transport.RoundTrip(r); err == nil {
+			t.Errorf("unsafe target %s", target)
+		}
+	}
+	if called {
+		t.Fatal("foreign request reached transport")
+	}
+}
diff --git a/internal/cache/gateway_scope.go b/internal/cache/gateway_scope.go
new file mode 100644
index 0000000..9eb54e8
--- /dev/null
+++ b/internal/cache/gateway_scope.go
@@ -0,0 +1,34 @@
+package cache
+
+import "context"
+
+// gatewayScopeKey keeps request-scoped Gateway cache identity separate from
+// ordinary cache state without changing the v8.0.48 context contract.
+//
+// The marker is intentionally private: callers can attach a scope through
+// WithGatewayScope, while cache implementations may opt into the value without
+// accepting arbitrary user-controlled context keys.
+type gatewayScopeKey struct{}
+
+// WithGatewayScope returns a child context carrying a Gateway cache scope.
+// Empty scopes preserve the original context and nil contexts are normalized to
+// context.Background so helper callers do not panic.
+func WithGatewayScope(ctx context.Context, scope string) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if scope == "" {
+		return ctx
+	}
+	return context.WithValue(ctx, gatewayScopeKey{}, scope)
+}
+
+// gatewayScope retrieves the private scope marker for cache implementations in
+// this package. An absent or malformed marker is equivalent to no scope.
+func gatewayScope(ctx context.Context) string {
+	if ctx == nil {
+		return ""
+	}
+	scope, _ := ctx.Value(gatewayScopeKey{}).(string)
+	return scope
+}
