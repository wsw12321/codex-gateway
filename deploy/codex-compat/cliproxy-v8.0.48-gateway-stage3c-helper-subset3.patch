@@ -0,0 +1,28 @@
+package helps
+
+import (
+	"errors"
+	"github.com/tidwall/gjson"
+	"strings"
+)
+
+// Every tool round must retain Google's real provenance. The default upstream
+// translator's bypass sentinel is never accepted in the Gateway deployment.
+func ValidateGatewayGeminiHistory(payload []byte) error {
+	for _, content := range gjson.GetBytes(payload, "request.contents").Array() {
+		firstCall := true
+		for _, part := range content.Get("parts").Array() {
+			signature := strings.TrimSpace(part.Get("thoughtSignature").String())
+			if signature == "skip_thought_signature_validator" {
+				return errors.New("new_session_required: Google thought signature is missing; start a new session")
+			}
+			if part.Get("functionCall").Exists() && firstCall {
+				firstCall = false
+				if signature == "" {
+					return errors.New("new_session_required: Google function signature is missing; start a new session")
+				}
+			}
+		}
+	}
+	return nil
+}
