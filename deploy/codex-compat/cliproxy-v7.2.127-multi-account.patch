+)
+
+func TestGatewayRetryEligible(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name string
+		err  error
+		want bool
+	}{
+		{name: "unauthorized", err: &Error{HTTPStatus: http.StatusUnauthorized}, want: true},
+		{name: "quota", err: &Error{HTTPStatus: http.StatusPaymentRequired}, want: true},
+		{name: "forbidden", err: &Error{HTTPStatus: http.StatusForbidden}, want: true},
+		{name: "request timeout", err: &Error{HTTPStatus: http.StatusRequestTimeout}, want: true},
+		{name: "rate limited", err: &Error{HTTPStatus: http.StatusTooManyRequests}, want: true},
+		{name: "server error", err: &Error{HTTPStatus: http.StatusBadGateway}, want: true},
+		{name: "network error", err: &url.Error{Op: "Post", URL: "https://example.invalid", Err: errors.New("connection reset")}, want: true},
+		{name: "network timeout", err: &url.Error{Op: "Post", URL: "https://example.invalid", Err: context.DeadlineExceeded}, want: true},
+		{name: "unexpected eof", err: io.ErrUnexpectedEOF, want: true},
+		{name: "request scoped timeout", err: &requestScopedStatusError{status: http.StatusRequestTimeout, message: "stream disconnected before completion"}, want: true},
+		{name: "untrusted invalid grant text", err: &Error{HTTPStatus: http.StatusBadRequest, Message: "invalid_grant"}, want: false},
+		{name: "unauthorized invalid grant", err: &Error{HTTPStatus: http.StatusUnauthorized, Message: "invalid_grant"}, want: true},
+		{name: "statusless typed retryable", err: &Error{Retryable: true}, want: false},
+		{name: "redirect", err: &Error{HTTPStatus: http.StatusTemporaryRedirect}, want: false},
+		{name: "bad request", err: &Error{HTTPStatus: http.StatusBadRequest}, want: false},
+		{name: "not found", err: &Error{HTTPStatus: http.StatusNotFound}, want: false},
+		{name: "conflict", err: &Error{HTTPStatus: http.StatusConflict}, want: false},
+		{name: "client canceled", err: context.Canceled, want: false},
+		{name: "client deadline", err: context.DeadlineExceeded, want: false},
+		{name: "unclassified", err: errors.New("unknown failure"), want: false},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if got := gatewayRetryEligible(test.err, context.Background()); got != test.want {
+				t.Fatalf("gatewayRetryEligible(%v) = %t, want %t", test.err, got, test.want)
+			}
+		})
+	}
+}
+
+type gatewayPolicyExecutor struct {
+	id            string
+	err           error
+	tailErr       error
+	empty         bool
+	missingSource bool
+
+	mu    sync.Mutex
+	calls []string
+}
+
+func (e *gatewayPolicyExecutor) Identifier() string { return e.id }
+
+func (e *gatewayPolicyExecutor) Execute(_ context.Context, candidate *Auth, _ cliproxyexecutor.Request, _ cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	e.record(candidate.ID)
+	if e.err != nil {
+		return cliproxyexecutor.Response{}, e.err
+	}
+	return cliproxyexecutor.Response{Payload: []byte("ok")}, nil
+}
+
+func (e *gatewayPolicyExecutor) ExecuteStream(_ context.Context, candidate *Auth, _ cliproxyexecutor.Request, _ cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error) {
+	e.record(candidate.ID)
+	if e.missingSource {
+		return &cliproxyexecutor.StreamResult{}, nil
+	}
+	chunks := make(chan cliproxyexecutor.StreamChunk, 2)
+	if e.empty {
+		close(chunks)
+		return &cliproxyexecutor.StreamResult{Chunks: chunks}, nil
+	}
+	if e.err != nil {
+		chunks <- cliproxyexecutor.StreamChunk{Err: e.err}
+		close(chunks)
+		return &cliproxyexecutor.StreamResult{Chunks: chunks}, nil
+	}
+	chunks <- cliproxyexecutor.StreamChunk{Payload: []byte("first")}
+	if e.tailErr != nil {
+		chunks <- cliproxyexecutor.StreamChunk{Err: e.tailErr}
+	}
+	close(chunks)
+	return &cliproxyexecutor.StreamResult{Chunks: chunks}, nil
+}
+
+func TestGatewayRetryPolicyEmptyBootstrapTouchesAtMostTwoAccounts(t *testing.T) {
+	for _, test := range []struct {
+		name          string
+		empty         bool
+		missingSource bool
+	}{
+		{name: "closed before payload", empty: true},
+		{name: "missing stream source", missingSource: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			executor := &gatewayPolicyExecutor{id: "codex", empty: test.empty, missingSource: test.missingSource}
+			manager := newGatewayPolicyManager(t, executor, 3)
+			result, _ := manager.ExecuteStream(context.Background(), []string{executor.id}, cliproxyexecutor.Request{Model: "gateway-model"}, cliproxyexecutor.Options{Stream: true})
+			if result != nil {
+				for range result.Chunks {
+				}
+			}
+			calls := executor.Calls()
+			if len(calls) != 2 || calls[0] == calls[1] {
+				t.Fatalf("upstream calls = %v, want two distinct accounts", calls)
+			}
+			for _, id := range calls {
+				candidate, ok := manager.GetByID(id)
+				if !ok || candidate == nil {
+					t.Fatalf("attempted account %q is missing", id)
+				}
+				if candidate.Unavailable || candidate.Status == StatusError {
+					t.Fatalf("empty bootstrap poisoned account %q: %#v", id, candidate)
+				}
+				if state := candidate.ModelStates["gateway-model"]; state != nil && state.Unavailable {
+					t.Fatalf("empty bootstrap poisoned model on %q: %#v", id, state)
+				}
+			}
+		})
+	}
+}
+
+func (*gatewayPolicyExecutor) Refresh(_ context.Context, candidate *Auth) (*Auth, error) {
+	return candidate, nil
+}
+
+func (e *gatewayPolicyExecutor) CountTokens(ctx context.Context, candidate *Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	return e.Execute(ctx, candidate, req, opts)
+}
+
+func (*gatewayPolicyExecutor) HttpRequest(context.Context, *Auth, *http.Request) (*http.Response, error) {
+	return nil, nil
+}
+
+func (e *gatewayPolicyExecutor) record(id string) {
+	e.mu.Lock()
+	e.calls = append(e.calls, id)
+	e.mu.Unlock()
+}
+
+func (e *gatewayPolicyExecutor) Calls() []string {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	return append([]string(nil), e.calls...)
+}
+
+func newGatewayPolicyManager(t *testing.T, executor *gatewayPolicyExecutor, accountCount int) *Manager {
+	t.Helper()
+	manager := NewManager(nil, nil, nil)
+	manager.SetRetryConfig(0, 0, 2)
+	manager.RegisterExecutor(executor)
+	prefix := uuid.NewString()
+	for i := 0; i < accountCount; i++ {
+		candidate := &Auth{ID: prefix + "-" + string(rune('a'+i)), Provider: executor.id, Status: StatusActive}
+		registry.GetGlobalRegistry().RegisterClient(candidate.ID, candidate.Provider, []*registry.ModelInfo{{ID: "gateway-model"}})
+		t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(candidate.ID) })
+		if _, err := manager.Register(context.Background(), candidate); err != nil {
+			t.Fatalf("Register(%s): %v", candidate.ID, err)
+		}
+	}
+	return manager
+}
+
+func TestGatewayRetryPolicyDoesNotReplayClientFailures(t *testing.T) {
+	for _, stream := range []bool{false, true} {
+		mode := "ordinary"
+		if stream {
+			mode = "stream bootstrap"
+		}
+		for _, test := range []struct {
+			name string
+			err  error
+		}{
+			{name: "bad request", err: &Error{HTTPStatus: http.StatusBadRequest, Message: "bad request"}},
+			{name: "conflict", err: &Error{HTTPStatus: http.StatusConflict, Message: "conflict"}},
+			{name: "upgrade required", err: &Error{HTTPStatus: http.StatusUpgradeRequired, Message: "websocket upgrade required"}},
+			{name: "client cancellation", err: context.Canceled},
+		} {
+			t.Run(mode+"/"+test.name, func(t *testing.T) {
+				executor := &gatewayPolicyExecutor{id: "codex", err: test.err}
+				manager := newGatewayPolicyManager(t, executor, 2)
+				request := cliproxyexecutor.Request{Model: "gateway-model"}
+				if stream {
+					_, _ = manager.ExecuteStream(context.Background(), []string{executor.id}, request, cliproxyexecutor.Options{Stream: true})
+				} else {
