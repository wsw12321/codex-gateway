+		},
+	}
+	SetCodexOAuthAccountIndexSeed(apiKey, "account-id")
+	if got := apiKey.Attributes[AttributeAuthIndexSeed]; got != codexAccountIndexSeedPrefix+"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" {
+		t.Fatalf("SetCodexOAuthAccountIndexSeed changed API-key seed: %q", got)
+	}
+	if key, ok := CodexOAuthDeduplicationKey(apiKey); ok || key != "" {
