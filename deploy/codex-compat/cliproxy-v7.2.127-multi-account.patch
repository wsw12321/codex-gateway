+	}
+	second, err := SynthesizeAuthFile(ctx, filepath.Join(ctx.AuthDir, "renamed", "codex-alice-pro.json"), raw)
+	if err != nil || len(second) != 1 {
+		t.Fatalf("second SynthesizeAuthFile() = %#v, %v", second, err)
