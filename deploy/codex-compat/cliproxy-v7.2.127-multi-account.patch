+package api
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"math"
+	"net/http"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/access"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+)
+
+const (
+	codexUsageURL          = "https://chatgpt.com/backend-api/wham/usage"
+	codexFiveHourSeconds   = 5 * 60 * 60
+	codexSevenDaySeconds   = 7 * 24 * 60 * 60
+	codexQuotaTimeout      = 15 * time.Second
+	codexQuotaMaxBodyBytes = 1 << 20
+	codexMaxExtraWindows   = 32
+	codexMaxWindowSeconds  = 31 * 24 * 60 * 60
+	codexMinResetUnix      = 946684800  // 2000-01-01T00:00:00Z
+	codexMaxResetUnix      = 4102444800 // 2100-01-01T00:00:00Z
+)
+
+type upstreamAccountView struct {
+	ID           string `json:"id"`
+	MaskedEmail  string `json:"masked_email"`
+	Plan         string `json:"plan"`
+	Status       string `json:"status"`
+	LastSyncedAt string `json:"last_synced_at"`
+}
+
+type quotaWindowView struct {
+	UsedRatio      float64 `json:"used_ratio"`
+	RemainingRatio float64 `json:"remaining_ratio"`
+	ResetAt        string  `json:"reset_at"`
+}
+
+type additionalQuotaWindowView struct {
+	Name           string  `json:"name"`
+	UsedRatio      float64 `json:"used_ratio"`
+	RemainingRatio float64 `json:"remaining_ratio"`
+	ResetAt        string  `json:"reset_at"`
+	WindowSeconds  int64   `json:"window_seconds"`
+}
+
+type upstreamQuotaView struct {
+	QueriedAt         string                      `json:"queried_at"`
+	Plan              string                      `json:"plan"`
+	FiveHour          quotaWindowView             `json:"five_hour"`
+	SevenDay          quotaWindowView             `json:"seven_day"`
+	AdditionalWindows []additionalQuotaWindowView `json:"additional_windows"`
+}
+
+type upstreamUsagePayload struct {
+	PlanType             string                    `json:"plan_type"`
+	RateLimit            upstreamRateLimit         `json:"rate_limit"`
+	AdditionalRateLimits []upstreamAdditionalLimit `json:"additional_rate_limits"`
+}
+
+type upstreamAdditionalLimit struct {
+	LimitName      string            `json:"limit_name"`
+	MeteredFeature string            `json:"metered_feature"`
+	RateLimit      upstreamRateLimit `json:"rate_limit"`
+}
+
+type upstreamRateLimit struct {
+	PrimaryWindow   *upstreamUsageWindow `json:"primary_window"`
+	SecondaryWindow *upstreamUsageWindow `json:"secondary_window"`
+}
+
+type upstreamUsageWindow struct {
+	UsedPercent        *float64 `json:"used_percent"`
+	LimitWindowSeconds *int64   `json:"limit_window_seconds"`
+	ResetAt            *int64   `json:"reset_at"`
+}
+
+func internalAccountAuthMiddleware(manager *access.Manager) gin.HandlerFunc {
+	return func(c *gin.Context) {
+		if manager == nil || len(manager.Providers()) == 0 {
+			c.AbortWithStatusJSON(http.StatusServiceUnavailable, gin.H{"error": "internal_auth_unavailable"})
+			return
+		}
+		values := c.Request.Header.Values("Authorization")
+		if len(values) != 1 {
+			c.AbortWithStatusJSON(http.StatusUnauthorized, gin.H{"error": "unauthorized"})
+			return
+		}
+		parts := strings.Fields(values[0])
+		if len(parts) != 2 || !strings.EqualFold(parts[0], "Bearer") || strings.TrimSpace(parts[1]) == "" {
+			c.AbortWithStatusJSON(http.StatusUnauthorized, gin.H{"error": "unauthorized"})
+			return
+		}
+		result, authErr := manager.Authenticate(c.Request.Context(), c.Request)
+		if authErr != nil {
+			status := http.StatusUnauthorized
+			if authErr.HTTPStatusCode() >= http.StatusInternalServerError {
+				status = http.StatusServiceUnavailable
+			}
+			c.AbortWithStatusJSON(status, gin.H{"error": "unauthorized"})
+			return
+		}
+		if result == nil || result.Principal != parts[1] || result.Metadata["source"] != "authorization" {
+			c.AbortWithStatusJSON(http.StatusUnauthorized, gin.H{"error": "unauthorized"})
+			return
+		}
+		c.Set("userApiKey", result.Principal)
+		c.Set("accessProvider", result.Provider)
+		if len(result.Metadata) > 0 {
+			c.Set("accessMetadata", result.Metadata)
+		}
+		c.Next()
+	}
+}
+
+func (s *Server) listUpstreamAccounts(c *gin.Context) {
+	c.Header("Cache-Control", "no-store")
+	if s == nil || s.handlers == nil || s.handlers.AuthManager == nil {
+		c.JSON(http.StatusServiceUnavailable, gin.H{"error": "account_registry_unavailable"})
+		return
+	}
+
+	observedAt := time.Now().UTC()
+	accountsByID := make(map[string]upstreamAccountView)
+	accountTimes := make(map[string]time.Time)
+	for _, candidate := range s.handlers.AuthManager.List() {
+		if !isCodexOAuthAccount(candidate) {
+			continue
+		}
+		id := stableCodexAccountID(candidate)
+		if id == "" {
+			continue
+		}
+		syncedAt := observedAuthSyncTime(candidate, observedAt)
+		if previous, ok := accountTimes[id]; ok && !syncedAt.After(previous) {
+			continue
+		}
+		accountTimes[id] = syncedAt
+		accountsByID[id] = upstreamAccountView{
+			ID:           id,
+			MaskedEmail:  maskUpstreamEmail(authEmail(candidate)),
+			Plan:         accountPlanView(candidate.Attributes["plan_type"]),
+			Status:       upstreamAccountStatus(candidate),
+			LastSyncedAt: formatOptionalTime(syncedAt),
+		}
+	}
+	accounts := make([]upstreamAccountView, 0, len(accountsByID))
+	for _, account := range accountsByID {
+		accounts = append(accounts, account)
+	}
+	sort.Slice(accounts, func(i, j int) bool { return accounts[i].ID < accounts[j].ID })
+	c.JSON(http.StatusOK, gin.H{"accounts": accounts})
+}
+
+func (s *Server) getUpstreamAccountQuota(c *gin.Context) {
+	c.Header("Cache-Control", "no-store")
+	if s == nil || s.handlers == nil || s.handlers.AuthManager == nil {
+		c.JSON(http.StatusServiceUnavailable, gin.H{"error": "account_registry_unavailable"})
+		return
+	}
+	account := findCodexOAuthAccount(s.handlers.AuthManager.List(), strings.TrimSpace(c.Param("id")))
+	if account == nil {
+		c.JSON(http.StatusNotFound, gin.H{"error": "upstream_account_not_found"})
+		return
+	}
+	if account.Disabled || account.Status == auth.StatusDisabled {
+		c.JSON(http.StatusConflict, gin.H{"error": "upstream_account_disabled"})
+		return
+	}
+
+	ctx, cancel := context.WithTimeout(c.Request.Context(), codexQuotaTimeout)
+	defer cancel()
+	headers := make(http.Header)
+	headers.Set("Accept", "application/json")
+	accountID, ok := account.Metadata["account_id"].(string)
+	accountID = strings.TrimSpace(accountID)
+	if !ok || !safeOpaqueAccountID(accountID) {
+		c.JSON(http.StatusBadGateway, gin.H{"error": "quota_account_identity_unavailable"})
+		return
+	}
+	headers.Set("Chatgpt-Account-Id", accountID)
+	quotaAuth := account.Clone()
+	stripQuotaCustomHeaders(quotaAuth)
+	quotaAuth.ProxyURL = ""
+	accessToken, _ := quotaAuth.Metadata["access_token"].(string)
+	accessToken = strings.TrimSpace(accessToken)
+	if !safeBearerToken(accessToken) {
+		c.JSON(http.StatusBadGateway, gin.H{"error": "quota_credential_unavailable"})
+		return
+	}
+	req, err := s.handlers.AuthManager.NewHttpRequest(ctx, quotaAuth, http.MethodGet, codexUsageURL, nil, headers)
+	if err != nil {
+		c.JSON(http.StatusBadGateway, gin.H{"error": "quota_request_failed"})
+		return
+	}
+	// Reset the complete outbound header set after provider preparation. The
+	// executor prepares once more before sending, but quotaAuth has no custom
+	// header attributes, so these protected values cannot be overridden by an
+	// OAuth file or inbound caller.
+	req.Header = make(http.Header)
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set("Authorization", "Bearer "+accessToken)
+	req.Header.Set("Chatgpt-Account-Id", accountID)
+	req.Host = req.URL.Host
+	resp, err := s.handlers.AuthManager.HttpRequest(ctx, quotaAuth, req)
+	if err != nil {
+		if errors.Is(ctx.Err(), context.DeadlineExceeded) || errors.Is(err, context.DeadlineExceeded) {
+			c.JSON(http.StatusGatewayTimeout, gin.H{"error": "quota_upstream_timeout"})
+			return
+		}
+		c.JSON(http.StatusBadGateway, gin.H{"error": "quota_upstream_unavailable"})
+		return
+	}
+	defer func() { _ = resp.Body.Close() }()
+	if resp.StatusCode < http.StatusOK || resp.StatusCode >= http.StatusMultipleChoices {
+		_, _ = io.Copy(io.Discard, io.LimitReader(resp.Body, 64<<10))
+		switch resp.StatusCode {
+		case http.StatusUnauthorized:
+			c.JSON(http.StatusUnauthorized, gin.H{"error": "quota_reauthentication_required"})
+		case http.StatusForbidden:
+			c.JSON(http.StatusForbidden, gin.H{"error": "quota_reauthentication_required"})
+		case http.StatusTooManyRequests:
+			c.JSON(http.StatusTooManyRequests, gin.H{"error": "quota_upstream_rate_limited"})
+		case http.StatusRequestTimeout, http.StatusGatewayTimeout:
+			c.JSON(http.StatusGatewayTimeout, gin.H{"error": "quota_upstream_timeout"})
+		default:
+			c.JSON(http.StatusBadGateway, gin.H{"error": "quota_upstream_error"})
+		}
+		return
+	}
+
+	body, err := io.ReadAll(io.LimitReader(resp.Body, codexQuotaMaxBodyBytes+1))
+	if err != nil || len(body) > codexQuotaMaxBodyBytes {
+		c.JSON(http.StatusBadGateway, gin.H{"error": "quota_response_invalid"})
+		return
+	}
+	quota, err := normalizeUpstreamUsage(body, account, time.Now().UTC())
+	if err != nil {
+		c.JSON(http.StatusBadGateway, gin.H{"error": "quota_schema_changed"})
+		return
+	}
+	c.JSON(http.StatusOK, quota)
+}
+
+func findCodexOAuthAccount(accounts []*auth.Auth, id string) *auth.Auth {
+	if id == "" {
+		return nil
+	}
+	var selected *auth.Auth
+	for _, candidate := range accounts {
+		if !isCodexOAuthAccount(candidate) {
+			continue
+		}
+		if stableCodexAccountID(candidate) == id && (selected == nil || latestAuthSyncTime(candidate).After(latestAuthSyncTime(selected))) {
+			selected = candidate
+		}
+	}
+	return selected
+}
+
+func stableCodexAccountID(candidate *auth.Auth) string {
+	id, _ := auth.CodexOAuthAccountIndex(candidate)
+	return id
+}
+
+func safeOpaqueAccountID(value string) bool {
+	return auth.ValidCodexOAuthAccountID(value)
+}
+
+func safeBearerToken(value string) bool {
+	if value == "" || len(value) > 16<<10 {
+		return false
+	}
+	for i := 0; i < len(value); i++ {
+		if value[i] <= 0x20 || value[i] >= 0x7f {
+			return false
+		}
+	}
+	return true
+}
+
+func stripQuotaCustomHeaders(candidate *auth.Auth) {
+	if candidate == nil || len(candidate.Attributes) == 0 {
+		return
+	}
+	for key := range candidate.Attributes {
+		normalized := strings.ToLower(strings.TrimSpace(key))
+		if strings.HasPrefix(normalized, "header:") || normalized == "api_key" || normalized == "base_url" ||
+			normalized == "compat_name" || normalized == "provider_key" {
+			delete(candidate.Attributes, key)
+		}
+	}
+}
+
+func isCodexOAuthAccount(candidate *auth.Auth) bool {
+	return candidate != nil && strings.EqualFold(strings.TrimSpace(candidate.Provider), "codex") && candidate.AuthKind() == auth.AuthKindOAuth
+}
+
+func authEmail(candidate *auth.Auth) string {
+	if candidate == nil {
+		return ""
+	}
+	if value := strings.TrimSpace(candidate.Attributes["email"]); value != "" {
+		return value
+	}
+	value, _ := candidate.Metadata["email"].(string)
+	return strings.TrimSpace(value)
+}
+
+func maskUpstreamEmail(email string) string {
+	const unknownMaskedEmail = "u***@unknown.invalid"
+
+	email = strings.TrimSpace(email)
+	if strings.Count(email, "@") != 1 {
+		return unknownMaskedEmail
+	}
+	local, domain, _ := strings.Cut(email, "@")
+	if local == "" || !asciiEmailLead(local[0]) || !safeASCIIDomain(domain) {
+		return unknownMaskedEmail
+	}
+	return string(local[0]) + "***@" + domain
+}
+
+func asciiEmailLead(value byte) bool {
+	return value >= 'a' && value <= 'z' || value >= 'A' && value <= 'Z' || value >= '0' && value <= '9'
+}
+
+func safeASCIIDomain(domain string) bool {
+	// The final mask is five bytes plus the unchanged domain. Keep it within
+	// the gateway/DB 7..254 byte contract.
+	if len(domain) < 2 || len(domain) > 249 || strings.HasPrefix(domain, ".") || strings.HasSuffix(domain, ".") || strings.Contains(domain, "..") {
+		return false
+	}
+	for _, label := range strings.Split(domain, ".") {
+		if label == "" || strings.HasPrefix(label, "-") || strings.HasSuffix(label, "-") {
+			return false
+		}
+		for i := 0; i < len(label); i++ {
+			value := label[i]
+			if !asciiEmailLead(value) && value != '-' {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func upstreamAccountStatus(candidate *auth.Auth) string {
+	if candidate == nil {
+		return "error"
+	}
+	if candidate.Disabled || candidate.Status == auth.StatusDisabled {
+		return "disabled"
+	}
+	if candidate.Unavailable || candidate.Quota.Exceeded || candidate.Status == auth.StatusPending || candidate.Status == auth.StatusRefreshing {
+		return "unavailable"
+	}
+	if candidate.Status == auth.StatusError || candidate.Status == auth.StatusUnknown || candidate.Status == "" {
+		return "error"
+	}
+	if candidate.Status == auth.StatusActive {
+		return "active"
+	}
+	return "error"
+}
+
+func latestAuthSyncTime(candidate *auth.Auth) time.Time {
+	if candidate == nil {
+		return time.Time{}
+	}
+	latest := candidate.CreatedAt
+	for _, value := range []time.Time{candidate.UpdatedAt, candidate.LastRefreshedAt} {
+		if value.After(latest) {
+			latest = value
+		}
+	}
+	return latest
+}
+
+func observedAuthSyncTime(candidate *auth.Auth, observedAt time.Time) time.Time {
+	if syncedAt := latestAuthSyncTime(candidate); !syncedAt.IsZero() {
+		return syncedAt
+	}
+	if observedAt.IsZero() {
+		observedAt = time.Now().UTC()
+	}
+	return observedAt.UTC()
+}
+
+func formatOptionalTime(value time.Time) string {
+	if value.IsZero() {
+		return ""
+	}
+	return value.UTC().Format(time.RFC3339)
+}
+
+func normalizeUpstreamUsage(body []byte, account *auth.Auth, queriedAt time.Time) (upstreamQuotaView, error) {
+	var payload upstreamUsagePayload
+	decoder := json.NewDecoder(bytes.NewReader(body))
+	if err := decoder.Decode(&payload); err != nil {
+		return upstreamQuotaView{}, err
+	}
+	if err := ensureJSONEOF(decoder); err != nil {
+		return upstreamQuotaView{}, err
+	}
+
+	plan := strings.ToLower(strings.TrimSpace(payload.PlanType))
+	if plan == "" && account != nil {
+		plan = strings.ToLower(strings.TrimSpace(account.Attributes["plan_type"]))
+	}
+	if !validCodexAccountPlan(plan) {
+		return upstreamQuotaView{}, errors.New("missing plan type")
+	}
+
+	var fiveHour, sevenDay *upstreamUsageWindow
+	for _, window := range []*upstreamUsageWindow{payload.RateLimit.PrimaryWindow, payload.RateLimit.SecondaryWindow} {
+		if window == nil {
+			continue
+		}
+		if window.LimitWindowSeconds == nil {
+			return upstreamQuotaView{}, errors.New("missing quota window duration")
+		}
+		switch *window.LimitWindowSeconds {
+		case codexFiveHourSeconds:
+			if fiveHour != nil {
+				return upstreamQuotaView{}, errors.New("duplicate five hour window")
+			}
+			fiveHour = window
+		case codexSevenDaySeconds:
+			if sevenDay != nil {
+				return upstreamQuotaView{}, errors.New("duplicate seven day window")
+			}
+			sevenDay = window
+		default:
+			return upstreamQuotaView{}, errors.New("unexpected primary quota window")
+		}
+	}
+	if fiveHour == nil || sevenDay == nil {
+		return upstreamQuotaView{}, errors.New("missing fixed quota window")
+	}
+
+	view := upstreamQuotaView{
+		QueriedAt:         queriedAt.UTC().Format(time.RFC3339),
+		Plan:              plan,
+		AdditionalWindows: make([]additionalQuotaWindowView, 0),
+	}
+	var err error
+	if view.FiveHour, err = normalizeQuotaWindow(fiveHour); err != nil {
+		return upstreamQuotaView{}, err
+	}
+	if view.SevenDay, err = normalizeQuotaWindow(sevenDay); err != nil {
+		return upstreamQuotaView{}, err
+	}
+
+	for _, additional := range payload.AdditionalRateLimits {
+		name, ok := normalizeQuotaWindowName(additional.LimitName, additional.MeteredFeature)
+		if !ok {
+			return upstreamQuotaView{}, errors.New("additional quota window missing name")
+		}
+		windowCount := 0
+		for _, window := range []*upstreamUsageWindow{additional.RateLimit.PrimaryWindow, additional.RateLimit.SecondaryWindow} {
+			if window == nil {
+				continue
+			}
+			normalized, errWindow := normalizeQuotaWindow(window)
+			if errWindow != nil || window.LimitWindowSeconds == nil || *window.LimitWindowSeconds <= 0 || *window.LimitWindowSeconds > codexMaxWindowSeconds || len(view.AdditionalWindows) >= codexMaxExtraWindows {
+				return upstreamQuotaView{}, errors.New("invalid additional quota window")
+			}
+			view.AdditionalWindows = append(view.AdditionalWindows, additionalQuotaWindowView{
+				Name:           name,
+				UsedRatio:      normalized.UsedRatio,
+				RemainingRatio: normalized.RemainingRatio,
+				ResetAt:        normalized.ResetAt,
+				WindowSeconds:  *window.LimitWindowSeconds,
+			})
+			windowCount++
+		}
+		if windowCount == 0 {
+			return upstreamQuotaView{}, errors.New("additional quota limit missing window")
+		}
+	}
+	sort.Slice(view.AdditionalWindows, func(i, j int) bool {
+		if view.AdditionalWindows[i].Name == view.AdditionalWindows[j].Name {
+			return view.AdditionalWindows[i].WindowSeconds < view.AdditionalWindows[j].WindowSeconds
+		}
+		return view.AdditionalWindows[i].Name < view.AdditionalWindows[j].Name
+	})
+	return view, nil
+}
+
+func normalizeQuotaWindow(window *upstreamUsageWindow) (quotaWindowView, error) {
+	if window == nil || window.UsedPercent == nil || window.LimitWindowSeconds == nil || window.ResetAt == nil ||
+		*window.LimitWindowSeconds <= 0 || *window.ResetAt <= 0 ||
+		*window.ResetAt < codexMinResetUnix || *window.ResetAt > codexMaxResetUnix ||
+		math.IsNaN(*window.UsedPercent) || math.IsInf(*window.UsedPercent, 0) ||
+		*window.UsedPercent < 0 || *window.UsedPercent > 100 {
+		return quotaWindowView{}, errors.New("invalid quota window")
+	}
+	used := math.Round((*window.UsedPercent/100)*1e6) / 1e6
+	remaining := math.Round((1-used)*1e6) / 1e6
+	return quotaWindowView{
+		UsedRatio:      used,
+		RemainingRatio: remaining,
+		ResetAt:        time.Unix(*window.ResetAt, 0).UTC().Format(time.RFC3339),
+	}, nil
+}
+
+func validCodexAccountPlan(plan string) bool {
+	switch strings.ToLower(strings.TrimSpace(plan)) {
+	case "plus", "pro":
+		return true
+	default:
+		return false
+	}
+}
+
+func accountPlanView(plan string) string {
+	plan = strings.ToLower(strings.TrimSpace(plan))
+	if validCodexAccountPlan(plan) {
+		return plan
+	}
+	return "unknown"
+}
+
+func normalizeQuotaWindowName(limitName, meteredFeature string) (string, bool) {
+	// The quota endpoint is intentionally strict: schema drift must not reflect
+	// an arbitrary upstream string through this narrow normalized interface.
+	for _, candidate := range []string{limitName, meteredFeature} {
+		switch strings.ToLower(strings.TrimSpace(candidate)) {
+		case "codex_other":
+			return "codex_other", true
+		}
+	}
+	return "", false
+}
+
+func ensureJSONEOF(decoder *json.Decoder) error {
+	var extra any
+	if err := decoder.Decode(&extra); !errors.Is(err, io.EOF) {
+		if err == nil {
+			return errors.New("multiple JSON values")
+		}
+		return err
+	}
+	return nil
+}
