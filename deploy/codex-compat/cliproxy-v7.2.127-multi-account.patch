 func extractSessionIDs(headers http.Header, payload []byte, metadata map[string]any) (string, string) {
+	primary, fallback := extractUnscopedSessionIDs(headers, payload, metadata)
+	callerScope, _ := metadata[cliproxyexecutor.CallerScopeMetadataKey].(string)
+	callerScope = strings.TrimSpace(callerScope)
+	if callerScope == "" {
+		return primary, fallback
+	}
+	prefix := "caller:" + callerScope + ":"
+	if primary != "" {
+		primary = prefix + primary
+	}
