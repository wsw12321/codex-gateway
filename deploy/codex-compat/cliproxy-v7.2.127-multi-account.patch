+func TestCodexInternalAndOAuthHeadersAreProtectedOnAllTransports(t *testing.T) {
+	const (
+		canaryClient = "codex-protected-header-canary-client"
+		canaryModel  = "gpt-codex-protected-header-canary-model"
+	)
+	registry.GetGlobalRegistry().RegisterClient(canaryClient, "codex", []*registry.ModelInfo{{
+		ID: canaryModel,
+		Config: &registry.ModelConfig{OverrideHeader: map[string]string{
+			"Authorization":            "Bearer model-override-token",
+			"Chatgpt-Account-Id":       "model-override-account",
+			"X-Codex-Gateway-Affinity": "model-override-internal",
+			"X-Codex-Upstream-Account": "model-override-internal",
+		}},
+	}})
+	t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(canaryClient) })
+	if got := registry.ModelOverrideHeaders(canaryModel)["Authorization"]; got == "" {
+		t.Fatal("protected-header canary model did not register its override headers")
+	}
+	auth := &cliproxyauth.Auth{
+		Provider: "codex",
+		Metadata: map[string]any{
+			"access_token": "canonical-token",
+			"account_id":   "canonical-account",
+		},
+		Attributes: map[string]string{
+			cliproxyauth.AttributeAuthKind:    "oauth",
+			"header:Authorization":            "Bearer attacker-token",
+			"header:Chatgpt-Account-Id":       "attacker-account",
+			"header:X-Codex-Gateway-Affinity": "must-not-leak",
+			"header:X-Codex-Upstream-Account": "must-not-leak",
+		},
+	}
+	cliproxyauth.SetCodexOAuthAccountIndexSeed(auth, "canonical-account")
+
+	assertProtected := func(t *testing.T, headers http.Header) {
+		t.Helper()
+		if got := headers.Get("Authorization"); got != "Bearer canonical-token" {
+			t.Fatalf("Authorization = %q, want canonical token", got)
+		}
+		if got := headers.Get("Chatgpt-Account-Id"); got != "canonical-account" {
+			t.Fatalf("Chatgpt-Account-Id = %q, want canonical account", got)
+		}
+		for _, name := range []string{"X-Codex-Gateway-Affinity", "X-Codex-Upstream-Account"} {
+			if got := headers.Get(name); got != "" {
+				t.Fatalf("%s leaked upstream as %q", name, got)
+			}
+		}
+	}
+
+	request := cliproxyexecutor.Request{
+		Model:   canaryModel,
+		Payload: []byte(`{"model":"` + canaryModel + `","input":"header canary"}`),
+	}
+	responseOptions := cliproxyexecutor.Options{
+		SourceFormat:   sdktranslator.FromString("openai-response"),
+		ResponseFormat: sdktranslator.FromString("openai-response"),
+	}
+	for _, path := range []struct {
+		name     string
+		wantPath string
+		run      func(context.Context, *cliproxyauth.Auth) error
+	}{
+		{
+			name:     "responses execute",
+			wantPath: "/backend-api/codex/responses",
+			run: func(ctx context.Context, candidate *cliproxyauth.Auth) error {
+				_, err := NewCodexExecutor(&config.Config{SDKConfig: config.SDKConfig{DisableImageGeneration: config.DisableImageGenerationAll}}).Execute(ctx, candidate, request, responseOptions)
+				return err
+			},
+		},
+		{
+			name:     "compact execute",
+			wantPath: "/backend-api/codex/responses/compact",
+			run: func(ctx context.Context, candidate *cliproxyauth.Auth) error {
+				opts := responseOptions
+				opts.Alt = "responses/compact"
+				_, err := NewCodexExecutor(&config.Config{}).Execute(ctx, candidate, request, opts)
+				return err
+			},
+		},
+		{
+			name:     "responses stream",
+			wantPath: "/backend-api/codex/responses",
+			run: func(ctx context.Context, candidate *cliproxyauth.Auth) error {
+				opts := responseOptions
+				opts.Stream = true
+				_, err := NewCodexExecutor(&config.Config{SDKConfig: config.SDKConfig{DisableImageGeneration: config.DisableImageGenerationAll}}).ExecuteStream(ctx, candidate, request, opts)
+				return err
+			},
+		},
+		{
+			name:     "image responses execute",
+			wantPath: "/backend-api/codex/responses",
+			run: func(ctx context.Context, candidate *cliproxyauth.Auth) error {
+				opts := codexOpenAIImageTestOptions(codexImagesGenerationsPath, false)
+				_, err := NewCodexExecutor(&config.Config{SDKConfig: config.SDKConfig{GPTImage2BaseModel: canaryModel}}).Execute(ctx, candidate, cliproxyexecutor.Request{
+					Model:   canaryModel,
+					Payload: []byte(`{"model":"` + canaryModel + `","prompt":"header canary"}`),
+				}, opts)
+				return err
+			},
+		},
+	} {
+		t.Run(path.name, func(t *testing.T) {
+			calls := 0
+			transport := codexRedirectRoundTripper(func(req *http.Request) (*http.Response, error) {
+				calls++
+				if req.URL.Path != path.wantPath {
+					t.Fatalf("outbound path = %q, want %q", req.URL.Path, path.wantPath)
+				}
+				assertProtected(t, req.Header)
+				return &http.Response{
+					StatusCode: http.StatusTeapot,
+					Header:     http.Header{"Content-Type": {"application/json"}},
+					Body:       io.NopCloser(strings.NewReader(`{"error":{"message":"captured"}}`)),
+					Request:    req,
+				}, nil
+			})
+			ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", http.RoundTripper(transport))
+			candidate := auth.Clone()
+			candidate.Attributes["base_url"] = "https://chatgpt.com/backend-api/codex"
+			if err := path.run(ctx, candidate); err == nil {
+				t.Fatal("executor returned nil error for capture response")
+			}
+			if calls != 1 {
+				t.Fatalf("outbound calls = %d, want 1", calls)
+			}
+		})
+	}
+
+	for _, path := range []struct {
+		name string
+		run  func(context.Context, *CodexWebsocketsExecutor, *cliproxyauth.Auth) error
+	}{
+		{
+			name: "websocket execute",
+			run: func(ctx context.Context, executor *CodexWebsocketsExecutor, candidate *cliproxyauth.Auth) error {
+				_, err := executor.Execute(ctx, candidate, request, responseOptions)
+				return err
+			},
+		},
+		{
+			name: "websocket stream",
+			run: func(ctx context.Context, executor *CodexWebsocketsExecutor, candidate *cliproxyauth.Auth) error {
+				_, err := executor.ExecuteStream(ctx, candidate, request, responseOptions)
+				return err
+			},
+		},
+	} {
+		t.Run(path.name, func(t *testing.T) {
+			captured := make(chan http.Header, 1)
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+				captured <- req.Header.Clone()
+				w.Header().Set("Content-Type", "application/json")
+				w.WriteHeader(http.StatusUnauthorized)
+				_, _ = w.Write([]byte(`{"error":{"message":"captured"}}`))
+			}))
+			defer server.Close()
+
+			candidate := auth.Clone()
+			candidate.Attributes["base_url"] = server.URL
+			executor := NewCodexWebsocketsExecutor(&config.Config{SDKConfig: config.SDKConfig{DisableImageGeneration: config.DisableImageGenerationAll}})
+			if err := path.run(context.Background(), executor, candidate); err == nil {
+				t.Fatal("websocket executor returned nil error for capture response")
+			}
+			select {
+			case headers := <-captured:
+				assertProtected(t, headers)
+			case <-time.After(2 * time.Second):
+				t.Fatal("timed out waiting for websocket handshake headers")
+			}
+		})
+	}
+
+	t.Run("seed metadata mismatch", func(t *testing.T) {
+		mismatched := auth.Clone()
+		mismatched.Metadata["account_id"] = "different-account"
+		req, err := http.NewRequest(http.MethodGet, "https://chatgpt.com/backend-api/wham/usage", nil)
+		if err != nil {
+			t.Fatalf("NewRequest() error = %v", err)
+		}
+		req.Header.Set("Chatgpt-Account-Id", "attacker-account")
+		if err = NewCodexExecutor(&config.Config{}).PrepareRequest(req, mismatched); err != nil {
+			t.Fatalf("PrepareRequest() error = %v", err)
+		}
+		finalizeCodexOutboundHeaders(req.Header, mismatched, canaryModel, nil)
+		if got := req.Header.Get("Authorization"); got != "Bearer canonical-token" {
+			t.Fatalf("Authorization = %q, want canonical token", got)
+		}
+		if got := req.Header.Get("Chatgpt-Account-Id"); got != "" {
+			t.Fatalf("mismatched identity leaked Chatgpt-Account-Id %q", got)
+		}
+	})
+
+	t.Run("production call sites", func(t *testing.T) {
+		_, testFile, _, ok := runtime.Caller(0)
+		if !ok {
+			t.Fatal("runtime.Caller() could not locate test source")
+		}
+		for file, wantCalls := range map[string]int{
+			"codex_executor_execute.go":   2,
+			"codex_executor_stream.go":    1,
+			"codex_openai_images.go":      4,
+			"codex_websockets_execute.go": 1,
+			"codex_websockets_stream.go":  1,
+		} {
+			data, err := os.ReadFile(filepath.Join(filepath.Dir(testFile), file))
+			if err != nil {
+				t.Fatalf("read %s: %v", file, err)
+			}
+			if got := strings.Count(string(data), "finalizeCodexOutboundHeaders("); got != wantCalls {
+				t.Fatalf("%s final header boundaries = %d, want %d", file, got, wantCalls)
+			}
+		}
+	})
+}
