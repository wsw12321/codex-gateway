+package api
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/access"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+)
+
+type quotaCaptureExecutor struct {
+	request      *http.Request
+	auth         *auth.Auth
+	responseBody string
+	status       int
+	err          error
+}
+
+func (*quotaCaptureExecutor) Identifier() string { return "codex" }
+
+func (*quotaCaptureExecutor) Execute(context.Context, *auth.Auth, coreexecutor.Request, coreexecutor.Options) (coreexecutor.Response, error) {
+	return coreexecutor.Response{}, nil
+}
+
+func (*quotaCaptureExecutor) ExecuteStream(context.Context, *auth.Auth, coreexecutor.Request, coreexecutor.Options) (*coreexecutor.StreamResult, error) {
+	return nil, nil
+}
+
+func (*quotaCaptureExecutor) Refresh(_ context.Context, candidate *auth.Auth) (*auth.Auth, error) {
+	return candidate.Clone(), nil
+}
+
+func (*quotaCaptureExecutor) CountTokens(context.Context, *auth.Auth, coreexecutor.Request, coreexecutor.Options) (coreexecutor.Response, error) {
+	return coreexecutor.Response{}, nil
+}
+
+func (*quotaCaptureExecutor) PrepareRequest(req *http.Request, candidate *auth.Auth) error {
+	token, _ := candidate.Metadata["access_token"].(string)
+	if apiKey := strings.TrimSpace(candidate.Attributes["api_key"]); apiKey != "" {
+		token = apiKey
+	}
+	req.Header.Set("Authorization", "Bearer "+token)
+	for key, value := range candidate.Attributes {
+		if !strings.HasPrefix(strings.ToLower(key), "header:") {
+			continue
+		}
+		name := strings.TrimSpace(key[len("header:"):])
+		if strings.EqualFold(name, "Host") {
+			req.Host = value
+		}
+		req.Header.Set(name, value)
+	}
+	return nil
+}
+
+func (e *quotaCaptureExecutor) HttpRequest(_ context.Context, candidate *auth.Auth, req *http.Request) (*http.Response, error) {
+	if err := e.PrepareRequest(req, candidate); err != nil {
+		return nil, err
+	}
+	e.request = req.Clone(req.Context())
+	e.auth = candidate.Clone()
+	if e.err != nil {
+		return nil, e.err
+	}
+	status := e.status
+	if status == 0 {
+		status = http.StatusOK
+	}
+	return &http.Response{
+		StatusCode: status,
+		Header:     http.Header{"Content-Type": {"application/json"}},
+		Body:       io.NopCloser(strings.NewReader(e.responseBody)),
+	}, nil
+}
