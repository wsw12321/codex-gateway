+func authCacheMarker(auth *coreauth.Auth) *coreauth.Auth {
+	if auth == nil {
+		return nil
+	}
+	marker := &coreauth.Auth{ID: auth.ID, Provider: auth.Provider}
+	if auth.Attributes != nil {
+		marker.Attributes = map[string]string{
+			coreauth.AttributeSourceBackend: auth.Attributes[coreauth.AttributeSourceBackend],
+			coreauth.AttributeAuthIndexSeed: auth.Attributes[coreauth.AttributeAuthIndexSeed],
+			coreauth.AttributeAuthKind:      auth.AuthKind(),
+		}
+	}
+	return marker
+}
