+func (e *CodexExecutor) newHTTPClient(ctx context.Context, auth *cliproxyauth.Auth) *http.Client {
+	httpClient := helps.NewUtlsHTTPClient(ctx, e.cfg, auth, 0)
+	// Never follow redirects on any Codex path. The auth manager must observe
+	// the original 3xx and refuse credential switching, while direct quota
+	// requests must not send account metadata to a Location-selected host.
+	httpClient.CheckRedirect = codexRejectRedirect
+	return httpClient
+}
+
+func (e *CodexExecutor) newProxyAwareHTTPClient(ctx context.Context, auth *cliproxyauth.Auth) *http.Client {
+	httpClient := helps.NewProxyAwareHTTPClient(ctx, e.cfg, auth, 0)
+	httpClient.CheckRedirect = codexRejectRedirect
+	return httpClient
+}
+
+func codexRejectRedirect(*http.Request, []*http.Request) error {
+	return http.ErrUseLastResponse
+}
+
+func protectCodexOAuthRequestHeaders(req *http.Request, auth *cliproxyauth.Auth) {
+	if req == nil {
+		return
+	}
+	util.RemoveCodexInternalHeaders(req.Header)
+	if auth == nil || auth.AuthKind() != cliproxyauth.AuthKindOAuth || !strings.EqualFold(strings.TrimSpace(auth.Provider), "codex") {
+		return
+	}
+	token, _ := auth.Metadata["access_token"].(string)
+	token = strings.TrimSpace(token)
+	if token == "" {
+		req.Header.Del("Authorization")
+	} else {
+		req.Header.Set("Authorization", "Bearer "+token)
+	}
+	accountID, _ := auth.Metadata["account_id"].(string)
+	accountID = strings.TrimSpace(accountID)
+	if _, attributable := cliproxyauth.CodexOAuthAccountIndex(auth); !attributable || !cliproxyauth.ValidCodexOAuthAccountID(accountID) {
+		req.Header.Del("Chatgpt-Account-Id")
+	} else {
+		req.Header.Set("Chatgpt-Account-Id", accountID)
+	}
+}
