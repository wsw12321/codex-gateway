+	if updated.Disabled && updated.Status == StatusDisabled {
+		return true
+	}
+	previousIndex, previousValid := CodexOAuthAccountIndex(previous)
+	updatedIndex, updatedValid := CodexOAuthAccountIndex(updated)
+	if !previousValid {
+		return false
+	}
+	return !updatedValid || previousIndex != updatedIndex
+}
