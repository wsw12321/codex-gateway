+func isCodexOAuthReconciliationMarker(candidate *coreauth.Auth) bool {
+	if candidate == nil || !strings.EqualFold(strings.TrimSpace(candidate.Provider), "codex") || candidate.AuthKind() != coreauth.AuthKindOAuth {
+		return false
+	}
+	if candidate.Attributes == nil || !strings.EqualFold(strings.TrimSpace(candidate.Attributes[coreauth.AttributeSourceBackend]), coreauth.AuthSourceFile) {
+		return false
+	}
+	seed := strings.TrimSpace(candidate.Attributes[coreauth.AttributeAuthIndexSeed])
+	const prefix = "codex-account:"
+	if !strings.HasPrefix(seed, prefix) || len(seed) != len(prefix)+sha256.Size*2 {
+		return false
+	}
+	for _, char := range seed[len(prefix):] {
+		if char < '0' || char > '9' {
