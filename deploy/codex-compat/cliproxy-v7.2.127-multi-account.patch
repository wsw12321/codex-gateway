+				if stream {
+					_, _ = manager.ExecuteStream(context.Background(), []string{"codex"}, request, cliproxyexecutor.Options{Stream: true})
+				} else {
+					_, _ = manager.Execute(context.Background(), []string{"codex"}, request, cliproxyexecutor.Options{})
+				}
+				calls := executor.Calls()
+				if len(calls) != 1 {
+					t.Fatalf("upstream calls = %v, want one", calls)
+				}
+				candidate, ok := manager.GetByID(calls[0])
+				if !ok || candidate == nil {
+					t.Fatalf("selected account %q is missing", calls[0])
+				}
+				if candidate.Unavailable || candidate.Status == StatusError {
