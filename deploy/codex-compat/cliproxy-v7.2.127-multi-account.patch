+// finalizeCodexOutboundHeaders is the mandatory last header assembly boundary
+// for every Codex HTTP, image, and WebSocket data path. Model overrides are
+// applied first; OAuth credentials and internal-header removal then win last.
+func finalizeCodexOutboundHeaders(headers http.Header, auth *cliproxyauth.Auth, modelName string, identityState *codexIdentityConfuseState) {
+	if headers == nil {
+		return
+	}
+	applyModelHeaderOverrides(headers, modelName)
+	applyCodexIdentityConfuseHeaders(headers, identityState)
+	protectCodexOAuthRequestHeaders(&http.Request{Header: headers}, auth)
+}
