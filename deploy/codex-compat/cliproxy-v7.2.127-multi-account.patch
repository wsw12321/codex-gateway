+func TestCodexOAuthTokenEndpointErrorsAreTypedAndRedacted(t *testing.T) {
+	for _, test := range []struct {
+		name         string
+		status       int
+		body         string
+		wantStatus   int
+		nonRetryable bool
+	}{
+		{
+			name:         "invalid grant",
+			status:       http.StatusBadRequest,
+			body:         `{"error":"invalid_grant","error_description":"secret-refresh-token must not leak"}`,
+			wantStatus:   http.StatusUnauthorized,
+			nonRetryable: true,
+		},
+		{
+			name:         "nested reused token",
+			status:       http.StatusBadRequest,
+			body:         `{"error":{"type":"invalid_grant","code":"refresh_token_reused","message":"secret-body"}}`,
+			wantStatus:   http.StatusUnauthorized,
+			nonRetryable: true,
+		},
+		{
+			name:       "untrusted text is not classified",
+			status:     http.StatusBadRequest,
+			body:       `invalid_grant secret-body`,
+			wantStatus: http.StatusBadRequest,
+		},
+		{
+			name:       "server failure",
+			status:     http.StatusBadGateway,
+			body:       `{"error":"server_error","detail":"secret-body"}`,
+			wantStatus: http.StatusBadGateway,
+		},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			auth := &CodexAuth{httpClient: &http.Client{Transport: roundTripFunc(func(req *http.Request) (*http.Response, error) {
+				return &http.Response{
+					StatusCode: test.status,
+					Body:       io.NopCloser(strings.NewReader(test.body)),
+					Header:     make(http.Header),
+					Request:    req,
+				}, nil
+			})}}
+			_, err := auth.refreshTokensSingleFlight(context.Background(), "secret-refresh-token")
+			if err == nil {
+				t.Fatal("expected token endpoint error")
+			}
+			statusErr, ok := err.(interface{ StatusCode() int })
+			if !ok || statusErr.StatusCode() != test.wantStatus {
+				t.Fatalf("typed status = %T %v, want %d", err, err, test.wantStatus)
+			}
+			if got := isNonRetryableRefreshErr(err); got != test.nonRetryable {
+				t.Fatalf("isNonRetryableRefreshErr() = %t, want %t", got, test.nonRetryable)
+			}
+			for _, sensitive := range []string{"secret-refresh-token", "secret-body", "error_description", "\"detail\""} {
+				if strings.Contains(err.Error(), sensitive) {
+					t.Fatalf("token endpoint error leaked %q: %v", sensitive, err)
+				}
+			}
+		})
+	}
+}
