+func orderCodexOAuthReplacementDeletes(updates []AuthUpdate, oldState, newState map[string]*coreauth.Auth) []AuthUpdate {
+	if len(updates) < 2 {
+		return updates
+	}
+	newWinnerByKey := make(map[string]string)
+	for id, candidate := range newState {
+		if key, ok := coreauth.CodexOAuthDeduplicationKey(candidate); ok {
+			newWinnerByKey[key] = id
+		}
+	}
+	replacedIDs := make(map[string]struct{})
+	for id, candidate := range oldState {
+		key, ok := coreauth.CodexOAuthDeduplicationKey(candidate)
+		if !ok {
+			continue
+		}
+		if newID := newWinnerByKey[key]; newID != "" && newID != id {
+			replacedIDs[id] = struct{}{}
+		}
+	}
+	if len(replacedIDs) == 0 {
+		return updates
+	}
+	ordered := make([]AuthUpdate, 0, len(updates))
+	for _, update := range updates {
+		if update.Action == AuthUpdateActionDelete {
+			if _, replaced := replacedIDs[update.ID]; replaced {
+				ordered = append(ordered, update)
+			}
+		}
+	}
+	for _, update := range updates {
+		if update.Action == AuthUpdateActionDelete {
+			if _, replaced := replacedIDs[update.ID]; replaced {
+				continue
+			}
+		}
+		ordered = append(ordered, update)
+	}
+	return ordered
+}
