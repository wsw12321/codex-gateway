+type codexOAuthTokenError struct {
+	operation      string
+	upstreamStatus int
+	code           string
+}
+
+func (e *codexOAuthTokenError) Error() string {
+	if e == nil {
+		return ""
+	}
+	operation := strings.TrimSpace(e.operation)
+	if operation == "" {
+		operation = "token request"
+	}
+	if e.code != "" {
+		return fmt.Sprintf("Codex OAuth %s failed: %s", operation, e.code)
+	}
+	return fmt.Sprintf("Codex OAuth %s failed with status %d", operation, e.upstreamStatus)
+}
+
+// StatusCode exposes only the normalized failure category. A trusted token
+// endpoint invalid_grant is authentication failure even though OAuth commonly
+// carries it in an HTTP 400 response.
+func (e *codexOAuthTokenError) StatusCode() int {
+	if e == nil {
+		return 0
+	}
+	switch e.code {
+	case "invalid_grant", "refresh_token_reused", "invalid_client", "unauthorized_client":
+		return http.StatusUnauthorized
+	case "access_denied":
+		return http.StatusForbidden
+	default:
+		return e.upstreamStatus
+	}
+}
+
+func newCodexOAuthTokenError(operation string, status int, body []byte) error {
+	return &codexOAuthTokenError{
