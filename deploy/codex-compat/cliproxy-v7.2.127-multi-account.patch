+// CaptureGatewayAffinityScope validates and consumes the gateway-only caller
+// scope header. The exact 43-character base64url shape matches an unpadded
+// HMAC-SHA256 value and avoids accepting client-controlled routing material.
+func CaptureGatewayAffinityScope(c *gin.Context) {
+	if c == nil || c.Request == nil {
+		return
+	}
+	values := c.Request.Header.Values(GatewayAffinityHeader)
+	c.Request.Header.Del(GatewayAffinityHeader)
+	if len(values) == 0 {
+		return
+	}
+	if len(values) != 1 || values[0] != strings.TrimSpace(values[0]) || !validGatewayAffinityScope(values[0]) {
+		c.AbortWithStatusJSON(http.StatusBadRequest, gin.H{"error": "invalid_gateway_affinity"})
+		return
+	}
+	c.Set(gatewayAffinityKey, values[0])
