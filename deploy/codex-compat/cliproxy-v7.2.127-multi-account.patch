+func TestGatewayRetryPolicyEligibleFailuresTouchAtMostTwoAccounts(t *testing.T) {
+	for _, failure := range []struct {
+		name string
+		err  error
+	}{
+		{name: "server error", err: &Error{HTTPStatus: http.StatusBadGateway, Message: "upstream failed"}},
+		{name: "request scoped 408", err: &requestScopedStatusError{status: http.StatusRequestTimeout, message: "stream disconnected before completion"}},
+	} {
+		for _, stream := range []bool{false, true} {
+			mode := "ordinary"
+			if stream {
+				mode = "stream bootstrap"
+			}
+			t.Run(failure.name+"/"+mode, func(t *testing.T) {
+				executor := &gatewayPolicyExecutor{id: "codex", err: failure.err}
+				manager := newGatewayPolicyManager(t, executor, 3)
+				request := cliproxyexecutor.Request{Model: "gateway-model"}
+				if stream {
+					_, _ = manager.ExecuteStream(context.Background(), []string{executor.id}, request, cliproxyexecutor.Options{Stream: true})
+				} else {
+					_, _ = manager.Execute(context.Background(), []string{executor.id}, request, cliproxyexecutor.Options{})
+				}
+				calls := executor.Calls()
+				if len(calls) != 2 || calls[0] == calls[1] {
+					t.Fatalf("upstream calls = %v, want two distinct accounts", calls)
+				}
+				if failure.name == "request scoped 408" {
+					for _, id := range calls {
+						candidate, ok := manager.GetByID(id)
+						if !ok || candidate == nil {
+							t.Fatalf("attempted account %q is missing", id)
+						}
+						if candidate.Unavailable || candidate.Status == StatusError {
+							t.Fatalf("request-scoped 408 poisoned account %q: %#v", id, candidate)
+						}
+						if state := candidate.ModelStates["gateway-model"]; state != nil && state.Unavailable {
+							t.Fatalf("request-scoped 408 poisoned model on %q: %#v", id, state)
+						}
+					}
+				}
+			})
+		}
+	}
+}
