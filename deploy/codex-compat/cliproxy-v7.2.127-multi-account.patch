+		// fileAuthsByPath intentionally stores only a non-secret marker, not the
+		// raw account ID required by CodexOAuthDeduplicationKey. Recognize that
+		// marker solely to trigger a full filesystem rescan; the rescan restores
+		// and revalidates the canonical identity before anything becomes routable.
+		if isCodexOAuthReconciliationMarker(candidate) {
+			return true
+		}
+	}
+	return false
