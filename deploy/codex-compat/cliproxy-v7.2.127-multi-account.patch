+func TestSessionAffinitySelectorCallerScopeIsolatesExplicitAndBodySessions(t *testing.T) {
+	t.Parallel()
+
+	for _, test := range []struct {
+		name    string
+		headers http.Header
+		body    []byte
+	}{
+		{name: "explicit header", headers: http.Header{"Session-Id": {"same-session"}}},
+		{name: "prompt cache", body: []byte(`{"prompt_cache_key":"same-session"}`)},
+		{name: "conversation", body: []byte(`{"conversation":{"id":"same-session"}}`)},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			selector := NewSessionAffinitySelectorWithConfig(SessionAffinityConfig{
+				Fallback: &RoundRobinSelector{},
+				TTL:      time.Minute,
+			})
+			defer selector.Stop()
+			auths := []*Auth{{ID: "auth-a"}, {ID: "auth-b"}}
+			provider := "caller-scope-" + test.name
+
+			optionsFor := func(scope string) cliproxyexecutor.Options {
+				return cliproxyexecutor.Options{
+					Headers:         test.headers,
+					OriginalRequest: test.body,
+					Metadata: map[string]any{
+						cliproxyexecutor.CallerScopeMetadataKey: scope,
+					},
+				}
+			}
+
+			firstA, err := selector.Pick(context.Background(), provider, "model", optionsFor("caller-a"), auths)
+			if err != nil {
+				t.Fatalf("caller A first Pick() error = %v", err)
+			}
+			firstB, err := selector.Pick(context.Background(), provider, "model", optionsFor("caller-b"), auths)
+			if err != nil {
+				t.Fatalf("caller B first Pick() error = %v", err)
+			}
+			if firstA.ID == firstB.ID {
+				t.Fatalf("different caller scopes shared a cold binding: %q", firstA.ID)
+			}
+
+			againA, _ := selector.Pick(context.Background(), provider, "model", optionsFor("caller-a"), auths)
+			againB, _ := selector.Pick(context.Background(), provider, "model", optionsFor("caller-b"), auths)
+			if againA.ID != firstA.ID || againB.ID != firstB.ID {
+				t.Fatalf("caller-scoped bindings were not sticky: A=%s/%s B=%s/%s", firstA.ID, againA.ID, firstB.ID, againB.ID)
+			}
+		})
+	}
+}
