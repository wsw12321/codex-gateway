+type codexRedirectRoundTripper func(*http.Request) (*http.Response, error)
+
+func (fn codexRedirectRoundTripper) RoundTrip(req *http.Request) (*http.Response, error) {
+	return fn(req)
+}
+
+func TestCodexRejectRedirectReturnsOriginalResponse(t *testing.T) {
+	t.Parallel()
+	if err := codexRejectRedirect(nil, nil); !errors.Is(err, http.ErrUseLastResponse) {
+		t.Fatalf("codexRejectRedirect() = %v, want http.ErrUseLastResponse", err)
+	}
+}
+
+func TestCodexHttpRequestDoesNotFollowRedirect(t *testing.T) {
+	t.Parallel()
+	calls := 0
+	transport := codexRedirectRoundTripper(func(req *http.Request) (*http.Response, error) {
+		calls++
+		if calls > 1 {
+			t.Fatalf("Codex HttpRequest followed redirect to %s", req.URL)
+		}
+		return &http.Response{
+			StatusCode: http.StatusFound,
+			Header:     http.Header{"Location": {"https://attacker.invalid/credential-sink"}},
+			Body:       io.NopCloser(strings.NewReader("redirect blocked")),
+			Request:    req,
+		}, nil
+	})
+	ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", http.RoundTripper(transport))
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, "https://chatgpt.com/backend-api/wham/usage", nil)
+	if err != nil {
+		t.Fatalf("NewRequestWithContext() error = %v", err)
+	}
+	executor := NewCodexExecutor(&config.Config{})
+	resp, err := executor.HttpRequest(ctx, &cliproxyauth.Auth{Metadata: map[string]any{"access_token": "secret"}}, req)
+	if err != nil {
+		t.Fatalf("HttpRequest() error = %v", err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusFound || calls != 1 {
+		t.Fatalf("status/calls = %d/%d, want 302/1", resp.StatusCode, calls)
+	}
+}
+
+func TestCodexImageHTTPClientDoesNotFollowRedirect(t *testing.T) {
+	t.Parallel()
+	calls := 0
+	transport := codexRedirectRoundTripper(func(req *http.Request) (*http.Response, error) {
+		calls++
+		if calls > 1 {
+			t.Fatalf("Codex image client followed redirect to %s", req.URL)
+		}
+		return &http.Response{
+			StatusCode: http.StatusTemporaryRedirect,
+			Header:     http.Header{"Location": {"https://attacker.invalid/prompt-sink"}},
+			Body:       io.NopCloser(strings.NewReader("redirect blocked")),
+			Request:    req,
+		}, nil
+	})
+	ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", http.RoundTripper(transport))
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"prompt":"sensitive"}`))
+	if err != nil {
+		t.Fatalf("NewRequestWithContext() error = %v", err)
+	}
+	executor := NewCodexExecutor(&config.Config{})
+	resp, err := executor.newProxyAwareHTTPClient(ctx, &cliproxyauth.Auth{}).Do(req)
+	if err != nil {
+		t.Fatalf("image client Do() error = %v", err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusTemporaryRedirect || calls != 1 {
+		t.Fatalf("status/calls = %d/%d, want 307/1", resp.StatusCode, calls)
+	}
+}
