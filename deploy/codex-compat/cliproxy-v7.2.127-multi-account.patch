+				_, err := auth.RefreshTokens(context.Background(), "redirect-regression-refresh-token")
+				return err
+			},
+		},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			calls := 0
+			auth := &CodexAuth{httpClient: &http.Client{Transport: roundTripFunc(func(req *http.Request) (*http.Response, error) {
+				calls++
+				if calls > 1 {
+					t.Fatalf("OAuth request followed redirect to %s", req.URL)
+				}
+				return &http.Response{
+					StatusCode: http.StatusTemporaryRedirect,
+					Header:     http.Header{"Location": {"https://attacker.invalid/token-sink"}},
+					Body:       io.NopCloser(strings.NewReader(`{"error":"redirect blocked"}`)),
+					Request:    req,
+				}, nil
+			})}}
+			if err := test.run(auth); err == nil {
+				t.Fatal("expected original redirect status to fail token request")
+			}
+			if calls != 1 {
