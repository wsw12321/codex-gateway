# Production template for the local "OpenAI API Token 等价成本" v2 catalog.
# Copy to .env, then replace the hostname, revision, and deployment group.
#
# Token prices were reviewed against official OpenAI documentation on
# 2026-08-20. Pricing v2 selects Standard/Flex/Fast, <=272K/>272K, cached input,
# and (for GPT-5.6) separate cache-write prices from an admission-time snapshot.
# Batch, Ultrafast, tools, regional processing and tax remain out of scope.
#
# The USD/CNY rate below is an operator-selected fixed accounting rate, not an
# OpenAI-published value. Replace it and fx_as_of with your reviewed rate.
# codex-auto-review has no separately published API price and is intentionally
# treated as a zero-priced internal governance request in this template.

GATEWAY_DOMAIN=replace-with-real-cloudflare-hostname

# For a checkout without a release tag, set all three values to the same full
# lowercase 40-character Git revision returned by: git rev-parse HEAD
GATEWAY_IMAGE_TAG=replace-with-full-git-sha
GATEWAY_VERSION=replace-with-full-git-sha
GATEWAY_REVISION=replace-with-full-git-sha

# Keep this minified copy of deploy/pricing-v2.example.json on exactly one line.
GATEWAY_USAGE_PRICING_JSON={"schema_version":2,"catalog_as_of":"2026-08-20","fx_as_of":"2026-08-20","usd_cny_rate":"7.20","fallback_policy":{"unknown_service_tier":"max_published","missing_price_combination":"max_published","missing_cache_write_tokens":"all_uncached_as_write"},"models":{"gpt-5.6-sol":{"cache_write_mode":"separate","max_input_tokens":1050000,"long_context_threshold_tokens":272000,"service_tiers":{"standard":{"short":{"input_usd_per_million":"5","cached_input_usd_per_million":"0.5","cache_write_usd_per_million":"6.25","output_usd_per_million":"30"},"long":{"input_usd_per_million":"10","cached_input_usd_per_million":"1","cache_write_usd_per_million":"12.5","output_usd_per_million":"45"}},"flex":{"short":{"input_usd_per_million":"2.5","cached_input_usd_per_million":"0.25","cache_write_usd_per_million":"3.125","output_usd_per_million":"15"},"long":{"input_usd_per_million":"5","cached_input_usd_per_million":"0.5","cache_write_usd_per_million":"6.25","output_usd_per_million":"22.5"}},"fast":{"short":{"input_usd_per_million":"10","cached_input_usd_per_million":"1","cache_write_usd_per_million":"12.5","output_usd_per_million":"60"},"long":{"input_usd_per_million":"20","cached_input_usd_per_million":"2","cache_write_usd_per_million":"25","output_usd_per_million":"90"}}}},"gpt-5.6-terra":{"cache_write_mode":"separate","max_input_tokens":1050000,"long_context_threshold_tokens":272000,"service_tiers":{"standard":{"short":{"input_usd_per_million":"2","cached_input_usd_per_million":"0.2","cache_write_usd_per_million":"2.5","output_usd_per_million":"12"},"long":{"input_usd_per_million":"4","cached_input_usd_per_million":"0.4","cache_write_usd_per_million":"5","output_usd_per_million":"18"}},"flex":{"short":{"input_usd_per_million":"1","cached_input_usd_per_million":"0.1","cache_write_usd_per_million":"1.25","output_usd_per_million":"6"},"long":{"input_usd_per_million":"2","cached_input_usd_per_million":"0.2","cache_write_usd_per_million":"2.5","output_usd_per_million":"9"}},"fast":{"short":{"input_usd_per_million":"4","cached_input_usd_per_million":"0.4","cache_write_usd_per_million":"5","output_usd_per_million":"24"},"long":{"input_usd_per_million":"8","cached_input_usd_per_million":"0.8","cache_write_usd_per_million":"10","output_usd_per_million":"36"}}}},"gpt-5.6-luna":{"cache_write_mode":"separate","max_input_tokens":1050000,"long_context_threshold_tokens":272000,"service_tiers":{"standard":{"short":{"input_usd_per_million":"0.2","cached_input_usd_per_million":"0.02","cache_write_usd_per_million":"0.25","output_usd_per_million":"1.2"},"long":{"input_usd_per_million":"0.4","cached_input_usd_per_million":"0.04","cache_write_usd_per_million":"0.5","output_usd_per_million":"1.8"}},"flex":{"short":{"input_usd_per_million":"0.1","cached_input_usd_per_million":"0.01","cache_write_usd_per_million":"0.125","output_usd_per_million":"0.6"},"long":{"input_usd_per_million":"0.2","cached_input_usd_per_million":"0.02","cache_write_usd_per_million":"0.25","output_usd_per_million":"0.9"}},"fast":{"short":{"input_usd_per_million":"0.4","cached_input_usd_per_million":"0.04","cache_write_usd_per_million":"0.5","output_usd_per_million":"2.4"},"long":{"input_usd_per_million":"0.8","cached_input_usd_per_million":"0.08","cache_write_usd_per_million":"1","output_usd_per_million":"3.6"}}}},"gpt-5.5":{"cache_write_mode":"included_in_input","max_input_tokens":1050000,"long_context_threshold_tokens":272000,"service_tiers":{"standard":{"short":{"input_usd_per_million":"5","cached_input_usd_per_million":"0.5","output_usd_per_million":"30"},"long":{"input_usd_per_million":"10","cached_input_usd_per_million":"1","output_usd_per_million":"45"}},"flex":{"short":{"input_usd_per_million":"2.5","cached_input_usd_per_million":"0.25","output_usd_per_million":"15"},"long":{"input_usd_per_million":"5","cached_input_usd_per_million":"0.5","output_usd_per_million":"22.5"}},"fast":{"short":{"input_usd_per_million":"12.5","cached_input_usd_per_million":"1.25","output_usd_per_million":"75"}}}},"gpt-5.4":{"cache_write_mode":"included_in_input","max_input_tokens":1050000,"long_context_threshold_tokens":272000,"service_tiers":{"standard":{"short":{"input_usd_per_million":"2.5","cached_input_usd_per_million":"0.25","output_usd_per_million":"15"},"long":{"input_usd_per_million":"5","cached_input_usd_per_million":"0.5","output_usd_per_million":"22.5"}},"flex":{"short":{"input_usd_per_million":"1.25","cached_input_usd_per_million":"0.13","output_usd_per_million":"7.5"},"long":{"input_usd_per_million":"2.5","cached_input_usd_per_million":"0.25","output_usd_per_million":"11.25"}},"fast":{"short":{"input_usd_per_million":"5","cached_input_usd_per_million":"0.5","output_usd_per_million":"30"}}}},"gpt-5.4-mini":{"cache_write_mode":"included_in_input","max_input_tokens":272000,"long_context_threshold_tokens":272000,"service_tiers":{"standard":{"short":{"input_usd_per_million":"0.75","cached_input_usd_per_million":"0.075","output_usd_per_million":"4.5"}},"flex":{"short":{"input_usd_per_million":"0.375","cached_input_usd_per_million":"0.0375","output_usd_per_million":"2.25"}},"fast":{"short":{"input_usd_per_million":"1.5","cached_input_usd_per_million":"0.15","output_usd_per_million":"9"}}}},"codex-auto-review":{"cache_write_mode":"included_in_input","max_input_tokens":272000,"long_context_threshold_tokens":272000,"service_tiers":{"standard":{"short":{"input_usd_per_million":"0","cached_input_usd_per_million":"0","output_usd_per_million":"0"}}}}}}

# Set to the primary group of the dedicated deployment user: id -g
GATEWAY_SECRET_GID=replace-with-deployment-user-gid

# Keep this aligned with the fixed Caddy address in docker-compose.yml.
GATEWAY_TRUSTED_PROXY_CIDRS=172.28.10.2/32

# Conservative starting points for one ChatGPT Pro upstream account.
LIMIT_KEY_CONCURRENT=16
LIMIT_USER_CONCURRENT=16
LIMIT_GLOBAL_CONCURRENT=32

# Used by scripts/smoke-sidecar.sh after the upstream OAuth login succeeds.
CODEX_SMOKE_MODEL=gpt-5.6-sol
