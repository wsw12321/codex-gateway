# Production template for a GPT-6/GPT-5.6 deployment.
# Copy to .env, then replace the hostname, revision, and deployment group.
#
# Prices are built into the Gateway image from the reviewed catalog
# internal/config/data/pricing.json; no pricing setting belongs here. To
# deviate from the built-in prices or USD/CNY rate on this server only, create
# deploy/pricing/override.json (see deploy/pricing/README.md). The retired
# GATEWAY_USAGE_PRICING_JSON setting stops every Compose call; migrate it with
# `gateway pricing migrate-env` (docs/operations.md).

GATEWAY_DOMAIN=replace-with-real-cloudflare-hostname

# For a checkout without a release tag, set all three values to the same full
# lowercase 40-character Git revision returned by: git rev-parse HEAD
GATEWAY_IMAGE_TAG=replace-with-full-git-sha
GATEWAY_VERSION=replace-with-full-git-sha
GATEWAY_REVISION=replace-with-full-git-sha

# Set to the primary group of the dedicated deployment user: id -g. The
# required gateway_api_key_encryption_key is generated under deploy/secrets as
# unpadded URL-safe Base64 for exactly 32 bytes and must never be put in .env.
GATEWAY_SECRET_GID=replace-with-deployment-user-gid

# Keep this aligned with the fixed Caddy address in docker-compose.yml.
GATEWAY_TRUSTED_PROXY_CIDRS=172.28.10.2/32

# Conservative starting points for a small pool of ChatGPT Plus/Pro upstream
# accounts. Tune these aggregate limits against observed per-account quotas.
LIMIT_KEY_CONCURRENT=16
LIMIT_USER_CONCURRENT=16
LIMIT_GLOBAL_CONCURRENT=32

# Shared Codex/Gemini egress. Apply changes with ./scripts/apply-egress.sh.
# See docs/egress.md. Missing/empty mode retains selection by CODEX_RELAY_IP.
EGRESS_MODE=direct
# Upgrade B's allowlist first for relay mode; see docs/relay-upgrade.md.
CODEX_RELAY_IP=
CODEX_RELAY_PORT=3128
SHADOWSOCKS_SERVER=
SHADOWSOCKS_PORT=24019
SHADOWSOCKS_CIPHER=aes-128-gcm
SHADOWSOCKS_PASSWORD_FILE=./deploy/secrets/shadowsocks_password
