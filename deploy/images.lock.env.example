# Production uses deploy/images.lock.env, generated by scripts/lock-images.sh.
# Every value in the generated file has this shape:
# CADDY_IMAGE=docker.io/library/caddy:2.10.2-alpine@sha256:<64 hex digits>
# CLOUDFLARED_IMAGE=docker.io/cloudflare/cloudflared:2026.7.3@sha256:<64 hex digits>
#
# Placeholder digests are intentionally not accepted by Compose validation.
# Resolve the reviewed tags in deploy/images.sources, inspect the diff, and
# commit deploy/images.lock.env before deploying.
